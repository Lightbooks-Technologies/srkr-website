# ─────────────────────────────────────────────────────────────
# SRKR CMS (Payload) — environment variables
# Copy to `.env` for local dev; set these in the Vercel project for prod.
# ─────────────────────────────────────────────────────────────

# REQUIRED — long random string used to sign auth tokens. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# DATABASE
# Local dev (default): SQLite file — leave as-is or omit.
#   DATABASE_URI=file:./cms.db
# Production: a Neon Postgres pooled connection string (starts with postgres://).
#   The config auto-switches to Postgres when this starts with postgres://
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# FILE STORAGE (uploads)
# Production only: a Vercel Blob read-write token. When set, uploads go to
# Vercel Blob instead of local disk. Leave blank for local dev.
BLOB_READ_WRITE_TOKEN=

# CORS / CSRF — comma-separated list of front-end origins allowed to call the API.
# Add your production site domain here.
CORS_ORIGINS=http://localhost:4321,https://www.srkrec.ac.in

# AUTO-REBUILD (optional but recommended for the static site)
# A Vercel Deploy Hook URL for the FRONTEND (Astro) project. When published
# content changes, the CMS pings this to rebuild the site (~1–2 min).
SITE_DEPLOY_HOOK_URL=

# UMAMI ANALYTICS (proxy for the website's online-now widget + /analytics page)
# Cloud Pro: set the API key + website ID. Self-hosted alternative: set
# UMAMI_API_URL=https://<host>/api with UMAMI_USERNAME/UMAMI_PASSWORD instead
# of the API key.
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
