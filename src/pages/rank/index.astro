--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     
    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Rank Cut-Off</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->



    <!-- event details -->
    <div class="rts-event-details pt--50 pb--80">
        <div class="container">
            <div class="row justify-content-md-center justify-content-start">
                <div class="col-lg-7 col-md-10">
                    <div class="event-details">
                        <div class="event-details__content">
                            
                            
                            <div class="event-details__content--feature">
                                <h4>EAPCET/EAMCET Rank Cut-Off Details</h4>
                                <div class="single-feature">
                                    <p class="feature-heading">Last Ranks Admitted In EAPCET-2025</p>
                                    <p class="feature-description"><a href="/assets/docs/eamcet2025.pdf" target="_blank">Click Here</a></p>
                                </div>
                                <div class="single-feature">
                                    <p class="feature-heading">Last Ranks Admitted In AP ECET-2025</p>
                                    <p class="feature-description"><a href="/assets/docs/ecet2025.pdf" target="_blank">Click Here</a></p>
                                </div>
                                <div class="single-feature">
                                    <p class="feature-heading">Last Ranks Admitted In EAPCET-2024</p>
                                    <p class="feature-description"><a href="/assets/images/EAMCET-2024.jpg" target="_blank">Click Here</a></p>
                                </div>
                                <div class="single-feature">
                                    <p class="feature-heading">Last Ranks Admitted In ECET-2024</p>
                                    <p class="feature-description"><a href="/assets/images/APEAPCET-2024.jpg" target="_blank">Click Here</a></p>
                                </div>
                                <div class="single-feature">
                                    <p class="feature-heading">Last Ranks Admitted In EAPCET-2023</p>
                                    <p class="feature-description"><a href="/assets/docs/APEAPCET-2023.pdf" target="_blank">Click Here</a></p>
                                </div>
                                <div class="single-feature">
                                    <p class="feature-heading">Last Ranks Admitted In EAPCET-2022</p>
                                    <p class="feature-description"><a href="#">Click Here</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>