---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = "Organogram";
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Official Organogram / Organisation Chart of SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/org-structure/">Institute</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-about-area rts-section-padding">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 col-md-12 text-center">
            <div class="organogram-wrapper mb--40">
              <img 
                src="/assets/images/Organization_Chart.png" 
                alt="SRKR Engineering College Organization Chart" 
                class="img-fluid border shadow-sm p-3 bg-white"
                style="max-width: 100%; height: auto;"
              />
            </div>
            <div class="back-btn-wrapper">
              <a href="/org-structure/" class="rts-theme-btn">Back to Organizational Structure</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
