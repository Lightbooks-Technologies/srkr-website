--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Ethics Commitee</li>
                        </ul>
                        <h1 class="section-title">Research Ethics Commitee</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <section class="rts-about-university pt--100 pb--10">
        <div class="container">
            <div class="row">
                <div class="rts-section">
                    <div class="col-lg-4 col-md-3 col-sm-12">
                        <h3 class="rts-section-title">Ethics Oversight</h3>
                    </div>
                    <div class="col-lg-8 col-md-9 col-sm-12">
                        <p class="rts-section-description">
                            The REC ensures all research aligns with ethical standards.
It reviews proposals, monitors compliance, and educates researchers.
Periodic audits and community focus uphold research integrity.
                        </p>
                    </div>
                </div>
            </div>
            
        </div>
    </section>
    <!-- admission page content -->
    <div class="rts-page-content">
        <div class="container">
            <div class="row">
                
                <div class="col-12">
                    <div class="admission-content-top">
                        <div class="application-deadline">
                            <h3 class="rts-section-title">Ethics Commitee</h3>
                            <div class="application-deadline__content">
                                <div class="application-deadline__content--table">
                                    <table class="table">
                                        <thead class="table-theme">
                                          <tr>
                                            <td>Name</td>
                                            <td>Designation</td>
                                            <td>Role</td>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          <tr>
                                            <td>Dr. K.V. Murali Krishnam Raju</td>
                                            <td>Principal</td>
                                            <td>Chairman</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. T. Vamsi Nagaraju</td>
                                            <td>Dean, R&amp;D</td>
                                            <td>Coordinator</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. G. Sri Bala</td>
                                            <td>Head, Dept. of Civil Engineering</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. Bh.V.S.R.K. Raju</td>
                                            <td>Head, Dept. of CSE</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. N. Udaya Kumar</td>
                                            <td>Head, Dept. of ECE</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. B.R.K. Varma</td>
                                            <td>Head, Dept. of EEE</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. P. Ravi Kiran Varma</td>
                                            <td>Head, Dept. of IT</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. K. Suresh Babu</td>
                                            <td>Head, Dept. of Mechanical Engg.</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. Venu Reddy</td>
                                            <td>WET Centre &amp; Associate Dean, R&amp;D</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. G. Harish Kumar Varma</td>
                                            <td>Associate Dean, R&amp;D</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. K. Chalapathi Raju</td>
                                            <td>Associate Dean, R&amp;D</td>
                                            <td>Member</td>
                                          </tr>
                                          <tr>
                                            <td>Dr. K. Bala Sindhuri</td>
                                            <td>Associate Dean, R&amp;D</td>
                                            <td>Member</td>
                                          </tr>
                                        </tbody>
                                      </table>
                                      
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- admission page content end -->
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->


    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>