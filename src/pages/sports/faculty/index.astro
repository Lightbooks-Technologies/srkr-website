                        <td><a href="tel:9866474674">9866474674</a></td>
                      </tr>
                      <tr>
                        <td>5</td>
                        <td>Mrs. G Lohitha</td>
                        <td>Assistant Professor</td>
                        <td><a href="mailto:lohitha.g@srkr.ac.in">lohitha.g@srkr.ac.in</a></td>
                        <td><a href="tel:9490343229">9490343229</a></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- footer -->
    <SrkrFooter />

