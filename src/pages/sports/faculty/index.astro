                        <td>Associate Professor</td>
                        <td><a href="mailto:Psnraju@srkrec.ac.in">snraju@srkrec.ac.in</a></td>
                        <td><a href="tel:9441814118">9441814118</a></td>
                      </tr>
                      <tr>
                        <td>2</td>
                        <td>Dr. Ch Hari Mohan</td>
                        <td>Associate Professor</td>
                        <td><a href="mailto:Harimohan.ch@srkrec.ac.in">harimohan.ch@srkrec.ac.in</a></td>
                        <td><a href="tel:9949111178">9949111178</a></td>
                      </tr>
                      <tr>
                        <td>3</td>
                        <td>Mrs. G Sarika</td>
                        <td>Assistant Professor</td>
                        <td><a href="mailto:Sarika.g@srkrec.ac.in">sarika.g@srkrec.ac.in</a></td>
