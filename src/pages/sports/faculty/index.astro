---
import BaseHead from "../../../components/BaseHead.astro";
import FooterScripts from "../../../components/FooterScripts.astro";
import OffCanvas from "../../../components/OffCanvas.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../../consts";
import SrkrHeader from "../../../components/SrkrHeader.astro";
import SrkrFooter from "../../../components/SrkrFooter.astro";
import DeptNav from "~/components/DeptNav.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->

    <!-- BREADCRUMB AREA -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
              </ul>
              <h1 class="section-title">Sports and Games</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <div class="container">
      <div class="row mt--30">
        <DeptNav dept="pet" current="Faculty" />

        <div class="col-12">
          <div class="admission-content-top">
            <div class="application-deadline">
              <h3 class="rts-section-title">
                Department Faculty Members
              </h3>
              <div class="application-deadline__content">
                <div class="application-deadline__content--table">
                  <table class="table">
