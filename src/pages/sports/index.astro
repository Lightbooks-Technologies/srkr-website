---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import DeptNav from '../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Department of Physical Education | SRKR Engineering College" description="Department of Physical Education & Sports at SRKR Engineering College, Bhimavaram." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image:url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
              </ul>
              <h1 class="section-title">Sports and Games</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- content -->
    <div class="rts-faculty-details py-5">
      <div class="container">

        <DeptNav dept="pet" current="Home" />

        <!-- About the Department -->
        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-12 col-md-11">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-4">About the Department</h3>
              <p style="text-align: justify;">The Department of Physical Education at SRKR Engineering College is dedicated to promoting physical fitness, sportsmanship, and overall well-being among students. Regular athletic training, indoor and outdoor sports facilities, and structured physical training programs are provided to foster competitive spirit, leadership, and team collaboration.</p>
              <p style="text-align: justify;">The college boasts excellent infrastructure for various games such as cricket, football, basketball, volleyball, badminton, athletics, and indoor board games, enabling students to excel at university, state, and national level sports tournaments.</p>
            </div>
          </div>
        </div>

        <div class="border-top my-60 my_sm--10"></div>

        <!-- Head of the Department -->
        <div class="row mt--30">
          <div class="rts-section mb--60">
            <h3 class="rts-section-title">Department of Physical Education</h3>
          </div>
        </div>
        <div class="row mb-5 pb-5">
          <div class="col-lg-4 col-md-8">
            <div class="faculty-image text-center">
              <img class="img-fluid" src="/assets/images/faculty/sports/hari-sports.jpeg" alt="Dr. P. Satyanarayana Raju" style="width: 100%; max-width: 250px; aspect-ratio: 1 / 1; object-fit: contain; object-position: top; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
              <div class="h5 mb-2 mt-5">Dr. Ch. Hari Mohan</div>
              <span>Associate Professor</span>
              
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faculty-content-text ms-lg-5 mt-5 mt-lg-0">
              <p class="h6 mb-4">Message from the Head / Faculty Incharge</p>
              <p style="text-align: justify;">Physical education and sports are an integral part of holistic student development at SRKR Engineering College. Our objective is to channelize the energy of youth towards constructive athletic achievements, physical endurance, mental toughness, and discipline. We continuously encourage students to participate actively in intramural and inter-collegiate sports events. Beyond physical wellness, these activities cultivate essential leadership skills, sportsmanship, and strategic thinking under pressure. Through state-of-the-art infrastructure and dedicated mentorship, we strive to instill a lifelong commitment to health and competitive excellence.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
    <!-- content end -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>