--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     
    <!-- BREADCRUMB AREA -->
 <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                    </ul>
                    <h1 class="section-title">Computer Centre</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
    <!-- Testimonial Start -->
    <div class="rts-testimonial v_2 rt-relative pt--120 pb--120">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-section text-center mb--45">
                        <h2 class="rts-section-title">General Computer Centre</h2>
                        <p>The General Computing Centre (GCC) enhances the academic and research experience of students, faculty, and staff by providing advanced computing infrastructure and automation support. It manages SRKR's core network with 5 servers, 200 nodes, and 1000 Mbps LAN connectivity across the campus. GCC offers 24/7 internet access via a dedicated 1000 Mbps leased line and supports wireless connectivity through 16 strategically placed access points, ensuring reliable network access for mobile users.</p>
                    </div>
                </div>
            </div>
            <!-- testimonial content -->
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-testimonial-box">
                        <div class="testimonial-item rt-flex">
                            
                            <div class="testimonial-item-content rt-relative" style="width: 100%;">
                                <div class="testmonial-v2">
                                    <div class="swiper-wrapper">
                                        <!-- single testimonial -->
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-11.jpg" alt="testimonial thumbnail">
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-12.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-13.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-14.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                </div>
                           <div class="swiper-pagination"></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Testimonial end -->
    



   <!-- footer -->
   <SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>