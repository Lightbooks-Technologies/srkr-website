--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Academic Calendar</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- admission page content -->
    <div class="rts-page-content rts-section-padding">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="admission-content-top">
                        

                        <div class="requirement-deadline">
                            <h4 class="rts-subsection-title">Academic Calendar Downloads</h4>
                            <div class="requirement-deadline__content">
                                <ul>
                                    <li class="single-requirement">Academic Calendar 2026-27: 
                                        <a href="/files/ac/II_III_IV_B_TECH_AC 2026-27.pdf" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/II_M_TECH_AC 2026-27.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">
                                        <details>
                                            <summary style="background-color: #fff3cd; padding: 8px 12px; border-left: 4px solid #ffc107; cursor: pointer; font-weight: 700;">Academic Calendar 2025-26 <span style="font-weight: 500; color: #856404;">(Click to expand)</span></summary>
                                            <strong>B.Tech:</strong> 
                                            <a href="/files/ac/I_YEAR_B.TECH_ACADEMIC_CALENDAR_2025-26.pdf" target="_blank">I Year</a> | 
                                            <a href="/files/ac/II_III_B.Tech_Academic_Calendar_2025-26.pdf" target="_blank">II & III Year</a> | 
                                            <a href="/files/ac/IV_B.Tech_Academic_Calendar_2025-26.pdf" target="_blank">IV Year</a>
                                            <br/>
                                            <strong>BBA:</strong> 
                                            <a href="/files/ac/I_YEAR_BBA_ACADEMIC_2025-26.pdf" target="_blank">I Year</a> | 
                                            <a href="/files/ac/II_YEAR_BBA_ACADEMIC_2025-26.pdf" target="_blank">II Year</a>
                                            <br/>
                                            <strong>M.Tech:</strong> 
                                            <a href="/files/ac/II_YEAR_M.TECH_ACADEMIC_CALENDAR_2025-26.pdf" target="_blank">II Year</a>
                                        </details>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2024-25: 
                                        <a href="/files/ac/btech_academic_calendar_2024_2025.jpg" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/M.Tech Academic Calendar 2024-25.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2023-24: 
                                        <a href="/files/ac/btech_academic_calendar_2023_2024.pdf" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/mtech_academic_calendar_2023_2024.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2022-23: 
                                        <a href="/files/ac/btech_academic_calendar_2022_2023.jpg" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/academic_calendar_2022_year1.pdf" target="_blank">Download B.Tech (I Year)</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2021-22: 
                                        <a href="/files/ac/academic_calendar_btech_2021_22.jpg" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/academic_calendar_mtech_2021_22.jpg" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2020-21: 
                                        <a href="/files/ac/btech_academic_calendar_2020_2021.jpg" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/academic_calendar_mtech_2020_2021.jpg" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2019-20: 
                                        <a href="/files/ac/academic_calendar_2019_2020.jpg" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/2019-2020_ACADEMIC_CALENDAR_MTech.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2018-19: 
                                        <a href="/files/ac/academic_calendar_2018_2019.pdf" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/2018-2019_ACADEMIC_CALENDAR_MTech.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2017-18: 
                                        <a href="/files/ac/academic_calendar_2017_2018.pdf" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/2017-2018_ACADEMIC_CALENDAR_MTech.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                    <li class="single-requirement">Academic Calendar 2016-17: 
                                        <a href="/files/ac/academic_calendar_2016_2017.pdf" target="_blank">Download B.Tech</a> | 
                                        <a href="/files/ac/2016-2017_ACADEMIC_CALENDAR_MTech.pdf" target="_blank">Download M.Tech</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- admission page content end -->

    <!-- footer -->
    <SrkrFooter/>

    <!-- footer copyright end -->


    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>