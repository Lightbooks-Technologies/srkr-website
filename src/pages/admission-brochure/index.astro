      <div class="container">
    <!-- 1. Undergraduate Programs -->
    <div class="mb-5">
      <h3 class="mb-4" style="text-align: center;">Undergraduate Programs (B.Tech. / BBA)</h3>
      <div class="row g-4">
        {departments.undergraduate.map((d) => (
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card h-100 shadow-sm single-cat-item" style="border-radius: 16px;">
              <div class="card-body d-flex">
                <div class="me-3">
                  <span class="badge mb-2 me-2" style="background-color: var(--rt-primary); color: white; padding: 7px; font-size: 1rem; font-weight: 600; border-radius: 0.5rem;">{d.code}</span>
                </div>
                <div class="d-flex flex-column justify-content-between">
                  <h6 class="card-title mb-1 mt-2">
                    <a href={`/departments/${d.slug}/`}>{d.name}</a>
                    {d.intake && <p class="m-0 small"><strong>Intake:</strong> {d.intake}</p>}
                  </h6>
                  {/* <a href={`/departments/${d.slug}/academic-programs/`} class="cat-link-arrow">
                    <i class="fa-sharp fa-regular fa-arrow-right"></i> Read More
                  </a> */}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

