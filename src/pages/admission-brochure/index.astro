---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="SRKR Engineering College admission overview — programs offered, intake, eligibility, fees and how to apply." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="#">Admissions</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HERO -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 text-center">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">Begin Your SRKR Journey</h3>
              <p class="rts-section-description">Everything you need to know about applying to SRKR Engineering College — programs, eligibility, key dates and downloads — all in one place.</p>
            </div>
            <a href="/assets/docs/admission-overview.pdf" class="rts-theme-btn"><i class="fa-regular fa-download me-3"></i> Download Overview (PDF)</a>
            <p class="small text-muted mt-2">{/* TODO: upload final admission overview PDF */}</p>
          </div>
        </div>
      </div>
    </div>

