    <!-- HOW TO APPLY -->
    <div class="py-5">
      <div class="container">
        <div class="row">
          <div class="col-lg-8">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">How to Apply</h3>
            </div>
            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="apply-accordion">
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#ap1" aria-expanded="true">
                      B.Tech via AP EAPCET (Category A — 70% seats)
                    </button>
                    <div id="ap1" class="accordion-collapse collapse show" data-bs-parent="#apply-accordion">
                      <div class="accordion-body">
                        <p>Appear for AP EAPCET, register for web counselling at <a href="https://cets.apsche.ap.gov.in" target="_blank" rel="noopener">cets.apsche.ap.gov.in</a> and exercise SRKR options (College Code: <strong>SRKR</strong>) in your web option entry. Allotment is rank-based.</p>
                      </div>
                    </div>
                  </div>
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ap2" aria-expanded="false">
                      B.Tech via AP ECET (Lateral Entry — 2nd Year)
                    </button>
                    <div id="ap2" class="accordion-collapse collapse" data-bs-parent="#apply-accordion">
                      <div class="accordion-body">
                        <p>Diploma holders may apply via AP ECET. Counselling and seat allotment are handled by APSCHE — choose SRKR in option entry.</p>
                      </div>
                    </div>
                  </div>
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ap3" aria-expanded="false">
                      Category B (Management Quota — 30%) &amp; NRI Seats
                    </button>
                    <div id="ap3" class="accordion-collapse collapse" data-bs-parent="#apply-accordion">
                      <div class="accordion-body">
                        <p>Apply directly to SRKR Admissions office during the Cat-B notification window (typically July – August). Cat-B sub-divided into 15% NRI &amp; 15% non-NRI. Contact the office for the prescribed application form.</p>
                      </div>
                    </div>
                  </div>
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ap4" aria-expanded="false">
                      M.Tech via AP PGECET
                    </button>
                    <div id="ap4" class="accordion-collapse collapse" data-bs-parent="#apply-accordion">
                      <div class="accordion-body">
                        <p>Appear for AP PGECET / GATE, register for PGECET web counselling and choose SRKR options. M.Tech college code: <strong>SRKR1</strong>.</p>
                      </div>
                    </div>
                  </div>
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ap5" aria-expanded="false">
                      Foreign / Overseas Students
                    </button>
                    <div id="ap5" class="accordion-collapse collapse" data-bs-parent="#apply-accordion">
                      <div class="accordion-body">
                        <p>Foreign nationals may apply directly to the Principal's office with academic transcripts &amp; passport. Admissions are subject to AICTE &amp; JNTUK norms for international students.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">External Links</h3>
            </div>
            <div class="card shadow-sm">
              <div class="card-body">
                <ul class="list-unstyled mb-0">
                  <li class="mb-2"><a href="https://cets.apsche.ap.gov.in" target="_blank" rel="noopener"><i class="fa-regular fa-arrow-up-right-from-square"></i> AP EAPCET / APSCHE Portal</a></li>
                  <li class="mb-2"><a href="https://jntuk.edu.in" target="_blank" rel="noopener"><i class="fa-regular fa-arrow-up-right-from-square"></i> JNTUK Kakinada</a></li>
                  <li class="mb-2"><a href="https://www.aicte-india.org" target="_blank" rel="noopener"><i class="fa-regular fa-arrow-up-right-from-square"></i> AICTE</a></li>
                  <li class="mb-2"><a href="https://www.ugc.gov.in" target="_blank" rel="noopener"><i class="fa-regular fa-arrow-up-right-from-square"></i> UGC</a></li>
                  <li class="mb-2"><a href="https://www.naac.gov.in" target="_blank" rel="noopener"><i class="fa-regular fa-arrow-up-right-from-square"></i> NAAC</a></li>
                  <li class="mb-2"><a href="https://www.nbaind.org" target="_blank" rel="noopener"><i class="fa-regular fa-arrow-up-right-from-square"></i> NBA India</a></li>
                  <li class="mb-2"><a href="/procedure">Admission Procedure</a></li>
                  <li class="mb-0"><a href="/regulations">Academic Regulations</a></li>
                </ul>
              </div>
            </div>
            <div class="card shadow-sm mt-4">
              <div class="card-body">
                <h6 class="mb-2"><i class="fa-light fa-phone"></i> Admissions Office</h6>
                <p class="mb-1 small">SRKR Engineering College, Bhimavaram – 534 204, A.P.</p>
                <p class="mb-1 small"><strong>Phone:</strong> <a href="tel:+919848823332">+91 9848823332</a></p>
                <p class="mb-0 small"><strong>Email:</strong> <a href="mailto:admissions@srkrec.ac.in">admissions@srkrec.ac.in</a></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
