---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { departments } from '../../data/departments';

const pageTitle = "Admission Brochure";

const totalIntake = departments.reduce((sum, d) => sum + d.intake, 0);

const importantDates = [
  { label: 'AP EAPCET — Notification', date: 'Feb (annual)' },
  { label: 'AP EAPCET — Exam', date: 'May (annual)' },
  { label: 'AP EAPCET — Results', date: 'May / Jun (annual)' },
  { label: 'AP EAPCET Counselling — Phase 1', date: 'Jul (annual)' },
  { label: 'AP ECET — Lateral Entry Exam', date: 'May (annual)' },
  { label: 'AP PGECET — M.Tech Exam', date: 'Jun (annual)' },
  { label: 'SRKR Category-B / NRI Admissions Open', date: 'Jul – Aug' },
  { label: 'Academic Year Commences', date: 'Aug / Sep' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="SRKR Engineering College admission brochure — programs offered, intake, eligibility, fees and how to apply." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="#">Admissions</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HERO -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 text-center">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">Begin Your SRKR Journey</h3>
              <p class="rts-section-description">Everything you need to know about applying to SRKR Engineering College — programs, eligibility, key dates and downloads — all in one place.</p>
            </div>
            <a href="/assets/docs/admission-brochure.pdf" class="rts-theme-btn"><i class="fa-regular fa-download"></i> Download Brochure (PDF)</a>
            <p class="small text-muted mt-2">{/* TODO: upload final admission brochure PDF */}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- QUICK SNAPSHOT -->
    <div class="rts-funfact pb-5">
      <div class="container">
        <div class="row justify-content-center mx-0">
          <div class="col-lg-12 px-0">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">{departments.length}+</h2>
                <p>Programs Offered</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">{totalIntake}</h2>
                <p>Total UG Intake</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">30</h2>
                <p>Acre Green Campus</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">A+</h2>
                <p>NAAC Cycle-II Grade</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PROGRAMS OFFERED -->
    <div class="rts-multi-row-section pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Programs Offered (B.Tech)</h3>
        </div>
        <div class="row g-4">
          {departments.map((d) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="card h-100 shadow-sm single-cat-item">
                <div class="card-body">
                  <div class="mb-2">
                    <span class="badge" style="background-color: var(--rt-primary); color: white; padding: 6px 12px; font-size: 0.8rem; font-weight: 600;">{d.code}</span>
                  </div>
                  <h6 class="card-title mb-2 mt-2">
                    <a href={`/departments/${d.slug}/`}>{d.name}</a>
                  </h6>
                  <p class="mb-1 small"><strong>Intake:</strong> {d.intake} {d.nbaAccredited && (<span class="text-success">· NBA</span>)}</p>
                  <p class="mb-2 small text-muted">{d.tagline}</p>
                  <a href={`/departments/${d.slug}/academic-programs/`} class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i> Curriculum</a>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="small text-muted mt-3 mb-0">Also see: <a href="/departments/ash/">Applied Sciences &amp; Humanities</a> · <a href="/programmes">All Programs</a> · <a href="/procedure">Admission Procedure</a></p>
      </div>
    </div>

    <!-- IMPORTANT DATES -->
    <div class="rts-mission py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Important Dates</h3>
        </div>
        <div class="application-deadline__content--table">
          <table class="table">
            <thead class="table-theme">
              <tr>
                <td>Activity / Milestone</td>
                <td>Indicative Timeline</td>
              </tr>
            </thead>
            <tbody>
              {importantDates.map((d) => (
                <tr><td>{d.label}</td><td>{d.date}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="small text-muted mt-2 mb-0">{/* TODO: replace with current academic-year exact dates */}Dates indicative — refer to official AP EAPCET / JNTUK notifications.</p>
        </div>
      </div>
    </div>

    <!-- DOWNLOADS -->
    <!-- <div class="rts-multi-row-section py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Downloads</h3>
        </div>
        <div class="row g-4">
          <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
              <div class="card-body text-center">
                <h2 class="single-cta-item__title"><i class="fa-light fa-file-pdf"></i></h2>
                <h6 class="mt-3 mb-2">Admission Brochure</h6>
                <a href="/assets/docs/admission-brochure.pdf" class="rts-theme-btn">Download</a>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
              <div class="card-body text-center">
                <h2 class="single-cta-item__title"><i class="fa-light fa-money-bill"></i></h2>
                <h6 class="mt-3 mb-2">Fee Structure</h6>
                <a href="/assets/docs/fee-structure.pdf" class="rts-theme-btn">Download</a>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
              <div class="card-body text-center">
                <h2 class="single-cta-item__title"><i class="fa-light fa-house"></i></h2>
                <h6 class="mt-3 mb-2">Hostel Brochure</h6>
                <a href="/assets/docs/hostel-brochure.pdf" class="rts-theme-btn">Download</a>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
              <div class="card-body text-center">
                <h2 class="single-cta-item__title"><i class="fa-light fa-award"></i></h2>
                <h6 class="mt-3 mb-2">Scholarship Info</h6>
                <a href="/assets/docs/scholarships.pdf" class="rts-theme-btn">Download</a>
              </div>
