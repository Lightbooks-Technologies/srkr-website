---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
import OffCanvas from "../../components/OffCanvas.astro";
import { departments } from "../../data/departments";

const pageTitle = "Placements Summary";

// Year-wise consolidated stats (drawn from public T&P updates)
const yearStats = [
  {
    year: "2025–26",
    offers: "1339+",
    topLPA: "19.00",
    avgLPA: "4.5",
    recruiters: "250+",
  },
  {
    year: "2024–25",
    offers: "1174+",
    topLPA: "17.16",
    avgLPA: "4.8",
    recruiters: "210+",
  },
  {
    year: "2023–24",
    offers: "850+",
    topLPA: "12.00",
    avgLPA: "4.5",
    recruiters: "190+",
  },
  {
    year: "2022–23",
    offers: "780+",
    topLPA: "10.50",
    avgLPA: "4.2",
    recruiters: "170+",
  },
  {
    year: "2021–22",
    offers: "720+",
    topLPA: "9.50",
    avgLPA: "4.0",
    recruiters: "150+",
  },
];

const years = yearStats.map((y) => y.year);

// Highest packages — sourced from the live srkrec.ac.in homepage placement ticker
const topOffers = [
  // { company: 'Amazon SDE',  lpa: '17.16 LPA', offers: '1 Offer'   },
  // { company: 'JTG',         lpa: '14.20 LPA', offers: '1 Offer'   },
  // { company: 'Amazon',      lpa: '13.20 LPA', offers: '1 Offer'   },
  // { company: 'Akrivia HCM', lpa: '10.00 LPA', offers: '4 Offers'  },
  // { company: 'Infosys',     lpa: '9.50 LPA',  offers: '3 Offers'  },
  // { company: 'TCS',         lpa: '9.00 LPA',  offers: '9 Offers'  },
  // { company: 'BOSON',       lpa: '8.00 LPA',  offers: '8 Offers'  },
  // { company: 'rootsquare labs', lpa: '7.80 LPA', offers: '3 Offers' },
  // { company: 'TCS Digital', lpa: '7.00 LPA',  offers: '23 Offers' },
  // { company: 'Agumentik',   lpa: '7.00 LPA',  offers: '3 Offers'  },

  { company: "AT&T", lpa: "19.00 LPA", offers: "1 Offer" },
  { company: "Infosys L2", lpa: "16.00 LPA", offers: "1 Offer" },
  { company: "Aunix", lpa: "12.00 LPA", offers: "1 Offer" },
  { company: "Infosys SP", lpa: "11.00 LPA", offers: "11 Offers" },
  { company: "Cognizant", lpa: "6.75 LPA", offers: "26 Offers" },
  { company: "Forsys", lpa: "6.6 LPA", offers: "1 Offer" },
  { company: "Ultratech Cement", lpa: "5 LPA", offers: "1 Offer" },

  { company: "TCS Prime", lpa: "9.00 LPA", offers: "5 Offers" },
  { company: "JobAlchemy", lpa: "9.00 LPA", offers: "1 Offer" },
  { company: "BOSON", lpa: "8.00 LPA", offers: "8 Offers" },
  { company: "Bluconnect AI", lpa: "7.80 LPA", offers: "8 Offers" },
  { company: "TCS Digital", lpa: "7.00 LPA", offers: "64 Offers" },
  { company: "Infosys DSE", lpa: "7.00 LPA", offers: "42 Offers" },
  { company: "Vedya Labs", lpa: "7.00 LPA", offers: "7 Offers" },
  { company: "Reliance Industries", lpa: "7.00 LPA", offers: "2 Offers" },
  { company: "Epiroc Mining", lpa: "6.00 LPA", offers: "6 Offers" },
];

// Volume recruiters
const volumeRecruiters = [
  { company: "Infosys", offers: "134", lpa: "3.60 - 16.00 LPA" },
  { company: "TCS", offers: "302", lpa: "3.42 - 9.09 LPA" },
  { company: "Cognizant", offers: "333", lpa: "4.00 - 6.75 LPA" },

  { company: "Transenergy", offers: "102", lpa: "3.00 LPA" },
  { company: "Brakes India", offers: "221", lpa: "3.00 LPA" },
  { company: "MEIL", offers: "87", lpa: "3.00 LPA" },
  { company: "LS Automotive", offers: "98", lpa: "3.00 LPA" },
];

const reportYears = ["2025-26", "2024-25", "2023-24", "2022-23", "2021-22"];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="Year-wise placement summary, top recruiters, highest packages and department-wise statistics at SRKR Engineering College."
    />
    <style>
      .program-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: inherit;
        transition:
          background-color 0.2s,
          box-shadow 0.2s;
        gap: 8px;
        margin-bottom: 12px;
      }
      .program-item:hover {
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .program-item span {
        display: flex;
        margin-right: 8px;
        align-items: center;
        color: var(--rt-primary);
      }
      .program-item i {
        margin-left: 8px;
        transition: transform 0.2s;
        padding: 8px;
        color: var(--rt-secondary);
      }
    </style>
    </head>

  <body>
    <SrkrHeader />

    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item">
                  <a href="/placements">Placements</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                  {pageTitle}
                </li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hero + Funfact bar -->
    <section class="rts-about-university pt--60 pb--40">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">Placements Summary</h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                Consolidated placement statistics across all UG and PG programs
                — offers, top packages, recruiter participation and
                department-wise outcomes.
              </p>
            </div>
          </div>
        </div>

        <div class="row g-4 mt--30">
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">1339+</h2>
                <p class="item-description">Total Offers (2025–26)</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">19.00 LPA</h2>
                <p class="item-description">Top Package</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">4.5 LPA</h2>
                <p class="item-description">Average Package</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">250+</h2>
                <p class="item-description">Recruiters</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Year-wise Stats Table -->
    <section class="rts-scholarship pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Year-wise Placement Statistics</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <table class="table table-bordered table-striped">
              <thead style="background: var(--rt-primary); color: #fff;">
                <tr>
                  <th>Academic Year</th>
                  <th>Total Offers</th>
                  <th>Highest LPA</th>
                  <th>Average LPA</th>
                  <th>Recruiters</th>
                </tr>
              </thead>
              <tbody>
                {
                  yearStats.map((y) => (
                    <tr>
                      <td>
                        <strong>{y.year}</strong>
                      </td>
                      <td>{y.offers}</td>
                      <td>₹{y.topLPA} LPA</td>
                      <td>₹{y.avgLPA} LPA</td>
                      <td>{y.recruiters}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Highest Packages -->
    <section class="rts-campus-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Highest Packages (2025–26)</h3>
          </div>
        </div>
        <div class="row g-4">
          {
            topOffers.map((o) => (
              <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="single-item">
                  <div
                    class="single-item__meta"
                    style="text-align:center; padding:20px;"
                  >
                    <h5 class="item-title">{o.company}</h5>
                    <p
                      class="item-description"
                      style="color: var(--rt-primary); font-weight: 700; font-size: 1.2rem;"
                    >
                      {o.lpa}
                    </p>
                    <p class="item-description">{o.offers}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Top Recruiters logo grid (reuse civil pattern) -->
    <div class="rts-multi-row-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Top Recruiters</h3>
          </div>
        </div>
        <div class="row g-4">
          <div class="col-lg-2 col-md-3 col-4">
            <div class="recruiter-logo-box">
              <img src="/assets/images/recruiters/tcs.png" alt="TCS" />
            </div>
          </div>
          <div class="col-lg-2 col-md-3 col-4">
            <div class="recruiter-logo-box">
              <img
                src="/assets/images/recruiters/cts.png"
                alt="Cognizant"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="col-lg-2 col-md-3 col-4">
            <div class="recruiter-logo-box">
              <img
                src="/assets/images/recruiters/infosys.png"
                alt="Infosys"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="col-lg-2 col-md-3 col-4">
            <div class="recruiter-logo-box">
              <img
                src="/assets/images/recruiters/ut.png"
                alt="Ultratech"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="col-lg-2 col-md-3 col-4">
            <div class="recruiter-logo-box">
              <img
                src="/assets/images/recruiters/att.png"
                alt="AT&T"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <div class="col-lg-2 col-md-3 col-4">
            <div class="recruiter-logo-box">
              <img
                src="/assets/images/recruiters/ril.png"
                alt="RIL"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- <div class="col-lg-2 col-md-3 col-4"><div class="recruiter-logo-box"><img src="/assets/images/recruiters/wipro.png" alt="Wipro" / loading="lazy" decoding="async"></div></div> -->
          <!-- <div class="col-lg-2 col-md-3 col-4"><div class="recruiter-logo-box"><img src="/assets/images/recruiters/hcl.png" alt="HCL" / loading="lazy" decoding="async"></div></div> -->
          <!-- <div class="col-lg-2 col-md-3 col-4"><div class="recruiter-logo-box"><img src="/assets/images/recruiters/tm.png" alt="Tech Mahindra" / loading="lazy" decoding="async"></div></div> -->
          <!-- <div class="col-lg-2 col-md-3 col-4"><div class="recruiter-logo-box"><img src="/assets/images/recruiters/ey.png" alt="Ernst &amp; Young" / loading="lazy" decoding="async"></div></div> -->
          <!-- <div class="col-lg-2 col-md-3 col-4"><div class="recruiter-logo-box"><img src="/assets/images/recruiters/ncc.png" alt="NCC" / loading="lazy" decoding="async"></div></div> -->
          <!-- <div class="col-lg-2 col-md-3 col-4"><div class="recruiter-logo-box"><img src="/assets/images/recruiters/lt.png" alt="L&amp;T" / loading="lazy" decoding="async"></div></div> -->
          {/* TODO: add more recruiter logos */}
        </div>
      </div>
    </div>

    <!-- Volume Recruiters table -->
    <section class="rts-scholarship pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Volume Recruiters (by offers)</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <table class="table table-bordered table-striped">
              <thead style="background: var(--rt-primary); color: #fff;">
                <tr><th>Company</th><th>Offers</th><th>Package</th></tr>
              </thead>
              <tbody>
                {
                  volumeRecruiters.map((r) => (
                    <tr>
                      <>
                        <td>
                          <strong>{r.company}</strong>
                        </td>
                        <td>{r.offers}</td>
                        <td>{r.lpa}</td>
                      </>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Department-wise stats card grid -->
    <section class="rts-campus-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Department-wise Placements</h3>
          </div>
        </div>
        <div class="row g-4">
          {
            departments.map((d) => (
              <div class="col-lg-4 col-md-6 col-sm-12">
                <a
                  href={`/departments/${d.slug}/placements/`}
                  class="program-item"
                >
                  <span>
                    <span class={d.icon} /> <strong>{d.name}</strong>
                  </span>
                  <i class="fa-regular fa-chevron-right" />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Year-wise PDFs + Quick Links -->
    <section class="rts-research-section pb--80">
      <div class="container">
        <div class="row">
          <div
            class="row g-5 justify-content-center justify-content-start align-items-center mt--80"
          >
            <div class="col-lg-7 col-md-11">
              <div class="rts-multi-row-image">
                <img
                  src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop"
                  alt="placement records"
                  style="border-radius: 10px;"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="col-lg-5 col-md-11">
              <div class="rts-multi-row-content">
                <h4 class="row-title">Year-wise Placement Records</h4>
                <p>
                  Download detailed placement reports with company names,
                  packages offered, and student achievements for each academic
                  year.
                </p>
                <div class="program-list">
                  {
                    years.map((year) => (
                      <a
                        href={`/assets/documents/placements/${year.replace("–", "-")}.pdf`}
                        class="program-item"
                        target="_blank"
                      >
                        <span>
                          {year} Placement Report{" "}
                          <i class="fa-regular fa-chevron-right" />
                        </span>{" "}
                        <span>PDF</span>
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
          <div class="research__text mt-2">
            <div class="research__text--single">
              <h3 class="rts-section-title mt-2">Quick Links</h3>
              <div class="program-list">
                <a href="/placements" class="program-item"
                  ><span
                    >About Placement Cell <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
                <a href="/placements-team" class="program-item"
                  ><span
                    >Placements Team <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
                <a href="/training" class="program-item"
                  ><span
                    >Training Activities <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
                <a href="/internships" class="program-item"
                  ><span
                    >Internship Opportunities <i
                      class="fa-regular fa-chevron-right"></i></span
                  ></a
                >
                <a
                  href="https://www.srkrexams.in"
                  class="program-item"
                  target="_blank"
                  rel="noopener"
                  ><span
                    >Examinations Portal <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      /* TODO: replace placeholder year-wise PDFs once finalized reports uploaded to /assets/documents/ */
    }
    {
      /* TODO: confirm department-wise per-year offer counts and add a breakdown table per dept */
    }

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
