--- 
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '~/components/SrkrHeader.astro';
import SrkrFooter from '~/components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
<section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Training</li>
                    </ul>
                    <h2 class="section-title">Training</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
    <!-- campus life -->
    <div class="rts-campus-life pt--50 pb--30">
        <div class="container">
            <div class="row">
                <div class="campus-life">
                    <div class="campus-life__content">
                        <h1 class="rts-section-title">Training & Placement Cell</h1>
                        <p class="description w-680">
                            Dedicated to bridging academics with careers, the Training & Placement Cell empowers students with quality training and top placement opportunities since 1995.
                        </p>
                        <div class="campus-video">
                            <img src="assets/images/campus/research.jpg" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- campus life end -->



    <!-- research enterprise -->
    <!-- single section -->
    <div class="rts-campus-section pt--30 pb-0 v_3">
        <div class="container">
            <div class="row">
                <div class="rts-section rt-center mb--45">
                    <h3 class="rts-section-title">Campus Recruitment Training (CRT)</h3>
                </div>
            </div>
            <div class="row g-5">
                <!-- single item -->
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                        <div class="single-item__content">
                            <div class="single-item__image">
                                <img src="assets/images/campus/12.jpg" alt="item-image">
                            </div>
                            <div class="single-item__meta">
                                <h5 class="item-title"><a href="#">Digital Reach</a></h5>
                                <p class="item-description">Recruitment has moved online to engage Gen Z through digital platforms, expanding beyond traditional campus efforts.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single item end -->
                <!-- single item -->
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                        <div class="single-item__content">
                            <div class="single-item__image">
                                <img src="assets/images/campus/13.jpg" alt="item-image">
                            </div>
                            <div class="single-item__meta">
                                <h5 class="item-title"><a href="#">Talent Investment</a></h5>
                                <p class="item-description">Campus hiring is not just for immediate roles—it’s a long-term talent investment that supports organizational growth.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single item end -->
                <!-- single item -->
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                        <div class="single-item__content">
                            <div class="single-item__image">
                                <img src="assets/images/campus/14.jpg" alt="item-image">
                            </div>
                            <div class="single-item__meta">
                                <h5 class="item-title"><a href="#">Other Research Centers & Labs</a></h5>
                                <p class="item-description">Academic departments sponsor numerous other research centers and labs.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single item end -->
            </div>
        </div>
    </div>
    <!-- single section end -->

    <!-- research enterprise end -->

    <!-- reasearch area -->
    <section class="rts-research-section rts-section-padding">
        <div class="container">
            <div class="row">
                <div class="rts-research-section__content">
                    <div class="research-image">
                        <img src="assets/images/campus/research-2.jpg" alt="research">
                    </div>
                    <div class="rts-section">
                        <h3 class="rts-section-title">
                            Internships
                        </h3>
                        <p class="description">Internships are short-term roles that provide hands-on experience in a professional setting. Interns usually assist teams with smaller tasks while learning on the job.
                        </p>
                        <p class="description">
                            These opportunities are ideal for college students, graduates, or career changers to explore new fields before committing to full-time roles.</p>
                            <p class="description">Multiple internships during your studies can help you discover your interests and career path through real-world exposure.</p>
                            <p class="description">Good internships offer mentorship, learning experiences, and involvement in meaningful projects that build skills and confidence.</p>
                    
                    </div>
                </div>
                
                <div class="research__text">
                    <div class="research__text--single">
                        <h3 class="rts-section-title">
                            Objectives of Training & Placement Cell
                        </h3>
                        <p class="description">
                            The Training & Placement Cell aims to enhance students’ skills to match industry requirements, identify employment opportunities, and build strong ties with corporate leaders for campus placements. It supports students in developing technical and aptitude skills, facilitates industry interaction, and fosters collaborations for internships, lab setups, and technical support through MoUs. The Cell also motivates students to pursue higher education by guiding them for competitive exams like GATE, collects alumni feedback for continuous improvement, and focuses on overall personality development through structured training programs.</p>
                    </div>
                    
                </div>
            </div>
        </div>
    </section>
    <!-- reasearch area end-->
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <!-- offcanvase menu -->
