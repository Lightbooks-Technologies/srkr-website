--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
<section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                    </ul>
                    <h1 class="section-title">Training & Placement Cell</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
    <!-- campus life -->
    <div class="rts-campus-life pt--50 pb--30">
        <div class="container">
            <div class="row">
                <div class="campus-life">
                    <div class="campus-life__content">
                        <p class="description w-680">
                            Dedicated to bridging academics with careers, the Training & Placement Cell empowers students with quality training .
                        </p>
                        <!-- <div class="campus-video">
                            <img src="/assets/images/campus/research-1.jpg" alt="">
                        </div> -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- campus life end -->



    <!-- research enterprise -->
    <!-- single section -->
    <div class="rts-campus-section pt--30 pb-0 v_3">

        <div class="container">
            <div class="row">
                <div class="rts-section rt-center mb--45">
                    <div class="research__text">
                                <div class="research__text--single">
 
                                    
                                    <p class="description" style="text-align: justify;">
                                        The Training & Placement (T&P) Cell at SRKREC is dedicated to enhancing students' employability and career readiness through structured training, industry exposure, and placement support. The Cell actively encourages students to gain practical experience through summer internships, semester-long internships, and industrial training programs that bridge the gap between academic learning and industry requirements.</p>
                                    <p class="description" style="text-align: justify;">
                                        To prepare students for competitive recruitment processes, the T&P Cell conducts comprehensive training programs focused on aptitude, communication, technical skills, personality development, and interview preparedness. These initiatives enable students to effectively showcase their competencies, strengths, and experiences during campus recruitment drives. Through strong industryâ€“institute collaborations and continuous engagement with leading organizations, the institute has consistently achieved an excellent placement record, with over 80% of students securing positions in reputed national and multinational companies.</p>
                                    <p class="description" style="text-align: justify;">
                                        SRKREC maintains strong relationships with corporate organizations, industry leaders, educational institutions, and entrepreneurs. The T&P Cell works throughout the year to create meaningful career opportunities and facilitate successful placements, internships, and higher education prospects for students.</p>
                                </div>
                                
                    </div>

                </div>
            </div>


            <div class="row">
                <div class="rts-section rt-center mb--45">
                    <div class="research__text">
                                <div class="research__text--single">
                                    <h3 class="rts-section-title">
                                         Objectives
                                    </h3>

                                                 <ul style="list-style: none; padding-left: 0; margin: 0;">
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To facilitate the placement of final-year students in reputed organizations through campus recruitment drives.</li>
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To provide opportunities for industrial training, internships, and experiential learning during the course of study.</li>
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To organize career development activities such as expert lectures, seminars, workshops, group discussions, mock interviews, and personality development programs.</li>
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To guide and support students in exploring employment opportunities in India and abroad.</li>
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To promote entrepreneurship and self-employment by providing relevant information, mentoring, and networking opportunities.</li>
                                                     
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To strengthen industryâ€“academia collaboration for enhancing employability and professional competence among students.</li>
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To develop leadership, communication, teamwork, and professional skills required for successful careers.</li>
                                                     <li class="description" style="text-align: justify; margin-bottom: 10px;">âž¤ To ensure holistic career development by aligning student competencies with evolving industry demands.</li>
                                                 </ul>

                                    
                                </div>
                                
                    </div>

                </div>
            </div>

        </div>


        <div class="container">
            <div class="row">
                <div class="rts-section rt-center mb--45">
                    <h3 class="rts-section-title">Career Services & Specialized Support</h3>
                    <p class="item-description">The T&P Cell at SRKREC provides tailored services to ensure students are well-prepared and confident as they step into their careers.</p>

                </div>
            </div>
            <div class="row g-5">
                <!-- single item -->
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                        <div class="single-item__content">
                            <div class="single-item__image">
                                <img src="/assets/images/campus/tp/01.jpeg" alt="item-image" loading="lazy" decoding="async">
                            </div>
                            <div class="single-item__meta">
                                <h5 class="item-title"><a href="#">Preparing Students for Professional Success</a></h5>
                                <p class="item-description">Students receive comprehensive support through CV and portfolio development, mock interviews, group discussion simulations, and personalized career counselling to build confidence and enhance employability.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single item end -->
                <!-- single item -->
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                        <div class="single-item__content">
                            <div class="single-item__image">
                                <img src="/assets/images/campus/tp/02.jpeg" alt="item-image" loading="lazy" decoding="async">
                            </div>
                            <div class="single-item__meta">
                                <h5 class="item-title"><a href="#">Connecting Learning with Career Opportunities</a></h5>
                                <p class="item-description">Through internship and placement preparation workshops, industry expert panels, leadership talks, and networking events, students gain valuable insights into workplace expectations and emerging industry trends.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single item end -->
                <!-- single item -->
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                        <div class="single-item__content">
                            <div class="single-item__image">
                                <img src="/assets/images/campus/tp/03.jpeg" alt="item-image" loading="lazy" decoding="async">
                            </div>
                            <div class="single-item__meta">
                                <h5 class="item-title"><a href="#">Upskilling for Future Careers and Higher Education</a></h5>
                                <p class="item-description">The Training & Placement Cell guides students in pursuing certifications, developing in-demand skills, applying for fellowships, and preparing strong applications for graduate studies in India and abroad.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- single item end -->
            </div>
        </div>
    </div>
    <!-- single section end -->

    <!-- research enterprise end -->

    <!-- reasearch area -->
    <section class="rts-research-section rts-section-padding">
        <div class="container">
            <div class="row">
                <div class="rts-research-section__content">
                    <!-- <div class="research-image">
                        <img src="/assets/images/campus/research-2.jpg" alt="research" loading="lazy" decoding="async">
                    </div> -->
                    <!-- <div class="rts-section">
                        <h3 class="rts-section-title">
                            Internships
                        </h3>
                        <p class="description">Internships are short-term roles that provide hands-on experience in a professional setting. Interns usually assist teams with smaller tasks while learning on the job.
                        </p>
                        <p class="description">
                            These opportunities are ideal for college students, graduates, or career changers to explore new fields before committing to full-time roles.</p>
                            <p class="description">Multiple internships during your studies can help you discover your interests and career path through real-world exposure.</p>
                            <p class="description">Good internships offer mentorship, learning experiences, and involvement in meaningful projects that build skills and confidence.</p>
                    
                    </div> -->
                </div>
                
       
            </div>
        </div>
    </section>
    <!-- reasearch area end-->
<!-- footer -->
<SrkrFooter/>

