      <!-- ── NOTICE BOARD + EVENTS ──────────────────────────────── -->
      <section class="rts-notice rts-section-padding-small">
        <div class="container">
          <div class="row gy-5 gy-lg-0 justify-content-md-center">
            <!-- Events column -->
            <div class="col-md-11 col-lg-6">
              <div class="rts-event-section">
                <h4 class="rts-section-title mb--25">Upcoming Events</h4>
                <div class="rts-event-section-content">
                  <ul class="list-unstyled rts-counter">
                    {
                      [...homeEvents].map((event) => {
                        const link =
                          event.link && event.link !== "#"
                            ? event.link
                            : "/events";
                        const external = /^https?:\/\//.test(link);
                        return (
                          <li class="single-event">
                            <a
                              class="single-event-link"
                              href={link}
                              target={external ? "_blank" : undefined}
                              rel={external ? "noopener" : undefined}
                            >
                              <div class="single-event-content">
                                <h5 class="event-title">{event.title}</h5>
                                <div class="single-event-content-meta">
                                  <div class="event-date">
                                    <>
                                      <span>
                                        <i class="fal fa-calendar" />
                                      </span>
                                      <span>{event.date}</span>
                                    </>
                                  </div>
                                </div>
                                <div class="single-event-content-meta">
                                  <div class="event-place">
                                    <>
                                      <span>
                                        <i class="fa-sharp fa-thin fa-location-dot" />
                                      </span>
                                      <span>
                                        {event.venue ||
                                          "SRKR Engineering College"}
                                      </span>
                                    </>
                                  </div>
                                </div>
                              </div>
                            </a>
                          </li>
                        );
                      })
                    }
                  </ul>
                </div>
              </div>
            </div>

            <!-- Notice board column -->
            <div class="col-md-11 col-lg-6">
              <div class="rts-notice-section">
                <div class="rts-section rt-between">
                  <h4 class="rts-section-title">News and Updates</h4>
                </div>
                <div class="rts-tab">
                  <ul class="list-unstyled notice-content-box">
                    {
                      homeNews.map((item) => (
                        <li class="single-notice">
                          <div class="single-notice-item">
                            <div class="notice-date">
                              <span class="d-flex justify-content-center">
                                {" "}
                                {item.day}
                              </span>
                              <span>{item.month}</span>
                            </div>
                            <div class="notice-content">
                              <p>
                                <a href={item.link}>{item.title}</a>
                              </p>
                            </div>
                          </div>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- ── NOTICE BOARD END ────────────────────────────────────── -->

