---
import BaseHead from '../components/BaseHead.astro';
import FooterScripts from '../components/FooterScripts.astro';
import OffCanvas from '../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import SrkrHeader from '../components/SrkrHeader.astro';
import SrkrFooter from '../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="page">

    <SrkrHeader />

    <!-- ── NEWS TICKER ─────────────────────────────────────────── -->
    <div class="srkr-ticker">
      <span class="srkr-ticker__label">What's New</span>
      <div class="srkr-ticker__track">
        <div class="srkr-ticker__inner">
          <span>Campus Placements 2025: Amazon SDE — 17.16 LPA (1 Offer) &nbsp;|&nbsp; TCS Ninja — 3.36 LPA &nbsp;|&nbsp; Infosys — 3.25 LPA &nbsp;|&nbsp; Capgemini — 4.75 LPA &nbsp;|&nbsp; Wipro — 3.5 LPA &nbsp;|&nbsp; Amaravati Quantum Valley Hackathon 2025 Semi-Finals Successfully Organised &nbsp;|&nbsp; NAAC A++ Accredited | NBA Accredited — B.Tech CSE, ECE, Civil, EEE, IT, ME &nbsp;|&nbsp; Admissions Open 2025–26 &nbsp;|&nbsp;</span>
          <span aria-hidden="true">Campus Placements 2025: Amazon SDE — 17.16 LPA (1 Offer) &nbsp;|&nbsp; TCS Ninja — 3.36 LPA &nbsp;|&nbsp; Infosys — 3.25 LPA &nbsp;|&nbsp; Capgemini — 4.75 LPA &nbsp;|&nbsp; Wipro — 3.5 LPA &nbsp;|&nbsp; Amaravati Quantum Valley Hackathon 2025 Semi-Finals Successfully Organised &nbsp;|&nbsp; NAAC A++ Accredited | NBA Accredited — B.Tech CSE, ECE, Civil, EEE, IT, ME &nbsp;|&nbsp; Admissions Open 2025–26 &nbsp;|&nbsp;</span>
        </div>
      </div>
    </div>
    <!-- ── NEWS TICKER END ──────────────────────────────────────── -->

    <!-- ── HERO BANNER ─────────────────────────────────────────── -->
    <div class="banner v__1">
      <div class="container">
        <div class="col-sm-12">
          <div class="banner__wrapper">
            <div class="banner__wrapper--left">
              <img src="/assets/images/banner/image__1.jpg" alt="">
            </div>
            <div class="banner__wrapper--middle">
              <div class="banner__content">
                <h6 class="banner__content--sub">
                  <img src="/assets/images/icon/e-cap.svg" alt="cap"> Where Innovation Meets Excellence
                </h6>
                <h1 class="banner__content--title">
                  SRKR Engineering
                  <span>College</span>
                </h1>
                <div class="banner__content--circle rts__circle v__2">
                  <svg class="spinner" viewBox="0 0 100 100">
                    <defs>
                      <path id="circle" d="M50,50 m-37,0a37,37 0 1,1 74,0a37,37 0 1,1 -74,0"></path>
                    </defs>
                    <text>
                      <textPath xlink:href="#circle">SRKR Engineering * Estd. 1980 * Innovate * Inspire *</textPath>
                    </text>
                  </svg>
                  <div class="rts__circle--icon save-from-hidden">
                    <a href="https://www.youtube.com/watch?v=mMejQJX731k" class="video-play rts-video-btn popup-video">
                      <i class="fa-sharp fa-solid fa-play"></i>
                    </a>
                  </div>
                </div>
                <div class="banner__content--description">
                  <p>Explore a future where knowledge fuels innovation. SRKR Engineering College empowers students to excel globally.</p>
                  <a href="programmes" class="rts-theme-btn btn-arrow">Explore Programs
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </div>
              </div>
            </div>
            <div class="banner__wrapper--right">
              <img src="/assets/images/banner/image__2.jpg" alt="banner right">
            </div>
          </div>
          <div class="banner__wrapper--shape">
            <img src="/assets/images/banner/banner-svg.svg" alt="banner">
          </div>
        </div>
      </div>
    </div>
    <!-- ── HERO BANNER END ─────────────────────────────────────── -->

    <!-- ── QUICK LINKS BAR ─────────────────────────────────────── -->
    <div class="srkr-quicklinks">
      <div class="container">
        <div class="srkr-quicklinks__inner">
          <a href="https://webmail.srkrec.edu.in" target="_blank" class="srkr-quicklinks__item">
            <i class="fa-light fa-envelope"></i> SRKREC Web Mail
          </a>
          <a href="https://www.srkrexams.in" target="_blank" class="srkr-quicklinks__item">
            <i class="fa-light fa-file-pen"></i> Examinations
          </a>
          <a href="prominent-alumni" class="srkr-quicklinks__item">
            <i class="fa-light fa-users"></i> Alumni Association
          </a>
          <a href="https://www.naac.gov.in" target="_blank" class="srkr-quicklinks__item">
            <i class="fa-light fa-certificate"></i> Education Verification
          </a>
        </div>
      </div>
    </div>
    <!-- ── QUICK LINKS BAR END ─────────────────────────────────── -->

    <!-- ── ABOUT ───────────────────────────────────────────────── -->
    <section class="about rts__padding--120-100 v__1">
      <div class="container">
        <div class="row justify-content-md-center align-items-center">
          <div class="col-lg-6 col-md-10">
            <div class="about__images">
              <div class="about__images--wrapper">
                <div class="about__images--wrapper--left">
                  <img src="/assets/images/about/about__h1.png" alt="">
                </div>
                <div class="about__images--wrapper--center">
                  <div class="rts__circle v__1">
                    <svg class="spinner" viewBox="0 0 100 100">
                      <defs>
                        <path id="circle-2" d="M50,50 m-37,0a37,37 0 1,1 74,0a37,37 0 1,1 -74,0"></path>
                      </defs>
                      <text>
                        <textPath xlink:href="#circle-2">SRKR Engineering * Estd. 1980 * Innovate * Inspire *</textPath>
                      </text>
                    </svg>
                    <div class="rts__circle--icon">
                      <i class="fa-light fa-arrow-right"></i>
                    </div>
                  </div>
                </div>
                <div class="about__images--wrapper--right">
                  <img src="/assets/images/about/about__h2.png" alt="">
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-6 col-md-10">
            <div class="about__content">
              <h2 class="rts__title">About SRKR Engineering College</h2>
              <p class="rts__description">Founded in 1980, SRKR Engineering College is one of the finest self-financing engineering institutions in Andhra Pradesh — NAAC A++ accredited, NBA accredited across six programmes, and recognised as a Scientific and Industrial Research Organisation (SIRO) by DSIR. Spread over 30 acres, the campus combines world-class facilities with a legacy of shaping industry-ready engineers.</p>
              <div class="stroke__text v__1">EST. 1980</div>
              <a href="college-profile" class="rts-nbg-btn btn-arrow">College Overview
                <span><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ── ABOUT END ──────────────────────────────────────────── -->

    <!-- ── UG PROGRAMS (department grid) ──────────────────────── -->
    <section class="rts__section rts__light rts-section-padding">
      <div class="container">
        <div class="row">
          <div class="rts__section--wrapper">
            <h4 class="rts__section--title">Programs</h4>
            <div class="rts__section--link">
              <a href="programmes" class="rts-nbg-btn btn-arrow">View All Programs<span><i class="fa-sharp fa-regular fa-arrow-right"></i></span></a>
            </div>
          </div>
        </div>
        <div class="row g-4">

          <!-- Row 1 -->
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1517180102446-f3ece451e9d8?w=600&h=320&fit=crop" alt="Computer Science & Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Computer Science &amp; Engineering</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=320&fit=crop" alt="Artificial Intelligence & ML">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Artificial Intelligence &amp; ML</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&h=320&fit=crop" alt="AI & Data Science">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">AI &amp; Data Science</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&h=320&fit=crop" alt="Electronics & Communication">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Electronics &amp; Communication</a></div>
              </div>
            </div>
          </div>

          <!-- Row 2 -->
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=600&h=320&fit=crop" alt="Electrical & Electronics">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Electrical &amp; Electronics</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=600&h=320&fit=crop" alt="Mechanical Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Mechanical Engineering</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=600&h=320&fit=crop" alt="Civil Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="/departments/civil/">Civil Engineering</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=600&h=320&fit=crop" alt="Information Technology">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Information Technology</a></div>
              </div>
            </div>
          </div>

          <!-- Row 3 -->
          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?w=600&h=320&fit=crop" alt="Computer Science & Design">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Computer Science &amp; Design</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1563986768494-4dee2763ff3f?w=600&h=320&fit=crop" alt="CSE IoT & Cyber Security">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">CSE (IoT &amp; Cyber Security)</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&h=320&fit=crop" alt="Computer Science & IT">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">Computer Science &amp; IT</a></div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&h=320&fit=crop" alt="CS & Business Systems">
              </div>
              <div class="cat-meta">
                <div class="cat-title"><a href="programmes">CS &amp; Business Systems</a></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
    <!-- ── UG PROGRAMS END ─────────────────────────────────────── -->

    <!-- ── SRKR AT A GLANCE ────────────────────────────────────── -->
    <div class="container rts__pt100">
      <div class="row justify-content-center">
        <div class="col-lg-12 rts-funfact v__1">
          <div class="rts-funfact-wrapper">
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">1980</h2>
              <p>Established</p>
            </div>
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">A++</h2>
              <p>NAAC Grade</p>
            </div>
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">400+</h2>
              <p>Faculty Members</p>
            </div>
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">15,000+</h2>
              <p>Students Enrolled</p>
            </div>
          </div>
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-12 rts-funfact v__1">
          <div class="rts-funfact-wrapper">
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">1,833</h2>
              <p>Scopus Publications</p>
            </div>
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">180+</h2>
              <p>Patents Filed</p>
            </div>
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">₹12.56 Cr</h2>
              <p>Funded Projects</p>
            </div>
            <div class="single-cta-item">
              <h2 class="single-cta-item__title">90%</h2>
              <p>Placement Rate</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ── AT A GLANCE END ─────────────────────────────────────── -->

    <!-- ── NOTICE BOARD + EVENTS ──────────────────────────────── -->
    <section class="rts-notice rts-section-padding">
      <div class="container">
        <div class="row gy-5 gy-lg-0 justify-content-md-center">

          <!-- Events column -->
          <div class="col-md-11 col-lg-7">
            <div class="rts-event-section">
              <h4 class="rts-section-title mb--25">Upcoming Events</h4>
              <div class="rts-event-section-content">
                <ul class="list-unstyled rts-counter">
                  <li class="single-event">
                    <div class="single-event-counter">
                      <div class="count-number rt-clip-text"></div>
                    </div>
                    <div class="single-event-content">
                      <h5 class="event-title">National Conference on AI in Engineering Education</h5>
                      <div class="single-event-content-meta">
                        <div class="event-date"><span><i class="fal fa-calendar"></i></span><span>May 20, 2025</span></div>
                        <div class="event-time"><span><i class="fa-sharp fa-thin fa-clock"></i></span><span>9:00 am</span></div>
                        <div class="event-place"><span><i class="fa-sharp fa-thin fa-location-dot"></i></span><span>SRKR Auditorium, Bhimavaram</span></div>
                      </div>
                    </div>
                  </li>
                  <li class="single-event">
                    <div class="single-event-counter">
                      <div class="count-number rt-clip-text"></div>
                    </div>
                    <div class="single-event-content">
                      <h5 class="event-title">Workshop: Blockchain for Sustainable Development</h5>
                      <div class="single-event-content-meta">
                        <div class="event-date"><span><i class="fal fa-calendar"></i></span><span>Jun 10, 2025</span></div>
                        <div class="event-time"><span><i class="fa-sharp fa-thin fa-clock"></i></span><span>10:30 am</span></div>
                        <div class="event-place"><span><i class="fa-sharp fa-thin fa-location-dot"></i></span><span>Seminar Hall, SRKR</span></div>
                      </div>
                    </div>
                  </li>
                  <li class="single-event">
                    <div class="single-event-counter">
                      <div class="count-number rt-clip-text"></div>
                    </div>
                    <div class="single-event-content">
                      <h5 class="event-title">Alumni Tech Summit 2025</h5>
                      <div class="single-event-content-meta">
                        <div class="event-date"><span><i class="fal fa-calendar"></i></span><span>Jul 5, 2025</span></div>
                        <div class="event-time"><span><i class="fa-sharp fa-thin fa-clock"></i></span><span>11:00 am</span></div>
                        <div class="event-place"><span><i class="fa-sharp fa-thin fa-location-dot"></i></span><span>SRKR Campus, Bhimavaram</span></div>
                      </div>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Notice board column -->
          <div class="col-md-11 col-lg-5">
            <div class="rts-notice-section">
              <div class="rts-section rt-between pb--25 rts-border-bottom-2">
                <h4 class="rts-section-title">Notice Board</h4>
              </div>
              <div class="rts-tab">
                <ul class="nav nav-pills pb--30" id="pills-tab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pills-latest-tab" data-bs-toggle="pill" data-bs-target="#pills-latest" type="button" role="tab" aria-selected="true">Latest</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-exam-tab" data-bs-toggle="pill" data-bs-target="#pills-exam" type="button" role="tab" aria-selected="false">Exams</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pills-admission-tab" data-bs-toggle="pill" data-bs-target="#pills-admission" type="button" role="tab" aria-selected="false">Admissions</button>
                  </li>
                </ul>
                <div class="tab-content" id="pills-tabContent">
                  <div class="tab-pane fade show active" id="pills-latest" role="tabpanel" tabindex="0">
                    <ul class="list-unstyled notice-content-box">
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">12<span>May</span></div><div class="notice-content"><p><a href="#">Amaravati Quantum Valley Hackathon 2025 — Semi-Finals successfully organised by SRKR.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">08<span>May</span></div><div class="notice-content"><p><a href="#">NAAC Peer Team Visit — SRKR retains A++ Grade for the current cycle.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">02<span>May</span></div><div class="notice-content"><p><a href="#">Campus Placement Drive 2025 results — Amazon SDE 17.16 LPA offer confirmed.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">28<span>Apr</span></div><div class="notice-content"><p><a href="#">IIC Activity: Design Thinking Workshop — registrations now open.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">20<span>Apr</span></div><div class="notice-content"><p><a href="#">Professor elected as JNTUK Academic Senate member.</a></p></div></div></li>
                    </ul>
                  </div>
                  <div class="tab-pane fade" id="pills-exam" role="tabpanel" tabindex="0">
                    <ul class="list-unstyled notice-content-box">
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">15<span>May</span></div><div class="notice-content"><p><a href="https://www.srkrexams.in" target="_blank">B.Tech IV Year (R20) End Semester Examinations — Time Table released.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">10<span>May</span></div><div class="notice-content"><p><a href="https://www.srkrexams.in" target="_blank">M.Tech II Year Supplementary Exam Schedule — May 2025.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">05<span>May</span></div><div class="notice-content"><p><a href="https://www.srkrexams.in" target="_blank">B.Tech II Year (R23) Mid Examination — Hall Tickets available.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">28<span>Apr</span></div><div class="notice-content"><p><a href="https://www.srkrexams.in" target="_blank">Ph.D. Course Work Examination schedule — JNTUK notification.</a></p></div></div></li>
                    </ul>
                  </div>
                  <div class="tab-pane fade" id="pills-admission" role="tabpanel" tabindex="0">
                    <ul class="list-unstyled notice-content-box">
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">01<span>May</span></div><div class="notice-content"><p><a href="procedure">B.Tech Admissions 2025–26 — EAPCET Counselling schedule announced.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">25<span>Apr</span></div><div class="notice-content"><p><a href="procedure">M.Tech Admissions 2025–26 — PGECET merit list published.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">18<span>Apr</span></div><div class="notice-content"><p><a href="procedure">Lateral Entry (B.Tech II Year) 2025 — ECET counselling dates released.</a></p></div></div></li>
                      <li class="single-notice"><div class="single-notice-item"><div class="notice-date">10<span>Apr</span></div><div class="notice-content"><p><a href="admission-brochure">Admissions Brochure 2025–26 — Download now.</a></p></div></div></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
    <!-- ── NOTICE BOARD END ────────────────────────────────────── -->

    <!-- ── CAMPUS LIFE ─────────────────────────────────────────── -->
    <section class="rts__section rts-section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-5 col-md-6">
            <div class="rts__section--wrapper v__2">
