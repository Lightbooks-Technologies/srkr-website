            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item srkr-dept-card">
              <div class="cat-thumb srkr-dept-thumb">
                <img
                  src="/assets/images/programs/mech.png"
