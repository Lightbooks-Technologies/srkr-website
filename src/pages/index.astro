---
import BaseHead from "../components/BaseHead.astro";
import SrkrHeader from "../components/SrkrHeader.astro";
import SrkrFooter from "../components/SrkrFooter.astro";
import FooterScripts from "../components/FooterScripts.astro";
import OffCanvas from "../components/OffCanvas.astro";
import { SITE_TITLE, SITE_DESCRIPTION, UPCOMING_EVENTS, NEWS } from "../consts";

// Upcoming Events — loaded live from the SRKR CMS, with a safe fallback to the
// static list in consts.ts if the CMS is unreachable (so the homepage never breaks).
const CMS_URL = import.meta.env.PUBLIC_CMS_URL || "http://localhost:3001";
// Always format CMS dates in IST. The build runs on Vercel (UTC), so without an
// explicit timeZone an event saved as "18 Jul, 12:00 AM" IST renders as 17 Jul.
const IST = "Asia/Kolkata";
const fmtEventDate = (iso) => {
  const d = new Date(iso);
  return isNaN(d.getTime())
    ? iso
    : d.toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        timeZone: IST,
      });
};
// Start of "today" in IST — used to hide events that have already passed.
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const nowIST = new Date(Date.now() + IST_OFFSET_MS);
const todayStartIST = new Date(
  Date.UTC(nowIST.getUTCFullYear(), nowIST.getUTCMonth(), nowIST.getUTCDate()) -
    IST_OFFSET_MS,
);
const now = new Date();
const baseYear = 2026;
const baseCount = 46;
const anniversaryMonth = 5;

const yearsOfExcellence =
  baseCount +
  (now.getFullYear() - baseYear) -
  (now.getMonth() < anniversaryMonth ? 1 : 0);
let homeEvents = UPCOMING_EVENTS;
try {
  const res = await fetch(
    `${CMS_URL}/api/events?where%5Bstatus%5D%5Bequals%5D=published&where%5Bdate%5D%5Bgreater_than_equal%5D=${encodeURIComponent(todayStartIST.toISOString())}&sort=date&depth=0&limit=6`,
    { headers: { Accept: "application/json" } },
  );
  if (res.ok) {
    const { docs = [] } = await res.json();
    if (docs.length) {
      homeEvents = docs.map((e) => ({
        title: e.title,
        date: e.dateText || fmtEventDate(e.date),
        venue: e.venue || "SRKR Engineering College",
        link: e.registrationLink || "/events",
      }));
    }
  }
} catch {
  /* CMS down → keep static UPCOMING_EVENTS */
}

// News & Updates — loaded live from the CMS, fallback to static NEWS in consts.ts.
let homeNews = NEWS;
try {
  const res = await fetch(
    `${CMS_URL}/api/news?where%5Bstatus%5D%5Bequals%5D=published&sort=-date&depth=0&limit=6`,
    { headers: { Accept: "application/json" } },
  );
  if (res.ok) {
    const { docs = [] } = await res.json();
    if (docs.length) {
      homeNews = docs.map((n) => {
        const d = new Date(n.date);
        const valid = !isNaN(d.getTime());
        return {
          title: n.title,
          day: valid
            ? d.toLocaleDateString("en-IN", { day: "2-digit", timeZone: IST })
            : "",
          month: valid
            ? d.toLocaleDateString("en-IN", { month: "short", timeZone: IST })
            : "",
          link: n.links?.[0]?.url || "/news",
        };
      });
    }
  }
} catch {
  /* CMS down → keep static NEWS */
}
