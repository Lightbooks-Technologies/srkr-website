        <!-- ==========================================
     ASTRO / SWIPER VIDEO SCRIPT
=========================================== -->

        <script is:inline>
          (function primeMobileHeroPoster() {
            const isMobile = window.matchMedia("(max-width: 768px)").matches;

            if (!isMobile) return;

            const videos = document.querySelectorAll(
              ".rts-hero-slider-active .hero-video",
            );

            videos.forEach((video, index) => {
              if (index === 0) {
                const poster =
                  video.dataset.posterMobile || video.dataset.posterDesktop;

                if (poster) {
                  video.poster = poster;
                  video.setAttribute("poster", poster);
                }

                return;
              }

              video.poster = "";
              video.removeAttribute("poster");
            });
          })();

          document.addEventListener("DOMContentLoaded", () => {
            /*
             * Find the existing Swiper instance/container.
             *
             * We don't create another .swiper element because
             * this code is already inside your existing Swiper.
             */

            const swiperElement = document.querySelector(".swiper");

            if (!swiperElement) {
              console.warn("Swiper container not found.");
              return;
            }

            /*
             * Load the correct video for the device.
             */

            /*
             * Load and prepare video playback.
             * Only after video starts playing / is ready, start a timer to move to the next slide.
             */
            let slideTimer = null;

            function clearSlideTimer() {
              if (slideTimer) {
                clearTimeout(slideTimer);
                slideTimer = null;
              }
            }

            function loadVideo(video) {
              if (!video) return;

              const isMobile = window.matchMedia("(max-width: 768px)").matches;
              const source = isMobile
                ? video.dataset.mobile
                : video.dataset.desktop;

              if (!source) return;

              syncVideoPoster(video, isMobile);

              if (video.dataset.loaded === source) {
                return;
              }

              video.src = source;
              video.dataset.loaded = source;
              video.load();
            }

            function syncVideoPoster(video, isMobile) {
              if (!video) return;

              const poster = isMobile
                ? video.dataset.posterMobile || video.dataset.posterDesktop
                : video.dataset.posterDesktop || video.dataset.posterMobile;

              if (!poster) return;

              video.poster = poster;
              video.setAttribute("poster", poster);

              const slideBg = video.closest(".hero-slide-bg");
              if (slideBg) {
                slideBg.style.backgroundImage = `url('${poster}')`;
              }
            }

            function syncActiveVideoPoster(swiper, isMobile) {
              if (!swiper) return;

              const activeSlide = swiper.slides[swiper.activeIndex];
              if (!activeSlide) return;

              document.querySelectorAll(".hero-video").forEach((video) => {
                const isActiveVideo = activeSlide.contains(video);

                if (isActiveVideo) {
                  syncVideoPoster(video, isMobile);
                }
              });
            }

            function stopAllVideos() {
              clearSlideTimer();
              document.querySelectorAll(".hero-video").forEach((video) => {
                video.pause();
                try { video.currentTime = 0; } catch(e) {}
              });
            }

            function playActiveVideo(swiper) {
              if (!swiper) return;
              clearSlideTimer();

              // Pause Swiper's default autoplay timer while waiting/playing
              if (swiper.autoplay && swiper.autoplay.running) {
                swiper.autoplay.stop();
              }

              const activeSlide = swiper.slides[swiper.activeIndex];
              if (!activeSlide) return;

              const video = activeSlide.querySelector(".hero-video");
              if (!video) return;

              // Ensure poster is set while video is downloading/loading
              const isMobile = window.matchMedia("(max-width: 768px)").matches;
              syncVideoPoster(video, isMobile);

              loadVideo(video);

              const slideDuration = parseInt(activeSlide.getAttribute("data-swiper-autoplay") || "10000", 10);

              const startSlideTimer = () => {
                clearSlideTimer();
                slideTimer = setTimeout(() => {
                  if (swiper && typeof swiper.slideNext === "function") {
                    swiper.slideNext();
                  }
                }, slideDuration);
              };

              video.addEventListener("playing", () => {
                startSlideTimer();
              }, { once: true });

              // Check if video is already ready to play
              if (video.readyState >= 3) {
                video.play().catch(() => {});
                startSlideTimer();
              } else {
                const onCanPlay = () => {
                  video.removeEventListener("canplaythrough", onCanPlay);
                  video.play().catch(() => {});
                };
                video.addEventListener("canplaythrough", onCanPlay, { once: true });

                video.play().catch(() => {});
              }
            }

            function handleSwiperSetup(swiper) {
              if (
                window.matchMedia("(max-width: 768px)").matches &&
                typeof swiper.slideToLoop === "function"
              ) {
                swiper.slideToLoop(0, 0, false);
              }

              syncActiveVideoPoster(
                swiper,
                window.matchMedia("(max-width: 768px)").matches,
              );

              /* Play initial video */
              playActiveVideo(swiper);

              /* Stop video when changing slides */
              swiper.on("slideChangeTransitionStart", () => {
                stopAllVideos();
                syncActiveVideoPoster(
                  swiper,
                  window.matchMedia("(max-width: 768px)").matches,
                );
              });

              /* Play new active video after transition */
              swiper.on("slideChangeTransitionEnd", () => {
                playActiveVideo(swiper);
              });
            }

            if (
              swiperElement.swiper &&
              typeof swiperElement.swiper.on === "function"
            ) {
              handleSwiperSetup(swiperElement.swiper);
            } else {
              let attempts = 0;
              const findSwiper = setInterval(() => {
                attempts++;
                const swiper = swiperElement.swiper;

                if (swiper && typeof swiper.on === "function") {
                  clearInterval(findSwiper);
                  handleSwiperSetup(swiper);
                }

                if (attempts >= 50) {
                  clearInterval(findSwiper);
                  console.warn("Swiper instance could not be found.");
                }
              }, 100);
            }

            /*
             * Handle desktop/mobile change.
             */
            let wasMobile = window.matchMedia("(max-width: 768px)").matches;

            window.addEventListener("resize", () => {
              const isMobile = window.matchMedia("(max-width: 768px)").matches;

              if (isMobile !== wasMobile) {
                wasMobile = isMobile;
                stopAllVideos();
                syncActiveVideoPoster(swiperElement.swiper, isMobile);

                const swiper = swiperElement.swiper;
                if (swiper) {
                  playActiveVideo(swiper);
                }
              }
            });
          });
        </script>
