    <!-- SRKREC at a Glance -->
    <section class="srkr-glance rts-section-padding-small">
      <div class="container">
        <div class="row">
          <div class="col-12 text-center mb--40">
            <h4 class="rts-section-title">SRKREC at a Glance</h4>
          </div>
        </div>
        <div class="row g-4">
          <!-- Card 1 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-building-columns"></i>
              </div>
              <div class="srkr-glance-label">Established In</div>
              <div class="srkr-glance-value">1980</div>
              <div class="srkr-glance-desc">
                45 Years of Academic Excellence
              </div>
            </div>
          </div>
          <!-- Card 2 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-award"></i>
              </div>
              <div class="srkr-glance-label">NAAC 'A+' Grade</div>
              <div class="srkr-glance-value">
                3.42<span class="small-text">/4</span>
              </div>
              <div class="srkr-glance-desc">NAAC Cycle - II</div>
            </div>
          </div>
          <!-- Card 3 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-certificate"></i>
              </div>
              <div class="srkr-glance-label">N B A</div>
              <div class="srkr-glance-value">6</div>
              <div class="srkr-glance-desc">
                Programs CSE, IT, ECE, EEE, CE, ME
              </div>
            </div>
          </div>
          <!-- Card 4 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-chalkboard-user"></i>
              </div>
              <div class="srkr-glance-label">Total Faculty</div>
              <div class="srkr-glance-value">
                400<span class="plus">+</span>
              </div>
              <div class="srkr-glance-desc">150+ PhD's</div>
            </div>
          </div>
          <!-- Card 5 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-user-graduate"></i>
              </div>
              <div class="srkr-glance-label">Graduates</div>
              <div class="srkr-glance-value">
                30000<span class="plus">+</span>
              </div>
              <div class="srkr-glance-desc">Produced</div>
            </div>
          </div>
          <!-- Card 6 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-briefcase"></i>
              </div>
              <div class="srkr-glance-label">Placement Meter</div>
              <div class="srkr-glance-value">
                2080<span class="plus">+</span>
              </div>
              <div class="srkr-glance-desc">
                Offers So far for 2025-26 Batch
              </div>
            </div>
          </div>
          <!-- Card 7 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-book"></i>
              </div>
              <div class="srkr-glance-label">Publications</div>
              <div class="srkr-glance-value">2600</div>
              <div class="srkr-glance-desc">Scopus Indexed</div>
            </div>
          </div>
          <!-- Card 8 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-handshake"></i>
              </div>
              <div class="srkr-glance-label">Citations</div>
              <div class="srkr-glance-value">12440</div>
              <div class="srkr-glance-desc">Scopus</div>
            </div>
          </div>
          <!-- Card 9 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-flask"></i>
              </div>
              <div class="srkr-glance-label">Funded Projects</div>
              <div class="srkr-glance-value">
                12.5<span class="small-text">Cr</span>
              </div>
              <div class="srkr-glance-desc">by DST, DBT, MSME & Others</div>
            </div>
          </div>
          <!-- Card 10 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-lightbulb"></i>
              </div>
              <div class="srkr-glance-label">Patents</div>
              <div class="srkr-glance-value">
                180<span class="plus">+</span>
              </div>
              <div class="srkr-glance-desc">Published/Granted</div>
            </div>
          </div>
          <!-- Card 11 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-handshake-angle"></i>
              </div>
              <div class="srkr-glance-label">Collaborations</div>
              <div class="srkr-glance-value">65<span class="plus">+</span></div>
              <div class="srkr-glance-desc">MOUs</div>
            </div>
          </div>
          <!-- Card 12 -->
          <div class="col-lg-2 col-md-4 col-sm-6 col-6">
            <div class="srkr-glance-card">
              <div class="srkr-glance-icon">
                <i class="fa-light fa-rocket"></i>
              </div>
