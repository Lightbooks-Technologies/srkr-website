--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Prominent Alumni</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- alumni banner -->
    <div class="alumni-banner pt--30 pb--10">
        <div class="container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="rts__section--wrapper v__9">
                        <h2 class="rts__section--title">Prominent Alumni</h2>
                        <p class="text-center text-muted">
                            Our alumni in India are leaders in various sectors, making invaluable contributions to the fields of engineering, technology, business, and more. Their achievements stand as a testament to the quality education and strong foundation provided by SRKR Engineering College.
                        </p>
                        
                    </div>
                </div>
            </div>
            <!-- banner image -->
            <div class="row">
                <div class="col-sm-12">
                    <div class="alumni__banner__image">
                        <img src="/assets/images/banner/alumni__banner__1.jpg" alt="">
                        <img src="/assets/images/banner/alumni__banner__2.jpg" alt="" loading="lazy" decoding="async">

                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- alumni banner end -->
   

    <!-- footer -->
    <SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>