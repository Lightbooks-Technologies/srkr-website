<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .program-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: inherit;
        transition:
          background-color 0.2s,
          box-shadow 0.2s;
        gap: 8px;
        margin-bottom: 12px;
      }
      .program-item:hover {
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .program-item span {
        display: flex;
        margin-right: 8px;
        align-items: center;
        color: var(--rt-primary);
      }
      .program-item i {
        margin-left: 8px;
        transition: transform 0.2s;
        padding: 8px;
        color: var(--rt-secondary);
      }

      .placement-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
      }
      .placement-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .placement-wall .container {
        position: relative;
        z-index: 1;
      }
      .placement-wall__eyebrow {
        margin: 0;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 12px;
        font-weight: 700;
        color: #5e71b3;
      }
      .placement-wall__title {
        text-align: center;
        margin: 8px 0 26px;
        color: #203a86;
        font-size: clamp(1.5rem, 2.6vw, 2.25rem);
      }
      .placement-wall__ticker {
        overflow: hidden;
        mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
      }
      .placement-wall__ticker.limited {
        mask-image: none;
        -webkit-mask-image: none;
      }
      .placement-wall__track {
        display: flex;
        width: max-content;
        gap: 18px;
        animation: placementTicker 80s linear infinite;
        will-change: transform;
      }
      .placement-wall__track.limited {
        animation: none;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
      }
      .placement-wall__ticker:hover .placement-wall__track {
        animation-play-state: paused;
      }
      .placement-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 16px;
        min-width: min(92vw, 360px);
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.08);
      }

      /* Ticker Avatar Box */
      .placement-wall-card__avatar {
        width: 96px;
        height: 96px;
        min-width: 72px;
        border-radius: 50%;
        background: #eef2ff;
        color: #203a86;
        border: 3px solid #dce4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.2rem;
        flex-shrink: 0;
        overflow: hidden;
      }
      .placement-wall-card__photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .placement-wall-card__meta {
        min-width: 0;
        flex: 1;
      }
      .placement-wall-card__designation {
        margin: 0 0 2px 0;
        color: #88211A;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .placement-wall-card__name {
        margin: 0 0 2px 0;
        color: #1f2a44;
        font-weight: 800;
        font-size: 1.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .placement-wall-card__company {
        margin: 0;
        color: #6c757d;
        font-size: 1.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      @keyframes placementTicker {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(calc(-50% - 9px));
        }
      }

      @media (max-width: 767px) {
        .placement-wall-card {
          min-width: min(96vw, 320px);
          padding: 12px 14px;
        }
        .placement-wall-card__avatar {
          width: 60px;
          height: 60px;
          min-width: 60px;
          font-size: 1rem;
        }
        .placement-wall-card__name {
          font-size: 14px;
        }
      }
    </style>
  </head>
  <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
              </ul>
              <h1 class="section-title">Prominent Alumni</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- ALUMNI BANNER -->
    <div class="alumni-banner pt--30 pb--10">
      <div class="container">
        <div class="row">
          <div class="col-sm-12">
            <div class="rts__section--wrapper v__9 mb-5">
              <h2 class="rts__section--title">Prominent Alumni - Abroad</h2>
              <p class="text-center text-muted">
                Our alumni in India and abroad are leaders in various sectors, making invaluable contributions to the fields of engineering, technology, business, and more. Their achievements stand as a testament to the quality education and strong foundation provided by SRKR Engineering College.
              </p>
            </div>
          </div>
        </div>

        <!-- Alumni Grid Mapping -->
        <section class="placement-wall pb--20 mb--10" aria-label="Prominent Alumni Abroad">
          <div class="container">
            <div class="row g-4 pt--30">
              {alumniAbroad.map((alumnus) => {
                const initials = alumnus.name
                  ? alumnus.name.split(" ").map((n) => n[0]).slice(0, 2).join("")
                  : "A";

                return (
                  <div class="col-lg-4 col-md-4 col-sm-6 d-flex">
                    <article class="placement-wall-card w-100">
                      <div class="placement-wall-card__avatar">
                        {alumnus.image ? (
                          <img
                            class="placement-wall-card__photo"
                            src={alumnus.image.startsWith('/') ? alumnus.image : `/${alumnus.image}`}
                            alt={alumnus.name}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span>{initials}</span>
                        )}
                      </div>
                      <div class="placement-wall-card__meta">
                        <p class="placement-wall-card__designation" title={alumnus.designation}>
                          {alumnus.designation}
                        </p>
                        <p class="placement-wall-card__name" title={alumnus.name}>
                          {alumnus.name}
                        </p>
                        <p class="placement-wall-card__company" title={alumnus.company}>
                          {alumnus.company}
                        </p>
                      </div>
                    </article>
                  </div>
                );
              })}
            </div>
          </div>
        </section>

      </div>
    </div>
     <div class="alumni-banner pt--30 pb--10">
      <div class="container">
        <div class="row">
          <div class="col-sm-12">
            <div class="rts__section--wrapper v__9 mb-0">
              <h2 class="rts__section--title">Prominent Alumni - India</h2>
            </div>
          </div>
        </div>

        <!-- Alumni Grid Mapping -->
        <section class="placement-wall pb--50 mb--50" aria-label="Prominent Alumni in India">
