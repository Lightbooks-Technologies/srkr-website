---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = "Student Clubs";

const techClubs = [
  { "name": "ACE - Association of Computer Engineers", "fullName": "Association of Computer Engineers", "dept": "CSE", "advisor": "Faculty Coordinator, CSE", "mission": "Coding contests, local hackathons, and core computer science technical workshops.", "img": "/assets/images/clubs/ace.jpg" },
  { "name": "CSI - Computer Society of India", "fullName": "Computer Society of India", "dept": "CSE / IT", "advisor": "CSI Faculty Advisor", "mission": "National-level IT workshops, student certifications, and institutional tech fests.", "img": "/assets/images/clubs/csi.jpg" },
  { "name": "IETE - The Institution of Electronics and Telecommunication Engineers", "fullName": "The Institution of Electronics and Telecommunication Engineers", "dept": "ECE", "advisor": "IETE Faculty Advisor", "mission": "Electronics design, telecom workshops, and emerging communication technology seminars.", "img": "/assets/images/clubs/iete.jpg" },
  { "name": "AEE - Association of Electrical Engineers", "fullName": "Association of Electrical Engineers", "dept": "EEE", "advisor": "Faculty Coordinator, EEE", "mission": "Power systems, electrical design workshops, and renewable energy seminars.", "img": "/assets/images/clubs/aee.jpg" },
  { "name": "AME - Association of Mechanical Engineering", "fullName": "Association of Mechanical Engineering", "dept": "Mechanical", "advisor": "Faculty Coordinator, Mechanical", "mission": "Departmental design challenges, manufacturing workshops, and guest lectures.", "img": "/assets/images/clubs/ame.jpg" },
  { "name": "IIPE - Indian Institution of Production Engineers", "fullName": "Indian Institution of Production Engineers", "dept": "Mechanical", "advisor": "IIPE Faculty Advisor", "mission": "Industrial engineering, production planning, and manufacturing technology conclaves.", "img": "/assets/images/clubs/iipe.jpg" },
  { "name": "IEI - Institution of Engineers (India)", "fullName": "Institution of Engineers (India)", "dept": "Civil / Multi-disciplinary", "advisor": "IEI Faculty Chapter Advisor", "mission": "Multi-disciplinary engineering seminars, standard codes, and sustainable infrastructure forums.", "img": "/assets/images/clubs/iei.jpg" },
  { "name": "ISTE - Indian Society for Technical Education", "fullName": "Indian Society for Technical Education", "dept": "College-wide", "advisor": "ISTE Faculty Advisor", "mission": "Overall technical education promotion, faculty development support, and student soft skills training.", "img": "/assets/images/clubs/iste.jpg" },

  ];

const culturalClubs = [
  { name: 'Cini Club', mission: 'Film screenings, short film making, movie discussions, script writing, and creative cinematography activities that nurture storytelling and visual creativity among students.', img: '/assets/images/clubs/cini-club.jpg' },
  { name: 'Music Club', mission: 'Vocal & instrumental ensembles, jam sessions, college band.', img: '/assets/images/clubs/music-club.jpg' },
  { name: 'Language Nest (Literary Club)', mission: 'Debates, elocution, SRKR Toastmasters & creative writing.', img: '/assets/images/clubs/language-nest.jpg' },

];

const serviceClubs = [
  { name: 'NSS — National Service Scheme', mission: 'Village outreach, blood donation drives, plantation & health camps.', img: '/assets/images/clubs/nss.jpg' },
  { name: 'NCC — National Cadet Corps', mission: 'Discipline, leadership training & national-level NCC camps.', img: '/assets/images/clubs/ncc.jpg' },
  { name: 'Eco Club / Green Society', mission: 'Plantation drives, plastic-free campus & sustainability projects.', img: '/assets/images/clubs/eco-club.jpg' },
  { name: 'Blood Donors Forum', mission: 'Voluntary blood-donation registry & emergency donor mobilisation.', img: '/assets/images/clubs/blood-donors-forum.jpg' },
];

const sportsClubs = [
  { name: 'Cricket Club', mission: 'Regular cricket matches, coaching clinics, and intercollegiate cricket tournaments.', img: '/assets/images/clubs/cricket-club.jpg' },
  { name: 'Volleyball Club', mission: 'Inter-departmental volleyball competitions, team practice sessions, and skill-building camps.', img: '/assets/images/clubs/volleyball-club.jpg' },
  { name: 'Kabaddi Club', mission: 'Traditional kabaddi training, intramural tournaments, and participation in intercollegiate events.', img: '/assets/images/clubs/kabaddi-club.jpg' },
  { name: 'Basketball Club', mission: 'Court practice sessions, college leagues, and participation in district-level basketball tournaments.', img: '/assets/images/clubs/basketball-club.jpg' },
  { name: 'Badminton Club', mission: 'Singles and doubles practice, racket skill workshops, and campus badminton championships.', img: '/assets/images/clubs/badminton-club.jpg' },
  { name: 'Football Club', mission: 'Inter-departmental football tournaments, coaching sessions, and annual JAITRA sports carnival.', img: '/assets/images/clubs/football-club.jpg' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Tech, cultural and service clubs at SRKR Engineering College — IEEE, ISTE, ASCE, NSS, NCC and more." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="#">Life @ SRKR</a></li>
                <li class="breadcrumb-item active" aria-current="page">{pageTitle}</li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB END -->

    <!-- HERO INTRO -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 text-center">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">Beyond the Classroom</h3>
              <p class="rts-section-description">SRKREC clubs cater to diverse student interests, including technical, artistic, research-oriented, and public speaking activities, creating a vibrant and engaging campus environment. These clubs help students develop leadership, teamwork, creativity, and communication skills while encouraging active participation beyond academics. Through continuous events and collaborative activities, the clubs contribute to the dynamic and lively culture of the institution.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TECH CLUBS -->
    <div class="rts-multi-row-section pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Technical &amp; Professional Clubs</h3>
        </div>
        <div class="row g-4">
          {techClubs.map((c) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm single-cat-item">
                {/* TODO: replace placeholder logo */}
                <div class="cat-thumb">
                  <img src={c.img} alt={c.name} loading="lazy" decoding="async" />
                  <span class="cat-link-btn">{c.dept}</span>
                </div>
                <div class="card-body">
                  <h5 class="card-title mb-2">{c.name}</h5>
                  <p class="mb-2"><strong>Faculty Advisor:</strong> {c.advisor}</p>
                  <p class="mb-3 small text-muted">{c.mission}</p>
                  <a href="/activities" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i> Activities</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- SPORTS CLUBS -->
    <div class="rts-multi-row-section rts-multi-row-content pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Sports Clubs</h3>
        </div>
        <div class="row g-4">
          {sportsClubs.map((c) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm single-cat-item">
                {/* TODO: replace placeholder logo */}
                <div class="cat-thumb">
                  <img src={c.img} alt={c.name} loading="lazy" decoding="async" />
                  <span class="cat-link-btn">Sports</span>
                </div>
                <div class="card-body">
                  <h5 class="card-title mb-2">{c.name}</h5>
                  <p class="mb-0 small text-muted">{c.mission}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>


    <!-- CULTURAL CLUBS -->
    <div class="rts-multi-row-section rts-multi-row-content pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Cultural Clubs</h3>
        </div>
        <div class="row g-4">
          {culturalClubs.map((c) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm single-cat-item">
                {/* TODO: replace placeholder logo */}
                <div class="cat-thumb">
                  <img src={c.img} alt={c.name} loading="lazy" decoding="async" />
                  <span class="cat-link-btn">Cultural</span>
                </div>
                <div class="card-body">
                  <h5 class="card-title mb-2">{c.name}</h5>
                  <p class="mb-0 small text-muted">{c.mission}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- SERVICE & SOCIAL CLUBS -->
    <div class="rts-multi-row-section pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Service &amp; Social Clubs</h3>
        </div>
        <div class="row g-4">
          {serviceClubs.map((c) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm single-cat-item">
                {/* TODO: replace placeholder logo */}
                <div class="cat-thumb">
                  <img src={c.img} alt={c.name} loading="lazy" decoding="async" />
                  <span class="cat-link-btn">Service</span>
                </div>
                <div class="card-body">
                  <h5 class="card-title mb-2">{c.name}</h5>
                  <p class="mb-0 small text-muted">{c.mission}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ANNUAL EVENTS ACCORDION -->
    <div class="rts-mission py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Annual Events &amp; Flagships</h3>
        </div>
        <div class="program-credit-area faq rts-scholarship-description">
          <div class="program-accordion">
            <div class="accordion" id="clubs-accordion">
              <div class="accordion-item">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cl1" aria-expanded="true">
                  SAMAGRA - Annual Techno Cultural Fest
                </button>
                <div id="cl1" class="accordion-collapse collapse show" data-bs-parent="#clubs-accordion">
                  <div class="accordion-body">

                    <p>A three-day flagship festival featuring national-level technical competitions in multidisciplinary emerging areas, research conclaves, project expos, cultural events, and annual day celebrations, jointly organized by all departments and student clubs of the institution.</p>
                  
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cl2" aria-expanded="false">
                 JAITRA - Annual Sports Carnival
                </button>
                <div id="cl2" class="accordion-collapse collapse" data-bs-parent="#clubs-accordion">
                  <div class="accordion-body">
                    <p style="text-align: justify;">JAITRA is the flagship national-level sports carnival of SRKR Engineering College, conducted annually during January. The mega sporting event attracts hundreds of participants from engineering colleges and universities across the country, fostering competitive spirit, teamwork, leadership, and sportsmanship. JAITRA features a wide range of intercollegiate tournaments and athletic competitions, creating a vibrant platform for students to showcase their talent and celebrate the spirit of sports.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cl3" aria-expanded="false">
                  NSS Special Camps &amp; Outreach
                </button>
                <div id="cl3" class="accordion-collapse collapse" data-bs-parent="#clubs-accordion">
                  <div class="accordion-body">
                    <p style="text-align: justify;">Annual 7-day village camps under NSS — covering health awareness, sanitation, literacy drives and skill-development workshops for local communities.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cl4" aria-expanded="false">
                  SRKR Toastmasters &amp; Literary Meets
                </button>
                <div id="cl4" class="accordion-collapse collapse" data-bs-parent="#clubs-accordion">
                  <div class="accordion-body">
                    <p style="text-align: justify;">Weekly Toastmasters sessions, debate tournaments, KYC/KYF/KYG events and the annual Language Nest extravaganza in January.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cl5" aria-expanded="false">
                 Hackathons &amp; Project Expos
                </button>
                <div id="cl5" class="accordion-collapse collapse" data-bs-parent="#clubs-accordion">
                  <div class="accordion-body">
                    <p style="text-align: justify;">SRKR Engineering College hosts numerous departmental hackathons throughout the academic year, encouraging innovation, creativity, and problem-solving among students. These hackathons focus on technology, sustainability, and domain-specific challenges, providing an excellent platform for participants to showcase their technical expertise, develop innovative solutions, collaborate with peers, and compete for exciting prizes and recognition.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- QUICK LINKS -->
    <div class="rts-funfact py-5">
      <div class="container">
        <div class="row justify-content-center mx-0">
          <div class="col-lg-12 px-0">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title"><i class="fa-light fa-calendar-star"></i></h2>
                <p><a href="/activities">Student Activities</a></p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title"><i class="fa-light fa-volleyball"></i></h2>
                <p><a href="/sports">Sports Facilities</a></p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title"><i class="fa-light fa-heart-pulse"></i></h2>
                <p><a href="/well-being">Well-Being</a></p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title"><i class="fa-light fa-house"></i></h2>
                <p><a href="/hostels">Hostels</a></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
