---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';

interface SubEventItem {
  description: string;
  image: string;
}

interface RecentEvent {
  title: string;
  description?: string;
  image?: string;
  items?: SubEventItem[];
}

const pageTitle = "SRKR CSI Club";
const category = "Professional";
const dept = "Department of IT";
const mission = "The Computer Society of India (CSI), established in 1965, promotes technological advancement, professional excellence, and knowledge sharing across India. The CSI Club at S.R.K.R. Engineering College, Bhimavaram, encourages students to explore emerging technologies, foster innovation, and develop technical and professional skills through collaborative learning and practical experiences.";
const advisor = "Dr. I. Hemalatha (Prof of Dept of Information Technology) / Dr. K. Kishore Raju (Assoc Prof of Dept of Information Technology)";
const joinInfo = "First-year regular students and second-year lateral entry students can register on Freshers' Day or at the event registration table when available. Contact: Charan K (8465833353) / Tiru A (9392824219).";
const clubImg = "/assets/images/clubs/csi-logo.jpg";

const objectives = [
  "To foster technical proficiency through workshops, seminars, and hackathons.",
  "To nurture creativity, innovation, and problem-solving.",
  "To facilitate academic and professional growth.",
  "To connect classroom learning with industry practices.",
  "To showcase student talent through competitions and projects."
];

const momentsImages = [
  "/assets/images/clubs/csi-high1.jpg",
  "/assets/images/clubs/csi-high2.jpg",
  "/assets/images/clubs/csi-high3.jpg",
  "/assets/images/clubs/csi-high4.jpg",
  "/assets/images/clubs/csi-high5.jpg",
];

const recentEvents: RecentEvent[] = [
  {
    title: "Udbhav National Level Hackathon",
    description: "A premier national-level hackathon fostering innovative solutions and technical problem-solving among student developers.",
    image: "/assets/images/clubs/csi1.jpg",
    items: [
      {
        description: "Participants explain their project and demonstrate its features to faculty members during the evaluation process. The interaction encourages technical learning, knowledge sharing, and constructive feedback to improve innovative solutions.",
        image: "/assets/images/clubs/csi1.jpg"
      },
      {
        description: "Participants collaborate closely during the hackathon, discussing ideas and reviewing project details while working in the computer lab. This teamwork promotes knowledge sharing, problem-solving, and the development of practical technical solutions.",
        image: "/assets/images/clubs/csi2.jpg"
      },
      {
        description: "The event concluded with a certificate presentation, recognizing the participants for their innovation, teamwork, and dedication. Faculty members and organizers appreciated the students' efforts and contributions throughout the national-level hackathon.",
        image: "/assets/images/clubs/csi3.jpg"
      }
    ]
  },
  {
    title: "HackNclash",
    description: "The Department of Information Technology, SRKR Engineering College, in association with CSI SRKREC Student Chapter, organized a 3-hour hands-on session on “Coding Platforms”. The session introduced students to popular coding platforms and practical coding practice, focusing on improving problem-solving and coding skills through hands-on learning to prepare for technical opportunities.",
    image: "/assets/images/clubs/csi4.jpg"
  },
  {
    title: "Peer-to-Learning Community (PLC) – CSI Club",
    description: "The Peer-to-Learning Community (PLC) under the CSI Club promotes collaborative learning, technical skill development, and knowledge sharing through interactive sessions, hands-on practice, and peer-led discussions.",
    image: "/assets/images/clubs/csi5.jpg",
    items: [
      {
        description: "The Peer-to-Learning Community (PLC) under the CSI Club promotes collaborative learning, technical skill development, and knowledge sharing through interactive sessions, hands-on practice, and peer-led discussions. It helps students enhance their problem-solving abilities, teamwork, and technical expertise while preparing them for academic and professional growth.",
        image: "/assets/images/clubs/csi5.jpg"
      },
      {
        description: "Build confidence and prepare students for academic excellence, internships, and future career opportunities through hands-on practice.",
        image: "/assets/images/clubs/csi6.jpg"
      }
    ]
  },
  {
    title: "Prakriti Quest",
    description: "Prakriti Quest 2025 – Smart Farming Innovation Expo was organized by the IT Department and CSI SRKREC Student Chapter on Kisan Diwas. The event showcased innovative student prototypes in smart agriculture and sustainable farming, encouraging creativity, teamwork, and real-world problem-solving.",
    image: "/assets/images/clubs/csi7.jpg"
  },
  {
    title: "GitHub Workshop",
    description: "The Department of Information Technology organized a hands-on workshop titled “Workshop on Git & GitHub”. The workshop introduced students to version control and collaborative software development using Git and GitHub, covering repository creation, cloning, branching, committing, pushing code, and pull requests.",
    image: "/assets/images/clubs/csi8.png"
  },
  {
    title: "Shutter Soul",
    description: "Shutter soul is an online photography contest organized by the Department of Information Technology, SRKREC CSI Student Branch for CSI registered members. Conducted on 22 October 2025 with 54 participants, it encouraged students to showcase their creativity, visual storytelling, and photography skills through Diwali-themed photographs/reels.",
    image: "/assets/images/clubs/csi9.jpg"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`${pageTitle} | Student Clubs | SRKR Engineering College`} 
      description={mission} 
    />
    <style>
      .event-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
        border-radius: 16px;
        border: 1px solid #e3e7f3;
        padding: 16px 0;
        margin-top: 15px;
      }
      .event-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .event-wall .container-fluid {
        position: relative;
        z-index: 1;
      }
      .event-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      }
      .event-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .event-wall__track {
        display: flex;
        width: max-content;
        gap: 20px;
        padding: 6px 12px;
      }
      .event-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(85vw, 420px);
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
      }
      .event-wall-card__photo {
        width: 100%;
        height: 230px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      .event-wall-card__text {
        text-align: left;
        font-size: 14.5px;
        line-height: 1.6;
        color: #334155;
        margin: 0;
      }
      /* Uniform styling for moments cards with fixed image height */
      .moment-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(75vw, 280px);
        flex: 0 0 auto;
        padding: 10px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .moment-card__photo {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Life @ SRKR</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Student Clubs</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB END -->

    <!-- MAIN CONTENT -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row g-5">
          <!-- Main Content Column -->
          <div class="col-lg-8">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-4">About Club</h3>
              <p style="text-align: justify; font-size: 16px; line-height: 1.8;" class="mb-5">
                {mission}
              </p>

              <div class="border-top my-4"></div>

              <!-- Objectives Section -->
              <div class="rts-scholarship-description mb-5">
                <h3 class="mb-4"><i class="fa-sharp fa-light fa-bullseye-arrow me-2" style="color: var(--rt-primary);"></i> Key Objectives</h3>
                <ul class="list-unstyled one-column-list">
                  {objectives.map((obj) => (
                    <li class="mb-3 d-flex align-items-start">
                      <i class="fa-solid fa-circle-check me-3 mt-1" style="color: var(--rt-primary); font-size: 14px;"></i>
                      <span style="font-size: 15px; line-height: 1.6;">{obj}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recent Events / Accordion Details -->
              <div class="rts-scholarship-description mb-4">
                <h3 class="mb-4"><i class="fa-sharp fa-light fa-sparkles me-2" style="color: var(--rt-primary);"></i> Recent Highlights</h3>
                <div class="program-credit-area faq rts-scholarship-description">
                  <div class="program-accordion">
                    <div class="accordion" id="club-events-lolo">
                      {recentEvents.map((evt, idx) => (
                        <div class="accordion-item">
                          <button 
                            class={`accordion-button ${idx > 0 ? '' : ''}`} 
                            type="button" 
                            data-bs-toggle="collapse" 
                            data-bs-target={`#evt-collapse-${idx}`} 
                            aria-expanded={idx === 0 ? 'false' : 'false'}
                          >
                            {evt.title}
                          </button>
                          <div 
                            id={`evt-collapse-${idx}`} 
                            class={`accordion-collapse collapse ${idx === 0 ? '' : ''}`} 
                            data-bs-parent="#club-events-lolo"
                          >
                            <div class="accordion-body">
                              {evt.items ? (
                                <div class="event-wall">
                                  <div class="container-fluid px-0">
                                    <div class="event-wall__ticker" data-ticker>
                                      <div class="event-wall__track">
                                        {[...evt.items, ...evt.items, ...evt.items, ...evt.items].map((subItem) => (
                                          <article class="event-wall-card">
                                            {subItem.image && (
                                              <img 
                                                class="event-wall-card__photo"
                                                src={subItem.image} 
                                                alt={evt.title} 
                                                loading="lazy" 
                                                decoding="async" 
                                              />
                                            )}
                                            <p class="event-wall-card__text">
                                              {subItem.description}
                                            </p>
                                          </article>
                                        ))}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              ) : (
                                <div class="row g-4 align-items-center">
                                  <div class={evt.image ? "col-lg-7 rts-scholarship-description" : "col-lg-12 rts-scholarship-description"}>
                                    <p style="text-align: justify; font-size: 15px; line-height: 1.7;" class="mb-0">
                                      {evt.description}
                                    </p>
                                  </div>
                                  {evt.image && (
                                    <div class="col-lg-5">
                                      <img 
                                        src={evt.image} 
                                        alt={evt.title} 
                                        style="height: 100%; max-height: 220px; min-height: 200px; object-fit: cover; width: 100%; border-radius: 8px;" 
                                        loading="lazy" 
                                        decoding="async" 
                                      />
                                    </div>
                                  )}
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Full Width Moments & Highlights Section -->
              <div class="row mt-5">
                <div class="col-12">
                  <div class="rts-scholarship-description">
                    <h3 class="mb-4"><i class="fa-sharp fa-light fa-images me-2" style="color: var(--rt-primary);"></i> Moments & Highlights</h3>
                    <div class="event-wall">
                      <div class="container-fluid px-0">
                        <div class="event-wall__ticker" data-ticker>
                          <div class="event-wall__track">
                            {momentsImages.map((imgSrc, idx) => (
                              <div class="moment-card">
                                <img 
                                  class="moment-card__photo"
                                  src={imgSrc} 
                                  alt={`Moment ${idx + 1}`} 
                                  loading="lazy" 
                                  decoding="async" 
                                />
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="col-lg-4">
            <div class="card shadow-sm p-4 border-0" style="background-color: #f8fafc; border-radius: 12px; position: sticky; top: 100px;">
              <!-- Club Thumbnail -->
              <div class="cat-thumb mb-4 overflow-hidden" style="border-radius: 0; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1;">
                <img 
                  src={clubImg} 
                  alt={pageTitle} 
                  class="img-fluid" 
                  style="object-fit: contain; max-height: 100%; max-width: 100%;" 
                  loading="lazy" 
                  decoding="async" 
                />
              </div>

              <h3 class="h5 mb-4 border-bottom pb-2" style="color: var(--rt-primary);">Club Details</h3>

              <ul class="list-unstyled mb-4">
                <li class="mb-3 d-flex justify-content-between">
                  <strong class="text-muted">Category:</strong>
                  <span class="text-capitalize badge text-white py-2 px-3" style="background-color: var(--rt-primary);">{category}</span>
                </li>
                <li class="mb-3 d-flex justify-content-between align-items-center">
                  <strong class="text-muted">Scope/Dept:</strong>
                  <span class="fw-semibold">{dept}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">Faculty Advisor:</strong>
                  <span class="fw-semibold text-dark"><i class="fa-regular fa-user-tie me-2" style="color: var(--rt-primary);"></i> {advisor}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">How to Join:</strong>
                  <span style="font-size: 14px; line-height: 1.5;" class="text-secondary d-block">{joinInfo}</span>
                </li>
              </ul>

              <!-- Social Links -->
              <div class="mt-4 border-top pt-3 mb-4">
                <strong class="text-muted d-block mb-2">Connect with Us:</strong>
                <div class="d-flex gap-3" style="font-size: 20px;">
                  <a href="https://www.instagram.com/srkr_csi/" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                  </a>
                  <a href="https://www.linkedin.com/company/csi-srkrit/" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                  </a>
                  <a href="https://www.youtube.com/@srkritcsievents86" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="YouTube">
                    <i class="fa-brands fa-youtube"></i>
                  </a>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const tickers = document.querySelectorAll('[data-ticker]');
        tickers.forEach((ticker) => {
          const track = ticker.querySelector('.event-wall__track');
          if (!track) return;

          let paused = false;
          let lastTime = 0;

          const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

          const step = (time) => {
            if (!lastTime) lastTime = time;
            const delta = time - lastTime;
            lastTime = time;

            if (!paused && ticker.clientWidth > 0) {
              ticker.scrollLeft += delta * 0.05;
              const maxScroll = getMaxScroll();
              if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
                ticker.scrollLeft = 0;
              }
            }

            window.requestAnimationFrame(step);
          };

          ticker.addEventListener('mouseenter', () => {
            paused = true;
          });

          ticker.addEventListener('mouseleave', () => {
            paused = false;
            lastTime = 0;
          });

          const observer = new ResizeObserver(() => {
            lastTime = 0;
          });
          observer.observe(ticker);

          window.requestAnimationFrame(step);
        });
      })();
    </script>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>