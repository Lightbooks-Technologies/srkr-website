---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';

const pageTitle = "Language Nest Club";
const category = "literary & communication";
const dept = "Department of English and Foreign Languages, SRKREC";
const mission = "Language Nest is a student-centered Literature, Language and Communication club that provides a vibrant platform for students to develop their English language, communication, and interpersonal skills. Through engaging, outcome-based activities, the club encourages students to communicate confidently, think creatively, and develop professional competence.";
const advisor = "Mr. M. Sankar & Mr. Hari Nair";
const joinInfo = "Enrollment opens at the start of the academic year. Watch out for club recruitment notifications and announcements.";
const clubImg = "/assets/images/clubs/languageNest-logo.jpg";

const objectives = [
  "To enhance students’ listening, speaking, reading, and writing skills.",
  "To develop confidence, fluency, and effective communication.",
  "To foster creativity, critical thinking, and collaborative learning.",
  "To develop public speaking, presentation, and interpersonal skills.",
  "To prepare students for academic, professional, and workplace communication.",
  "To create an inclusive and engaging environment for language learning."
];

const recentEvents: Array<{
  title: string;
  description?: string;
  image?: string;
  items?: Array<{ description: string; image?: string }>;
}> = [
  {
    title: "Workshop on Resume Building",
    description: "Guided students in preparing effective, professional, and industry-oriented resumes tailored for modern workplace requirements and career progression.",
  },
  {
    title: "SRKR Orator Championship",
    description: "Provided a competitive platform for students to demonstrate public speaking, articulation, confidence, and persuasive communication skills.",
  },
  {
    title: "Debates",
    description: "Conducted structured debates to develop critical thinking, argumentation, listening, and persuasive speaking skills among participants.",
  },
  {
    title: "Group Discussions (GDs)",
    description: "Organised GD sessions to strengthen students’ communication, teamwork, leadership, and analytical skills in collaborative settings.",
  },
  {
    title: "Workshop on Prompt Engineering",
    description: "Introduced students to the fundamentals of prompt engineering and effective interaction with AI tools to enhance modern digital communication and productivity.",
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`${pageTitle} | Student Clubs | SRKR Engineering College`} 
      description={mission} 
    />
    <style>
      .event-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
        border-radius: 16px;
        border: 1px solid #e3e7f3;
        padding: 16px 0;
        margin-top: 15px;
      }
      .event-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .event-wall .container-fluid {
        position: relative;
        z-index: 1;
      }
      .event-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      }
      .event-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .event-wall__track {
        display: flex;
        width: max-content;
        gap: 20px;
        padding: 6px 12px;
      }
      .event-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(85vw, 420px);
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
      }
      .event-wall-card__photo {
        width: 100%;
        height: 230px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      .event-wall-card__text {
        text-align: left;
        font-size: 14.5px;
        line-height: 1.6;
        color: #334155;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Life @ SRKR</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Student Clubs</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB END -->

    <!-- MAIN CONTENT -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row g-5">
          <!-- Main Content Column -->
          <div class="col-lg-8">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-4">About Club</h3>
              <p style="text-align: justify; font-size: 16px; line-height: 1.8;" class="mb-5">
                {mission}
              </p>

              <div class="border-top my-4"></div>

              <!-- Objectives Section -->
              <div class="rts-scholarship-description mb-5">
                <h4 class="font-32 mb-4"><i class="fa-sharp fa-light fa-bullseye-arrow me-2" style="color: var(--rt-primary);"></i> Objectives</h4>
                <ul class="list-unstyled one-column-list">
                  {objectives.map((obj) => (
                    <li class="mb-3 d-flex align-items-start">
                      <i class="fa-solid fa-circle-check me-3 mt-1" style="color: var(--rt-primary); font-size: 14px;"></i>
                      <span style="font-size: 15px; line-height: 1.6;">{obj}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recent Activities & Achievements -->
              <div class="rts-scholarship-description mb-4">
                <h4 class="font-32 mb-4"><i class="fa-sharp fa-light fa-sparkles me-2" style="color: var(--rt-primary);"></i> Recent Highlights</h4>
                <p style="text-align: justify; font-size: 15px; line-height: 1.7;" class="mb-4">
                  Language Nest has successfully conducted a range of outcome-based activities, competitions, workshops, and communication-focused events that have provided students with opportunities to develop their language, creative, and professional skills. Major initiatives include:
                </p>
                <div class="program-credit-area faq rts-scholarship-description">
                  <div class="program-accordion">
                    <div class="accordion" id="club-events-langnest">
                      {recentEvents.map((evt, idx) => (
                        <div class="accordion-item">
                          <button 
                            class="accordion-button" 
                            type="button" 
                            data-bs-toggle="collapse" 
                            data-bs-target={`#evt-collapse-${idx}`} 
                            aria-expanded="false"
                          >
                            {evt.title}
                          </button>
                          <div 
                            id={`evt-collapse-${idx}`} 
                            class="accordion-collapse collapse" 
                            data-bs-parent="#club-events-langnest"
                          >
                            <div class="accordion-body">
                              <div class="row g-4 align-items-center">
                                <div class="col-12 rts-scholarship-description">
                                  <p style="text-align: justify; font-size: 15px; line-height: 1.7;" class="mb-0">
                                    {evt.description}
                                  </p>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="col-lg-4">
            <div class="card shadow-sm p-4 border-0" style="background-color: #f8fafc; border-radius: 12px; position: sticky; top: 100px;">
              <!-- Club Thumbnail -->
              <div class="cat-thumb mb-4 overflow-hidden" style="border-radius: 0; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1;">
                <img 
                  src={clubImg} 
                  alt={pageTitle} 
                  class="img-fluid" 
                  style="object-fit: contain; max-height: 100%; max-width: 100%;" 
                  loading="lazy" 
                  decoding="async" 
                />
              </div>

              <h4 class="h5 mb-4 border-bottom pb-2" style="color: var(--rt-primary);">Club Details</h4>

              <ul class="list-unstyled mb-4">
                <li class="mb-3 d-flex justify-content-between">
                  <strong class="text-muted">Category:</strong>
                  <span class="text-capitalize badge text-white py-2 px-3" style="background-color: var(--rt-primary);">{category}</span>
                </li>
                <li class="mb-3 d-flex justify-content-between align-items-center">
                  <strong class="text-muted">Scope/Dept:</strong>
                  <span class="fw-semibold text-end">{dept}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">Faculty Advisors:</strong>
                  <span class="fw-semibold text-dark d-block mb-2">
                    <i class="fa-regular fa-user-tie me-2" style="color: var(--rt-primary);"></i> Mr. M. Sankar
                  </span>
                  <span class="text-secondary d-block mb-2" style="font-size: 13.5px; padding-left: 22px;">
                    <a href="mailto:sankarmusunoori@gmail.com" style="color: inherit;">sankarmusunoori@gmail.com</a>
                  </span>
                  <span class="fw-semibold text-dark d-block mb-2">
                    <i class="fa-regular fa-user-tie me-2" style="color: var(--rt-primary);"></i> Mr. Hari Nair
                  </span>
                  <span class="text-secondary d-block" style="font-size: 13.5px; padding-left: 22px;">
                    <a href="mailto:hnkrishnan@srkrec.ac.in" style="color: inherit;">hnkrishnan@srkrec.ac.in</a>
                  </span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">How to Join:</strong>
                  <span style="font-size: 14px; line-height: 1.5;" class="text-secondary d-block">{joinInfo}</span>
                </li>
              </ul>

              <!-- Social Links / Email -->
              <div class="mt-4 border-top pt-3 mb-4">
                <strong class="text-muted d-block mb-2">Primary Contact:</strong>
                <div class="d-flex gap-3 align-items-center" style="font-size: 18px;">
                  <a href="mailto:sankarmusunoori@gmail.com" style="color: var(--rt-primary);" title="Email">
                    <i class="fa-solid fa-envelope"></i>
                  </a>
                  <span style="font-size: 13.5px;" class="text-secondary">sankarmusunoori@gmail.com</span>
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const tickers = document.querySelectorAll('[data-ticker]');
        tickers.forEach((ticker) => {
          const track = ticker.querySelector('.event-wall__track');
          if (!track) return;

          let paused = false;
          let lastTime = 0;

          const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

          const step = (time) => {
            if (!lastTime) lastTime = time;
            const delta = time - lastTime;
            lastTime = time;

            if (!paused && ticker.clientWidth > 0) {
              ticker.scrollLeft += delta * 0.05;
              const maxScroll = getMaxScroll();
              if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
                ticker.scrollLeft = 0;
              }
            }

            window.requestAnimationFrame(step);
          };

          ticker.addEventListener('mouseenter', () => {
            paused = true;
          });

          ticker.addEventListener('mouseleave', () => {
            paused = false;
            lastTime = 0;
          });

          const observer = new ResizeObserver(() => {
            lastTime = 0;
          });
          observer.observe(ticker);

          window.requestAnimationFrame(step);
        });
      })();
    </script>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>