---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';

interface SubEventItem {
  description: string;
  image: string;
}

interface RecentEvent {
  title: string;
  description?: string;
  image?: string;
  items?: SubEventItem[];
}

const pageTitle = "SRKR IEI Mechanical Chapter";
const category = "Professional";
const dept = "Department of Mechanical Engineering";
const mission = "The Institution of Engineers (India) [IEI] is the world's largest multi-disciplinary professional society of engineers, established in 1920 and incorporated under a Royal Charter in 1935. Headquartered in Kolkata, India, it operates as a statutory body to promote and advance engineering and technology across 15 distinct disciplines.";
const advisor = "Mr. P.V.Ch.R.K. Santosh / Assistant Professor";
const joinInfo = "First-year regular students and second-year lateral entry students can register on Freshers' Day or at the event registration table when available.";
const clubImg = "/assets/images/clubs/iei.jpg";

const objectives = [
  "To enhance student’s knowledge and skills in engineering disciplines through workshops, seminars, industrial visits, and technical talks.",
  "To facilitate interaction between students and industry experts to expose them to real-world engineering problems and industrial practices.",
  "To motivate students to take up innovative projects and research work by providing platforms for presentations and publications.",
  "To develop student’s soft skills, leadership qualities, and ethical practices needed to become competent engineers."
];

const momentsImages = [
  "/assets/images/clubs/iei-high1.png",
  "/assets/images/clubs/iei-high2.png",
  "/assets/images/clubs/iei-high3.png",
  "/assets/images/clubs/iei-high4.png",
  "/assets/images/clubs/iei-high5.png",
];

const recentEvents: RecentEvent[] = [
  {
    title: "A Three-Day Workshop on Vehicle Diagnostics",
    description: "Organized by the Department of Mechanical Engineering on 29th, 30th & 31st December 2025. A total of 58 students from Mechanical Engineering attended and gained hands-on technical knowledge under the coordination of HoD Dr. K. Sita Rama Raju and faculty advisor Mr. P.V.Ch.R.K. Santosh.",
    image: "/assets/images/clubs/iei1.png"
  },
  {
    title: "A One-Day Workshop on Career Opportunities after Engineering",
    description: "Organized on 17th September 2025 for final-year Mechanical Engineering students. Mr. Aditya Vangala and Mr. Kausik Agastyaraj from ACE Engineering Academy interacted with students to guide them in career building and professional preparation.",
    image: "/assets/images/clubs/iei2.png"
  },
  {
    title: "VIBHA – An Awareness Program",
    description: "Organized on 7th March 2025 on the occasion of International Women’s Day. The program aimed to create awareness and promote good menstrual hygiene practices among girl students while emphasizing the importance of education.",
    image: "/assets/images/clubs/iei3.png"
  },
  {
    title: "Industrial Visit to AMTZ, MSME (Visakhapatnam)",
    description: "Conducted from 6th to 8th March 2025. Students gained valuable insights into organizational structures, advanced manufacturing processes, and workplace safety protocols, bridging the gap between classroom academics and real-world industrial practices.",
    image: "/assets/images/clubs/iei4.png"
  },
  {
    title: "A Two-Day Robotics Workshop (Aurdubotics)",
    description: "Organized on 15th & 16th February 2025, with 90 students participating from various branches and colleges. The workshop focused on the fundamentals of robotics, providing practical experience with Aurdubotics robots to foster creative problem-solving skills.",
    image: "/assets/images/clubs/iei5.png"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`${pageTitle} | Student Clubs | SRKR Engineering College`} 
      description={mission} 
    />
    <style>
      .event-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
        border-radius: 16px;
        border: 1px solid #e3e7f3;
        padding: 16px 0;
        margin-top: 15px;
      }
      .event-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .event-wall .container-fluid {
        position: relative;
        z-index: 1;
      }
      .event-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      }
      .event-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .event-wall__track {
        display: flex;
        width: max-content;
        gap: 20px;
        padding: 6px 12px;
      }
      .event-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(85vw, 420px);
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
      }
      .event-wall-card__photo {
        width: 100%;
        height: 230px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      .event-wall-card__text {
        text-align: left;
        font-size: 14.5px;
        line-height: 1.6;
        color: #334155;
        margin: 0;
      }
      /* Uniform styling for moments cards with fixed image height */
      .moment-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(75vw, 280px);
        flex: 0 0 auto;
        padding: 10px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .moment-card__photo {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Life @ SRKR</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Student Clubs</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB END -->

    <!-- MAIN CONTENT -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row g-5">
          <!-- Main Content Column -->
          <div class="col-lg-8">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-4">About Club</h3>
              <p style="text-align: justify; font-size: 16px; line-height: 1.8;" class="mb-5">
                {mission}
              </p>

              <div class="border-top my-4"></div>

              <!-- Objectives Section -->
              <div class="rts-scholarship-description mb-5">
                <h3 class="mb-4"><i class="fa-sharp fa-light fa-bullseye-arrow me-2" style="color: var(--rt-primary);"></i> Key Objectives</h3>
                <ul class="list-unstyled one-column-list">
                  {objectives.map((obj) => (
                    <li class="mb-3 d-flex align-items-start">
                      <i class="fa-solid fa-circle-check me-3 mt-1" style="color: var(--rt-primary); font-size: 14px;"></i>
                      <span style="font-size: 15px; line-height: 1.6;">{obj}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recent Events / Accordion Details -->
              <div class="rts-scholarship-description mb-4">
                <h3 class="mb-4"><i class="fa-sharp fa-light fa-sparkles me-2" style="color: var(--rt-primary);"></i> Recent Highlights</h3>
                <div class="program-credit-area faq rts-scholarship-description">
                  <div class="program-accordion">
                    <div class="accordion" id="club-events-lolo">
                      {recentEvents.map((evt, idx) => (
                        <div class="accordion-item">
                          <button 
                            class={`accordion-button ${idx > 0 ? '' : ''}`} 
                            type="button" 
                            data-bs-toggle="collapse" 
                            data-bs-target={`#evt-collapse-${idx}`} 
                            aria-expanded={idx === 0 ? 'false' : 'false'}
                          >
                            {evt.title}
                          </button>
                          <div 
                            id={`evt-collapse-${idx}`} 
                            class={`accordion-collapse collapse ${idx === 0 ? '' : ''}`} 
                            data-bs-parent="#club-events-lolo"
                          >
                            <div class="accordion-body">
                              {evt.items ? (
                                <div class="event-wall">
                                  <div class="container-fluid px-0">
                                    <div class="event-wall__ticker" data-ticker>
                                      <div class="event-wall__track">
                                        {[...evt.items, ...evt.items, ...evt.items, ...evt.items].map((subItem) => (
                                          <article class="event-wall-card">
                                            {subItem.image && (
                                              <img 
                                                class="event-wall-card__photo"
                                                src={subItem.image} 
                                                alt={evt.title} 
                                                loading="lazy" 
                                                decoding="async" 
                                              />
                                            )}
                                            <p class="event-wall-card__text">
                                              {subItem.description}
                                            </p>
                                          </article>
                                        ))}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              ) : (
                                <div class="row g-4 align-items-center">
                                  <div class={evt.image ? "col-lg-7 rts-scholarship-description" : "col-lg-12 rts-scholarship-description"}>
                                    <p style="text-align: justify; font-size: 15px; line-height: 1.7;" class="mb-0">
                                      {evt.description}
                                    </p>
                                  </div>
                                  {evt.image && (
                                    <div class="col-lg-5">
                                      <img 
                                        src={evt.image} 
                                        alt={evt.title} 
                                        style="height: 100%; max-height: 220px; min-height: 200px; object-fit: cover; width: 100%; border-radius: 8px;" 
                                        loading="lazy" 
                                        decoding="async" 
                                      />
                                    </div>
                                  )}
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Full Width Moments & Highlights Section -->
              <div class="row mt-5">
                <div class="col-12">
                  <div class="rts-scholarship-description">
                    <h3 class="mb-4"><i class="fa-sharp fa-light fa-images me-2" style="color: var(--rt-primary);"></i> Moments & Highlights</h3>
                    <div class="event-wall">
                      <div class="container-fluid px-0">
                        <div class="event-wall__ticker" data-ticker>
                          <div class="event-wall__track">
                            {momentsImages.map((imgSrc, idx) => (
                              <div class="moment-card">
                                <img 
                                  class="moment-card__photo"
                                  src={imgSrc} 
                                  alt={`Moment ${idx + 1}`} 
                                  loading="lazy" 
                                  decoding="async" 
                                />
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="col-lg-4">
            <div class="card shadow-sm p-4 border-0" style="background-color: #f8fafc; border-radius: 12px; position: sticky; top: 100px;">
              <!-- Club Thumbnail -->
              <div class="cat-thumb mb-4 overflow-hidden" style="border-radius: 0; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1;">
                <img 
                  src={clubImg} 
                  alt={pageTitle} 
                  class="img-fluid" 
                  style="object-fit: contain; max-height: 100%; max-width: 100%;" 
                  loading="lazy" 
                  decoding="async" 
                />
              </div>

              <h3 class="h5 mb-4 border-bottom pb-2" style="color: var(--rt-primary);">Club Details</h3>

              <ul class="list-unstyled mb-4">
                <li class="mb-3 d-flex justify-content-between">
                  <strong class="text-muted">Category:</strong>
                  <span class="text-capitalize badge text-white py-2 px-3" style="background-color: var(--rt-primary);">{category}</span>
                </li>
                <li class="mb-3 d-flex justify-content-between align-items-center">
                  <strong class="text-muted">Scope/Dept:</strong>
                  <span class="fw-semibold">{dept}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">Faculty Advisor:</strong>
                  <span class="fw-semibold text-dark"><i class="fa-regular fa-user-tie me-2" style="color: var(--rt-primary);"></i> {advisor}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">How to Join:</strong>
                  <span style="font-size: 14px; line-height: 1.5;" class="text-secondary d-block">{joinInfo}</span>
                </li>
              </ul>

              <!-- Primary Contact -->
              <div class="mt-4 border-top pt-3 mb-4">
                <strong class="text-muted d-block mb-2">Primary Contact:</strong>
                <div class="d-flex gap-3 align-items-center" style="font-size: 18px;">
                  <a href="mailto:pvcrksantosh@srkrec.ac.in" style="color: var(--rt-primary);" title="Email">
                    <i class="fa-solid fa-envelope"></i>
                  </a>
                  <span style="font-size: 13.5px;" class="text-secondary">pvcrksantosh@srkrec.ac.in</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const tickers = document.querySelectorAll('[data-ticker]');
        tickers.forEach((ticker) => {
          const track = ticker.querySelector('.event-wall__track');
          if (!track) return;

          let paused = false;
          let lastTime = 0;

          const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

          const step = (time) => {
            if (!lastTime) lastTime = time;
            const delta = time - lastTime;
            lastTime = time;

            if (!paused && ticker.clientWidth > 0) {
              ticker.scrollLeft += delta * 0.05;
              const maxScroll = getMaxScroll();
              if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
                ticker.scrollLeft = 0;
              }
            }

            window.requestAnimationFrame(step);
          };

          ticker.addEventListener('mouseenter', () => {
            paused = true;
          });

          ticker.addEventListener('mouseleave', () => {
            paused = false;
            lastTime = 0;
          });

          const observer = new ResizeObserver(() => {
            lastTime = 0;
          });
          observer.observe(ticker);

          window.requestAnimationFrame(step);
        });
      })();
    </script>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>