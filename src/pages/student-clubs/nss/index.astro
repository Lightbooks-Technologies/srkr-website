---
import BaseHead from "../../../components/BaseHead.astro";
import FooterScripts from "../../../components/FooterScripts.astro";
import SrkrHeader from "../../../components/SrkrHeader.astro";
import SrkrFooter from "../../../components/SrkrFooter.astro";
import OffCanvas from "../../../components/OffCanvas.astro";
import DeptNav from "../../../components/DeptNav.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Department of Computer Science & Engineering | SRKR Engineering College"
      description="Department of Computer Science & Engineering at SRKR Engineering College, Bhimavaram — established 1991, NBA accredited, JNTUK Research Centre."
    />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/faculty/cse/csehome.jpeg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item">
                  <a href="/student-clubs">Student Clubs</a>
                </li>
                <li class="breadcrumb-item">
                  <a href="/student-clubs/nss">NSS</a>
                </li>
              </ul>
              <h1 class="section-title">NSS — National Service Scheme</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- Department Highlights -->
    <div class="rts-blog v_1 rts__light rts-section-padding">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11">
            <div class="rts-section pb--10">
              <h4 class="rts-section-title text-uppercase">NSS SRKREC</h4>
            </div>
          </div>
        </div>
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11">
            <div
              class="card shadow-sm p-4 h-100"
              style="border-radius: 12px; border: 1px solid #eee; background: #fff;"
            >
              <div class="card-body">
                <ul
                  class="list-unstyled mb-0"
                  style="font-size: 16px; line-height: 1.8;"
                >
                  <li class="mb-3 d-flex align-items-start">
                    <span class="text-primary me-3" style="font-size: 18px;"
                    ></span>
                    <span
                      >The National Service Scheme (NSS) is a Central Government
                      program under the Ministry of Youth Affairs and Sports. It
                      provides opportunities for students to engage in voluntary
                      community service, helping them develop their personality
                      and social conscience. NSS was launched in 1969, during
                      the birth centenary year of Mahatma Gandhi.</span
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rts-blog v_1 rts__light rts-section-padding pt--0">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11">
            <div class="rts-section pb--10">
              <h4 class="rts-section-title text-uppercase">Motto</h4>
            </div>
          </div>
        </div>
        <div class="row justify-content-md-center">
          <div class="col-lg-6 col-md-11 mb--10">
            <div
              class="card shadow-sm p-4 h-100"
              style="border-radius: 12px; border: 1px solid #eee; background: #fff;"
            >
              <div class="card-body">
                <ul
                  class="list-unstyled mb-0"
                  style="font-size: 16px; line-height: 1.8;"
                >
                  <li class="mb-3 d-flex align-items-start">
                    <span class="text-primary me-3" style="font-size: 18px;"
                    ></span>
                    <span
                      >The main motto of NSS is "NOT ME BUT YOU", which reflects
                      the essence of democratic living and emphasizes the
                      importance of selfless service. NSS VNRVJIET has its own
                      motto, "Personality Development through Social Service",
                      which signifies that while we serve society, we also shape
                      ourselves.</span
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
          <div class="col-lg-6 col-md-11 mb--10">
            <div
              class="card shadow-sm p-4 h-100"
              style="border-radius: 12px; border: 1px solid #eee; background: #fff;"
            >
              <div class="card-body">
                <ul
                  class="list-unstyled mb-0"
                  style="font-size: 16px; line-height: 1.8;"
                >
                  <li class="mb-3 d-flex align-items-start">
                    <span class="text-primary me-3" style="font-size: 18px;"
                    ></span>
                    <span
                      >The main motto of NSS is "NOT ME BUT YOU", which reflects
                      the essence of democratic living and emphasizes the
                      importance of selfless service. NSS VNRVJIET has its own
                      motto, "Personality Development through Social Service",
                      which signifies that while we serve society, we also shape
                      ourselves.</span
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rts-blog v_1 rts__light rts-section-padding pt--0">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11">
            <div class="rts-section pb--10">
              <h4 class="rts-section-title text-uppercase">Objectives</h4>
            </div>
          </div>
        </div>
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11">
            <div
              class="card shadow-sm p-4 h-100"
              style="border-radius: 12px; border: 1px solid #eee; background: #fff;"
            >
              <div class="card-body">
                <ul
                  class="list-unstyled mb-0"
                  style="font-size: 16px; line-height: 1.8;"
                >
                  <li class="mb-3 d-flex align-items-start">
                    <span class="text-primary me-3" style="font-size: 18px;"
                    ></span>
                    <div
                      class="prose prose-slate max-w-none font-poppins
                      prose-headings:font-poppins prose-headings:text-primary
                      prose-h1:text-3xl prose-h1:font-bold prose-h1:mt-0 prose-h1:mb-6
                      prose-h2:text-2xl prose-h2:font-semibold prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-border prose-h2:pb-2
                      prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-8 prose-h3:mb-3
                      prose-p:text-foreground/85 prose-p:leading-relaxed
                      prose-a:text-primary prose-a:font-medium prose-a:no-underline hover:prose-a:underline
                      prose-ul:my-4 prose-li:my-1 prose-li:text-foreground/85
                      prose-strong:text-foreground prose-strong:font-semibold
                      prose-table:text-sm
                      prose-img:rounded-xl prose-img:shadow-md prose-img:my-6 prose-img:mx-auto prose-img:max-h-[480px] prose-img:w-auto prose-img:object-cover"
                    >
                      <p>
                        The National Service Scheme aims to develop the
                        personality and character of students through community
                        service and social responsibility. The major objectives
                        of NSS are:
                      </p>
                      <ul>
                        <li>
                          To understand the community in which students work and
                          identify its needs and problems.
                        </li>
                        <li>
                          To develop a sense of social and civic responsibility
                          among students.
                        </li>
                        <li>
                          To encourage students to apply their knowledge and
                          skills for the betterment of society.
                        </li>
                        <li>
                          To promote leadership qualities, teamwork, and
                          democratic values among youth.
                        </li>
                        <li>
                          To develop competence required for group living and
                          sharing of responsibilities.
                        </li>
                        <li>
                          To foster national integration, social harmony, and
                          communal unity.
                        </li>
                        <li>
                          To motivate students to participate in community
                          service and nation-building activities.
                        </li>
                        <li>
                          To enhance students' capacity to meet emergencies and
                          natural disasters effectively.
                        </li>
                        <li>
                          To cultivate discipline, empathy, and a spirit of
                          volunteerism among students.
                        </li>
                        <li>
                          To provide opportunities for experiential learning
                          through social outreach and community engagement
                          activities.
                        </li>
                      </ul>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="rts-blog v_1 rts__light rts-section-padding pt--0">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11">
            <div class="rts-section pb--10">
              <h4 class="rts-section-title text-uppercase">
                Programs and Activities
              </h4>
            </div>
          </div>
        </div>
        <div class="row justify-content-md-center">
          <div class="col-lg-6 col-md-11 mb--10">
            <div
              class="card shadow-sm p-4 h-100"
              style="border-radius: 12px; border: 1px solid #eee; background: #fff;"
            >
              <div class="card-body">
                <ul
                  class="list-unstyled mb-0"
                  style="font-size: 16px; line-height: 1.8;"
                >
                  <li class="mb-3 d-flex align-items-start">
                    <span class="text-primary me-3" style="font-size: 18px;"
                    ></span>
                    <span
                      >FIST FULL OF RICE – A grain donation drive to feed the
                      needy in slums, orphanage centers, and old age homes.</span
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
          <div class="col-lg-6 col-md-11 mb--10">
            <div
              class="card shadow-sm p-4 h-100"
              style="border-radius: 12px; border: 1px solid #eee; background: #fff;"
            >
              <div class="card-body">
                <ul
                  class="list-unstyled mb-0"
                  style="font-size: 16px; line-height: 1.8;"
                >
                  <li class="mb-3 d-flex align-items-start">
                    <span class="text-primary me-3" style="font-size: 18px;"
                    ></span>
                    <span
                      >SAARADHI – An initiative where we guide students, invite
                      unsung heroes to share their stories, and spread awareness
                      about sustainable development goals.</span
                    >
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Department Highlights end -->

   <!-- Section 1: Orientation (Image Left, Text Right with Stats & #B71A34 Theme) -->
<section class="rts-mission pt--30 pb--30">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-11">
        <section class="mb--40">
          <div class="row g-4 align-items-center">
            
            <!-- Left Column: Image with White Border and Rounded Corners -->
            <div class="col-lg-5">
              <div class="image-zoom-wrapper" style="overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                <img
                  src="https://media.licdn.com/dms/image/v2/D4D22AQEdn84WYQb-3w/feedshare-shrink_1280/B4DaAGEyMBIAAM-/0/1786808312836?e=1791417600&v=beta&t=KV44pZ_mLUa9JvWyhpuRu1ua2NzOsM88_xmHR_TOKyA"
                  alt="Orientation Vision"
                  style="height: 100%; max-height: 450px; object-fit: cover; width: 100%; display: block;"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <!-- Right Column: Card-like Box with #B71A34 Theme & Stats Layout -->
            <div class="col-lg-7">
              <div class="p-4 p-md-5" style="background: #B71A34; border-radius: 20px; color: #fff; box-shadow: 0 10px 30px rgba(183, 26, 52, 0.25);">
                <div class="row align-items-center">
                  
                  <!-- Main Description Column -->
                  <div class="col-lg-7 mb-4 mb-lg-0" style="border-right: 1px solid rgba(255, 255, 255, 0.2);">
                    <div class="rts-section mb--15">
                      <h2 class="rts-section-title" style="color: #fff; font-size: 2.3rem; font-weight: 700; line-height: 1.2;">
                        Orientation
                      </h2>
                    </div>
                    <p style="color: rgba(255, 255, 255, 0.95); font-size: 1.5rem; line-height: 1.6; margin-bottom: 20px;">
                      Newly recruited volunteers were introduced to the NSS motto 
                      "Not Me But You" and oriented on the values, vision and 
                      activities of Team NSS SRKREC.
                    </p>
                    <a href="#" style="color: #fff; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                      <span>&#8599;</span> Know More
                    </a>
                  </div>

                  <!-- Stats Column (1 Million & 30+) -->
                  <div class="col-lg-5 ps-lg-4">
                    <div class="mb-4">
                      <h3 style="color: #fff; font-size: 2.5rem; font-weight: 800; margin-bottom: 0; line-height: 1;">1 Million</h3>
                      <p style="color: rgba(255, 255, 255, 0.85); font-size: 1.2rem; margin-top: 5px; margin-bottom: 0;">Rural residents benefited</p>
                    </div>
                    <div>
                      <h3 style="color: #fff; font-size: 2.5rem; font-weight: 800; margin-bottom: 0; line-height: 1;">30+</h3>
                      <p style="color: rgba(255, 255, 255, 0.85); font-size: 1.2rem; margin-top: 5px; margin-bottom: 0;">Institutional Participation</p>
                    </div>
                  </div>

                </div>
              </div>
            </div>

          </div>
        </section>
      </div>
    </div>
  </div>
</section>

   <!-- Section 2: Additional Community Service (Text Left, Multiple Images Right) -->
<section class="rts-mission pt--0 pb--30" style="background-color: #ffffff;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-11">
        <section class="mb--40">
          <div class="row g-4 align-items-center">
            
            <!-- Left Column: Text Content & Know More Link -->
            <div class="col-lg-5 order-lg-1 order-2">
              <div class="py-4 pe-lg-4">
                <div class="rts-section mb--15">
                  <h2 class="rts-section-title" style="color: #1a1a1a; font-size: 2.5rem; font-weight: 700; line-height: 1.2;">
                    Community Outreach
                  </h2>
                </div>
                <p style="color: #555555; font-size: 1.5rem; line-height: 1.6; margin-bottom: 25px;">
                  Our volunteers actively participate in rural camps,
                  cleanliness drives, health check-ups, and awareness
                  campaigns to uplift local communities and foster social
                  responsibility.
                </p>
                <a href="#" style="color: #B71A34; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                  <span>&#8599;</span> Know More
                </a>
              </div>
            </div>

            <!-- Right Column: Multiple Images Layout (Matching the Reference Grid) -->
            <div class="col-lg-7 order-lg-2 order-1">
              <div class="row g-3">
                <!-- Top/Single Main or Tall Image (e.g., Robot/Large feature style) -->
                <div class="col-sm-7">
                  <div class="d-flex flex-column gap-3">
                    <div class="image-zoom-wrapper" style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
                      <img
                        src="https://media.licdn.com/dms/image/v2/D4D22AQGkj8mXGy6LzA/feedshare-shrink_800/B4DZ_nBlD2IcAc-/0/1786287379109?e=1791417600&v=beta&t=kaLpMVqO3ji3kTYxj9khW16lvqTUBM4XkkbNYy6ulOk"
                        alt="Community Service 1"
                        style="height: 180px; object-fit: cover; width: 100%; display: block;"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="image-zoom-wrapper" style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
                      <img
                        src="https://media.licdn.com/dms/image/v2/D4D22AQGkj8mXGy6LzA/feedshare-shrink_800/B4DZ_nBlD2IcAc-/0/1786287379109?e=1791417600&v=beta&t=kaLpMVqO3ji3kTYxj9khW16lvqTUBM4XkkbNYy6ulOk"
                        alt="Community Service 2"
                        style="height: 180px; object-fit: cover; width: 100%; display: block;"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                </div>

                <!-- Tall Side Image Column -->
                <div class="col-sm-5">
                  <div class="image-zoom-wrapper h-100" style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
                    <img
                      src="https://media.licdn.com/dms/image/v2/D4D22AQGkj8mXGy6LzA/feedshare-shrink_800/B4DZ_nBlD2IcAc-/0/1786287379109?e=1791417600&v=beta&t=kaLpMVqO3ji3kTLxj9khW16lvqTUBM4XkkbNYy6ulOk"
                      alt="Community Service Feature"
                      style="height: 100%; min-height: 372px; object-fit: cover; width: 100%; display: block;"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
            </div>

          </div>
        </section>
      </div>
    </div>
  </div>
</section>
    <!-- Section 1: Orientation (Text Left, Image Right) -->
    <section class="rts-mission pt--30 pb--30">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-11">
            <section class="mb--40">
              <div class="row g-4 align-items-start">
                <div
                  class="my-auto col-lg-5 rts-scholarship-description d-flex justify-content-center align-items-start flex-column"
                  style="padding-right: 30px;"
                >
                  <div class="rts-section mb--10">
                    <h2 class="rts-section-title">Hands of Hope</h2>
                  </div>
                  <p>
                    An initiative to support the affected families of the fire
                    accident that happened near Pragathi Nagar — volunteers
                    distributed groceries, clothes and daily essentials.
                  </p>
                </div>

                <!-- Zoom-on-hover & Clickable Image -->
                <div class="col-lg-7">
                  <div class="image-zoom-wrapper">
                    <img
                      src="https://media.licdn.com/dms/image/v2/D5622AQGb28HIXb6OVQ/feedshare-shrink_800/B56aAOb74SKEAc-/0/1786948599542?e=1791417600&v=beta&t=rH7u13Ez_8Zlabb8jaCTTovV3Hh6ul4kggpJnu0ALx8"
                      alt="Orientation Vision"
                      style="height: 100%; max-height: 500px; object-fit: cover; width: 100%; border-radius: 12px;"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </section>
    <!-- Fullscreen Image Modal with X mark -->
    <div id="imageModal" class="custom-image-modal">
      <div class="modal-content-wrapper">
        <button
          id="modalCloseBtn"
          class="modal-close-btn"
          aria-label="Close modal">&times;</button
        >
        <img id="modalImage" src="" alt="Enlarged View" />
      </div>
    </div>
    <!-- LinkedIn Call-to-Action Section -->
    <div class="rts-newsletter v_1 rts-cta-background rts__white pt--30 pb--30">
      <div class="container">
        <div class="row">
          <div
            class="d-flex justify-content-center col-lg-12 col-md-12 flex-column align-items-center"
          >
            <div
              class="rts-newsletter-box col-lg-8 col-md-8"
              style="background-image: url(/assets/images/newsletter/bg-1.jpg);"
            >
              <div
                class="rts-newsletter-box-content flex-column d-flex justify-content-start align-items-start"
              >
                <h4 class="newsletter-title">
                  Reach out to NSS — National Service Scheme
                </h4>
                <div class="newsletter-form w-530">
                  <a
                    href="https://www.linkedin.com/in/srkrec-nss-783441371"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="newsletter-title rts-nbg-btn btn-arrow text-decoration-none d-inline-flex align-items-center gap-2 no-hover-effect"
                  >
                    <i class="fa-brands fa-linkedin" style="font-size: 20px;"
                    ></i>
                    <span>Follow on LinkedIn</span>
                    <span>
                      <i class="fa-sharp fa-regular fa-arrow-right"></i>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      /* Completely freeze the button on hover */
      .no-hover-effect,
      .no-hover-effect:hover,
      .no-hover-effect:focus,
      .no-hover-effect:active {
        box-shadow: none !important;
        transform: none !important;
        transition: none !important;
        background-color: inherit !important;
      }
      .no-hover-effect * {
        transition: none !important;
        transform: none !important;
      }
    </style>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      /* Equal-height specialization cards */
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* Zoom on hover styles */
      .image-zoom-wrapper {
        overflow: hidden;
        border-radius: 12px;
        cursor: pointer;
        height: 100%;
        min-height: 300px;
      }

      .image-zoom-wrapper img {
        transition: transform 0.4s ease-in-out;
      }

      .image-zoom-wrapper:hover img {
        transform: scale(1.08);
      }

      /* Modal styling */
      .custom-image-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.85);
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .custom-image-modal.active {
        display: flex;
      }

      .modal-content-wrapper {
        position: relative;
        max-width: 90%;
        max-height: 90vh;
      }

      .modal-content-wrapper img {
        max-width: 100%;
        max-height: 90vh;
        border-radius: 8px;
        display: block;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }

      .modal-close-btn {
        position: absolute;
        top: -15px;
        right: -15px;
        background: #ffffff;
        color: #333333;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        font-size: 26px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        transition:
          background 0.2s,
          transform 0.2s;
        z-index: 10000;
      }

      .modal-close-btn:hover {
        background: #f1f1f1;
        transform: scale(1.1);
      }
    </style>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const zoomWrappers = document.querySelectorAll(".image-zoom-wrapper");
        const modal = document.getElementById("imageModal");
        const modalImg = document.getElementById(
          "modalImage",
        ) as HTMLImageElement | null;
        const closeBtn = document.getElementById("modalCloseBtn");

        // Open modal when any image wrapper is clicked
        zoomWrappers.forEach((wrapper) => {
          wrapper.addEventListener("click", () => {
            const img = wrapper.querySelector("img");
            if (img && modal && modalImg) {
              modalImg.src = img.src;
              modal.classList.add("active");
              document.body.style.overflow = "hidden"; // Prevent background scrolling
            }
          });
        });

        // Close modal function
        const closeModal = () => {
          if (modal) {
            modal.classList.remove("active");
            document.body.style.overflow = "auto"; // Restore scrolling
          }
        };

        // Close when clicking the close button explicitly
        if (closeBtn) {
          closeBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            closeModal();
          });
        }

        // Close when clicking the background backdrop outside the image
        if (modal) {
          modal.addEventListener("click", (event) => {
            if (event.target === modal) {
              closeModal();
            }
          });
        }

        // Close modal on pressing the 'Escape' key
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeModal();
          }
        });
      });
    </script>
  </body>
</html>
