---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';

const pageTitle = "National Service Scheme (NSS)";
const category = "service";
const dept = "Institution-wide / Student Affairs";
const mission = "The National Service Scheme (NSS) at SRKR Engineering College aims to instill the urge for social service in young students and develop their personality through community service. It bridges the gap between the campus and society by engaging students in various social welfare activities, rural development programs, blood donation camps, and environmental awareness drives.";
const advisor = "Dr. K. V. Sarma (Program Officer)";
const joinInfo = "Enrollment opens at the start of the academic year for first and second-year students. Watch out for annual recruitment notifications.";
const clubImg = "/assets/images/clubs/nss_logo.png";

const objectives = [
  "Understand the community in which they work and relate themselves to their community.",
  "Identify the needs and problems of the community and involve themselves in problem-solving processes.",
  "Develop among themselves a sense of social and civic responsibility.",
  "Gain leadership qualities and democratic attitude for cooperative living.",
  "Develop competence required for group-living and sharing of responsibilities."
];
const years = ['2025–26', '2024–25', '2023–24', '2022–23'];

const momentsImages = [
  "/assets/images/clubs/nss-1.jpg",
  "/assets/images/clubs/nss-2.jpg",
  "/assets/images/clubs/nss-3.jpg",
  "/assets/images/clubs/nss-4.jpg",
  "/assets/images/clubs/nss-5.jpg",
  "/assets/images/clubs/nss-6.jpg",
  "/assets/images/clubs/nss-7.jpg",
  "/assets/images/clubs/nss-8.png"
];

const recentEvents = [
  {
    title: "Viksit Bharat Young Leaders Dialogue 2027 – Mass Quiz",
    image: "/assets/images/clubs/nss-1.png",
    description: "SRKR NSS Unit conducted the Viksit Bharat Young Leaders Dialogue 2027 Mass Quiz to engage students and young volunteers in learning about India’s development goals.",
    items: [
      {
        description: "Increased awareness about Viksit Bharat 2047 and India’s development journey.",
        image: "/assets/images/clubs/nss-event-1.jpg"
      },
      {
        description: "Encouraged youth participation in national development initiatives.",
        image: "/assets/images/clubs/nss-event-2.jpg"
      },
      {
        description: "Improved students’ general awareness and knowledge through the quiz.",
        image: "/assets/images/clubs/nss-event-3.jpg"
      },
      {
        description: "Promoted leadership, critical thinking, and active citizenship.",
        image: "/assets/images/clubs/nss-event-4.jpg"
      }
    ]
  },
  {
    title: "Eco-Friendly Ganesh Idol Distribution – 2200+ Idols",
    description: "As part of the Ganesh Chaturthi celebrations, SRKR NSS Unit organized an Eco-Friendly Ganesh Idol Distribution Programme and distributed 2200+ clay Ganesh idols to students and members of the local community. The initiative aimed to encourage the use of eco-friendly idols and promote environmental responsibility during the festival.",
    image: "/assets/images/clubs/nss-event-5.jpg"
  },
  {
    title: "Digital Awareness Program – Day 3",
    description: "As part of Literacy Awareness Week, the SRKR NSS Unit conducted a Digital Awareness Program at ZP High School, Kopalli. The session focused on educating students about the safe and responsible use of digital technology. Awareness was created on cyber crimes, fraud calls, OTP safety, online scams, suspicious loan apps, betting apps, and other digital risks. NSS volunteers interacted with the students and explained the importance of staying alert and responsible while using digital platforms.",
    image: "/assets/images/clubs/nss-event-6.jpg"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`${pageTitle} | Student Clubs | SRKR Engineering College`} 
      description={mission} 
    />
    <style>
      .event-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
        border-radius: 16px;
        border: 1px solid #e3e7f3;
        padding: 16px 0;
        margin-top: 15px;
      }
      .event-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .event-wall .container-fluid {
        position: relative;
        z-index: 1;
      }
      .event-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      }
      .event-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .event-wall__track {
        display: flex;
        width: max-content;
        gap: 20px;
        padding: 6px 12px;
      }
      .event-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(85vw, 420px);
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
      }
      .event-wall-card__photo {
        width: 100%;
        height: 230px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      .event-wall-card__text {
        text-align: left;
        font-size: 14.5px;
        line-height: 1.6;
        color: #334155;
        margin: 0;
      }
      /* Uniform styling for moments cards with fixed image height */
      .moment-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(75vw, 280px);
        flex: 0 0 auto;
        padding: 10px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .moment-card__photo {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Life @ SRKR</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Student Clubs</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB END -->

    <!-- MAIN CONTENT -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row g-5">
          <!-- Main Content Column -->
          <div class="col-lg-8">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-4">About Club</h3>
              <p style="text-align: justify; font-size: 16px; line-height: 1.8;" class="mb-5">
                {mission}
              </p>

              <div class="border-top my-4"></div>

              <!-- Objectives Section -->
              <div class="rts-scholarship-description mb-5">
                <h4 class="font-32 mb-4"><i class="fa-sharp fa-light fa-bullseye-arrow me-2" style="color: var(--rt-primary);"></i> Objectives</h4>
                <ul class="list-unstyled one-column-list">
                  {objectives.map((obj) => (
                    <li class="mb-3 d-flex align-items-start">
                      <i class="fa-solid fa-circle-check me-3 mt-1" style="color: var(--rt-primary); font-size: 14px;"></i>
                      <span style="font-size: 15px; line-height: 1.6;">{obj}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recent Events / Accordion Details -->
              <div class="rts-scholarship-description mb-4">
                <h4 class="font-32 mb-4"><i class="fa-sharp fa-light fa-sparkles me-2" style="color: var(--rt-primary);"></i> Recent Highlights</h4>
                <div class="program-credit-area faq rts-scholarship-description">
                  <div class="program-accordion">
                    <div class="accordion" id="club-events-nss">
                      {recentEvents.map((evt, idx) => (
                        <div class="accordion-item">
                          <button 
                            class={`accordion-button ${idx > 0 ? '' : ''}`} 
                            type="button" 
                            data-bs-toggle="collapse" 
                            data-bs-target={`#evt-collapse-${idx}`} 
                            aria-expanded={idx === 0 ? 'false' : 'false'}
                          >
                            {evt.title}
                          </button>
                          <div 
                            id={`evt-collapse-${idx}`} 
                            class={`accordion-collapse collapse ${idx === 0 ? '' : ''}`} 
                            data-bs-parent="#club-events-nss"
                          >
                            <div class="accordion-body">
                              {evt.items ? (
                                <div class="event-wall">
                                  <div class="container-fluid px-0">
                                    <div class="event-wall__ticker" data-ticker>
                                      <div class="event-wall__track">
                                        {evt.items.map((subItem) => (
                                          <article class="event-wall-card">
                                            <img 
                                              class="event-wall-card__photo"
                                              src={subItem.image} 
                                              alt={evt.title} 
                                              loading="lazy" 
                                              decoding="async" 
                                            />
                                            <p class="event-wall-card__text">
                                              {subItem.description}
                                            </p>
                                          </article>
                                        ))}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              ) : (
                                <div class="row g-4 align-items-center">
                                  <div class="col-lg-7 rts-scholarship-description">
                                    <p style="text-align: justify; font-size: 15px; line-height: 1.7;" class="mb-0">
                                      {evt.description}
                                    </p>
                                  </div>
                                  <div class="col-lg-5">
                                    <img 
                                      src={evt.image} 
                                      alt={evt.title} 
                                      style="height: 100%; min-height: 220px; object-fit: cover; width: 100%; border-radius: 8px;" 
                                      loading="lazy" 
                                      decoding="async" 
                                    />
                                  </div>
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
 <!-- Full Width Moments & Highlights Section (Placed Below Recent Highlights spanning entire container width) -->
        <div class="row mt-5">
          <div class="col-12">
            <div class="rts-scholarship-description">
              <h4 class="font-32 mb-4"><i class="fa-sharp fa-light fa-images me-2" style="color: var(--rt-primary);"></i> Moments & Highlights</h4>
              <div class="event-wall">
                <div class="container-fluid px-0">
                  <div class="event-wall__ticker" data-ticker>
                    <div class="event-wall__track">
                      {momentsImages.map((imgSrc, idx) => (
                        <div class="moment-card">
                          <img 
                            class="moment-card__photo"
                            src={imgSrc} 
                            alt={`Moment ${idx + 1}`} 
                            loading="lazy" 
                            decoding="async" 
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="col-lg-4">
            <div class="card shadow-sm p-4 border-0" style="background-color: #f8fafc; border-radius: 12px; position: sticky; top: 100px;">
              <!-- Club Thumbnail -->
              <div class="cat-thumb mb-4 overflow-hidden" style="border-radius: 0; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1;">
                <img 
                  src={clubImg} 
                  alt={pageTitle} 
                  class="img-fluid" 
                  style="object-fit: contain; max-height: 100%; max-width: 100%;" 
                  loading="lazy" 
                  decoding="async" 
                />
              </div>

              <h4 class="h5 mb-4 border-bottom pb-2" style="color: var(--rt-primary);">Club Details</h4>

              <ul class="list-unstyled mb-4">
                <li class="mb-3 d-flex justify-content-between">
                  <strong class="text-muted">Category:</strong>
                  <span class="text-capitalize badge text-white py-2 px-3" style="background-color: var(--rt-primary);">{category}</span>
                </li>
                <li class="mb-3 d-flex justify-content-between align-items-center">
                  <strong class="text-muted">Scope/Dept:</strong>
                  <span class="fw-semibold">{dept}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">Faculty Advisor:</strong>
                  <span class="fw-semibold text-dark"><i class="fa-regular fa-user-tie me-2" style="color: var(--rt-primary);"></i> {advisor}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">How to Join:</strong>
                  <span style="font-size: 14px; line-height: 1.5;" class="text-secondary d-block">{joinInfo}</span>
                </li>
              </ul>

              <!-- Social Links -->
              <div class="mt-4 border-top pt-3 mb-4">
                <strong class="text-muted d-block mb-2">Connect with Us:</strong>
                <div class="d-flex gap-3" style="font-size: 20px;">
                  <a href="https://www.srkrec.ac.in" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="College Website">
                    <i class="fa-regular fa-globe"></i>
                  </a>
                  <a href="https://www.instagram.com/srkr_engineering_college" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                  </a>
                  <a href="https://www.linkedin.com/school/srkr-engineering-college/" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                  </a>
                  <a href="https://www.youtube.com/@srkreclive8303" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="YouTube">
                    <i class="fa-brands fa-youtube"></i>
                  </a>
                </div>
              </div>

            </div>
            <div class="row g-5 justify-content-center justify-content-start align-items-center mt--10 rts-multi-row-section">
          
          <div class="col-12">
            <div class="rts-multi-row-content pl--10">
              <h4 class="row-title">Archives</h4>
              <div class="program-list">
                {years.map(year => (
                  <a href={`/assets/documents/civil-placements-${year.replace('–', '-')}.pdf`} class="program-item" target="_blank">
                    <span>{year} <i class="fa-regular fa-chevron-right"></i></span> <span>PDF</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
          </div>
          
        </div>

       

      </div>
    </div>

    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const tickers = document.querySelectorAll('[data-ticker]');
        tickers.forEach((ticker) => {
          const track = ticker.querySelector('.event-wall__track');
          if (!track) return;

          let paused = false;
          let lastTime = 0;

          const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

          const step = (time) => {
            if (!lastTime) lastTime = time;
            const delta = time - lastTime;
            lastTime = time;

            // Only scroll if the element is visible (has a clientWidth greater than 0)
            if (!paused && ticker.clientWidth > 0) {
              ticker.scrollLeft += delta * 0.05;
              const maxScroll = getMaxScroll();
              if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
                ticker.scrollLeft = 0;
              }
            }

            window.requestAnimationFrame(step);
          };

          ticker.addEventListener('mouseenter', () => {
            paused = true;
          });

          ticker.addEventListener('mouseleave', () => {
            paused = false;
            lastTime = 0;
          });

          // Watch for visibility/size changes (e.g. when accordion expands)
          const observer = new ResizeObserver(() => {
            lastTime = 0;
          });
          observer.observe(ticker);

          window.requestAnimationFrame(step);
        });
      })();
    </script>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>