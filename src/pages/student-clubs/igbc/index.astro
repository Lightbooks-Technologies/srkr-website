---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';

const pageTitle = "Indian Green Building Council (IGBC)";
const category = "Technical";
const dept = "Department of Civil Engineering";
const mission = "The primary objective of the Indian Green Building Council (IGBC) is to encourage, foster, and enable the creation of eco-friendly, sustainable buildings and a sustainable built environment across India.";
const advisor = "Dr. T. Vamsi Naga Raju";
const joinInfo = "Membership and student chapter enrollment open at the beginning of the academic year. Watch out for chapter recruitment and orientation notifications.";
const clubImg = "/assets/images/clubs/igbc-logo.png";

const objectives = [
  "Promote Environmental Sustainability: Encourage design practices that conserve natural resources, reduce energy and water consumption, and minimize waste generation.",
  "Integrate Architecture and Nature: Combine ancient Indian architectural principles with modern technological innovations based on the five elements of nature (Panchabhutas).",
  "Enhance Occupant Comfort and Health: Focus on indoor environmental quality, proper ventilation, and non-toxic materials to boost the health, well-being, and productivity of building occupants.",
  "Develop Rating and Certification Programs: Formulate consensus-driven rating systems (such as for new buildings, factories, campuses, and residential societies) to evaluate and certify green structures.",
  "Transform Market and Supply Chains: Encourage the use of certified green building materials, equipment, and eco-friendly products through dedicated lifecycle assessments.",
  "Drive Global Leadership: Position India as one of the global leaders in a sustainable built environment by uniting industry stakeholders, government bodies, and international agencies like the World Green Building Council."
];

const years = ['2025–26'];

const momentsImages = [
  "/assets/images/clubs/igbc1.jpg",
  "/assets/images/clubs/igbc2.jpg",
  "/assets/images/clubs/igbc3.jpg",
  "/assets/images/clubs/igbc4.png",
  "/assets/images/clubs/igbc5.png",
  "/assets/images/clubs/igbc6.png",
  "/assets/images/clubs/igbc7.png",
  "/assets/images/clubs/igbc8.png",
];

const recentEvents = [
  {
    title: "Soil Health Matters",
    description: "The IGBC of SRKR Engineering College (A), Bhimavaram, Andhra Pradesh, organized an expert talk titled “Soil Health Matters” on 5th December 2025, in view of World Soil Day.",
    image: "/assets/images/clubs/igbc1.jpg",
    items: [
      {
        description: "The IGBC of SRKR Engineering College (A), Bhimavaram, Andhra Pradesh, organized an expert talk titled “Soil Health Matters” on 5th December 2025, in view of World Soil Day.",
        image: "/assets/images/clubs/igbc1.jpg"
      },
      {
        description: "Expert insights and student interactions emphasizing ecological balance, soil conservation, and agricultural sustainability on World Soil Day.",
        image: "/assets/images/clubs/igbc2.jpg"
      },
      {
        description: "Expert insights and student interactions emphasizing ecological balance, soil conservation, and agricultural sustainability on World Soil Day.",
        image: "/assets/images/clubs/igbc3.jpg"
      }
    ]
  },
  {
  title: "Materials Science to Materials Sustainability",
  description: "The IGBC of SRKR Engineering College (A), Bhimavaram, in association with the Department of Civil Engineering, organized an interactive technical session titled “Materials Science to Materials Sustainability” on 11th December 2025.",
  image: "/assets/images/clubs/igbc4.png",
  items: [
    {
      description: "Interactive technical session organized by IGBC SRKREC in association with the Department of Civil Engineering on December 11, 2025.",
      image: "/assets/images/clubs/igbc4.png"
    },
    {
      description: "Explored key principles and practical methodologies for transitioning from conventional materials science to sustainable engineering practices.",
      image: "/assets/images/clubs/igbc5.png"
    },
    {
      description: "Highlighted eco-friendly construction materials, lifecycle performance, and modern sustainable building technologies.",
      image: "/assets/images/clubs/igbc6.png"
    },
    {
      description: "Examined case studies and real-world implementations demonstrating the environmental impact of sustainable material choices.",
      image: "/assets/images/clubs/igbc7.png"
    },
    {
      description: "Facilitated active student participation and dynamic Q&A discussions on future innovations in green civil engineering.",
      image: "/assets/images/clubs/igbc8.png"
    }
  ]
}
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`${pageTitle} | Student Clubs | SRKR Engineering College`} 
      description={mission} 
    />
    <style>
      .event-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
        border-radius: 16px;
        border: 1px solid #e3e7f3;
        padding: 16px 0;
        margin-top: 15px;
      }
      .event-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .event-wall .container-fluid {
        position: relative;
        z-index: 1;
      }
      .event-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      }
      .event-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .event-wall__track {
        display: flex;
        width: max-content;
        gap: 20px;
        padding: 6px 12px;
      }
      .event-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(85vw, 420px);
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
      }
      .event-wall-card__photo {
        width: 100%;
        height: 230px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 14px;
      }
      .event-wall-card__text {
        text-align: left;
        font-size: 14.5px;
        line-height: 1.6;
        color: #334155;
        margin: 0;
      }
      .moment-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(75vw, 280px);
        flex: 0 0 auto;
        padding: 10px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .moment-card__photo {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Life @ SRKR</a></li>
                <li class="breadcrumb-item"><a href="/student-clubs">Student Chapters</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB END -->

    <!-- MAIN CONTENT -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row g-5">
          <!-- Main Content Column -->
          <div class="col-lg-8">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-4">About the Body</h3>
              <p style="text-align: justify; font-size: 16px; line-height: 1.8;" class="mb-5">
                {mission}
              </p>

              <div class="border-top my-4"></div>

              <!-- Objectives Section -->
              <div class="rts-scholarship-description mb-5">
                <h3 class="mb-4"><i class="fa-sharp fa-light fa-bullseye-arrow me-2" style="color: var(--rt-primary);"></i> Objectives</h3>
                <ul class="list-unstyled one-column-list">
                  {objectives.map((obj) => (
                    <li class="mb-3 d-flex align-items-start">
                      <i class="fa-solid fa-circle-check me-3 mt-1" style="color: var(--rt-primary); font-size: 14px;"></i>
                      <span style="font-size: 15px; line-height: 1.6;">{obj}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recent Events / Accordion Details -->
              <div class="rts-scholarship-description mb-4">
                <h3 class="mb-4"><i class="fa-sharp fa-light fa-sparkles me-2" style="color: var(--rt-primary);"></i> Recent Highlights</h3>
                <div class="program-credit-area faq rts-scholarship-description">
                  <div class="program-accordion">
                    <div class="accordion" id="club-events-igbc">
                      {recentEvents.map((evt, idx) => (
                        <div class="accordion-item">
                          <button 
                            class="accordion-button" 
                            type="button" 
                            data-bs-toggle="collapse" 
                            data-bs-target={`#evt-collapse-${idx}`} 
                            aria-expanded={idx === 0 ? 'true' : 'false'}
                          >
                            {evt.title}
                          </button>
                          <div 
                            id={`evt-collapse-${idx}`} 
                            class={`accordion-collapse collapse ${idx === 0 ? 'show' : ''}`} 
                            data-bs-parent="#club-events-igbc"
                          >
                            <div class="accordion-body">
                              {evt.items ? (
                                <div class="event-wall">
                                  <div class="container-fluid px-0">
                                    <div class="event-wall__ticker" data-ticker>
                                      <div class="event-wall__track">
                                        {[...evt.items, ...evt.items, ...evt.items, ...evt.items].map((subItem) => (
                                          <article class="event-wall-card">
                                            {subItem.image && (
                                              <img 
                                                class="event-wall-card__photo"
                                                src={subItem.image} 
                                                alt={evt.title} 
                                                loading="lazy" 
                                                decoding="async" 
                                              />
                                            )}
                                            <p class="event-wall-card__text">
                                              {subItem.description}
                                            </p>
                                          </article>
                                        ))}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              ) : (
                                <div class="row g-4 align-items-center">
                                  <div class={evt.image ? "col-lg-7 rts-scholarship-description" : "col-lg-12 rts-scholarship-description"}>
                                    <p style="text-align: justify; font-size: 15px; line-height: 1.7;" class="mb-0">
                                      {evt.description}
                                    </p>
                                  </div>
                                  {evt.image && (
                                    <div class="col-lg-5">
                                      <img 
                                        src={evt.image} 
                                        alt={evt.title} 
                                        style="height: 100%; max-height: 220px; min-height: 200px; object-fit: cover; width: 100%; border-radius: 8px;" 
                                        loading="lazy" 
                                        decoding="async" 
                                      />
                                    </div>
                                  )}
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Full Width Moments & Highlights Section -->
              <div class="row mt-5">
                <div class="col-12">
                  <div class="rts-scholarship-description">
                    <h3 class="mb-4"><i class="fa-sharp fa-light fa-images me-2" style="color: var(--rt-primary);"></i> Moments & Highlights</h3>
                    <div class="event-wall">
                      <div class="container-fluid px-0">
                        <div class="event-wall__ticker" data-ticker>
                          <div class="event-wall__track">
                            {momentsImages.map((imgSrc, idx) => (
                              <div class="moment-card">
                                <img 
                                  class="moment-card__photo"
                                  src={imgSrc} 
                                  alt={`Moment ${idx + 1}`} 
                                  loading="lazy" 
                                  decoding="async" 
                                />
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Sidebar Column -->
          <div class="col-lg-4">
            <div class="card shadow-sm p-4 border-0" style="background-color: #f8fafc; border-radius: 12px; position: sticky; top: 100px;">
              <!-- Club Thumbnail -->
              <div class="cat-thumb mb-4 overflow-hidden" style="border-radius: 0; background: #fff; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1;">
                <img 
                  src={clubImg} 
                  alt={pageTitle} 
                  class="img-fluid" 
                  style="object-fit: contain; max-height: 100%; max-width: 100%;" 
                  loading="lazy" 
                  decoding="async" 
                />
              </div>

              <h3 class="h5 mb-4 border-bottom pb-2" style="color: var(--rt-primary);">Chapter Details</h3>

              <ul class="list-unstyled mb-4">
                <li class="mb-3 d-flex justify-content-between">
                  <strong class="text-muted">Category:</strong>
                  <span class="text-capitalize badge text-white py-2 px-3" style="background-color: var(--rt-primary);">{category}</span>
                </li>
                <li class="mb-3 d-flex justify-content-between align-items-center">
                  <strong class="text-muted">Scope/Dept:</strong>
                  <span class="fw-semibold">{dept}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">Faculty Advisor:</strong>
                  <span class="fw-semibold text-dark"><i class="fa-regular fa-user-tie me-2" style="color: var(--rt-primary);"></i> {advisor}</span>
                </li>
                <li class="mb-3">
                  <strong class="text-muted d-block mb-1">How to Join:</strong>
                  <span style="font-size: 14px; line-height: 1.5;" class="text-secondary d-block">{joinInfo}</span>
                </li>
              </ul>

              <!-- Social Links -->
              <!-- <div class="mt-4 border-top pt-3 mb-4">
                <strong class="text-muted d-block mb-2">Connect with Us:</strong>
                <div class="d-flex gap-3" style="font-size: 20px;">
                  <a href="https://igbc.in" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="IGBC National Website">
                    <i class="fa-regular fa-globe"></i>
                  </a>
                  <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                  </a>
                  <a href="https://www.linkedin.com/school/srkr-engineering-college/" target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary);" title="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                  </a>
                </div>
              </div>

            </div> -->

            <div class="row g-5 justify-content-center justify-content-start align-items-center mt--10 rts-multi-row-section">
              <div class="col-12">
                <div class="rts-multi-row-content pl--10">
                  <h3 class="row-title">Archives</h3>
                  <div class="program-list">
                    {years.map(year => (
                      <a href={`/assets/documents/igbc/${year.replace('–', '-')}.pdf`} class="program-item" target="_blank">
                        <span>{year} <i class="fa-regular fa-chevron-right"></i></span> <span>PDF</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const tickers = document.querySelectorAll('[data-ticker]');
        tickers.forEach((ticker) => {
          const track = ticker.querySelector('.event-wall__track');
          if (!track) return;

          let paused = false;
          let lastTime = 0;

          const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

          const step = (time) => {
            if (!lastTime) lastTime = time;
            const delta = time - lastTime;
            lastTime = time;

            if (!paused && ticker.clientWidth > 0) {
              ticker.scrollLeft += delta * 0.05;
              const maxScroll = getMaxScroll();
              if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
                ticker.scrollLeft = 0;
              }
            }

            window.requestAnimationFrame(step);
          };

          ticker.addEventListener('mouseenter', () => {
            paused = true;
          });

          ticker.addEventListener('mouseleave', () => {
            paused = false;
            lastTime = 0;
          });

          const observer = new ResizeObserver(() => {
            lastTime = 0;
          });
          observer.observe(ticker);

          window.requestAnimationFrame(step);
        });
      })();
    </script>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>