---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = "Institution Development Plan";

const pillars = [
  {
    id: 'idpGovernance',
    title: 'Governance Enablers',
    items: [
      'Institutional structures and policy strengthening',
      'Quality assurance and accreditation systems',
      'Stakeholder inclusion and participative governance',
      'Alignment with societal and regional development needs',
      'Transparency, accountability, and digital governance mechanisms'
    ]
  },
  {
    id: 'idpFinancial',
    title: 'Financial Enablers &amp; Funding Models',
    items: [
      'Transparent budgeting and financial governance',
      'Sustainable revenue generation and resource optimization',
      'Scholarships, fellowships, and stakeholder financial assistance',
      'Industry, alumni, and consultancy-based funding support',
      'Endowment and corpus fund development initiatives'
    ]
  },
  {
    id: 'idpAcademic',
    title: 'Academic Enablers',
    items: [
      'Future-ready and industry-oriented curriculum design',
      'Employability, skill development, and experiential learning',
      'Curriculum integration with emerging technologies and SDGs',
      'Academic Bank of Credit (ABC) implementation and awareness',
      'Continuous curriculum updates aligned with global trends'
    ]
  },
  {
    id: 'idpResearchEnablers',
    title: 'Research &amp; Intellectual Property Enablers',
    items: [
      'Quality research promotion and publication support',
      'Patent filing, IPR awareness, and commercialization initiatives',
      'Innovation ecosystem with incubation and startup mentoring',
      'Externally funded projects and interdisciplinary collaborations',
      'Centres of Excellence and advanced research infrastructure'
    ]
  },
  {
    id: 'idpHumanResources',
    title: 'Human Resources &amp; Supportive Facilitative Enablers',
    items: [
      'Transparent recruitment and competency-based hiring',
      'Faculty and staff training, leadership, and skill enhancement',
      'Performance management with KPI-based evaluation systems',
      'Student mentoring, counselling, and wellbeing initiatives',
      'Inclusive, service-oriented, and supportive institutional culture'
    ]
  },
  {
    id: 'idpNetworking',
    title: 'Networking &amp; Collaboration Enablers',
    items: [
      'Alumni engagement and strategic partnership development',
      'Collaborations with higher education institutions globally',
      'Industry networking for internships, consultancy, and innovation',
      'Community outreach and societal engagement programs',
      'Knowledge-sharing through conferences, workshops, and exchange programs'
    ]
  },
  {
    id: 'idpPhysical',
    title: 'Physical Enablers',
    items: [
      'Green and sustainable campus infrastructure development',
      'Smart classrooms, renewable energy, and eco-friendly initiatives',
      'Sports excellence and holistic student fitness facilities',
      'Modern hostels and integrated residential support systems',
      'Campus-wide healthcare, wellness, and recreational infrastructure'
    ]
  },
  {
    id: 'idpDigitalEnablers',
    title: 'Digital Enablers',
    items: [
      'AI-driven e-governance and digital administration systems',
      'Dynamic website and stakeholder interaction platforms',
      'Digital libraries, MOOCs, and adaptive learning ecosystems',
      'Smart Wi-Fi campus with IoT-enabled connectivity',
      'Cybersecurity, data privacy, and digital governance frameworks'
    ]
  }
];

const roadmap = [
  { period: '2025–27', focus: 'Foundation', items: [
    'Strengthen governance, IQAC systems, and transparent institutional processes',
    'Introduce industry-aligned, interdisciplinary, and skill-based curricula',
    'Expand digital infrastructure with ERP, LMS, Wi-Fi, and e-governance initiatives',
    'Promote innovation awareness, incubation support, and faculty research training',
    'Enhance green campus initiatives, student wellness, and community outreach programs'
  ]},
  { period: '2027–30', focus: 'Acceleration', items: [
    'Establish Centres of Excellence, interdisciplinary research labs, and innovation hubs',
    'Increase funded research projects, patents, consultancy, and startup incubation support',
    'Strengthen international collaborations, industry partnerships, and alumni engagement',
    'Implement AI-enabled digital learning ecosystems and data-driven governance systems',
    'Expand sustainable infrastructure, smart classrooms, and student-centric support services'
  ]},
  { period: '2030–35', focus: 'Global Leadership', items: [
    'Position SRKR as a globally recognized multidisciplinary institution with international rankings',
    'Develop advanced incubation centres, technology commercialization, and global innovation networks',
    'Achieve a sustainable, AI-driven smart campus with net-zero and resilient infrastructure',
    'Build globally competitive academic programs with lifelong learning and immersive digital education',
    'Strengthen societal impact through sustainable development, inclusivity, and regional transformation initiatives'
  ]}
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Strategic Institution Development Plan of SRKR Engineering College — pillars and roadmap (2025-35)." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/">Institute</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Outcome metrics funfact -->
    <div class="rts-funfact v_2 stroke pt--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">8</h2>
                <p>Strategic Enablers</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">2035</h2>
                <p>Long-range Horizon</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">8+</h2>
                <p>Centres of Excellence Powering R&amp;D</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">

        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
          <div class="col-lg-8 col-md-11">
            <div class="program-about mb--40">
              <h4 class="title">A Vision for the Next Decade</h4>
              <p>The Institution Development Plan (IDP) sets SRKR Engineering College's roadmap to evolve from a regional autonomous institution into a nationally benchmarked, research-intensive engineering college — anchored in academic rigour, sustainable infrastructure and strong industry engagement.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="idp-accordion">
                  {pillars.map((p, i) => (
                    <div class="accordion-item">
                      <button class={`accordion-button ${i === 0 ? '' : 'collapsed'}`} type="button" data-bs-toggle="collapse" data-bs-target={`#${p.id}`} aria-expanded={i === 0 ? 'true' : 'false'} set:html={p.title}></button>
                      <div id={p.id} class={`accordion-collapse collapse ${i === 0 ? 'show' : ''}`} data-bs-parent="#idp-accordion">
                        <div class="accordion-body">
                          <ul class="list-unstyled">
                            {p.items.map((it) => (
                              <li class="si__list--single">{it}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">
              <div class="program-curriculum">
                <h6 class="heading-title">Related Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/vision"><span><i class="fa-light fa-arrow-right"></i></span>Vision &amp; Mission</a></li>
                    <li><a href="/iqac"><span><i class="fa-light fa-arrow-right"></i></span>IQAC &amp; AQAR Reports</a></li>
                    <li><a href="/vitals"><span><i class="fa-light fa-arrow-right"></i></span>Institute Vitals</a></li>
                    <li><a href="/governing"><span><i class="fa-light fa-arrow-right"></i></span>Governing Body</a></li>
                    <li><a href="https://srkrec.ac.in/nirf.php" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>NIRF Data</a></li>
                    <li><a href="https://srkrec.ac.in/naac.php" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>NAAC Mandates</a></li>
                  </ul>
                </div>
              </div>
              <div class="program-info">
                <h5>IDP Custodian</h5>
                <p>Office of the Principal in coordination with IQAC and Dean, R&amp;D.</p>
                <a class="rts-theme-btn mt--10" href="/assets/files/idp.pdf">Download IDP (PDF)</a>
                {/* TODO: upload final IDP PDF to /assets/documents/institute-development-plan.pdf */}
              </div>
            </div>
          </div>
        </div>

        <div class="row mt--60">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Roadmap · 2025 → 2035</h3>
          </div>
        </div>
        <div class="row g-4">
          {roadmap.map((r) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm">
                <div class="card-body">
                  <h5 class="card-title">{r.period} · {r.focus}</h5>
                  <ul class="list-unstyled mb--0">
                    {r.items.map((it) => (
                      <li class="si__list--single">{it}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>



      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
