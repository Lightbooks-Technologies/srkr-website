---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = "MoUs & Collaborations";


---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description={`SRKR Engineering College institutional MoUs and collaborations with academic, industry, government and international partners.`} />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <div class="rts-campus-life rts-section-padding pb--40">
      <div class="container">
        <div class="row">
          <div class="campus-life">
            <div class="campus-life__content">
              <h1 class="rts-section-title">Partnerships that Power Research &amp; Learning.</h1>
              <p class="description w-680">
                SRKR's institutional MoUs span IITs and global universities, marquee industry partners, central / state government agencies and international research projects &mdash; bringing real-world relevance into classrooms and labs.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stat funfact bar -->
    <div class="rts-funfact v_3">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 col-xl-10">
            <div class="rts-funfact-wrapper justify-content-center">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">50+</h2>
                <p>Active MoUs</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar only -->
    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
          <!-- Sidebar -->
          <div class="col-lg-8 col-md-11">
            <div class="program-sidebar">

              <div class="program-curriculum">
                <h6 class="heading-title">Inside Research</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/research-overview/"><span><i class="fa-light fa-arrow-right"></i></span>Research Overview</a></li>
                    <li><a href="/research-projects/"><span><i class="fa-light fa-arrow-right"></i></span>Research Projects</a></li>
                    <li><a href="/research-committees/"><span><i class="fa-light fa-arrow-right"></i></span>Research Committees</a></li>
                    <li><a href="/iic/"><span><i class="fa-light fa-arrow-right"></i></span>IIC</a></li>
                    <li><a href="/ipr-cell/"><span><i class="fa-light fa-arrow-right"></i></span>IPR Cell</a></li>
                    <li><a href="/entrepreneurship-cell/"><span><i class="fa-light fa-arrow-right"></i></span>EDC</a></li>
                  </ul>
                </div>
              </div>

              <div class="program-curriculum mt--30">
                <h6 class="heading-title">Partner Portals</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="https://nptel.ac.in" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>NPTEL</a></li>
                    <li><a href="https://spoken-tutorial.org" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>Spoken Tutorial</a></li>
                    <li><a href="https://www.netacad.com" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>CISCO Networking Academy</a></li>
                    <li><a href="https://www.3ds.com" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>Dassault Systèmes</a></li>
                    <li><a href="https://www.msme.gov.in" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>Ministry of MSME</a></li>
                    <li><a href="https://www.aicte-india.org" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>AICTE</a></li>
                    <li><a href="https://iic.mic.gov.in" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>MoE IIC</a></li>
                    <li><a href="https://bhuvan.nrsc.gov.in" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>NRSC Bhuvan</a></li>
                  </ul>
                </div>
              </div>

              <div class="program-curriculum mt--30">
                <h6 class="heading-title">Downloads</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    {/* TODO: replace with real PDF once register is published */}
                    <li><a href="/assets/documents/srkr-mou-register.pdf"><span><i class="fa-light fa-arrow-right"></i></span>SRKR MoU Register (PDF)</a></li>
                  </ul>
                </div>
              </div>

              <div class="program-info">
                <h5>For New Partnerships</h5>
                <p>Office of the Principal<br>SRKR Engineering College, Bhimavaram</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:principal@srkrec.ac.in">principal@srkrec.ac.in</a>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
