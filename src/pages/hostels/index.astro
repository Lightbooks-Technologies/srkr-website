--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hostel-swiper {
        padding: 15px 0 !important;
      }
      .hostel-swiper .swiper-slide {
        padding: 10px !important;
      }
      .hostel-swiper .testimonial-item-image {
        height: 300px !important;
        background: #fff;
        border-radius: 12px !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
        overflow: hidden;
        border: 1px solid #eee;
      }
      .hostel-swiper img {
        height: 100% !important;
        width: 100% !important;
        object-fit: cover !important;
        border-radius: 0 !important;
      }
    </style>
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
<section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                    </ul>
                    <h1 class="section-title">Hostels</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
    <!-- Organogram -->
    <!-- Testimonial Start -->
    <div class="rts-testimonial v_2 rt-relative pt--120 pb--120">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-section text-center mb--45">
                        <h2 class="rts-section-title">Hostels
                        </h2>
                        <p style="text-align: justify;">Hostel facilities on campus for students are well-designed to provide a comfortable living experience. Necessary facilities for learning and recreation are provided in the hostel blocks. All measures are taken to ensure that the campus is a safe and secure place for students to stay. Wardens ensure that the students are attended to. They regularly provide students with medical and other essential support. Strict compliance is adhered to ensure that the campus follows the “No Ragging” ethos.</p>
                        <p style="text-align: justify;">Life on campus helps students not only study but also socialize with their peers. Friendships formed on the campus last a lifetime. Students living on campus are encouraged to use the gymnasium, playground, and all indoor gaming facilities.</p>

                    </div>
                </div>
            </div>

            <!-- Hostel Administration -->
            <div class="row mb--50">
                <div class="col-12">
                    <h3 class="rts-section-title mb--30" style="font-size: 1.6rem;">Hostel Administration</h3>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle" style="font-size: 0.95rem;">
                            <thead style="background: #890C25; color: #fff;">
                                <tr>
                                    <th style="padding: 12px 16px;">Name</th>
                                    <th style="padding: 12px 16px;">Designation</th>
                                    <th style="padding: 12px 16px;">Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 10px 16px;">Dr. K. Kishore Raju</td>
                                    <td style="padding: 10px 16px;">Associate Professor (IT)</td>
                                    <td style="padding: 10px 16px;">Chief Warden</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 16px;">Dr. A. V. S. Surya Varma</td>
                                    <td style="padding: 10px 16px;">Assistant Professor (ECE)</td>
                                    <td style="padding: 10px 16px;">Warden – Boys Hostels</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 16px;">Dr. V. Nagavalli</td>
                                    <td style="padding: 10px 16px;">Associate Professor (ECE)</td>
                                    <td style="padding: 10px 16px;">Warden – Girls Hostels</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 16px;">Dr. I. Swetha Monica</td>
                                    <td style="padding: 10px 16px;">Assistant Professor (EEE)</td>
                                    <td style="padding: 10px 16px;">Warden – Girls Hostels</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 16px;">Ms. J. S. S. L. Bharani</td>
                                    <td style="padding: 10px 16px;">Assistant Professor (EEE)</td>
                                    <td style="padding: 10px 16px;">Warden – Girls Hostels</td>
                                </tr>
                                <tr>
                                    <td style="padding: 10px 16px;">Ms. P. D. S. S. Lakshmi Kumari</td>
                                    <td style="padding: 10px 16px;">Assistant Professor (IT)</td>
                                    <td style="padding: 10px 16px;">Warden – Girls Hostels</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Hostel Office / Contact Us -->
            <div class="row mb--50">
                <div class="col-12">
                    <h3 class="rts-section-title mb--25" style="font-size: 1.6rem;">Hostel Office</h3>
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 border rounded d-flex align-items-center gap-3" style="background:#fff3f5; border-color:#f5c2cb !important;">
                                <i class="fa-light fa-phone" style="font-size:1.4rem; color:#890C25;"></i>
                                <div>
                                    <div style="font-size:0.78rem; color:#888; text-transform:uppercase; letter-spacing:0.5px;">Chief Warden</div>
                                    <div style="font-weight:600; color:#2b3d4f;">8074874235</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 border rounded d-flex align-items-center gap-3" style="background:#fff3f5; border-color:#f5c2cb !important;">
                                <i class="fa-light fa-phone" style="font-size:1.4rem; color:#890C25;"></i>
                                <div>
                                    <div style="font-size:0.78rem; color:#888; text-transform:uppercase; letter-spacing:0.5px;">Boys Hostel</div>
                                    <div style="font-weight:600; color:#2b3d4f;">9492123311</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 border rounded d-flex align-items-center gap-3" style="background:#fff3f5; border-color:#f5c2cb !important;">
                                <i class="fa-light fa-phone" style="font-size:1.4rem; color:#890C25;"></i>
                                <div>
                                    <div style="font-size:0.78rem; color:#888; text-transform:uppercase; letter-spacing:0.5px;">Girls Hostel</div>
                                    <div style="font-weight:600; color:#2b3d4f;">7995383711</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="p-3 border rounded d-flex align-items-center gap-3" style="background:#fff3f5; border-color:#f5c2cb !important;">
                                <i class="fa-light fa-envelope" style="font-size:1.4rem; color:#890C25;"></i>
                                <div>
                                    <div style="font-size:0.78rem; color:#888; text-transform:uppercase; letter-spacing:0.5px;">Email</div>
                                    <a href="mailto:hostels@srkrec.ac.in" style="font-weight:600; color:#890C25; text-decoration:none;">hostels@srkrec.ac.in</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- testimonial content -->
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-testimonial-box">
                        <div class="testimonial-item rt-flex">
                            
                            <div class="testimonial-item-content rt-relative" style="width: 100%;">
                                <div class="hostel-swiper swiper-container">
                                    <div class="swiper-wrapper">
                                        <!-- single slide -->
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/banner/hostel1.jpg" alt="Hostel Block 1" loading="lazy" decoding="async">
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/banner/hostel2.jpg" alt="Hostel Block 2" loading="lazy" decoding="async">
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/banner/hoatel3.jpg" alt="Hostel Block 3" loading="lazy" decoding="async">
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/banner/hostel4.jpg" alt="Hostel Facilities" loading="lazy" decoding="async">
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/banner/hostel5.jpg" alt="Hostel Rooms" loading="lazy" decoding="async">
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                <div class="swiper-pagination"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Testimonial end -->
    



    <!-- footer -->
    <SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        new Swiper('.hostel-swiper', {
          slidesPerView: 1,
          spaceBetween: 20,
          loop: true,
          autoplay: {
            delay: 3500,
            disableOnInteraction: false,
          },
          pagination: {
            el: '.swiper-pagination',
            clickable: true
          },
          breakpoints: {
            640: {
              slidesPerView: 2,
            },
            1024: {
              slidesPerView: 3,
            }
          }
        });
      });
    </script>

</body>

</html>