---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
import OffCanvas from "../../components/OffCanvas.astro";
import { departments } from "../../data/departments";

const pageTitle = "Institute Vitals";

const naacCycles = [
  {
    cycle: "Cycle 1",
    grade: "A",
    cgpa: "3.60",
    from: "19.02.2016",
    to: "18.02.2022",
    href: "/assets/documents/mandates/nacc1.pdf",
  },
  {
    cycle: "Cycle 1 (Extension)",
    grade: "A",
    cgpa: "3.60",
    from: "19.02.2022",
    to: "31.12.2022",
    href: "/assets/documents/mandates/nacc2.pdf",
  },
  {
    cycle: "Cycle 2",
    grade: "A+",
    cgpa: "3.42",
    from: "20.12.2022",
    to: "19.12.2027",
    href: "/assets/documents/mandates/nacc3.pdf",
  },
];

const nirfYears = [
  {
    year: 2026,
    links: [
      {
        label: "Overall",
        href: "/assets/documents/mandates/NIRF_2026_overall.pdf",
      },
      {
        label: "Engineering",
        href: "/assets/documents/mandates/NIRF_2026_engineering.pdf",
      },
      {
        label: "Innovation",
        href: "/assets/documents/mandates/NIRF_2026_innovation.pdf",
      },
    ],
  },
  {
    year: 2025,
    links: [
      {
        label: "Overall",
        href: "/assets/documents/mandates/NIRF_2025_overall.pdf",
      },
      {
        label: "Engineering",
        href: "/assets/documents/mandates/NIRF_2025_engineering.pdf",
      },
      {
        label: "Innovation",
        href: "/assets/documents/mandates/NIRF_2025_innovation.pdf",
      },
      {
        label: "SDG",
        href: "/assets/documents/mandates/NIRF_2025_sdg.pdf",
      },
    ],
  },
  {
    year: 2024,
    links: [
      {
        label: "Overall",
        href: "/assets/documents/mandates/NIRF_2024_overall.pdf",
      },
      {
        label: "Engineering",
        href: "/assets/documents/mandates/NIRF_2024_engineering.pdf",
      },
      {
        label: "Innovation",
        href: "/assets/documents/mandates/NIRF_2024_innovation.pdf",
      },
    ],
  },
  {
    year: 2023,
    links: [
      {
        label: "Overall",
        href: "/assets/documents/mandates/NIRF_2023_overall.pdf",
      },
      {
        label: "Engineering",
        href: "/assets/documents/mandates/NIRF_2023_engineering.pdf",
      },
    ],
  },
];

const approvals = [
  {
    name: "UGC",
    desc: "Autonomous status since 2016",
    href: "/vitals/ugc/",
  },
  {
    name: "AICTE",
    desc: "All UG/PG programmes approved by AICTE",
    href: "/vitals/aicte/",
  },
  {
    name: "JNTUK",
    desc: "Affiliated to Jawaharlal Nehru Technological University, Kakinada",
    href: "/vitals/jntuk/",
  },
  {
    name: "NBA",
    desc: "Multiple programmes accredited by the National Board of Accreditation",
    href: "/vitals/nba/",
  },
  {
    name: "NAAC",
    desc: "A+ Grade with CGPA 3.42 (Cycle 2)",
    href: "/vitals/naac/",
  },
  {
    name: "IQAC",
    desc: "Internal Quality Assurance Cell",
    href: "/vitals/iqac/",
  },
  {
    name: "SIRO",
    desc: "Recognised as Scientific & Industrial Research Organisation by DSIR",
    href: "/vitals/siro/",
  },
  {
    name: "NIRF",
    desc: "Participates in MoE NIRF rankings since 2023",
    href: "/vitals/nirf/",
  },
];

const facts = [
  { k: "Established", v: "1980" },
  { k: "Affiliation", v: "JNTUK, Kakinada" },
  { k: "Type", v: "Autonomous Engineering College" },
  { k: "Campus", v: "30 Acres, Bhimavaram, AP" },
  { k: "UG Engineering Programs", v: "12 B.Tech" },
  { k: "PG Programs", v: "8 M.Tech" },
  { k: "Recognised Research Centres", v: "Multiple under JNTUK" },
  { k: "Centres of Excellence", v: "8+" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="Institute vitals at a glance — NAAC, NBA, NIRF, AICTE, JNTUK, SIRO statistics and admission codes for SRKR Engineering College."
    />
  </head>
  <body>
    <SrkrHeader />

    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/">Institute</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Big headline funfact -->
    <div class="rts-funfact v_2 stroke pt--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">46+</h2>
                <p>Years of Excellence (Est. 1980)</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">A+</h2>
                <p>NAAC Grade · CGPA 3.42</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">12</h2>
                <p>UG Engineering Programs</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary funfact: research/facilities -->
    <div class="rts-funfact v_2 stroke pt--40">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">8+</h2>
                <p>Centres of Excellence</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">30 Acres</h2>
                <p>Green Campus</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">6</h2>
                <p>NBA-Accredited Programs</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="rts-campus-section rts-section-padding">
      <div class="container">
        <!-- Quick facts -->
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title pt_sm--30">Quick Facts</h3>
          </div>
        </div>
        <div class="row g-4">
          {
            facts.map((f) => (
              <div class="col-lg-3 col-md-6">
                <div class="card h-100 shadow-sm">
                  <div class="card-body">
                    <h5 class="card-title">{f.k}</h5>
                    <p class="card-text">{f.v}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>


        <!-- Approvals & accreditations grid -->
        <div class="row mt--80">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Approvals &amp; Accreditations</h3>
          </div>
        </div>
        <div class="row g-4">
          {
            approvals.map((a) => (
              <div class="col-lg-3 col-md-6">
                <div class="card h-100 shadow-sm">
                  <div class="card-body">
                    <h5 class="card-title">{a.name}</h5>
                    <p class="card-text">{a.desc}</p>
                    <a
                      class="rts-theme-btn"
                      href={a.href}
                    >
                      View Details
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

      
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
