---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
import OffCanvas from "../../components/OffCanvas.astro";

const pageTitle = "NBA Accreditation Status";
const activePage = "NBA";

const menuItems = [
  { name: "UGC", href: "/vitals/ugc/" },
  { name: "AICTE", href: "/vitals/aicte/" },
  { name: "JNTUK", href: "/vitals/jntuk/" },
  { name: "NBA", href: "/vitals/nba/" },
  { name: "NAAC", href: "/vitals/naac/" },
  { name: "IQAC", href: "/vitals/iqac/" },
  { name: "SIRO", href: "/vitals/siro/" },
  { name: "NIRF", href: "/vitals/nirf/" },
];

const nbaAccreditations = [
  {
    title: "NBA Accreditation (2023-24 to 2025-26)",
    desc: "National Board of Accreditation status letters for qualifying programs",
    href: "/assets/documents/mandates/nba2.pdf",
  },
  {
    title: "NBA Accreditation (2020-21 to 2022-23)",
    desc: "National Board of Accreditation status letters for the previous cycle",
    href: "/assets/documents/mandates/nba1.pdf",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="National Board of Accreditation (NBA) letters and accreditation status for programs at SRKR Engineering College."
    />
  </head>
  <body>
    <SrkrHeader />

    <!-- Breadcrumb -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/vitals/">Vitals</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">
        <div class="row justify-content-center g-5">
          <!-- Main Content -->
          <div class="col-lg-8">
            <div class="program-about mb--40">
              <h3 class="title">National Board of Accreditation (NBA)</h3>
              <p>
                Sagi Rama Krishnam Raju Engineering College takes immense pride in maintaining high educational and process standards. Multiple undergraduate programs in engineering (including CSE, ECE, EEE, Mechanical, Civil, and IT) are periodically accredited by the National Board of Accreditation (NBA) in recognition of outcome-based education system implementation, industry-aligned curricula, and exceptional learning resources.
              </p>
            </div>

            <!-- NBA Letters List -->
            <div class="card shadow-sm border-0">
              <div class="card-body p-4">
                <h4 class="card-title mb-4"><i class="fa-solid fa-ribbon me-2" style="color: var(--rt-primary);"></i> NBA Accreditation Documents</h4>
                <div class="list-group list-group-flush">
                  {
                    nbaAccreditations.map((n) => (
                      <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                          <h6 class="mb-1 text-dark">{n.title}</h6>
                          <p class="mb-0 text-muted small">{n.desc}</p>
                        </div>
                        <a
                          href={n.href}
                          class="rts-theme-btn"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <i class="fa-light fa-download me-1"></i> Download PDF
                        </a>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="col-lg-4">
            <div class="program-sidebar">
              <div class="program-curriculum">
                <h6 class="heading-title">Vitals Quick Links</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    {
                      menuItems.map((item) => (
                        <li class={item.name === activePage ? "active" : ""}>
                          <a href={item.href}>
                            <span><i class="fa-light fa-arrow-right"></i></span>
                            {item.name}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
