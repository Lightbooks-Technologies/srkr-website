--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Time Tables (2023-24 Sem I)</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- admission page content -->
    <div class="rts-page-content rts-section-padding">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="admission-content-top">
                        

                        <div class="requirement-deadline">
                            <h4 class="rts-subsection-title">2023-24 Sem I Downloads</h4>
                            <div class="requirement-deadline__content">
                                <ul>
                                    <li class="single-requirement">
                                        <a href="https://srkrec.edu.in/files/TIMETABLES/II_B.TECH_I_SEM_2023_24.pdf">II B.Tech (All Branches) Sem I Time Tables</a> </a>
                                    </li>
                                    <li class="single-requirement">
                                        <a href="https://srkrec.edu.in/files/TIMETABLES/III_B.TECH_I_SEM_2023_24.pdf">III B.Tech (All Branches) Sem I Time Tables</a> </a>
                                    </li>
                                    <li class="single-requirement">
                                        <a href="https://srkrec.edu.in/files/TIMETABLES/IV_B.TECH_I_SEM_2023_24.pdf">IV B.Tech (All Branches) Sem I Time Tables</a></a>
                                    </li>
                                    
                                </ul>
                            </div>
                        </div>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- admission page content end -->
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->


    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>