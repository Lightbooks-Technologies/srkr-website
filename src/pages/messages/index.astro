            </div>
            <div class="col-lg-2 col-md-6 col-sm-6">
                <div class="footer__widget">
                    <h6 class="footer__widget--title">Resources</h6>
                    <div class="footer__widget--menu">
                        <ul>
                            <li><a href="faculty.html">Faculty</a></li>
                            <li><a href="tution-fee.html">Tuition & Fees</a></li>
                            <li><a href="scholarship.html">Scholarships</a></li>
                            <li><a href="alumni.html">Alumni</a></li>
                            <li><a href="contact.html">Contact</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="footer__widget">
                    <h6 class="footer__widget--title">Apply Now</h6>
                    <div class="footer__widget--button">
                        <a href="admission.html" class="cta__button active">Start Your Application</a>
                        <a href="scholarship.html" class="cta__button">Explore Scholarships</a>
                    </div>
