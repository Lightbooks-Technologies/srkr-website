--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Research Centers and Resources</li>
                        </ul>
                        <h1 class="section-title">Research Centers and Resources</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- Scholarship content -->
    <div class="rts-scholarship pt--20">
        <div class="container">
            <div class="rts-scholarship-description">
                <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
                    <div class="col-lg-10 col-md-11">
                        <div class="program-description-area">
                            <!-- scholarship requirement -->
                            <!-- si = scholarship-information -->
                            <div class="si">
                                <h4 class="title">JNTUK-Approved Centers
                                </h4>
                                <p>
                                    The following Departments are the recognized Research Centers and Resources of the Jawaharlal Nehru Technological University Kakinada, Kakinada (JNTUK) offering Ph.D. programs:
                                </p>
                                <div class="si__list">
                                    <ul class="list-unstyled">
                                        <li class="si__list--single">
                                            Department of Civil Engineering
                                        </li>
                                        <li class="si__list--single">
                                            Department of Computer Science and Engineering
                                        </li>
                                        <li class="si__list--single">
                                            Department of Electronics and Communication Engineering
                                        </li>
                                        <li class="si__list--single">
                                            Department of Electrical and Electronics Engineering
                                        </li>
                                        <li class="si__list--single">
                                            Department of Information Technology
                                        </li>
                                        <li class="si__list--single">
                                            Department of Mechanical Engineering
                                        </li>
                                        <li class="si__list--single">
                                            Department of Mathematics
                                        </li>
                                        <li class="si__list--single">
                                            Department of Chemistry
                                        </li>
                                        <li class="si__list--single">
                                            Department of Physics
                                        </li>
                                        <li class="si__list--single">
                                            Department of English
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- faq -->
                            <div class="program-credit-area faq mt--50">
                                <div class="program-accordion">
                                    <div class="accordion" id="rts-accordion">
                                        <div class="accordion-item">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                                Admission to Research Program:
                                            </button>
                                            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#rts-accordion">
                                                <div class="accordion-body">
                                                    <p>
                                                        Admissions will be made to Full-Time (Regular research scholars) Ph.D. research programs offered by the J N T University Kakinada every year.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                                Eligibility:
                                            </button>
                                            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#rts-accordion">
                                                <div class="accordion-body">
                                                    <p>
                                                        B.Tech. and M.Tech in appropriate / relevant branch of Engineering (Candidates must have Post Graduate degree in concerned discipline with a minimum of 55% of marks in aggregate in the qualifying examination as per above eligibility. For SC / ST / BC candidates the aggregate shall be 50% as per UGC-2016 guidelines).
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                                Mode of Selection:
                                            </button>
                                            <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#rts-accordion">
                                                <div class="accordion-body">
                                                    <p>Based on the performance in Entrance Examination conducted by JNTUK and Interview performance including the due weightage to percentage of marks obtained in undergraduate and postgraduate qualifying examinations.</p>
                                                    <p>The candidates who qualify the UGC-NET / UGC CSIR NET/ SLET / GATE / GPAT / Teacher Fellowship conducted by Govt., who passed M.Phil program, and other tests as per UGC-2016 guidelines are not required to take the written test conducted by the JNT University Kakinada. However, they should appear for the interview as per schedule, which will be displayed in the JNTUK website.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- program content end -->
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>