            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="footer__widget">
                    <h6 class="footer__widget--title">Apply Now</h6>
                    <div class="footer__widget--button">
                        <a href="admission.html" class="cta__button active">Start Your Application</a>
                        <a href="scholarship.html" class="cta__button">Explore Scholarships</a>
