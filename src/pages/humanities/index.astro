--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Department of English and Foreign Languages</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- about university -->
    <section class="rts-about-university pt--100 pb--80">
        <div class="container">
            <div class="row">
                <div class="rts-section">
                    <div class="col-lg-4 col-md-3 col-sm-12">
                        <h3 class="rts-section-title">Language & Career Excellence Hub</h3>
                    </div>
                    <div class="col-lg-8 col-md-9 col-sm-12">
                        <p class="rts-section-description">
                            The department, known for its strong academic focus, excels in English and foreign language education while offering top-tier placement training. It also leads in personality development and career programs, along with coaching for GRE, TOEFL, IELTS, and DUOLINGO tests.
                        </p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="academic-picture">
                        <img src="/assets/images/feature/academic-1.jpg" alt="academic" width="1290" height="600">
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- about university end -->

    <!-- multi row item -->
    <div class="rts-multi-row-section pt--100">
        <div class="container">
            <!-- first -->
            <div class="row g-5 justify-content-center justify-content-start align-items-center">
                <div class="col-lg-7 col-md-11">
                    <div class="rts-multi-row-image">
                        <img src="/assets/images/feature/multi-1.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                    </div>
                </div>
                <div class="col-lg-5 col-md-11">
                    <div class="rts-multi-row-content">
                        <h4 class="row-title">Dr. Bh V N Lakshmi M.A., M.Phil., Ph.D, TESOL,
                            Professor & Head</h4>
                        <p>HoD’s Message: Empowering Articulation
                            As the scriptures say, the harmony between speech and meaning is key to impactful communication. Our faculty is dedicated to helping students develop strong articulation and confidence for both professional and personal success. Excel and thrive in the verbal energy of our campus!</p>
                        
                    </div>
                </div>
            </div>
            <!-- second -->
            <div class="row g-5 justify-content-center justify-content-start align-items-center">
                <div class="col-lg-5 col-md-11">
                    <div class="rts-multi-row-content left-side">
                        <h3 class="row-title">Facilities:</h3>
                        <div class="program-list">
                            <a  class="program-item"><span>M.Tech (CAD/CAM) - 2 Years </span> </a>
                            <a  class="program-item"><span>M.Tech (CAD/CAM) - 2 Years </span> </a>
                            <a  class="program-item"><span>M.Tech (CAD/CAM) - 2 Years </span> </a>
                            <a  class="program-item"><span>M.Tech (Structural Engineering) - 2 Years </span> </a>
                            <a  class="program-item"><span>M.Tech (Communication Systems) - 2 Years </span> </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7 col-md-11">
                    <div class="rts-multi-row-image">
                        <img src="/assets/images/feature/multi-2.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>
            <!-- third -->
            <div class="row g-5 justify-content-center justify-content-start align-items-center">
                <div class="col-lg-7 col-md-11">
                    <div class="rts-multi-row-image">
                        <img src="/assets/images/feature/multi-3.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                    </div>
                </div>
                <div class="col-lg-5 col-md-11">
                    <div class="rts-multi-row-content">
                        <div class="program-list">
                            <div class="single-list">
                                <div class="rts-multi-row-content left-side">
                                    <div class="rts-multi-row-content left-side">
                                        <h3 class="row-title">Activities:</h3>
                                        <div class="program-list">
                                            <a class="program-item"><span>CRT (Campus Recruitment Training)</span></a>
                                            <a class="program-item"><span>Soft Skills Training</span></a>
                                            <a class="program-item"><span>Personality Development Training</span></a>
                                            <a class="program-item"><span>Coaching for Higher Education</span></a>
                                            <a class="program-item"><span>Business English Certificate (BEC), Conferences, Workshops, Counselling, Community Outreach</span></a>
                                        </div>
                                    </div>
                                    
                                </div>
                                </div>
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-5 justify-content-center justify-content-start align-items-center">
                <div class="col-lg-5 col-md-11">
                    <div class="rts-multi-row-content left-side">
                        <div class="single-list">
                            <h4 class="row-title">Clubs</h4>
                            <p>S.R.K.R. Toastmasters: Master Orator Championship</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7 col-md-11">
                    <div class="rts-multi-row-image">
                        <img src="/assets/images/feature/multi-4.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>
            <div class="row g-5 justify-content-center justify-content-start align-items-center">

            <div class="col-lg-7 col-md-11">
                <div class="rts-multi-row-image">
                    <img src="/assets/images/feature/multi-5.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                </div>
            </div>
            <div class="col-lg-5 col-md-11">
                <div class="rts-multi-row-content">
                    <div class="program-list">
                        <div class="single-list">
                            <div class="rts-multi-row-content left-side">
                                <div class="rts-multi-row-content left-side">
                                    <h4 class="row-title">Professional Bodies</h4>
                                    <div class="program-list">
                                        <p>English Language Teachers’ Association of India (ELT@I), Godavari Chapter</p>
                                    </div>
                                </div>
                                
                            </div>
                            </div>
                        
                    </div>
                </div>
            </div>
            </div>
            <div class="row g-5 justify-content-center justify-content-start align-items-center">
                <div class="col-lg-5 col-md-11">
                    <div class="rts-multi-row-content left-side">
                        <div class="single-list">
                            <h4 class="row-title">CELLs</h4>
                            <p>Pychological Counselling cell (PCC)</p>
                            <p>Women Empowerment cell (WEC)</p> 
                        </div>
                    </div>
                </div>
                <div class="col-lg-7 col-md-11">
                    <div class="rts-multi-row-image">
                        <img src="/assets/images/feature/multi-6.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>
            
            </div>
            <div class="row pt--100 pb--100 g-5 justify-content-center justify-content-start align-items-center">

                <div class="col-lg-7 col-md-11">
                    <div class="rts-multi-row-image">
                        <img src="/assets/images/feature/multi-7.jpg" alt="undergraduate education" loading="lazy" decoding="async">
                    </div>
                </div>
                <div class="col-lg-5 col-md-11">
                    <div class="rts-multi-row-content">
                        <div class="program-list">
                            <div class="single-list">
                                <div class="rts-multi-row-content left-side">
                                    <div class="rts-multi-row-content left-side">
                                        <h4 class="row-title">Others</h4>
                                        <div class="program-list">
                                            <p>Campus Chronicle: 4-monthly campus newsletter</p>
                                        </div>
                                    </div>
                                    
                                </div>
                                </div>
                            
                        </div>
                    </div>
                </div>
                </div>
        </div>
    </div>
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>