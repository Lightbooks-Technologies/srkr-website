--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
<section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                    </ul>
                    <h1 class="section-title">R&D Cell</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
    <!-- campus life -->
    <div class="rts-campus-life rts-section-padding pb--40">
        <div class="container">
            <div class="row">
                <div class="campus-life">
                    <div class="campus-life__content">
                        <h1 class="rts-section-title">Research and Development Cell</h1>
                        <p style="text-align: justify; margin-bottom: 20px;">
                            SRKR Engineering College (SRKREC) has been at the forefront of research and development (R&D), addressing pressing societal needs through focused efforts in diverse verticals such as IoT, Artificial Intelligence, Sustainable Materials, Energy Transition, Drone Technologies, Deep Technology, and Sustainable Infrastructure.
                        </p>
                        <p style="text-align: justify; margin-bottom: 30px;">
                            Recent years, the college has witnessed a significant surge in research activities, supported by various government-funded projects. These projects, sanctioned by prominent agencies, underscore the institution's commitment to impactful research and innovation. The outcome of these endeavors includes a remarkable number of high-impact publications in reputed journals, elevating the college's research profile on national and international platforms. In addition to research output, SRKREC hosts Centres of Excellence (CoEs) that foster capacity building among faculty, enable hands-on student training, and support student mini projects. These CoEs drive product development, encourage high-quality publications, and promote effective technology transfer to nearby rural communities. They serve as catalysts for societal impact by bridging advanced technological innovations with grassroots needs, contributing to sustainable regional growth. Through its relentless pursuit of excellence in R&D, the institution continues to make significant strides in solving real-world challenges while nurturing a culture of innovation and societal responsibility.
                        </p>

                        <h4 class="mb--20">R&D Cell Objectives</h4>
                        <div class="si">
                            <div class="si__list">

                                <ul style="list-style-type: disc; padding-left: 1.5rem; margin-bottom: 0; text-align: justify;">
                                    <li class="si__list--single">Promote a strong research culture by encouraging faculty and students to engage in high-quality research.</li>
                                    <li class="si__list--single">Enhance research capacity and competence through continuous skill development in research methodology, scientific writing, intellectual property rights (IPR), and ethics in research.</li>
                                    <li class="si__list--single">Facilitate and guide externally funded research projects by identifying funding opportunities from national and international agencies.</li>
                                    <li class="si__list--single">Strengthen industry–academia and institutional collaborations to translate research outcomes into practical solutions, consultancy services, technology transfer, and commercialization.</li>
                                    <li class="si__list--single">Support interdisciplinary and multidisciplinary research initiatives, including emerging areas such as sustainability, climate change, artificial intelligence, and deep technology.</li>
                                    <li class="si__list--single">Promote student-centric research and innovation by integrating research into curricula, supporting final-year projects, internships, fellowships, and participation in national and international research programs and hackathons.</li>
                                    <li class="si__list--single">Align research activities with national priorities and global goals, including the Sustainable Development Goals (SDGs), the National Education Policy (NEP) 2020, and mission-oriented research initiatives.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- campus life end -->

    <!-- funfact -->

    <div class="rts-funfact v_3">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-lg-12 col-xl-10">
                    <div class="    rts-funfact-wrapper justify-content-sm-between">
                        <div class="single-cta-item max-w-sm-100">
                            <h2 class="single-cta-item__title">Idea Cafe</h2>
                            <p style="text-align: justify;">To encourage creativity, innovation, and early-stage entrepreneurship among students. This cafe is driven by the R&D Cell and the Entrepreneurship Development Cell.</p>
                        </div>
                        <div class="single-cta-item max-w-sm-100">
                            <h2 class="single-cta-item__title">IPR Cell</h2>
                            <p style="text-align: justify;">To foster innovation by creating awareness, guiding faculty/students on patenting, and protecting new inventions.</p>
                        </div>
                        <div class="single-cta-item max-w-sm-100">
                            <h2 class="single-cta-item__title">Climate Cell</h2>
                            <p style="text-align: justify;">To plan, coordinate, and drive sustainability and climate action initiatives across the campus.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- funfact end-->

    <!-- single section end -->

    <!-- research enterprise end -->

    <!-- reasearch area -->
    <section class="rts-research-section rts-section-padding">
        <div class="container">
            <div class="row">
                <!-- research item -->
                <div class="research__items">
                    <!-- apply content -->
                    <div class="row justify-content-sm-center justify-content-md-start g-5">
                        <div class="col-lg-4 col-md-6 col-sm-11">
                            
                            <div class="research-procedure">
                                <div class="research-image">
                                    <img src="/assets/images/apply/01.jpg" alt="application-thumb" loading="lazy" decoding="async">
                                </div>
                                <div class="rt-serial">01</div>
                                <!-- <div class="icon">
                                    <img src="/assets/images/icon/14.svg" alt="" loading="lazy" decoding="async">
                                </div> -->
                                <a href="#">Research That Matters</a>
                                <p>We solve real-world problems using emerging technologies.</p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-sm-11">
                            <div class="research-procedure primary-style">
                                <div class="research-image">
                                    <img src="/assets/images/apply/02.jpg" alt="application-thumb" loading="lazy" decoding="async">
                                </div>
                                <div class="rt-serial">02</div>
                                        <!-- <div class="icon">
                                            <img src="/assets/images/icon/15.svg" alt="" loading="lazy" decoding="async">
                                        </div> -->
                                <a href="#">Centers of Excellence</a>
                                <p>Innovation hubs connect research with hands-on learning.</p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-sm-11">
                            <div class="research-procedure">
                                <div class="research-image">
                                    <img src="/assets/images/apply/03.jpg" alt="application-thumb" loading="lazy" decoding="async">
                                </div>
                                <div class="rt-serial">03</div>
                                <!-- <div class="icon">
                                    <img src="/assets/images/icon/16.svg" alt="" loading="lazy" decoding="async">
                                </div> -->
                                <a href="#">Recognized Worldwide</a>
                                <p>Our work is published in top international journals.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- research text -->
                <div class="research__text">
                    <div class="research__text--single">
                        <h5 class="rts-section-title">High-Impact Publications</h5>
                        <p class="description">Hundreds of papers in leading international journals every year.</p>
                    </div>
                    <div class="research__text--single">
                        <h5 class="rts-section-title">Government-Funded Innovation</h5>
                        <p class="description">Multiple funded projects from DRDO, DST, AICTE, and others.</p>
                    </div>
                    <div class="research__text--single">
                        <h5 class="rts-section-title">Grassroots Tech Outreach</h5>
                        <p class="description">Rural communities benefit from our hands-on innovation programs.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- reasearch area end-->


    <!-- footer -->
    <SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>