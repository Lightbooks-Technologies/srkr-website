---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import OffCanvas from "../../components/OffCanvas.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->

    <!-- BREADCRUMB AREA -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcrumb-height-full breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb-2.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                  Excellence
                </li>
              </ul>
              <h1 class="section-title">Centres Of Excellence</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- content -->
    <div class="rts-faculty-details rts-section-padding">
      <div class="container">
        <div class="row justify-content-md-center g-0">
          <div class="rts-section mb--60 text-center">
            <h3 class="rts-section-title">Centres of Excellence</h3>
              <p class="description w-680">
              SRKREC has established multiple Centres of Excellence (CoEs) to
              promote innovation, interdisciplinary research, and skill
              development in emerging technologies. These centres act as dynamic
              platforms for faculty capacity building, hands-on student
              training, and the execution of student mini projects and product
              development initiatives. They foster a strong research culture by
              encouraging high-quality publications, industry collaboration, and
              effective technology transfer to nearby rural communities. The
              CoEs play a vital role in bridging advanced technological
              innovations with grassroots societal needs, thereby contributing
              to sustainable regional development and societal well-being.
              Through continuous efforts in research, development, and
              innovation, SRKREC nurtures a culture of creativity,
              problem-solving, and social responsibility while addressing
              real-world challenges through impactful technological solutions.
            </p>
          </div>

          <!-- Column 1 -->
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg1.jpg" alt="" />
              </div>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Embedded Systems and Internet of Things
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Centre of Excellence in Drone Technologies
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
               
              </ul>
            </div>
          </div>

          <!-- Column 2 -->
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item v__2">
              <div class="program__single--item--bg">
                <img
                  src="/assets/images/program/program__bg2.jpg"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Cyber Physical Systems
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Artificial Intelligence
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Quantum Technologies
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
             
              </ul>
            </div>
          </div>

          <!-- Column 3 -->
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img
                  src="/assets/images/program/program__bg3.jpg"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <ul class="program__single--item--list">
                 <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Solar Energy
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Water Environment and Technology
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="#" class="link__list"
                    >Sustainability
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
               
            
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- footer -->
    <SrkrFooter />

    <!-- footer copyright end -->

    <!-- offcanvase menu -->
    <!-- header style two -->
    <div id="side-bar" class="side-bar">
      <button class="close-icon-menu"><i class="far fa-times"></i></button>
      <!-- inner menu area desktop start -->
      <div class="inner-main-wrapper-desk">
        <div class="thumbnail">
          <img
            src="/assets/images/logo/srkr-logo.png"
            alt="SRKR Engineering College"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="inner-content">
          <p class="disc">
            Apply to SRKR – Start your journey with excellence.
          </p>
          <!-- offcanvase banner -->
          <div class="offcanvase__banner mt--50">
            <div class="offcanvase__banner--content">
              <img
                src="/assets/images/offcanvase.jpg"
                alt="offcanvase"
                loading="lazy"
                decoding="async"
              />
              <a href="/admission-brochure/" class="rts-theme-btn">Apply Now</a>
            </div>
          </div>
          <div class="offcanvase__info">
            <div class="offcanvase__info--content">
              <a href="tel:+919848823332"
                ><span><i class="fa-sharp fa-light fa-phone"></i></span>+91
                9848823332</a
              >
              <a href="#"
                ><span><i class="fa-sharp fa-light fa-location-dot"></i></span
                >SRKR Marg, China Amiram, Bhimavaram, A.P, India - 534204</a
              >
              <div class="offcanvase__info--content--social">
                <p class="title">Follow Us:</p>
                <div class="social__links">
                  <a href="#"><i class="fa-brands fa-facebook"></i></a>
                  <a href="#"><i class="fa-brands fa-instagram"></i></a>
                  <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                  <a href="#"><i class="fa-brands fa-youtube"></i></a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- mobile menu area start -->
      <div class="mobile-menu-main">
        <nav class="nav-main mainmenu-nav mt--30">
          <ul class="mainmenu metismenu" id="mobile-menu-active">
            <li class="has-droupdown">
              <a href="#" class="main">Homepages</a>
              <ul class="submenu mm-collapse">
                <li><a class="mobile-menu-link" href="/">Home Style One</a></li>
                <li><a class="mobile-menu-link" href="/">Home Style Two</a></li>
                <li>
                  <a class="mobile-menu-link" href="/">Home Style Three</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/">Home Style Four</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/">Home Style Five</a>
                </li>
              </ul>
            </li>
            <li class="has-droupdown">
              <a href="#" class="main">Pages</a>
              <ul class="submenu mm-collapse">
                <li>
                  <a class="mobile-menu-link" href="/college-profile/"
                    >About Us</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/sports/">Athletics</a>
                </li>
                <li class="has-dropdown third-lvl">
                  <a href="javascript:void(0);">Faculty</a>
                  <ul class="submenu third-lvl base">
                    <li>
                      <a class="mobile-menu-link" href="/departments/"
                        >Faculty</a>
                    </li>
                    <li>
                      <a class="mobile-menu-link" href="/departments/"
                        >Faculty Details</a>
                    </li>
                    <li>
                      <a class="mobile-menu-link" href="/departments/"
                        >Faculty</a>
                    </li>
                    <li>
                      <a class="mobile-menu-link" href="/departments/"
                        >Faculty Staff details</a>
                    </li>
                  </ul>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/research-overview/"
                    >Research</a>
                </li>
              </ul>
            </li>
            <li class="has-droupdown">
              <a href="#" class="main">Academics</a>
              <ul class="submenu mm-collapse">
                <li>
                  <a class="mobile-menu-link" href="/programmes/">Academic</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/admission-brochure/"
                    >Admission</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/programmes/"
                    >Academic Area</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/activities/"
                    >Campus Life</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/fee/">Scholarship</a>
                </li>
                <li><a class="mobile-menu-link" href="/fee/">Tution Fee</a></li>
                <li>
                  <a class="mobile-menu-link" href="/prominent-alumni/"
                    >Alumni</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/programmes/"
                    >Program Single</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/departments/"
                    >Department Details</a>
                </li>
              </ul>
            </li>

            <li class="has-droupdown">
              <a href="#" class="main">Events</a>
              <ul class="submenu mm-collapse">
                <li>
                  <a class="mobile-menu-link" href="/activities/">Event</a>
                </li>
                <li>
                  <a class="mobile-menu-link" href="/activities/"
                    >Event Details</a>
                </li>
              </ul>
            </li>
            <li class="has-droupdown">
              <a href="#" class="main">Blog</a>
              <ul class="submenu mm-collapse">
                <li><a class="mobile-menu-link" href="/">Blog</a></li>
                <li><a class="mobile-menu-link" href="/">Blog Grid</a></li>
                <li><a class="mobile-menu-link" href="/">Blog List</a></li>
                <li><a class="mobile-menu-link" href="/">Blog Details</a></li>
              </ul>
            </li>
            <li>
              <a href="/quick-links/" class="main">Contact Us</a>
            </li>
          </ul>
        </nav>

        <div class="offcanvase__info--content mt--30">
          <a href="tel:+919848823332"
            ><span><i class="fa-sharp fa-light fa-phone"></i></span>+91
            9848823332</a
          >
          <a href="#"
            ><span><i class="fa-sharp fa-light fa-location-dot"></i></span>SRKR
            Marg, China Amiram, Bhimavaram, A.P, India - 534204</a
          >
          <div class="offcanvase__info--content--social">
            <p class="title">Follow Us:</p>
            <div class="social__links">
              <a href="#"><i class="fa-brands fa-facebook"></i></a>
              <a href="#"><i class="fa-brands fa-instagram"></i></a>
              <a href="#"><i class="fa-brands fa-linkedin"></i></a>
              <a href="#"><i class="fa-brands fa-youtube"></i></a>
            </div>
          </div>
        </div>
      </div>
      <!-- mobile menu area end -->
    </div>
    <!-- header style two End -->

    <div class="search-input-area">
      <div class="container">
        <div class="search-input-inner">
          <div class="input-div">
            <input
              class="search-input autocomplete ui-autocomplete-input"
              type="text"
              placeholder="Search by keyword or #"
              autocomplete="off"
            />
            <button><i class="far fa-search"></i></button>
          </div>
        </div>
      </div>
      <div id="close" class="search-close-icon">
        <i class="far fa-times"></i>
      </div>
    </div>
    <!-- rts backto top start -->
    <div class="progress-wrap">
      <svg
        class="progress-circle svg-content"
        width="100%"
        height="100%"
        viewBox="-1 -1 102 102"
      >
        <path
          d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"
          style="transition: stroke-dashoffset 10ms linear 0s; stroke-dasharray: 307.919, 307.919; stroke-dashoffset: 307.919;"
        ></path>
      </svg>
    </div>
    <!-- rts back to top end -->
    <div id="anywhere-home" class=""></div>

    <!-- scripts -->
    <FooterScripts />
  </body>
</html>
