---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const hod = [
  {
    name: 'Dr. Penmetsa Bhavani',
    designation: 'Professor & Head of Division',
    specialization: 'Ceramics, Glass Materials, Bioenzymes',
    profile: '#'
  }
];

const faculty = [

  { subject: "Engineering Chemistry", name: "Dr.P.Bhavani", profile: "https://srkrec.irins.org/profile/320165", email: "Bhavani.penmatsa@srkrec.ac.in", specialization: "Applied Chemistry", designation: "Professor And HOD", photo: "506" },
  { subject: "Engineering Chemistry", name: "Dr. Venu Reddy", profile: "https://srkrec.irins.org/profile/245699", email: "rvenu8@srkrec.ac.in", specialization: "Chemistry", designation: "Professor", photo: "1166" },
  { subject: "Engineering Chemistry", name: "Dr.D.Chandra Sekhar", profile: "https://srkrec.irins.org/profile/537596", email: "chandu1884@srkrec.ac.in", specialization: "Industrial chemistry", designation: "Associate Professor", photo: "532" },
  { subject: "Engineering Chemistry", name: "Dr.B.S.Diwakar", profile: "https://srkrec.irins.org/profile/248105", email: "diwakar.b@srkrec.ac.in", specialization: "Organic Chemistry", designation: "Associate Professor", photo: "1048" },
  { subject: "Engineering Chemistry", name: "K.Bala Geeta", profile: "https://srkrec.irins.org/profile/537861", email: "kbgeeta@srkrec.ac.in", specialization: "Organic Chemistry", designation: "Assistant Professor", photo: "1188" },
  { subject: "Engineering Chemistry", name: "Dr.U.Naga Babu", profile: "https://srkrec.irins.org/profile/536925", email: "nagababu.u@srkrec.ac.in", specialization: "Analytical Chemistry", designation: "Assistant Professor", photo: "1290" },
  { subject: "Engineering Chemistry", name: "K.Tulasi Bhavani", profile: "https://srkrec.irins.org/profile/538012", email: "tulasibhavani1995@srkrec.ac.in", specialization: "Organic Chemistry", designation: "Assistant Professor", photo: "1299" },
  { subject: "Engineering Chemistry", name: "J.Suresh Kumar", profile: "https://srkrec.irins.org/profile/656578", email: "Suresh.j@srkrec.ac.in", specialization: "Applied chemistry", designation: "Assistant Professor", photo: "1303" },
  { subject: "Engineering Chemistry", name: "CH.L.Prasanna", profile: "https://srkrec.irins.org/profile/538026", email: "chlprasanna@srkrec.ac.in", specialization: "Organic Chemistry", designation: "Assistant professor", photo: "1324" },
  { subject: "Engineering Chemistry", name: "U.Venkata Lakshmi", profile: "https://srkrec.irins.org/profile/536982", email: "uvlakshmi@srkrec.ac.in", specialization: "Organic Chemistry", designation: "Assistant professor", photo: "1328" },
  { subject: "Engineering Chemistry", name: "S.Prameela devi", profile: "https://srkrec.irins.org/profile/657040", email: "prameeladevi90@srkrec.ac.in", specialization: "Organic chemistry", designation: "Assistant professor", photo: "1325" }

];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty of Chemistry | Applied Sciences & Humanities | SRKR" description="Faculty of the Division of Chemistry at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ash/">Applied Sciences & Humanities</a></li>
              </ul>
              <h1 class="section-title">Faculty Chemistry</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="ash" current="Faculty Chemistry" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Division Head</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src="/assets/images/faculty/chemistry/506.jpg" alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Faculty List -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Division Faculty</h3>
        </div>
        <div class="row g-5">
          {faculty.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/chemistry/${f.photo}.jpg`} alt={f.name} loading="lazy" decoding="async" />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
/