---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="EFL Highlights | Applied Sciences | SRKR" description="Highlights of the Department of English and Foreign Languages (EFL) at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/ash.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ash/">Applied Sciences</a></li>
              </ul>
              <h1 class="section-title">EFL Highlights</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5">
      <div class="container">
        <DeptNav dept="ash" current="EFL Highlights" />

        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-12 col-md-11">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-5">Department of English and Foreign Languages – Highlights</h3>
              
              <ul class="highlights-list list-unstyled" style="padding-left: 0;">
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Recognized as a JNTUK Research Centre offering Ph.D. programmes in English, promoting advanced research in English Language Teaching (ELT), Linguistics, Literature, Communication Skills, and interdisciplinary studies.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Established an ETS-authorized GRE and TOEFL Test Centre on campus, providing internationally standardized testing facilities for students and external candidates.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Established an MoU with Northeastern University to facilitate higher education opportunities for students abroad.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>As a part of Consultancy service, the department successfully launched <strong>SRKR Overseas Education</strong> to guide students nationwide in pursuing international education and global careers.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Established the Centre for Foreign Languages, offering training in German, French, Spanish, and Japanese through qualified in-house faculty.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Enabled students to secure admissions to German public universities (zero tuition fee) through German language proficiency training.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Houses modern Communication Skills Laboratory and Viswakavi Multilingual Communication Skills Laboratory to enhance students' communication competence.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Offers comprehensive training in Communication Skills, Soft Skills, Personality Development, Campus Recruitment Training (CRT), Career Readiness, and Higher Education Counselling.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Provides specialized coaching for international English proficiency examinations including GRE, TOEFL, IELTS, and Duolingo English Test.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Established <strong>Srujana Vatika</strong>, an innovative experiential learning centre dedicated to promoting Indian Knowledge Systems (IKS) through workshops, awareness programmes, educational visits, faculty development, and research initiatives.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Dr. Satish Kumar Nadimpalli from the Department is a UGC and AICTE Master Trainer in Indian Knowledge Systems (IKS) and UGC Resource Person for IKS, Ministry of Education, Government of India.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Actively promotes experiential learning through community outreach programmes, cultural activities, and student engagement initiatives.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Successfully established the ELT@I Godavari Chapter, contributing to the professional development of English language teachers through webinars, conferences, and academic programmes.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Faculty members actively serve as resource persons, moderators, and reviewers in national ELT forums and conferences.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Hosts the award-winning <strong>SRKR Toastmasters Club</strong>, consistently achieving Distinguished Club status and producing winners at prestigious public speaking competitions.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Carried out a Major Research Project titled <em>‘Bilingual Idioms Picture Book: A Self-learning Tool’</em>, funded by the Indian Council of Social Science Research (ICSSR), Ministry of Education, Govt. of India, 2023.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Established <strong>Language Nest</strong>, a unique student-led language and literary club fostering communication, leadership, creativity, and public speaking among engineering students.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Operates a dedicated <strong>Psychological Counselling Cell (PCC)</strong> supporting students' mental health, emotional well-being, and academic success.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Maintains a well-equipped Department Library supporting teaching, learning, and research activities.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Publishes the <strong>Campus Chronicle</strong>, documenting institutional achievements, student success stories, research, innovation, placements, and campus life.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Integrates innovative pedagogy with technology-enabled language learning to prepare students for global academic and professional environments.</span>
                </li>
                <li style="margin-bottom: 16px; display: flex; align-items: start; gap: 12px; text-align: justify; line-height: 1.6;">
                  <i class="fa-light fa-circle-check" style="color: var(--rt-primary); margin-top: 5px; font-size: 1.1rem; flex-shrink: 0;"></i>
                  <span>Committed to producing confident communicators, critical thinkers, and globally competent professionals through holistic language education.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
