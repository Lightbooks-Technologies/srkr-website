---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const iksImages = [
  {
    src: "/assets/images/program/iks-image.jpg",
    alt: "Experiential learning at Srujana Vatika",
    caption: "Experiential learning and traditional activities at Srujana Vatika"
  },
  {
    src: "/assets/images/iks/iks1.jpeg",
    alt: "As a UGC IKS Resource Person at Sri Venkateswara University",
    caption: "As a UGC IKS Resource Person at Sri Venkateswara University"
  },
  {
    src: "/assets/images/iks/iks2.jpeg",
    alt: "On UGC Official Instagram Page",
    caption: "On UGC Official Instagram Page"
  },
  {
    src: "/assets/images/iks/iks3.jpeg",
    alt: "As a UGC Resource Person for IKS at the University of Hyderabad",
    caption: "As a UGC Resource Person for IKS at the University of Hyderabad"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Indian Knowledge Systems | Applied Sciences & Humanities | SRKR" description="Indian Knowledge Systems (IKS) and traditional knowledge courses at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/ash.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ash/">Applied Sciences & Humanities</a></li>
              </ul>
              <h1 class="section-title">Indian Knowledge Systems</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-5">
      <div class="container">
        <DeptNav dept="ash" current="Indian Knowledge Systems" />

        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-12">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-5">Indian Knowledge Systems (IKS)</h3>
              <p style="text-align: justify; margin-bottom: 20px;">The Division of Humanities offers special study units and seminars focused on the traditional Indian sciences, architecture, mathematics, and philosophical values as part of the holistic engineering curriculum.</p>
              <p style="text-align: justify; margin-bottom: 35px;">The Indian Knowledge Systems (IKS) curriculum intends to bridge historical Indian contributions in science, engineering, and metallurgy with modern mathematical tools and methods. By doing so, it helps students develop a balanced understanding of classical methodologies and their modern applications in various technological disciplines.</p>

              <h4 class="mb-3" style="color: var(--rt-primary);">Srujana Vaatika (A Pathway to Indian Knowledge Systems (IKS))</h4>
              <p style="text-align: justify; margin-bottom: 20px;">Srujana Vatika is a unique initiative of SRKR Engineering College that serves as a vibrant centre for preserving, promoting, and experiencing India's rich heritage of knowledge, culture, and sustainable living. Conceived as a living laboratory of Indian Knowledge Systems (IKS), it provides students with opportunities to connect with India's timeless traditions through experiential learning.</p>
              <p style="text-align: justify; margin-bottom: 20px;">The centre hosts workshops on traditional food practices, awareness programmes on Indian culture, educational visits for school students, and interactions with eminent scholars and national leaders. It also supports the integration of IKS into higher education through faculty training, academic programmes, and research initiatives, nurturing a deep appreciation of India's knowledge traditions while inspiring innovation rooted in cultural wisdom.</p>
              <p style="text-align: justify; margin-bottom: 20px;">The initiative is further strengthened by <strong>Dr. Satish Kumar Nadimpalli</strong>, who is a UGC and AICTE Recognized Master Trainer in Indian Knowledge Systems (IKS) and a UGC Resource Person for IKS, IKS Division, Ministry of Education, Government of India. As one of the select Master Trainers from Andhra Pradesh, he actively contributes to the promotion and integration of IKS through training, research, and academic outreach.</p>
              
              <div class="row g-4 mt-4">
                {iksImages.map((img) => (
                  <div class="col-md-6 col-lg-6 col-12">
                    <div class="iks-card">
                      <div class="iks-image-wrapper">
                        <img src={img.src} alt={img.alt} class="iks-img" />
                      </div>
                      <div class="iks-caption">
                        <p>{img.caption}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>

<style>
  .iks-card {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  
  .iks-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .iks-image-wrapper {
    width: 100%;
    height: 300px;
    overflow: hidden;
    position: relative;
    background-color: #f8fafc;
  }

  .iks-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .iks-card:hover .iks-img {
    transform: scale(1.05);
  }

  .iks-caption {
    padding: 16px 20px;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .iks-caption p {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: #334155;
    text-align: center;
    line-height: 1.5;
  }
</style>

