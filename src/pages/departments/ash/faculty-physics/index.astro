---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const hod = [
  { name: 'Dr. M.V. Someswara Rao', designation: 'Associate Professor & Head of Department', specialization: 'Nanofibers and Nanomaterials', profile: 'https://srkrec.irins.org/profile/501847', email: 'somesh.phy@gmail.com', image: '508.jpg' },
];

const faculty = [
  { name: 'Dr. K.V. Ramana Murthy', designation: 'Professor', specialization: 'Material Science and Solid state Physics', profile: 'https://srkrec.irins.org/profile/320427', email: 'ramana_kopparty@hotmail.com', image: '225.jpg' },
  { name: 'P.V. Prasanna Kumar', designation: 'Assistant Professor', specialization: 'Spectroscopy-DFT functional theory', profile: 'https://srkrec.irins.org/profile/579114', email: 'prasan.peramana@gmail.com', image: '530.jpg' },
  { name: 'Dr. Sk. Rameeza Begum', designation: 'Assistant Professor', specialization: 'Spectroscopy', profile: 'https://srkrec.irins.org/profile/579152', email: 'rameeza03@gmail.com', image: '531.jpg' },
  { name: 'Dr. N.P.S. Acharyulu', designation: 'Assistant Professor', specialization: 'Nanoscience and Nanotechnology', profile: 'https://srkrec.irins.org/profile/320371', email: 'phanisat2010@gmail.com', image: '1164.jpg' },
  { name: 'Dr. P.V.S. Lakshmi Aparna', designation: 'Assistant Professor', specialization: 'Spectroscopy and Ultrasonic studies in Liquids', profile: 'https://srkrec.irins.org/profile/516496', email: 'aparna_physics@yahoo.com', image: '1225.jpg' },
  { name: 'Dr. Ch. J.N. Pavankumar', designation: 'Assistant Professor', specialization: 'Materialscience', profile: 'https://srkrec.irins.org/profile/579118', email: 'chintalajagannadh13@gmail.com', image: '1298.jpg' },
  { name: 'Dr. S. Srikanth', designation: 'Assistant Professor', specialization: 'Applied Physics', profile: 'https://srkrec.irins.org/profile/501924', email: 'siramsrikanth@srkrec.ac.in', image: '1323.jpg' },
  { name: 'G. Anusha', designation: 'Assistant Professor', specialization: 'Solid State Physics', profile: 'https://srkrec.irins.org/profile/', email: 'anusha5030@gmail.com', image: '1327.jpg' },
  { name: 'V. Likhita', designation: 'Assistant Professor', specialization: 'Physics', profile: 'https://srkrec.irins.org/profile/714838', email: 'likhitavegesna18@gmail.com', image: '1498.jpg' },
  { name: 'V. Rupavalli', designation: 'Assistant Professor', specialization: 'Physics', profile: 'https://srkrec.irins.org/profile/714829', email: 'rupalokesh0612@gmail.com', image: '1499.jpg' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty of Physics | Applied Sciences & Humanities | SRKR" description="Faculty of the Division of Physics at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/ash.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ash/">Applied Sciences & Humanities</a></li>
              </ul>
              <h1 class="section-title">Faculty Physics</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="ash" current="Faculty Physics" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Department Head</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/physics/${f.image}`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Faculty List -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Department Faculty</h3>
        </div>
        <div class="row g-5">
          {faculty.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/physics/${f.image}`} alt={f.name} loading="lazy" decoding="async" />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
