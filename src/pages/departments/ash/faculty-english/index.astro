---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const hod = [
  {
    name: 'Dr. Bh. V. N. Lakshmi',
    designation: 'Professor & Head of Division',
    specialization: 'English & Foreign Languages, TESOL',
    profile: '#'
  }
];

const faculty = [
  { name: 'Dr. Riyaz Mohammad', designation: 'Assistant Professor', specialization: 'English Language Teaching and English Drama', profile: '#' },
  { name: 'Ramesh Vijaya Babu K', designation: 'Assistant Professor', specialization: 'ELT, Indian Literature in English', profile: '#' },
  { name: 'N. Pavan Kumar', designation: 'Assistant Professor', specialization: 'English Language Teaching', profile: '#' },
  { name: 'E. Sita Rama Raju', designation: 'Personality Development Trainer', specialization: 'Soft Skills', profile: '#' },
  { name: 'Musunoori Sankar', designation: 'Assistant Professor', specialization: 'ELT, Ecocritical Studies', profile: '#' },
  { name: 'Aruna Kumari K', designation: 'Assistant Professor', specialization: 'English Language Teaching', profile: '#' },
  { name: 'Hari Nair', designation: 'Assistant Professor', specialization: 'Indian Literature', profile: '#' },
  { name: 'Mrs. K. Esther Rani', designation: 'Assistant Professor', specialization: 'English Literature', profile: '#' },
  { name: 'S. Madhuri', designation: 'Assistant Professor', specialization: 'English Language and Literature, ELT', profile: '#' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty of English | Applied Sciences & Humanities | SRKR" description="Faculty of the Division of English and Foreign Languages at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/ash.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ash/">Applied Sciences & Humanities</a></li>
              </ul>
              <h1 class="section-title">Faculty English</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="ash" current="Faculty English" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Division Head</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src="/assets/images/faculty/placeholder.jpg" alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Faculty List -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Division Faculty</h3>
        </div>
        <div class="row g-5">
          {faculty.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src="/assets/images/faculty/placeholder.jpg" alt={f.name} loading="lazy" decoding="async" />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
