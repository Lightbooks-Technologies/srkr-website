---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const years = ['2025–26', '2024–25', '2023–24', '2022–23'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Placements | Mathematics | SRKR" description="Placement records and academic training details of the Department of Mathematics at SRKR Engineering College." />
    <style>
      .recruiter-logo-box {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100px;
        transition: all 0.3s ease;
      }
      .recruiter-logo-box:hover {
        border-color: #1a3c6b;
        box-shadow: 0 4px 12px rgba(26, 60, 107, 0.1);
        transform: translateY(-2px);
      }
      .recruiter-logo-box img {
        max-width: 100%;
        max-height: 60px;
        object-fit: contain;
        transition: filter 0.3s ease;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/mathematics/">Mathematics</a></li>
              </ul>
              <h1 class="section-title">Placements & Training</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40">
      
    </section>

    <!-- About Placements -->
    <section class="rts-about-university pb--80">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">Placements & Academic Support</h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                The Department of Mathematics at SRKR plays a fundamental role in shaping students' analytical reasoning, problem-solving abilities, and quantitative aptitude. By providing strong foundations in engineering mathematics, statistics, linear algebra, and computational methods, the department prepares students across all engineering branches to excel in campus placements, competitive examinations, and higher studies.
              </p>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <div class="academic-picture">
              <img src="/assets/images/placeholder/photo-1517245386807-bb43f82c33c4_1200x400.jpg" alt="placements" style="max-height: 400px; object-fit: cover;">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Multi Row Sections -->
    <div class="rts-multi-row-section pb--80">
      <div class="container">
        <!-- Top Recruiters -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center">
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="/assets/images/placeholder/photo-1486406146926-c627a92ad1ab_800x600.jpg" alt="top recruiters" style="border-radius: 10px;" loading="lazy" decoding="async">
            </div>
          </div>
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content">
              <h4 class="row-title">Top Recruiters</h4>
              <p>Leading technology firms, data analytics companies, research institutions, and core industries actively recruit SRKR engineering graduates who demonstrate strong mathematical grounding, logical reasoning, and quantitative competence.</p>
              <div class="row g-4 mt-3">
              
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/tcs.png" alt="Tata Consultancy Services" loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/infosys.png" alt="Infosys" loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/cts.png" alt="Cognizant" loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/ril.png" alt="Reliance" loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/jsw.jpeg" alt="JSW" loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/epiroc.jpeg" alt="Epiroc" loading="lazy" decoding="async">
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- Placement Training -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center mt--80">
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content left-side">
              <h4 class="row-title">Quantitative & Analytical Training</h4>
              <p>The Department of Mathematics conducts specialized modules and training sessions designed to enhance quantitative aptitude, analytical thinking, logical reasoning, and mathematical modeling skills essential for recruitment drives and competitive tests.</p>
              <div class="program-list">
                <a href="#" class="program-item"><span>Quantitative Aptitude & Reasoning <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Mathematical Modeling & Simulation <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Statistical & Data Analysis Foundations <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>GATE & Competitive Exam Coaching <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Problem-Solving & Logical Ability Workshops <i class="fa-regular fa-chevron-right"></i></span></a>
              </div>
            </div>
          </div>
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="/assets/images/placeholder/photo-1517694712202-14dd9538aa97_800x600.jpg" alt="placement training" style="border-radius: 10px;" loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <!-- Year-wise Records -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center mt--80">
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="/assets/images/placeholder/photo-1460925895917-afdab827c52f_800x600.jpg" alt="placement records" style="border-radius: 10px;" loading="lazy" decoding="async">
            </div>
          </div>
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content">
              <h4 class="row-title">Year-wise Placement Reports</h4>
              <p>Download comprehensive reports highlighting placement statistics, student achievements, and career readiness outcomes for each academic year.</p>
              <div class="program-list">
                {years.map(year => (
                  <a href={`/assets/documents/maths/placements/${year.replace('–', '-')}.pdf`} class="program-item" target="_blank">
                    <span>{year} Placement Report <i class="fa-regular fa-chevron-right"></i></span> <span>PDF</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Multi Row Sections End -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>