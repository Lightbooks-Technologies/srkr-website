---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="CSIT Faculty | Information Technology | SRKR" description="Computer Science & Information Technology Faculty under Department of Information Technology at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/it/ithome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/it/">Information Technology</a></li>
              </ul>
              <h1 class="section-title">CSIT Faculty</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="it" current="CSIT Faculty" />

        <!-- Professors -->
        {professors.length > 0 && (
          <>
            <div class="rts-section mb--40">
              <h3 class="rts-section-title">Professors</h3>
            </div>
            <div class="row g-5 mb--50">
              {professors.map((f) => (
                <div class="col-lg-6 col-md-11">
                  <div class="single-staff">
                    <div class="single-staff__content">
                      <div class="staf-image">
                        <img src={`/assets/images/faculty/csit/${f.imgsrc}`} alt={f.name} loading="lazy" decoding="async" />
                      </div>
                      <div class="staf-info">
                        <h5 class="name">{f.name}</h5>
                        <span class="designation">{f.designation}</span>
                        <div class="staf-info__speciality">
                          {f.specialization && <p><strong>Area:</strong> {f.specialization}</p>}
                          {f.email && <p><strong>Email:</strong> <a href={`mailto:${f.email}`}>{f.email}</a></p>}
                        </div>
                        {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        <!-- Assistant Professors -->
        {assistantProfessors.length > 0 && (
          <>
            <div class="rts-section mb--40">
              <h3 class="rts-section-title">Assistant Professors</h3>
            </div>
            <div class="row g-5 mb--50">
              {assistantProfessors.map((f) => (
                <div class="col-lg-6 col-md-11">
                  <div class="single-staff">
                    <div class="single-staff__content">
                      <div class="staf-image">
                        <img src={`/assets/images/faculty/csit/${f.imgsrc}`} alt={f.name} loading="lazy" decoding="async" />
                      </div>
                      <div class="staf-info">
                        <h5 class="name">{f.name}</h5>
                        <span class="designation">{f.designation}</span>
                        <div class="staf-info__speciality">
                          {f.specialization && <p><strong>Area:</strong> {f.specialization}</p>}
                          {f.email && <p><strong>Email:</strong> <a href={`mailto:${f.email}`}>{f.email}</a></p>}
                        </div>
                        {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        <!-- Teaching Assistants -->
        {teachingAssistants.length > 0 && (
          <>
            <div class="rts-section mb--40">
              <h3 class="rts-section-title">Teaching Assistants</h3>
            </div>
            <div class="row g-5">
              {teachingAssistants.map((f) => (
                <div class="col-lg-6 col-md-11">
                  <div class="single-staff">
                    <div class="single-staff__content">
                      <div class="staf-image">
                        <img src={`/assets/images/faculty/csit/${f.imgsrc}`} alt={f.name} loading="lazy" decoding="async" />
                      </div>
                      <div class="staf-info">
                        <h5 class="name">{f.name}</h5>
                        <span class="designation">{f.designation}</span>
                        <div class="staf-info__speciality">
                          {f.specialization && <p><strong>Area:</strong> {f.specialization}</p>}
                          {f.email && <p><strong>Email:</strong> <a href={`mailto:${f.email}`}>{f.email}</a></p>}
                        </div>
                        {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
