---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Information Technology | SRKR" description="Research areas, projects, publications and consultancy services of the Information Technology department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/it/">Information Technology</a></li>
                <li class="breadcrumb-item active" aria-current="page">Research &amp; Consultancy</li>
              </ul>
              <h1 class="section-title">Research &amp; Consultancy</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="it" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>The Department of Information Technology actively engages in applied research and industry consultancy across web technologies, cloud computing, cyber security, data analytics, mobile computing and IoT. Faculty publications appear regularly in SCI / Scopus indexed journals and international conferences, and the department partners with local industry on cloud migration, web platform development and security audits — bridging academic research and real-world IT delivery.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="it-rts-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#it-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="it-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#it-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Web Technologies &amp; Full-Stack Development</li>
                              <li class="si__list--single">Cloud Computing &amp; DevOps</li>
                              <li class="si__list--single">Cyber Security &amp; Cryptography</li>
                              <li class="si__list--single">Data Analytics &amp; Machine Learning</li>
                              <li class="si__list--single">Mobile Computing &amp; Wireless Networks</li>
                              <li class="si__list--single">Internet of Things (IoT) &amp; Edge Computing</li>
                              <li class="si__list--single">Software Engineering &amp; DevOps Practices</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Industry Collaborations -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#it-collapseTwo" aria-expanded="false">
                      Industry Collaborations &amp; Certifications
                    </button>
                    <div id="it-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#it-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">AWS Academy &amp; AWS Educate cloud certifications</li>
                              <li class="si__list--single">Microsoft Learn / Azure Fundamentals partnerships</li>
                              <li class="si__list--single">Google Developer Student Club activities</li>
                              <li class="si__list--single">Salesforce Trailhead Academy &amp; admin certifications</li>
                              <li class="si__list--single">Red Hat &amp; Linux Foundation open-source training</li>
                              <li class="si__list--single">TCS iON / Infosys Springboard skill-building modules</li>
                              <li class="si__list--single">Cisco certifications are for all levels and technologies</li>
                              <li class="si__list--single">An EduSkills certification (Bridges the gap between traditional academics and the needs of the Industry 4.0 job market)</li>

                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Funded Projects -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#it-collapseThree" aria-expanded="false">
                      Funded Projects
                    </button>
                    <div id="it-collapseThree" class="accordion-collapse collapse" data-bs-parent="#it-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">

                              <li class="si__list--single">Dr. N. Gopala Krishna Murthy successfully completed "Demonstration of Grid Supportive EV Charger and Charging Infrastructure at LT Level (D-EVCI)," funded by DST under reference F.No: DST/CERI/MI/SG/ with a sanctioned budget of ₹71.784 Lakhs.</li>
                              <li class="si__list--single">Dr. N. Gopala Krishna Murthy successfully completed "Skill and Personality Development Programme Centre for SC/ST Students (SPDP)," funded by AICTE under reference 65-18/RIFD/SPDP/POLICY-1/2016-17 dated 18.05.2017 with a sanctioned budget of ₹25.00 Lakhs.</li>
                              <li class="si__list--single">Dr. N. Gopala Krishna Murthy successfully completed "Margadarshan," funded by AICTE under reference F.No: 58-14/RIFD/Margadharshan/2019-20 with a sanctioned budget of ₹20.00 Lakhs.</li>
                              <li class="si__list--single">Dr. N. Gopala Krishna Murthy successfully completed "SC/ST Startups," funded by AICTE–SAMRID DHI under reference F.No: 73-Policy-9/RFID/Samriddhi/Policy-1/2017/18 with a sanctioned budget of ₹14.90 Lakhs.</li>
                              <li class="si__list--single">Dr. Bh. V. S. R. K. Raju successfully completed "Data Analytics and Statistical Analysis Research Laboratory," funded by MODROBS-AICTE on 16-05-2018 with a sanctioned budget of ₹10.917 Lakhs.</li>
                              <li class="si__list--single">Dr. I. Hemalatha successfully completed "Development of Machine Learning Algorithms for Detection and Impact Analysis of Brain Tumor in Human Brain," funded by SERB on 16-02-2017 with a sanctioned budget of ₹29.064 Lakhs.</li>
                              <li class="si__list--single">Dr. M. Suresh Babu successfully completed "Microsatellites in Human Genome: Development of Algorithms and Web-Server for Impact Analysis of Repeats in Diseases," funded by DST-SERB on 15-09-2016 with a sanctioned budget of ₹22.263 Lakhs.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#it-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="it-collapseFour" class="accordion-collapse collapse" data-bs-parent="#it-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <div class="table-responsive">
                              <table class="table">
                                <thead>
                                  <tr>
                                    <th>Publication Type</th>
                                    <th>2023-2024</th>
                                    <th>2024-2025</th>
                                    <th>2025-2026*</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <tr>
                                    <td>Journals</td>
                                    <td>83</td>
                                    <td>28</td>
                                    <td>30</td>
                                  </tr>
                                  <tr>
                                    <td>Conference</td>
                                    <td>24</td>
                                    <td>46</td>
                                    <td>106</td>
                                  </tr>
                                  <tr>
                                    <td>Books/ Book Chapters</td>
                                    <td>7</td>
                                    <td>30</td>
                                    <td>8</td>
                                  </tr>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#it-collapseFive" aria-expanded="false">
                      Consultancy Services
                    </button>
                    <div id="it-collapseFive" class="accordion-collapse collapse" data-bs-parent="#it-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Web &amp; mobile application development for local businesses and educational institutions.</li>
                              <li class="si__list--single">Cloud migration, AWS / Azure architecture reviews and cost optimisation.</li>
                              <li class="si__list--single">Cyber security audits, vulnerability assessments and secure-coding workshops.</li>
                              <li class="si__list--single">Data analytics dashboards, BI reporting and Power BI / Tableau training.</li>
                              <li class="si__list--single">Corporate training programmes on full-stack, DevOps and cyber security.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">The department's consultancy work focuses on practical, deployable IT solutions for industry partners in Andhra Pradesh and beyond.</p>
                      </div>
                    </div>
                  </div>




                  <!-- Patents Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#it-patents" aria-expanded="true">
                      Patents 
                    </button>
                    <div id="it-patents" class="accordion-collapse collapse show" data-bs-parent="#it-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div >
                            <ul class="list-unstyled">
                              <li class="si__list--single" >With 40+ patents published, the Department of Information Technology showcases a culture of creativity, innovation, and technological advancement.</li>

                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/it/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/it/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/it/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>Academic Programs</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>Information Technology Department<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:hod.it@srkrec.ac.in">hod.it@srkrec.ac.in</a>
                  <a href="mailto:research.it@srkrec.ac.in">research.it@srkrec.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+918842226666">+91 884 222 6666</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
