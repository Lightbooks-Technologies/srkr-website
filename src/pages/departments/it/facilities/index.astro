---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Web Technologies Lab',                     img: '/assets/images/placeholder/photo-1547658719-da2b51169166_800x600.jpg' },
  { name: 'Programming Lab',                          img: '/assets/images/placeholder/photo-1517694712202-14dd9538aa97_800x600.jpg' },
  { name: 'Advanced Computing Lab',                   img: '/assets/images/placeholder/photo-1544383835-bda2bc66a55d_800x600.jpg' },
  { name: 'R&D Lab',                                  img: '/assets/images/placeholder/photo-1573164713988-8665fc963095_800x600.jpg' },
  { name: 'Advanced Programming Lab',                 img: '/assets/images/placeholder/photo-1551288049-bebda4e38f71_800x600.jpg' },
  { name: 'Microprocessor and IOT Lab',               img: '/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg' },
  { name: 'Knowledge Engineering Lab',                img: '/assets/images/placeholder/photo-1544197150-b99a580bb7a8_800x600.jpg' },
  { name: 'Networks Lab',                             img: '/assets/images/placeholder/photo-1558494949-ef010cbdcc31_800x600.jpg' },
  { name: 'OS Lab',                                   img: '/assets/images/placeholder/photo-1614064641938-3bbee52942c7_800x600.jpg' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Information Technology | SRKR" description="Laboratories and computing facilities of the Information Technology department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/it/ithome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/it/">Information Technology</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="it" current="Facilities" />
        <div class="row">
          <div class="col-12">

            
            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>


      <!-- <div class="row">
          <div class="col-12">
            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Department library</h3>
            </div>
            <p>The department is equipped with a dedicated library with a large number of text books, magazines, research journals and computers to facilitate e-learning through Massive Open Online Courses (MOOCs), NPTEL, etc.</p>
            <ul>
              <li>No. of Titles: 688</li>
              <li>No. of Volumes: 9191</li>
              <li>No. of CDs &amp; VCDS: 56 SONET CDs</li>
            </ul>
          </div> -->
      </div>

      </div>
    </section>



    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
