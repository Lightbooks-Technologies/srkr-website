---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }

  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }

  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | Information Technology | SRKR" description="Department, faculty and student achievements of the Information Technology department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/it/ithome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/it/">Information Technology</a></li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="it" current="Achievements" />

        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                Established in 1999, the Department of Information Technology has built a strong record of academic and professional excellence — NBA-accredited B.Tech programme, consistent top-tier placements with leading IT companies, a highest recent offer of 17.16 LPA from Amazon, and active research output across web, cloud, data and security.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                <img src="/assets/images/placeholder/photo-1573164713988-8665fc963095_800x600.jpg" alt="Information Technology Department">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">NBA</h3>
                    <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Accredited B.Tech Information Technology Programme(4X)</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">19 LPA</h3>
                    <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Highest Recent Placement Offer (AT&T)</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">200+</h3>
                    <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>SCI / Scopus Indexed Research Publications</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="  rts-funfact-wrapper justify-content-sm-between">
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">14</h2>
                    <p>Specialised Laboratories</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">180</h2>
                    <p>Sanctioned Intake (B.Tech IT)</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">90%+</h2>
                    <p>Placement Rate (Eligible Students)</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">1999</h2>
                    <p>Year Established</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1524178232363-1fb2b075b655_800x600.jpg" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Recipients of Best Woman Researcher Award in Research Excellence, Uttama Adyapika Award in recognition of excellence in teaching, and the Best PG Engineering Teacher Award.</li>
                      <li class="si__list--single">Our faculty member serves as the Chair of the IEEE Education Society, Visakhapatnam Section.</li>
                      <li class="si__list--single">Consistent achievements in NPTEL–SWAYAM certifications and mentoring excellence.</li>
                      <li class="si__list--single">Active reviewers for IEEE, Springer, and reputed international journals.</li>
                      <li class="si__list--single">Faculty members serve as technical session chairs and conference reviewers.</li>
                      <li class="si__list--single">Our faculty members have published over 200 research papers in reputed journals, including IEEE Transactions, Springer, and Elsevier publications.</li>
                      <li class="si__list--single">Multiple faculty members recognized as JNTUK Ph.D. supervisors.</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Our students emerged as winners at the Amaravathi Quantum Computing (AQVH 2025) competition.</li>
                      <li class="si__list--single">Our students secured the 1st Prize in the Vision X Hackathon held at Swarnandhra College, Narsapur.</li>
                      <li class="si__list--single">One of our students secured the 1st Prize in the 3rd South India Goju-Ryu Karate Open Championship.</li>
                      <li class="si__list--single">Consistent placements in leading multinational companies and product-based organizations.</li>
                      <li class="si__list--single">Industry-recognized certifications in AI, Cloud Computing, Cyber Security, and Full Stack Development.</li>
                      <li class="si__list--single">Selection for internships and training programs with reputed industry partners.</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1523240795612-9a054b0db644_800x600.jpg" alt="Student Success" loading="lazy" decoding="async">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Department Milestones Timeline -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">Department Milestones</h2>
                  <p class="rts__section--description">From a brand-new B.Tech programme in 1999 to today's NBA-accredited, industry-aligned department — the Information Technology department has grown steadily into one of the most sought-after streams at SRKR.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- 1999 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1517694712202-14dd9538aa97_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">1999</a></h4>
                        <p class="campus__life--single--description">Department of Information Technology established with the B.Tech IT programme.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2010 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1547658719-da2b51169166_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2010</a></h4>
                        <p class="campus__life--single--description">Expansion of web, networks and cloud laboratories; growing placement record with top IT services companies.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2018 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1544197150-b99a580bb7a8_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2018</a></h4>
                        <p class="campus__life--single--description">NBA accreditation awarded; B.Tech intake raised to 180 with an industry-aligned curriculum.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2024 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1614064641938-3bbee52942c7_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2024</a></h4>
                        <p class="campus__life--single--description">Highest recent placement of 17.16 LPA at Amazon — strong year for IT placements across product and services companies.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
