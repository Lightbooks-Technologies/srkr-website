    <style>
      /* Equal-height specialization cards */
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
