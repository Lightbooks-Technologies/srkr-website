              </div>
              <h5 class="program__single--item--title">Specialisations</h5>
              <ul class="program__single--item--list">

              <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">M.Tech IT
                    <span><i class="fa-regular fa-arrow-right"></i></span>
