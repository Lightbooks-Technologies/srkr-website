---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';
import DeptNav from '../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Department of Information Technology | SRKR Engineering College" description="Department of Information Technology at SRKR Engineering College, Bhimavaram — established 2001, NBA accredited, B.Tech in Information Technology." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/it/ithome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
              </ul>
              <h1 class="section-title">Department of Information Technology</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- content -->
    <div class="rts-faculty-details py-5">
      <div class="container">

        <DeptNav dept="it" current="Home" />

        <!-- About the Department -->
        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-6 col-md-11">
            <div class="faculty-content-text me-5">
              <h3 class="rts-section-title mb-5">About the Department</h3>
              
              <p style="text-align: justify;">Established in 1999, the Department of Information Technology has developed into a dynamic center for academic excellence, research, and innovation. Beginning with an intake of 60 students, the department has expanded significantly and now offers Undergraduate, Postgraduate, and Ph.D. programs with a current B.Tech intake of 180 students. The department is dedicated to delivering quality technical education through innovative teaching methodologies, industry-oriented training, and research-focused initiatives.</p>
              <p style="text-align: justify;">The department provides modern infrastructure, including spacious classrooms, e-classrooms, advanced computer laboratories, a modern library, and a fully air-conditioned seminar hall. High-speed internet and advanced computing facilities support academic and research activities. Programs offered include B.Tech in Information Technology, Artificial Intelligence and Data Science, Computer Science and Business Systems, and Computer Science and Information Technology, along with M.Tech in Information Technology. Through industry collaborations, technical events, hands-on training, and research opportunities, students gain strong technical and analytical skills, preparing them for successful careers in industry, higher education, and research.</p>
            </div>
          </div>
          <div class="col-lg-6 col-md-11">
            <div class="ratio ratio-16x9 mt-5 mt-lg-0">
              <iframe
                src="https://www.youtube.com/embed/zWHp1cRW8fc?html5=1&enablejsapi=1"
                title="SRKR Department Video"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Message from HoD -->
        <div class="row mt--30">
          <div class="rts-section mb--60">
            <h3 class="rts-section-title">Message from Head of Department</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-8">
            <div class="faculty-image text-center">
              {/* TODO: replace with real faculty photo */}
              <img class="img-fluid mw-100" src="/assets/images/faculty/it/1356.jpg" alt="Dr.P.Ravi Kiran Varma">
              <div class="h5 mb-2 mt-5">Dr. P. Ravi Kiran Varma</div>
              <span>Professor &amp; Head of Department</span>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faculty-content-text ms-lg-5 mt-5 mt-lg-0">
              
              <p class="h6 mb-4">Welcome to the Department of Information Technology</p>
              <p style="text-align: justify;">Welcome to the Department of Information Technology, where innovation, knowledge, and technology-driven learning come together to shape future professionals. Our department focuses on applying computing solutions to real-world challenges through strong foundations in software development, data management, networking, and system implementation. We are committed to providing quality education, practical exposure, and industry-oriented skills through modern laboratories, research activities, internships, and technical programs. With dedicated faculty and a student-centric environment, we encourage creativity, problem-solving, teamwork, and lifelong learning, preparing students to excel in diverse and rapidly evolving technology-driven industries.</p>
            </div>
          </div>

          <div class="border-top my-60"></div>

          <!-- Mission & Vision -->
          <div class="row g-4 align-items-start justify-content-md-center">
            <div class="col-lg-6 col-md-6 rts-scholarship-description">
              <div class="faculty-content-text si__list h-100">
                <h4 class="font-32 mb-3 mt-4">Vision</h4>
                <ul class="list-unstyled one-column-list mb-0">
                  <li class="mb-3">To evolve as a centre of excellence by adopting innovative methods for teaching learning and research in the diversified fields of Information Technology.</li>
                </ul>
              </div>
            </div>
            <div class="col-lg-6 col-md-6 rts-scholarship-description">
              <div class="faculty-content-text si__list h-100">
                <h4 class="font-32 mb-4">Mission</h4>
                <ul class="list-unstyled one-column-list">
                  <li class="mb-3">The highest quality technology-based education and services in the most effective manner.</li>
                  <li class="mb-3">Maintain a vital, state-of-art research to provide its students and faculty with opportunities to create, interpret, apply and disseminate knowledge.</li>
                  <li class="mb-3">Empower students towards higher education, research and becoming entrepreneur/employee and meet intellectual, ethical, carrier challenges and community service.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Core Specializations -->
        <div class="row g-5 faculty-sub-details rts-section-padding">
          <div class="rts-section mb-4 text-center">
            <h3 class="rts-section-title">Core Specializations</h3>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1547658719-da2b51169166?w=600&h=380&fit=crop" alt="Full-Stack Web Development" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/it/research-consultancy/">Full-Stack Web Development</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/it/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1544197150-b99a580bb7a8?w=600&h=380&fit=crop" alt="Cloud Computing & DevOps" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/it/research-consultancy/">Cloud Computing &amp; DevOps</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/it/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=600&h=380&fit=crop" alt="Cyber Security" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/it/research-consultancy/">Cyber Security</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/it/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&h=380&fit=crop" alt="Data Analytics" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/it/research-consultancy/">Data Analytics</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/it/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Academics & Programs -->
        <div class="row justify-content-md-center g-0">
          <div class="rts-section mb--60 text-center">
            <h3 class="rts-section-title">Academics &amp; Programs</h3>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Undergraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">B.Tech Information Technology
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">4-Year JNTUK Affiliated
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">NBA Accredited
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">Sanctioned Intake — 180
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item v__2">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Specialisations</h5>
              <ul class="program__single--item--list">

              <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">M.Tech IT
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">Full-Stack &amp; Mobile Development
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">Cloud Computing &amp; DevOps
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">Cyber Security
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/academic-programs/" class="link__list">Data Analytics &amp; ML
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Industry &amp; Research</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/it/research-consultancy/" class="link__list">Industry-Aligned Curriculum
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/research-consultancy/" class="link__list">Internships &amp; Live Projects
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/research-consultancy/" class="link__list">AWS / Azure / Cloud Certifications
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/it/research-consultancy/" class="link__list">Faculty Publications &amp; Projects
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
    <!-- content end -->

    <!-- Department Highlights -->
    <div class="rts-blog v_1 rts__light rts-section-padding">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-md-11 col-lg-12">
            <div class="rts-section rts-border-bottom-1 mb--50 pb--20">
              <h2 class="rts-section-title text-uppercase">Department Highlights</h2>
              <p class="rts-section-description">Two decades of excellence in information technology education, placements and industry partnerships.</p>
            </div>
          </div>
        </div>
        <div class="row g-5 justify-content-md-center">
          <div class="col-md-11 col-lg-6">
            <div class="rts-blog-post blog-v-full">
              <div class="single-blog-post">
                <a href="/departments/it/achievements/" class="blog-thumb">
                  <img src="/assets/images/blog/big-thumb-1.jpg" alt="NBA Accreditation" loading="lazy" decoding="async">
                </a>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-award"></i></span>
                      <a href="#">Accreditation</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>NBA Accredited Program</span>
                    </div>
                  </div>
                  <a href="/departments/it/achievements/" class="post-title">
                    NBA-accredited B.Tech Information Technology — a mark of sustained academic quality.
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-11 col-lg-6">
            <div class="rts-blog-post">
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/it/placements/">
                    <img src="/assets/images/blog/small-thumb-1.jpg" alt="Top Placements" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-briefcase"></i></span>
                      <a href="#">Placements</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Highest 17.16 LPA</span>
                    </div>
                  </div>
                  <a href="/departments/it/placements/" class="post-title">
                    Recent top offer of 17.16 LPA from Amazon, with consistent placements at top IT MNCs.
                  </a>
                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/it/facilities/">
                    <img src="/assets/images/blog/small-thumb-2.jpg" alt="Modern Labs" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-flask"></i></span>
                      <a href="#">Facilities</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>12 Specialised Labs</span>
                    </div>
                  </div>
                  <a href="/departments/it/facilities/" class="post-title">
                    Twelve modern labs covering web, cloud, mobile, networks, security and data.
                  </a>
                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/it/research-consultancy/">
                    <img src="/assets/images/blog/small-thumb-3.jpg" alt="Industry Collaboration" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-handshake"></i></span>
                      <a href="#">Collaborations</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Industry &amp; Academia</span>
                    </div>
                  </div>
                  <a href="/departments/it/research-consultancy/" class="post-title">
                    Industry collaborations and certifications with AWS, Microsoft, Google and Salesforce.
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Department Highlights end -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      /* Equal-height specialization cards */
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    </style>
  </body>
</html>
