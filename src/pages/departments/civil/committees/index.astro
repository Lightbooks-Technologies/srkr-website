// BoS Committee Members
const bosMembers = [
  { name: 'Dr. G Sri Bala', role: 'Chairman\nAssistant Professor and Head', link: 'https://srkrec.irins.org/profile/500999', image: '550' },
  { name: 'Dr. P. Subba Rao (JNTUK Nominee)', role: 'Member\nProfessor, Dept. of Civil Engineering, JNTUK', link: ' ', image: 'PSubbarao' },
  { name: 'Dr. J.S. Kalyana Rama (Expert from Other University)', role: 'Member\nAssociate Professor (Mahindra University)', link: ' ', image: 'SriKalyanaRamaJyosyula' },
  { name: 'Dr. G Bharat (Expert from Research Organization)', role: 'Member\nPrincipal Scientist (CSIR-CRRI)', link: ' ', image: 'bharath' },
  { name: 'Sri P. Sri Pavan Krupa Kumar (Expert from Industry)', role: 'Member\nCEO, PossiBuild Building Technologies, Hyderabad.', link: ' ', image: 'pavan' },
  { name: 'Dr. A. Uma Maheswar Arepalli', role: 'Member\nAssistant Professor, SRM-AP, Guntur', link: ' ', image: 'UmaMaheshwararao' }
  
];

// PAQIC Committee Members
const paqicMembers = [
  { name: 'Dr. G Sri Bala', role: 'Chairman', link: 'https://srkrec.irins.org/profile/500999', image: '550' },
  { name: 'Dr. ACSV Prasad', role: 'Coordinator', link: 'https://srkrec.irins.org/profile/320273', image: '432' },
  { name: 'Dr. T Vamsi Nagaraju', role: 'Member', link: 'https://srkrec.irins.org/profile/178533', image: '959' },
  { name: 'Dr. S K V S T Lavakumar', role: 'Member', link: 'https://srkrec.irins.org/profile/180447', image: '454' },
  { name: 'Dr. E Ramanjaneya Raju', role: 'Member', link: 'https://srkrec.irins.org/profile/579043', image: '939' },
  { name: 'Dr. M Venkata Rao', role: 'Member', link: 'https://srkrec.irins.org/profile/501813', image: '695' },
  { name: 'Dr. S Srikanth Reddy', role: 'Member', link: 'https://srkrec.irins.org/profile/504013', image: '995' },
  { name: 'Mr. M S K Chaitanya', role: 'Member', link: 'https://srkrec.irins.org/profile/503636', image: '1165' },

];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }
  
  .cat-title {
    margin-bottom: 0.5rem;
  }
  
  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }
  
  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | Civil Engineering | SRKR" description="Department committees of the Civil Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/civil/civilhome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/civil/">Civil Engineering</a></li>
              </ul>
              <h1 class="section-title">Committees</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="civil" current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Department Advisory Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/civil/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: contain;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/civil/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: contain;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/civil/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: contain;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>