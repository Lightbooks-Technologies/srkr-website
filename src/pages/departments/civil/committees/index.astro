---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import CivilDeptNav from '../../../../components/CivilDeptNav.astro';

// DAC Committee Members
const dacMembers = [
  { name: 'Dr. P. Poluraju', role: 'Chairman', image: '01', link: '/departments/civil/faculty/' },
  { name: 'Dr. G.V.R. Prasada Raju', role: 'Member', image: '02', link: '/departments/civil/faculty/' },
  { name: 'Dr. N. Ramanjaneyulu', role: 'Member', image: '03', link: '/departments/civil/faculty/' },
  { name: 'Industry Nominee 1', role: 'Member (TBD)', image: '04', link: null },
  { name: 'Industry Nominee 2', role: 'Member (TBD)', image: '05', link: null },
];

// BoS Committee Members
const bosMembers = [
  { name: 'Dr. P. Poluraju', role: 'Chairman', image: '01', link: '/departments/civil/faculty/' },
  { name: 'Dr. K. Satyanarayana', role: 'Member', image: '06', link: '/departments/civil/faculty/' },
  { name: 'Dr. E. Kiran Kumar', role: 'Member', image: '07', link: '/departments/civil/faculty/' },
  { name: 'Dr. K. Srinivasa Rao', role: 'Member', image: '08', link: '/departments/civil/faculty/' },
  { name: 'Dr. Y. Aravind', role: 'Member', image: '09', link: '/departments/civil/faculty/' },
  { name: 'Industry Expert 1', role: 'Member (TBD)', image: '10', link: null },
  { name: 'Industry Expert 2', role: 'Member (TBD)', image: '01', link: null },
];

// PAQIC Committee Members
const paqicMembers = [
  { name: 'Dr. P. Poluraju', role: 'Coordinator', image: '01', link: '/departments/civil/faculty/' },
  { name: 'Dr. P. Sridhar Babu', role: 'Member', image: '02', link: '/departments/civil/faculty/' },
  { name: 'Dr. B. Kavitha', role: 'Member', image: '03', link: '/departments/civil/faculty/' },
  { name: 'Dr. K.V.G.D. Balaji', role: 'Member', image: '04', link: '/departments/civil/faculty/' },
  { name: 'Dr. Y. Srinivasa Rao', role: 'Member', image: '05', link: '/departments/civil/faculty/' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }
  
  .cat-title {
    margin-bottom: 0.5rem;
  }
  
  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }
  
  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | Civil Engineering | SRKR" description="Department committees of the Civil Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/civil/">Civil Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Committees</li>
              </ul>
              <h2 class="section-title">Committees</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <CivilDeptNav current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Departmental Academic Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>