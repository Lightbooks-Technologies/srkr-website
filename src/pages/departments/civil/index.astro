---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';
import CivilDeptNav from '../../../components/CivilDeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Department of Civil Engineering | SRKR Engineering College" description="Department of Civil Engineering at SRKR Engineering College, Bhimavaram — established 1980, NBA accredited." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Civil Engineering</li>
              </ul>
              <h2 class="section-title">Department of Civil Engineering</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS (full width, outside sidebar layout) -->
    <div class="rts-funfact rts-section-padding">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">29</h2>
                <p>Faculty Members</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">4x</h2>
                <p>NBA Accredited</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">80%+</h2>
                <p>Consultancy Share</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">6</h2>
                <p>Centres of Excellence</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="rts-faculty-details rts-section-padding">
      <div class="container">
        <CivilDeptNav current="Home" />

        <!-- Message from HoD -->
        <div class="row mt--60">
          <div class="rts-section mb--60">
            <h3 class="rts-section-title">Message from Head of Department</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-8">
            <div class="faculty-image text-center">
              <img class="img-fluid mw-100" src="/assets/images/faculty/hod-civil.jpg" alt="Dr. P. Poluraju">
              <div class="h5 mb-2 mt-5">Dr. P. Poluraju</div>
              <span>Professor & Head of Department</span>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faculty-content-text ms-lg-5 mt-5 mt-lg-0">
              <p class="h6 mb-4">Welcome to Civil Engineering</p>
              <p class="mb-5">The Department of Civil Engineering at SRKR Engineering College stands as a beacon of excellence in engineering education and research since 1980. Our commitment to producing skilled professionals who can address contemporary infrastructure challenges remains unwavering.</p>
              
              <p class="h6 mb-4">Building Tomorrow's Infrastructure Leaders</p>
              <p class="mb-5">We take pride in our NBA-accredited program that combines rigorous academics with hands-on learning through our state-of-the-art laboratories and research centres. Our faculty members bring decades of experience from both academia and industry, ensuring students receive education that's both theoretically sound and practically relevant.</p>
              
              <p class="h6 mb-4">Research That Makes a Difference</p>
              <p>Our six Centres of Excellence focus on critical areas including sustainable construction, water quality management, and advanced structural systems. Through consultancy projects worth crores, we contribute directly to regional infrastructure development while providing students invaluable real-world exposure.</p>
            </div>
          </div>

          <div class="border-top my-60"></div>

          <!-- Mission & Vision with Image -->
          <div class="row align-items-center justify-content-md-center">
            <div class="col-lg-6 col-md-11">
              <div class="faculty-content-text me-5">
                <h4 class="font-32 mb-4">Mission</h4>
                <ul class="list-unstyled">
                  <li class="mb-3"><i class="fa-regular fa-circle-check text-primary me-2"></i> To provide high quality education and make the students ethical, world-class professionals.</li>
                  <li class="mb-3"><i class="fa-regular fa-circle-check text-primary me-2"></i> To improve the skills of both staff and students through research projects and consultancy.</li>
                  <li class="mb-3"><i class="fa-regular fa-circle-check text-primary me-2"></i> To inculcate a sense of societal responsibility and evoke commitment to serve communities better.</li>
                </ul>
                
                <h4 class="font-32 mb-4 mt-5">Vision</h4>
                <p><strong>To Lead Academics and Research in Civil Engineering Globally.</strong></p>
              </div>
            </div>
            <div class="col-lg-6 col-md-11">
              <figure class="mt-5 mt-lg-0">
                <img class="mw-100" src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=800&h=600&fit=crop" alt="Infrastructure" style="border-radius: 10px;">
              </figure>
            </div>
          </div>
        </div>

        <!-- Specialization Areas -->
        <div class="row g-5 faculty-sub-details rts-section-padding">
          <div class="rts-section mb-4 text-center">
            <h3 class="rts-section-title">Core Specializations</h3>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item">
              <div class="cat-thumb">
                <img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=800&h=600&fit=crop" alt="Structural Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/civil/research-consultancy/">Structural Engineering</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/civil/research-consultancy/">Learn More <i class="fa-light fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item">
              <div class="cat-thumb">
                <img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?w=800&h=600&fit=crop" alt="Geotechnical Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/civil/research-consultancy/">Geotechnical Engineering</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/civil/research-consultancy/">Learn More <i class="fa-light fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item">
              <div class="cat-thumb">
                <img src="https://images.unsplash.com/photo-1464938050520-ef2270bb8ce8?w=800&h=600&fit=crop" alt="Transportation Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/civil/research-consultancy/">Transportation Engineering</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/civil/research-consultancy/">Learn More <i class="fa-light fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item">
              <div class="cat-thumb">
                <img src="https://images.unsplash.com/photo-1497250681960-ef046c08a56e?w=800&h=600&fit=crop" alt="Environmental Engineering">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/civil/research-consultancy/">Environmental Engineering</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/civil/research-consultancy/">Learn More <i class="fa-light fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Academic Programs -->
        <div class="row justify-content-md-center g-0">
          <div class="rts-section mb--60 text-center">
            <h3 class="rts-section-title">Academic Programs</h3>
          </div>
          
          <div class="col-lg-6 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="">
              </div>
              <h5 class="program__single--item--title">Undergraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/academic-programs/">
                    <span>B.Tech. in Civil Engineering</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/academic-programs/">
                    <span>NBA Accredited Program</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/academic-programs/">
                    <span>120 Seats per Year</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/academic-programs/">
                    <span>Industry-Aligned Curriculum</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div class="col-lg-6 col-md-10">
            <div class="program__single--item v__2">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="">
              </div>
              <h5 class="program__single--item--title">Postgraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/academic-programs/">
                    <span>M.Tech. Structural Engineering</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/research-consultancy/">
                    <span>Ph.D. Programs (AU & JNTUK)</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/research-consultancy/">
                    <span>18 Seats M.Tech</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/civil/research-consultancy/">
                    <span>Active Research Centre</span>
                    <i class="fa-light fa-arrow-right"></i>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
