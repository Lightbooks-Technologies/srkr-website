                    Over 80% of SRKR's consultancy revenue from Civil Engineering projects.
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Department Highlights end -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      /* Equal-height specialization cards */
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    </style>
  </body>
</html>
