---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }
  
  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  
  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }
  
  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | Civil Engineering | SRKR" description="Department, faculty, and student achievements of the Civil Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/civil/civilhome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/civil/">Civil Engineering</a></li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="civil" current="Achievements" />
        
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                The Department of Civil Engineering at SRKR has established a legacy of academic and professional excellence spanning four decades. With four consecutive NBA accreditations, 150+ research publications, and significant contributions to industry consultancy, we continue to set benchmarks in civil engineering education.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                <img src="/assets/images/banner/civil-achievements.jpg" alt="Civil Engineering Department">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">4x</h3>
                    <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>NBA Accreditation Since 2002</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">150+</h3>
                    <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Research Publications in SCI/Scopus Journals</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">80%+</h3>
                    <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Institutional Consultancy Revenue Share</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="rts-funfact-wrapper">
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">6</h2>
                    <p>Centres of Excellence</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">&#x20B9;3.95 Cr</h2>
                    <p>Funded Projects</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">NABL ACCREDITED</h2>
                    <p>Civil Engineering Materials Testing Laboratory</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">Quality Control Services</h2>
                    <p>Civil Engineering Department is empanelled by Bhimavaram Municipality</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=800&h=600&fit=crop" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">3 faculty members received JNTUK Best Teacher Award</li>
                      <li class="si__list--single">2 faculty recognized as JNTUK Ph.D. supervisors</li>
                      <li class="si__list--single">Materials Testing Laboratory accredited by NABL</li>
                      <li class="si__list--single">Research Centre status by JNTUK</li>
                      <li class="si__list--single">Third-party quality control for Bhimavaram Municipality</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">19 out of 25 first ranks in Andhra University exams since 1984</li>
                      <li class="si__list--single">Consistent top ranks in GATE, GRE, and competitive exams</li>
                      <li class="si__list--single">Placements in L&T, Gammon India, Simplex Infrastructures</li>
                      <li class="si__list--single">National-level prizes in technical paper presentations</li>
                      <li class="si__list--single">Winners at project expos and innovation challenges</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=800&h=600&fit=crop" alt="Student Success" loading="lazy" decoding="async">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Accreditation Timeline -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">NBA Accreditation History</h2>
                  <p class="rts__section--description">The Department of Civil Engineering has maintained continuous NBA accreditation since 2002, demonstrating consistent commitment to quality education, outcome-based learning, and industry-aligned curriculum development across four consecutive accreditation cycles.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- 2002-07 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2002-07</a></h4>
                        <p class="campus__life--single--description">First NBA accreditation establishing quality standards and outcome-based education framework.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2007-12 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1541829070764-84a7d30dd3f3?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2007-12</a></h4>
                        <p class="campus__life--single--description">Second accreditation recognizing continued excellence in engineering education and faculty development.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2020-23 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2020-23</a></h4>
                        <p class="campus__life--single--description">Third accreditation acknowledging research growth, consultancy impact, and industry engagement.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2023-26 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2023-26</a></h4>
                        <p class="campus__life--single--description">Current accreditation demonstrating sustained quality, innovation, and student success outcomes.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
