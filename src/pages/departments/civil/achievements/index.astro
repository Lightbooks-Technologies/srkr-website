---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }
  
  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  
  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }
  .rts-funfact-wrapper .single-cta-item:not(:last-child):after {
    right: 10% !important;
  }
  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | Civil Engineering | SRKR" description="Department, faculty, and student achievements of the Civil Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/civil/civilhome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/civil/">Civil Engineering</a></li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="civil" current="Achievements" />
        
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                The Department of Civil Engineering at SRKR has established a legacy of academic and professional excellence spanning four decades. With four consecutive NBA accreditations, 150+ research publications, and significant contributions to industry consultancy, we continue to set benchmarks in civil engineering education.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                <img src="/assets/images/banner/civil-achievements.jpg" alt="Civil Engineering Department">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">4x</h3>
                    <!-- <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async"> -->
                  </div>
                  <div class="desc">
                    <p>NBA Accreditation Since 2002</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">150+</h3>
                    <!-- <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async"> -->
                  </div>
                  <div class="desc">
                    <p>Research Publications in SCI/Scopus Journals</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">₹3.95 Cr</h3>
                    <!-- <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async"> -->
                  </div>
                  <div class="desc">
                    <p>Funded Projects</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="rts-funfact-wrapper justify-content-sm-between">
                  <!-- <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">6</h2>
                    <p>Centres of Excellence</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">&#x20B9;3.95 Cr</h2>
                    <p>Funded Projects</p>
                  </div> -->
                  <div class="single-cta-item col-12 col-md-6" style="max-width: 100%;">
                    <h2 class="single-cta-item__title">NABL ACCREDITED</h2>
                    <p>Civil Engineering Materials Testing Laboratory</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100 col-12 col-md-6" style="max-width: 100%;">
                    <h2 class="single-cta-item__title">Quality Control Services</h2>
                    <p>Civil Engineering Department is empanelled by Bhimavaram Municipality</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1524178232363-1fb2b075b655_800x600.jpg" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
  <li class="si__list--single">Dr. T Vamsi Nagaraju is recognized as Institute Top 3 Researchers 2026, SRKR Engineering College.</li>
  <li class="si__list--single">Dr. T. Vamsi Nagaraju is also serving as Co-PI for the DST Science, Technology & Innovation (STI) Hub Project for inland aquaculture in Bhimavaram suburbs, with a sanctioned grant of ₹96 lakhs (2025).</li>
  <li class="si__list--single">Dr. B. R. Phanikumar is recognized as an influential researcher with an H-index of 30 and more than 3712 Google Scholar citations (2025).</li>
  <li class="si__list--single">Dr. T Vamsi Nagaraju received Best Paper Award at AIRISE 2025, Manipal University.</li>
  <li class="si__list--single">Dr. B. R. Phanikumar's impact extends far and wide with an H-index of 26 and over 2800 Google Scholar Research Citations, solidifying a reputation as an Influential Researcher in the academic community.</li>
  <li class="si__list--single">Sri Suneel Merugu recognised as NPTEL Discipline Star, NPTEL, Jan–Apr 2024.</li>
  <li class="si__list--single">Sri Nandyala Siva Kishan recognised as NPTEL Discipline Star, NPTEL, Jul–Dec 2023.</li>
  <li class="si__list--single">Sri Nandyala Siva Kishan recognised as NPTEL Believer, NPTEL, Jan–Apr 2024.</li>
  <li class="si__list--single">Sri Nandyala Siva Kishan recognised as NPTEL Motivated Learner, NPTEL, Jan–Apr 2024.</li>
  <li class="si__list--single">Sri Nandyala Siva Kishan achieved NPTEL Domain Certification, NPTEL, April 2024.</li>
  <li class="si__list--single">Sri Nandyala Siva Kishan recognised as NPTEL Enthusiast, NPTEL, Jul–Dec 2024.</li>
  <li class="si__list--single">Sri Nandyala Siva Kishan recognised as NPTEL Believer, NPTEL, Jul–Dec 2023.</li>
  <li class="si__list--single">Dr. M. Jagapathi Raju is a Chief Mentor for AICTE IDEA Lab (112.81 Lakhs grant) of SRKR Engineering College.</li>
  <li class="si__list--single">Dr. M. Jagapathi Raju received the Best Teacher Award in the year 2019.</li>
  <li class="si__list--single">Dr. P. A. Rama Krishnam Raju is the Principal Investigator for the DBT sponsored European Spring Project, EU-India Collaborative Project-SPRING: Strategic Planning for Water Resources and Implementation of Novel Biotechnical Treatment Solutions and Good Practices (2020-2025), 146.4 Lakhs.</li>
  <li class="si__list--single">Dr. G Sri Bala, Associate Professor of Civil Engineering, got Springer Best Paper Award for the work titled “Prediction of Inland Aquaculture Ammonia using Hybrid Intelligent Soft Computing” under the “Environmental Engineering” theme, International Conference on Interdisciplinary Approaches in Civil Engineering for Sustainable Development (IACESD-2023), Jyothy Institute of Technology, Bangalore, 7-8th July 2023.</li>
  <li class="si__list--single">Dr. T. Vamsi Nagaraju, Assistant Professor of Civil Engineering, got the Young Researcher Award for the year 2022, STEM research society in association with Himachal University and NIT Jalandhar, December 2022.</li>
  <li class="si__list--single">Dr. T. Vamsi Nagaraju, Assistant Professor of Civil Engineering, got the Best Oral Presentation for the work titled “Effect of chemical and pozzolanic additives on micro-structural behaviour of expansive clays”, 4th International conference on advances in civil and ecological engineering research (ACEER 2022), China (online).</li>
  <li class="si__list--single">Dr. T. Vamsi Nagaraju, Assistant Professor of Civil Engineering, got IGS – YGE Best Paper Biennial Award – 2020 for the paper entitled “New Prediction Models for Compressive Strength of GGBS-Based Geopolymer Clays Using Swarm Assisted Optimization” in the theme Computational Geomechanics by IGS-Delhi Chapter.</li>
  <li class="si__list--single">Mr. M. Suneel, Assistant Professor of Civil Engineering, got the Best Paper Award in “International Conference on Sustainable Systems and Structures”, MVGR College of Engineering, Vizianagaram, 2019, Nov 15th -16th.</li>
  <li class="si__list--single">Dr. T. Vamsi Nagaraju, Assistant Professor of Civil Engineering, got the Best Paper Award in “Young Researchers Symposium for Geotechnical Engineers”, NIT Warangal, 2018, Oct 1st -2nd.</li>
</ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
  <li class="si__list--single">Ch. Chaitanya, Ch. Hemanth, V. Bharani Prakash, L. Padma Teja Sri, K. Sree Satya Kalyani, and K. Pavan secured the Third Prize in the "Geo Quest" event at the National Surveying Competition, held at Vishnu Institute of Technology on 19th September 2026.</li>
  <li class="si__list--single">B T P Manikanta, K Yaswanth Satya Subramanayam, and G Deepak won the First Prize in the Light Weight Concrete event at Techmania 2K26, held at Bonam Venkata Chalamayya Institute, Odalarevu, on 24th February 2026.</li>
  <li class="si__list--single">P. Jnana Chaitanya, T. Chiranjeevi, R. Madhan, and A. Charan Teja secured the First Prize in the "Filter Frenzy" event at the National Level Technical Symposium 2K26 (MPa), held at Aditya University, Surampalem, on 7th March 2026.</li>
  <li class="si__list--single">S. Gopal, N. Purna Chandrika, and P. Venkanna Babu won the First Prize in the "Be Lite & Strong" event at the National Level Technical Symposium 2K26 (MPa), held at Aditya University, Surampalem, on 7th March 2026.</li>
  <li class="si__list--single">B. Venkatesh Babu, Ch. Hemanth, B. Divya, and B. Yamini won the First Prize in the Poster Presentation event at Punrava '26, held on 9th September 2026.</li>
  <li class="si__list--single">M. Rohit Das, L. Kavya, M. Vishnu Keerthi, and T. Naga Sreenu bagged the First Prize in the Ideathon event at Civilthon 2K26, held at Swarnandra Engineering College on 10th September 2026.</li>
  <li class="si__list--single">Chiru Sai Balaji and A. Kishore clinched the First Prize in the "Be Lite & Strong" event at the National Level Technical Symposium 2K25 (MPa), held at Aditya University, Surampalem, on 7th and 8th March 2025.</li>
  <li class="si__list--single">P. Krishna Raju, a student from the Department of Civil Engineering, secured the Winner position in the Technical Quiz event at Soudha 2023, held at JNTUK Kakinada, during the academic year 2022-23.</li>
  <li class="si__list--single">V. Tejaswi, N. Jahnavi, G. Srihasini, and S. Renuka Devi won the First Prize in the Epitome Fabrication event at Phoenix 2k23, organized by Shri Vishnu Engineering College for Women, Bhimavaram, held from 2nd to 4th August 2023.</li>
  <li class="si__list--single">Students V. Thirdesh, K. Bhargavi, K. Syam Kiran, K. Chandrika, and Mentor P. Raju, Assistant Professor of Civil Engineering, secured National Level First Prize worth Rs. 51000/- for Chattra Vishwakarma Award 2020 for their innovative idea “SHRAMIKS” at AICTE Headquarters, New Delhi, 2021, September 5th.</li>
  <li class="si__list--single">Students N. Satya Sundari, M. Sarvani, and T. Syam Sumanth Reddy, along with Mentor T. Vamsi Nagaraju, Assistant Professor of Civil Engineering, secured State Level First Prize worth Rs. 75000/- for their innovative idea “VR-Geo Tiles and Blocks” at Invest India, Startup India Andhra Yathra, GITAM Deemed University, Visakhapatnam, 2018, September 11th.</li>
  <li class="si__list--single">G. Satyanarayana of 2010-14 batch has received the Prathiba Award for Academic Excellence by the Government of Andhra Pradesh.</li>
  <li class="si__list--single">M. Sai Krishna of 2010-14 batch has received the Prathiba Award for Academic Excellence by the Government of Andhra Pradesh.</li>
  <li class="si__list--single">Kavali Pratyusha of 2008-12 Batch of Civil Engineering has received the University Gold Medal for Academic Excellence with a CGPA of 9.33.</li>
  <li class="si__list--single">19 out of 25 declared First Ranks in Andhra University from 1984.</li>
</ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/civil/student-achievements.jpg" alt="Student Success" loading="lazy" decoding="async" style="object-fit: contain;">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Accreditation Timeline -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">NBA Accreditation History</h2>
                  <p class="rts__section--description">The Department of Civil Engineering has maintained continuous NBA accreditation since 2002, demonstrating consistent commitment to quality education, outcome-based learning, and industry-aligned curriculum development across four consecutive accreditation cycles.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- 2002-07 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1523240795612-9a054b0db644_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2002-07</a></h4>
                        <p class="campus__life--single--description">First NBA accreditation establishing quality standards and outcome-based education framework.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2007-12 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1541829070764-84a7d30dd3f3_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2007-12</a></h4>
                        <p class="campus__life--single--description">Second accreditation recognizing continued excellence in engineering education and faculty development.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2020-23 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1581092160562-40aa08e78837_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2020-23</a></h4>
                        <p class="campus__life--single--description">Third accreditation acknowledging research growth, consultancy impact, and industry engagement.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2023-26 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1581092918056-0c4c3acd3789_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2023-26</a></h4>
                        <p class="campus__life--single--description">Current accreditation demonstrating sustained quality, innovation, and student success outcomes.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
