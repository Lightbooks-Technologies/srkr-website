---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Computer Science & Business Systems | SRKR" description="Research focus areas, industry consultancy, and innovation initiatives of the Computer Science & Business Systems department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csbs/">Computer Science &amp; Business Systems</a></li>
              </ul>
              <h1 class="section-title">Research &amp; Consultancy</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="csbs" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>Research in CSBS sits at the intersection of computer science, business systems, and applied analytics. With a curriculum co-designed by TCS, the department channels student and faculty effort into industry-relevant problems — financial analytics, enterprise data platforms, supply-chain optimisation, and digital business transformation. The department actively builds consulting and live-project partnerships with banks, IT services firms, and local enterprises to translate research into practice.</p>
              {/* TODO: Update with verified funded project counts, publication metrics, and consultancy revenue once available. */}
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="csbs-rts-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="csbs-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#csbs-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Business Analytics &amp; Decision Sciences</li>
                              <li class="si__list--single">Financial Analytics &amp; FinTech</li>
                              <li class="si__list--single">Enterprise Systems, ERP &amp; Information Systems</li>
                              <li class="si__list--single">Machine Learning for Business Applications</li>
                              <li class="si__list--single">Cloud Computing, IoT &amp; Cyber Security for Enterprises</li>
                              <li class="si__list--single">Operations Research &amp; Supply Chain Optimisation</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Innovation Cells -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-collapseTwo" aria-expanded="false">
                      Innovation Cells &amp; Centres
                    </button>
                    <div id="csbs-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#csbs-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">FinTech &amp; Business Innovation Cell</li>
                              <li class="si__list--single">Centre for Enterprise Analytics &amp; Visualisation</li>
                              <li class="si__list--single">IT Consulting &amp; Case-Study Studio</li>
                              <li class="si__list--single">Student Entrepreneurship &amp; Product Lab</li>
                            </ul>
                          </div>
                        </div>
                        {/* TODO: Replace with formal Centre-of-Excellence names once approved. */}
                      </div>
                    </div>
                  </div>

                  <!-- Funded Projects -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-collapseThree" aria-expanded="false">
                      Funded Projects &amp; Sponsored Research
                    </button>
                    <div id="csbs-collapseThree" class="accordion-collapse collapse" data-bs-parent="#csbs-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Industry-sponsored capstone projects in collaboration with TCS curriculum partners.</li>
                              <li class="si__list--single">Faculty-led proposals under AICTE/DST schemes for business analytics and digital transformation.</li>
                              <li class="si__list--single">Live-project consultancy engagements with regional banks and SMEs.</li>
                            </ul>
                          </div>
                        </div>
                        {/* TODO: List exact funded project titles, sanctioned amounts, and PIs. */}
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="csbs-collapseFour" class="accordion-collapse collapse" data-bs-parent="#csbs-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Faculty publications in Scopus / SCI-indexed journals in machine learning, analytics, and information systems.</li>
                              <li class="si__list--single">Student–faculty co-authored papers at national and international conferences.</li>
                              <li class="si__list--single">Book chapters and case studies on FinTech, ERP, and digital transformation.</li>
                            </ul>
                          </div>
                        </div>
                        {/* TODO: Insert verified publication counts and representative citations. */}
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-collapseFive" aria-expanded="false">
                      Consultancy Services
                    </button>
                    <div id="csbs-collapseFive" class="accordion-collapse collapse" data-bs-parent="#csbs-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Business Analytics &amp; Dashboarding — KPI design, BI implementations, and customer analytics.</li>
                              <li class="si__list--single">Financial Analytics &amp; Risk — credit scoring, fraud analytics, and portfolio modeling.</li>
                              <li class="si__list--single">ERP &amp; Enterprise Systems — process automation, integration, and digital transformation roadmaps.</li>
                              <li class="si__list--single">IT Strategy &amp; Cloud Migration — architecture reviews, vendor strategy, and cost optimisation.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">The department offers consultancy to local enterprises, banks, and educational institutions — providing students with first-hand exposure to client engagements alongside faculty mentors.</p>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/csbs/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/csbs/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/it/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>B.Tech Programme</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>Computer Science &amp; Business Systems<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:hod.csbs@srkrec.ac.in">hod.csbs@srkrec.ac.in</a>
                  <a href="mailto:research.csbs@srkrec.ac.in">research.csbs@srkrec.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+918842226666">+91 884 222 6666</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
