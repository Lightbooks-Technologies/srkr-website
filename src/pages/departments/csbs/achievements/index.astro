---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }

  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }

  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | Computer Science & Business Systems | SRKR" description="Department, faculty, and student achievements of the Computer Science & Business Systems department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csbs/">Computer Science &amp; Business Systems</a></li>
                <li class="breadcrumb-item active" aria-current="page">Achievements</li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="csbs" current="Achievements" />

        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                Established in 2021 with a TCS-designed curriculum and a small, mentor-rich cohort of 60, the CSBS department at SRKR has rapidly built a reputation for industry-aligned learning. Our students have already begun making a mark — through internships at leading IT services firms, success in national hackathons, and a strong first-batch placement pipeline focused on consulting, FinTech, and analytics.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1000&h=700&fit=crop" alt="CSBS Department Excellence">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">TCS</h3>
                    <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Curriculum Co-Designed with Tata Consultancy Services</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">60</h3>
                    <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Sanctioned Intake — Small Cohort, Personal Mentorship</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">2021</h3>
                    <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Department Established · First Batch Graduating 2025</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="rts-funfact-wrapper">
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">10+</h2>
                    <p>Industry 4.0 Core Courses</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">4</h2>
                    <p>Domain Elective Tracks</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">11</h2>
                    <p>Dedicated Laboratories</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">1:6</h2>
                    <p>Faculty-Mentor Ratio</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=800&h=600&fit=crop" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Faculty trained under the TCS CSBS Faculty Development Programme</li>
                      <li class="si__list--single">Publications in Scopus/SCI journals across analytics and information systems</li>
                      <li class="si__list--single">Active mentorship for student startups and capstone projects</li>
                      <li class="si__list--single">Industry collaborations with TCS, regional banks, and IT consulting firms</li>
                      <li class="si__list--single">Workshops on Power BI, SAP, Python for Finance, and Cloud Architecture</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Strong first-batch placement pipeline targeting TCS, Deloitte, Accenture, and EY</li>
                      <li class="si__list--single">Winners and finalists at Smart India Hackathon and FinTech case competitions</li>
                      <li class="si__list--single">Live-project internships with banks, IT consulting firms, and analytics startups</li>
                      <li class="si__list--single">Student-led Business Analytics Club and FinTech Innovation Forum</li>
                      <li class="si__list--single">Industry certifications in Power BI, Tableau, SAP, AWS, and Azure</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=800&h=600&fit=crop" alt="Student Success" loading="lazy" decoding="async">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Programme Milestones -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">Programme Milestones</h2>
                  <p class="rts__section--description">A young, fast-moving department building a strong foundation — from launching the TCS-designed curriculum, to fully equipping analytics and ERP labs, to shepherding the first cohort into industry-leading consulting and FinTech roles.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- 2021 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2021</a></h4>
                        <p class="campus__life--single--description">Department launched with the TCS-designed B.Tech CSBS programme and the first cohort of 60 students.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2022 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2022</a></h4>
                        <p class="campus__life--single--description">Business Analytics and ERP labs commissioned; first faculty cohort completed TCS FDP training.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2024 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2024</a></h4>
                        <p class="campus__life--single--description">First industry internships placed with TCS, banks, and analytics firms; capstone-project showcase launched.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2025 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=800&h=600&fit=crop" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2025</a></h4>
                        <p class="campus__life--single--description">First batch of CSBS graduates entering consulting, FinTech, analytics, and product engineering roles.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
