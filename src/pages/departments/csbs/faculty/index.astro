---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: Replace placeholder faculty entries with the verified CSBS faculty list from
// srkrec.ac.in / IRINS once available. Image paths follow /assets/images/faculty/csbs/<imgsrc>.jpg
const hod = [
  { name: 'Dr. K. V. Sambasiva Rao', designation: 'Associate Professor & Head of Department', specialization: 'Software Engineering & Business Systems', profile: '', imgsrc: 'PLACEHOLDER' },
];

const professors = [
  { name: 'Dr. P. Ramesh Babu',  designation: 'Professor', specialization: 'Business Analytics & Decision Sciences', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. S. Lakshmi Devi', designation: 'Professor', specialization: 'Information Systems & Enterprise Architecture', profile: '', imgsrc: 'PLACEHOLDER' },
];

const associateProfessors = [
  { name: 'Dr. M. Srinivasa Rao',   designation: 'Associate Professor', specialization: 'Software Engineering & Cloud Computing', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. K. Anusha',          designation: 'Associate Professor', specialization: 'Business Analytics & Machine Learning', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. T. Praveen Kumar',   designation: 'Associate Professor', specialization: 'Finance & Quantitative Methods',         profile: '', imgsrc: 'PLACEHOLDER' },
];

const assistantProfessors = [
  { name: 'Mr. B. Naga Raju',       designation: 'Assistant Professor', specialization: 'Data Structures & Algorithms',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. V. Sai Priya',       designation: 'Assistant Professor', specialization: 'Database Management Systems',   profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. G. Vamsi Krishna',   designation: 'Assistant Professor', specialization: 'Operations Research & Optimisation', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. R. Divya Bharathi',  designation: 'Assistant Professor', specialization: 'Web Technologies & UX',         profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. N. Karthik',         designation: 'Assistant Professor', specialization: 'Information Systems & ERP',     profile: '', imgsrc: 'PLACEHOLDER' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Computer Science & Business Systems | SRKR" description="Faculty of the Department of Computer Science & Business Systems at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csbs/">Computer Science &amp; Business Systems</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="csbs" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace PLACEHOLDER.jpg with actual faculty photo */}
                    <img src={`/assets/images/faculty/csbs/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace PLACEHOLDER.jpg with actual faculty photo */}
                    <img src={`/assets/images/faculty/csbs/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace PLACEHOLDER.jpg with actual faculty photo */}
                    <img src={`/assets/images/faculty/csbs/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace PLACEHOLDER.jpg with actual faculty photo */}
                    <img src={`/assets/images/faculty/csbs/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
