---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Academic Programs | Computer Science & Business Systems | SRKR" description="B.Tech in Computer Science & Business Systems — a TCS-designed curriculum offered by the CSBS department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csbs/">Computer Science &amp; Business Systems</a></li>
                <li class="breadcrumb-item active" aria-current="page">Academic Programs</li>
              </ul>
              <h1 class="section-title">Academic Programs</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="csbs" current="Academic Programs" />
        <div class="row sticky-coloum-wrap">
          <div class="col-lg-8 col-md-12">

            <!-- Intro -->
            <div class="program-about">
              <h4 class="title">Programs Offered</h4>
              <p>The Department of Computer Science &amp; Business Systems offers a JNTUK-affiliated four-year B.Tech programme whose curriculum is uniquely co-designed by Tata Consultancy Services (TCS) and leading academicians. The programme blends a rigorous Computer Science core with Industry 4.0 topics — Data Analytics, Machine Learning, Cloud Computing, Cyber Security, IoT — and a strong stream of management, finance, and humanities courses, producing industry-ready professionals for technology consulting, fintech, and analytics careers.</p>
            </div>

            <!-- Program Cards -->
            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Our Programs</h3>
            </div>
            <div class="row g-4 mb--40">
              <div class="col-lg-6 col-md-6">
                <div class="single-cat-item">
                  <div class="cat-thumb" style="height: 200px;">
                    <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop" alt="B.Tech CS & Business Systems" style="height: 100%; object-fit: cover;">
                    <a href="#btech" class="cat-link-btn">Undergraduate</a>
                  </div>
                  <div class="cat-meta">
                    <div class="cat-title">
                      <a href="#btech">B.Tech CS &amp; Business Systems</a>
                    </div>
                    <div class="cat-link">
                      <a href="#btech" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-6">
                <div class="single-cat-item">
                  <div class="cat-thumb" style="height: 200px;">
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop" alt="Domain Electives" style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                    <a href="#electives" class="cat-link-btn">Domain Electives</a>
                  </div>
                  <div class="cat-meta">
                    <div class="cat-title">
                      <a href="#electives">TCS Curriculum &amp; Domain Electives</a>
                    </div>
                    <div class="cat-link">
                      <a href="#electives" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Accordion: B.Tech -->
            <div id="btech" class="program-credit-area faq mt--50 rts-scholarship-description">
              <div class="rts-section mb--30">
                <h3 class="rts-section-title">B.Tech — Computer Science &amp; Business Systems</h3>
              </div>
              <div class="program-accordion">
                <div class="accordion" id="csbs-btech-accordion">

                  <!-- PEOs -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-btech-peo" aria-expanded="true">
                      Program Educational Objectives (PEOs)
                    </button>
                    <div id="csbs-btech-peo" class="accordion-collapse collapse show" data-bs-parent="#csbs-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">The PEOs define what graduates of the B.Tech CSBS programme are expected to achieve within a few years of graduation. They reflect the TCS-aligned vision of producing industry-ready professionals who combine technology expertise with business and ethical judgement.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Graduates will apply computing, analytics, and business fundamentals to design and deliver impactful technology solutions for industry and society.</li>
                              <li class="si__list--single">Graduates will integrate Industry 4.0 technologies — analytics, machine learning, cloud, IoT, and cyber security — with management principles to drive digital transformation.</li>
                              <li class="si__list--single">Graduates will demonstrate ethical leadership, effective communication, and lifelong learning, advancing as consultants, analysts, entrepreneurs, or researchers in global organisations.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- POs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-btech-po" aria-expanded="false">
                      Program Outcomes (POs)
                    </button>
                    <div id="csbs-btech-po" class="accordion-collapse collapse" data-bs-parent="#csbs-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Program Outcomes describe the knowledge, skills, and attributes that students acquire by graduation. They align with national accreditation standards and the unique CSBS focus on integrating technology with business systems.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single"><strong>Engineering Knowledge:</strong> Apply mathematics, computing, and business fundamentals to model and solve complex business-technology problems.</li>
                              <li class="si__list--single"><strong>Problem Analysis:</strong> Identify, formulate, and analyse problems across software, data, and business processes using first principles.</li>
                              <li class="si__list--single"><strong>Design &amp; Development:</strong> Design software systems, analytics pipelines, and digital business processes that meet user, regulatory, and ethical requirements.</li>
                              <li class="si__list--single"><strong>Investigation:</strong> Use data-driven research methods to investigate business problems and synthesise valid conclusions.</li>
                              <li class="si__list--single"><strong>Modern Tools:</strong> Apply contemporary tools — Python, R, SQL, cloud platforms, ERP suites, BI dashboards — for analysis, modeling, and deployment.</li>
                              <li class="si__list--single"><strong>Engineer &amp; Society:</strong> Assess the societal, legal, and cultural implications of technology choices in business contexts.</li>
                              <li class="si__list--single"><strong>Sustainability:</strong> Build digital solutions that consider environmental, economic, and organisational sustainability.</li>
                              <li class="si__list--single"><strong>Ethics:</strong> Demonstrate professional ethics, data privacy awareness, and responsibility in business and engineering practice.</li>
                              <li class="si__list--single"><strong>Teamwork:</strong> Function effectively in multidisciplinary teams of engineers, business analysts, and domain experts.</li>
                              <li class="si__list--single"><strong>Communication:</strong> Communicate technical and business ideas through reports, presentations, and dashboards to diverse audiences.</li>
                              <li class="si__list--single"><strong>Project &amp; Finance Management:</strong> Apply project, finance, and operations management principles to plan and execute technology initiatives.</li>
                              <li class="si__list--single"><strong>Lifelong Learning:</strong> Engage in continuous learning to adapt to evolving Industry 4.0 technologies and business models.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- PSOs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-btech-pso" aria-expanded="false">
                      Program Specific Outcomes (PSOs)
                    </button>
                    <div id="csbs-btech-pso" class="accordion-collapse collapse" data-bs-parent="#csbs-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">PSOs are specialised competencies that distinguish the CSBS programme. They focus on the unique convergence of computer science, business systems, and analytics that defines a CSBS graduate.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Architect and develop scalable software and analytics solutions that solve real-world business problems across finance, operations, and customer experience.</li>
                              <li class="si__list--single">Apply data analytics, machine learning, and business intelligence to translate enterprise data into actionable strategy and measurable value.</li>
                              <li class="si__list--single">Combine technology, management, and ethical reasoning to lead digital transformation projects in consulting, IT services, and fintech organisations.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Curriculum Highlights -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-btech-curr" aria-expanded="false">
                      Curriculum Highlights (4 Years · 8 Semesters)
                    </button>
                    <div id="csbs-btech-curr" class="accordion-collapse collapse" data-bs-parent="#csbs-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">The TCS-aligned curriculum sequences core computing, mathematics, business, and emerging technologies across eight semesters, culminating in a full-semester industry internship and capstone project.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single"><strong>Year 1:</strong> Programming, Mathematics for Computing, Statistics, Business Communication, Principles of Economics, Discrete Structures.</li>
                              <li class="si__list--single"><strong>Year 2:</strong> Data Structures, OOP, DBMS, Operating Systems, Computer Organization, Financial Accounting, Operations Research, Software Engineering.</li>
                              <li class="si__list--single"><strong>Year 3:</strong> Computer Networks, Design &amp; Analysis of Algorithms, Web Technologies, Data Analytics, Machine Learning, Information Systems, Enterprise Resource Planning, Business Strategy.</li>
                              <li class="si__list--single"><strong>Year 4:</strong> Cloud Computing, Cyber Security, IoT, Big Data, Domain Electives (Financial Analytics, BI, Operations Research, IT Strategy), Capstone Project &amp; Industry Internship.</li>
                            </ul>
                          </div>
                        </div>
                        {/* TODO: Link the official TCS-CSBS curriculum PDF when available */}
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>

            <!-- Accordion: TCS Curriculum Highlights / Domain Electives -->
            <div id="electives" class="program-credit-area faq mt--50 rts-scholarship-description">
              <div class="rts-section mb--30">
                <h3 class="rts-section-title">TCS Curriculum Highlights &amp; Domain Electives</h3>
              </div>
              <div class="program-accordion">
                <div class="accordion" id="csbs-electives-accordion">

                  <!-- Financial Analytics -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-elec-fin" aria-expanded="true">
                      Financial Analytics
                    </button>
                    <div id="csbs-elec-fin" class="accordion-collapse collapse show" data-bs-parent="#csbs-electives-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">A focused track preparing students for analyst and FinTech roles in banking, capital markets, and risk advisory.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Financial Modeling &amp; Valuation, Quantitative Finance, Risk Analytics.</li>
                              <li class="si__list--single">Algorithmic Trading, Time Series Forecasting, Credit &amp; Fraud Analytics.</li>
                              <li class="si__list--single">Tools: Excel/VBA, Python (pandas, statsmodels), R, Bloomberg-style market data feeds.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Business Intelligence -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-elec-bi" aria-expanded="false">
                      Business Intelligence
                    </button>
                    <div id="csbs-elec-bi" class="accordion-collapse collapse" data-bs-parent="#csbs-electives-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Transform enterprise data into dashboards, reports, and decisions for product, marketing, and operations leaders.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Data Warehousing, ETL Pipelines, Dimensional Modeling, OLAP.</li>
                              <li class="si__list--single">Dashboarding &amp; Visualisation with Power BI, Tableau, Looker.</li>
                              <li class="si__list--single">Customer Analytics, Marketing Mix Modeling, KPI Design.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Operations Research -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-elec-or" aria-expanded="false">
                      Operations Research
                    </button>
                    <div id="csbs-elec-or" class="accordion-collapse collapse" data-bs-parent="#csbs-electives-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Apply mathematical optimisation and simulation to solve supply chain, scheduling, and resource allocation problems.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Linear &amp; Integer Programming, Network Flows, Queuing Theory.</li>
                              <li class="si__list--single">Supply Chain Analytics, Inventory Optimisation, Discrete-Event Simulation.</li>
                              <li class="si__list--single">Tools: AMPL, Gurobi/CPLEX, Python (PuLP, SimPy).</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- IT Strategy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#csbs-elec-it" aria-expanded="false">
                      IT Strategy &amp; Consulting
                    </button>
                    <div id="csbs-elec-it" class="accordion-collapse collapse" data-bs-parent="#csbs-electives-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Prepare for IT consulting and digital transformation roles at firms like TCS, Deloitte, Accenture, and the Big Four.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Enterprise Architecture, IT Governance, Digital Transformation Frameworks.</li>
                              <li class="si__list--single">Service Management (ITIL), Vendor &amp; Sourcing Strategy, Cloud Economics.</li>
                              <li class="si__list--single">Case-based learning with consulting frameworks and real client problem statements.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>

          </div>

          <!-- Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="theiaStickySidebar">

              <!-- Program Links -->
              <div class="program-sidebar">
                <div class="program-curriculum">
                  <h6 class="heading-title">CSBS Programs</h6>
                  <div class="program-menu">
                    <ul class="list-unstyled">
                      <li><a href="/departments/csbs/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Members</a></li>
                      <li><a href="/departments/csbs/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Facilities &amp; Labs</a></li>
                      <li><a href="/departments/csbs/research-consultancy/"><span><i class="fa-light fa-arrow-right"></i></span>Research &amp; Projects</a></li>
                      <li><a href="/departments/csbs/placements/"><span><i class="fa-light fa-arrow-right"></i></span>Placements</a></li>
                      <li><a href="/departments/csbs/achievements/"><span><i class="fa-light fa-arrow-right"></i></span>Achievements</a></li>
                    </ul>
                  </div>
                </div>
                <!-- Image -->
                <div class="program-event-image mt-4">
                  <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=600&h=800&fit=crop" alt="CSBS Campus Life" style="width: 100%; height: auto; display: block;" loading="lazy" decoding="async">
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
