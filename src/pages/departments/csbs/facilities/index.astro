---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Programming Lab (C, Python, Java)',          img: '/assets/images/placeholder/photo-1517694712202-14dd9538aa97_800x600.jpg' },
  { name: 'Data Structures & Algorithms Lab',            img: '/assets/images/placeholder/photo-1555066931-4365d14bab8c_800x600.jpg' },
  { name: 'Database Management Systems Lab',             img: '/assets/images/placeholder/photo-1544383835-bda2bc66a55d_800x600.jpg' },
  { name: 'Operating Systems & Networks Lab',            img: '/assets/images/placeholder/photo-1573164713988-8665fc963095_800x600.jpg' },
  { name: 'Web Technologies Lab',                        img: '/assets/images/placeholder/photo-1498050108023-c5249f4df085_800x600.jpg' },
  { name: 'Business Analytics Lab (Power BI, Tableau)',  img: '/assets/images/placeholder/photo-1551288049-bebda4e38f71_800x600.jpg' },
  { name: 'ERP Lab (SAP / Odoo Sandboxes)',              img: '/assets/images/placeholder/photo-1460925895917-afdab827c52f_800x600.jpg' },
  { name: 'Financial Modeling Lab (Python, R, Excel)',   img: '/assets/images/placeholder/photo-1611974789855-9c2a0a7236a3_800x600.jpg' },
  { name: 'IT Consulting & Case-Study Studio',           img: '/assets/images/placeholder/photo-1454165804606-c3d57bc86b40_800x600.jpg' },
  { name: 'Software Engineering & DevOps Lab',           img: '/assets/images/placeholder/photo-1542831371-29b0f74f9713_800x600.jpg' },
  { name: 'Capstone Project Lab',                        img: '/assets/images/placeholder/photo-1522071820081-009f0129c71c_800x600.jpg' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Computer Science & Business Systems | SRKR" description="Laboratories and digital infrastructure of the Computer Science & Business Systems department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csbs/">Computer Science &amp; Business Systems</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="csbs" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The CSBS department is equipped with modern computing laboratories, business analytics studios, and ERP sandboxes that mirror real industry environments. Students work hands-on with Python, R, SQL, cloud platforms, Power BI, Tableau, SAP, and financial modeling tools — the same stack used by leading IT consulting and FinTech firms. Each lab is designed to support the TCS-aligned curriculum and the small-cohort, mentor-rich learning model of the department.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
