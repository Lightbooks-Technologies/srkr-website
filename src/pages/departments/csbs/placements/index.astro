---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const years = ['2025–26', '2024–25', '2023–24', '2022–23'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Placements | Computer Science & Business Systems | SRKR" description="Placement records and recruiter network of the Computer Science & Business Systems department at SRKR Engineering College." />
    <style>
      .recruiter-logo-box {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100px;
        transition: all 0.3s ease;
      }
      .recruiter-logo-box:hover {
        border-color: #1a3c6b;
        box-shadow: 0 4px 12px rgba(26, 60, 107, 0.1);
        transform: translateY(-2px);
      }
      .recruiter-logo-box img {
        max-width: 100%;
        max-height: 60px;
        object-fit: contain;
        transition: filter 0.3s ease;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csbs/">Computer Science &amp; Business Systems</a></li>
                <li class="breadcrumb-item active" aria-current="page">Placements</li>
              </ul>
              <h2 class="section-title">Placements</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40">
      <div class="container">
        <DeptNav dept="csbs" current="Placements" />
      </div>
    </section>

    <!-- About Placements -->
    <section class="rts-about-university pb--80">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">Placements</h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                The CSBS department combines a TCS-aligned technical curriculum with a focused career-readiness programme — preparing graduates for roles in IT consulting, business analytics, FinTech, ERP, and product engineering. With an intake of just 60, every student receives personal mentorship, mock interview support, and direct exposure to curriculum-partner TCS and other premier recruiters.
              </p>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <div class="academic-picture">
              <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1200&h=400&fit=crop" alt="placements" style="max-height: 400px; object-fit: cover;">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Multi Row Sections -->
    <div class="rts-multi-row-section pb--80">
      <div class="container">
        <!-- Top Recruiters -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center">
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&h=600&fit=crop" alt="top recruiters" style="border-radius: 10px;">
            </div>
          </div>
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content">
              <h4 class="row-title">Top Recruiters</h4>
              <p>As the curriculum design partner, <strong>TCS</strong> remains the anchor recruiter for CSBS graduates, joined by leading consulting and FinTech firms — Deloitte, Accenture, EY, KPMG — and major banks and IT services companies.</p>
              <div class="row g-4 mt-3">
                {/* TODO: Replace placeholder recruiter logos with verified CSBS recruiter list and add Deloitte / Accenture / EY / KPMG / bank logos. */}
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/tcs.png" alt="Tata Consultancy Services" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/cts.png" alt="Cognizant Technology Solutions" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/infosys.png" alt="Infosys" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/ey.png" alt="Ernst & Young" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/hcl.png" alt="HCL Technologies" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/wipro.png" alt="Wipro" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/tm.png" alt="Tech Mahindra" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/lt.png" alt="L&T Infotech" />
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/ncc.png" alt="NCC Limited" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Placement Training -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center mt--80">
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content left-side">
              <h4 class="row-title">Placement Training</h4>
              <p>A focused training pipeline that prepares CSBS students for both technical interviews and business-case rounds expected by consulting firms and FinTech recruiters.</p>
              <div class="program-list">
                <a href="#" class="program-item"><span>Technical &amp; Coding Interview Prep <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Business Case &amp; Guesstimate Training <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Analytics &amp; SQL/Excel Bootcamps <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Resume Building &amp; Mock Interviews <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Group Discussion &amp; Soft-Skill Sessions <i class="fa-regular fa-chevron-right"></i></span></a>
              </div>
            </div>
          </div>
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=800&h=600&fit=crop" alt="placement training" style="border-radius: 10px;">
            </div>
          </div>
        </div>

        <!-- Year-wise Records -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center mt--80">
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop" alt="placement records" style="border-radius: 10px;">
            </div>
          </div>
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content">
              <h4 class="row-title">Year-wise Placement Records</h4>
              <p>Download detailed placement reports with company names, packages offered, and student achievements for each academic year.</p>
              <div class="program-list">
                {/* TODO: Upload year-wise PDFs to /assets/documents/ once first-batch placement data is verified. */}
                {years.map(year => (
                  <a href={`/assets/documents/csbs-placements-${year.replace('–', '-')}.pdf`} class="program-item" target="_blank">
                    <span>{year} Placement Report <i class="fa-regular fa-chevron-right"></i></span> <span>PDF</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Multi Row Sections End -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
