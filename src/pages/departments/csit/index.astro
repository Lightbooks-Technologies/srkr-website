---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';
import DeptNav from '../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Department of Computer Science & Information Technology | SRKR Engineering College" description="Department of Computer Science & Information Technology at SRKR Engineering College, Bhimavaram — established 2020, modern industry-aligned B.Tech program." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Computer Science & Information Technology</li>
              </ul>
              <h1 class="section-title">Department of Computer Science & Information Technology</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- content -->
    <div class="rts-faculty-details py-5">
      <div class="container">

        <DeptNav dept="csit" current="Home" />

        <!-- About the Department -->
        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-6 col-md-11">
            <div class="faculty-content-text me-5">
              <h3 class="rts-section-title mb-5">About the Department</h3>
              <p>The Department of Computer Science and Engineering (IoT) focuses on intelligent sensing, connected platforms, real-time systems, and cloud-integrated application development.</p>
              <p>Students learn to combine core computer science principles with device programming, data flow management, and distributed system thinking required for smart environments.</p>
              <p>The program encourages interdisciplinary innovation through project-centric learning in areas such as smart cities, healthcare monitoring, industrial automation, and intelligent infrastructure.</p>
            </div>
          </div>
          <div class="col-lg-6 col-md-11">
            <div class="ratio ratio-16x9 mt-5 mt-lg-0">
              <iframe
                src="https://www.youtube.com/embed/GQigLJ6iV4Y?html5=1&enablejsapi=1"
                title="SRKR Department Video"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Message from HoD -->
        <div class="row mt--30">
          <div class="rts-section mb--60">
            <h3 class="rts-section-title">Message from Program Coordinator</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-8">
            <div class="faculty-image text-center">
              {/* TODO: Replace with actual Program Coordinator photo at /assets/images/faculty/csit/PLACEHOLDER.jpg */}
              <img class="img-fluid mw-100" src="/assets/images/faculty/csit/PLACEHOLDER.jpg" alt="Dr. Y. Kiran Kumar">
              <div class="h5 mb-2 mt-5">Dr. Y. Kiran Kumar</div>
              <span>Associate Professor &amp; Program Coordinator</span>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faculty-content-text ms-lg-5 mt-5 mt-lg-0">
              <p class="h6 mb-4">Welcome to the Department of Computer Science &amp; Information Technology</p>
              <p class="mb-5">The Department of Computer Science &amp; Information Technology (CSIT) at SRKR Engineering College is a modern, future-focused department offering a four-year B.Tech program that fuses the rigour of Computer Science with the applied breadth of Information Technology. Since its inception, CSIT has grown rapidly — driven by industry demand, strong curriculum, and the rich infrastructure of SRKR's Technology Centre.</p>
              <p class="h6 mb-4">An Industry-Aligned Curriculum</p>
              <p class="mb-5">Our curriculum balances core computing foundations — data structures, algorithms, databases, operating systems, and networks — with high-demand specializations such as Full-Stack Web Development, Cloud Computing, Artificial Intelligence &amp; Machine Learning, DevOps, and Cybersecurity. Students learn through project-based courses, full-semester internships, and hands-on lab work that mirrors real engineering workflows.</p>
              <p class="h6 mb-4">A Launchpad for Modern Tech Careers</p>
              <p>CSIT students have full access to the Technology Centre's AICTE IDEA Lab, Innovation Centre, on-campus start-ups and 400+ high-performance computing systems. With mentorship from industry-experienced faculty, active coding communities, and a strong placements pipeline, our graduates are well-prepared for careers as software engineers, full-stack developers, cloud engineers, data scientists, and entrepreneurs. I invite you to explore the department and join us in building the next generation of technologists.</p>
            </div>
          </div>

          <div class="border-top my-60"></div>

          <!-- Mission & Vision -->
          <div class="row align-items-center justify-content-md-center">
            <div class="col-lg-6 col-md-11 rts-scholarship-description">
              <div class="faculty-content-text si__list me-5">

                <h4 class="font-32 mb-3 mt-4">Vision</h4>
                <ul class="list-unstyled one-column-list mb-0">
                  <li class="mb-3">To be a centre of excellence in Computer Science &amp; Information Technology education, fostering innovation, research and entrepreneurship aligned with the evolving needs of the digital economy.</li>
                  <li>To mould socially responsible technologists who design, build and operate the software, data and cloud systems that shape modern society.</li>
                </ul>

                <h4 class="font-32 mb-4">Mission</h4>
                <ul class="list-unstyled one-column-list">
                  <li class="mb-3">To deliver an industry-aligned, project-driven curriculum that combines strong computing fundamentals with emerging technologies in cloud, AI and full-stack development.</li>
                  <li class="mb-3">To cultivate a culture of continuous learning, open-source contribution and applied research through hackathons, internships and start-up exposure.</li>
                  <li class="mb-3">To develop ethical, articulate and team-oriented professionals who can lead, collaborate and innovate in diverse global technology organisations.</li>
                </ul>

              </div>
            </div>
            <div class="col-lg-6 col-md-11">
              <figure class="mt-5 mt-lg-0">
                {/* TODO: Replace with CSIT department / Technology Centre photo */}
                <img class="mw-100" src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop" alt="CSIT Technology Centre" loading="lazy" decoding="async">
              </figure>
            </div>
          </div>
        </div>

        <!-- Core Specializations -->
        <div class="row g-5 faculty-sub-details rts-section-padding">
          <div class="rts-section mb-4 text-center">
            <h3 class="rts-section-title">Core Specializations</h3>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=600&h=380&fit=crop" alt="Full-Stack Development" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/csit/research-consultancy/">Full-Stack Web Development</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/csit/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=380&fit=crop" alt="Cloud Computing" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/csit/research-consultancy/">Cloud Computing &amp; DevOps</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/csit/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=380&fit=crop" alt="AI / ML" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/csit/research-consultancy/">Artificial Intelligence &amp; ML</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/csit/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=600&h=380&fit=crop" alt="Cybersecurity" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/csit/research-consultancy/">Cybersecurity &amp; Networks</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/csit/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Academics & Programs -->
        <div class="row justify-content-md-center g-0">
          <div class="rts-section mb--60 text-center">
            <h3 class="rts-section-title">Academics &amp; Programs</h3>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Undergraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">B.Tech CS &amp; Information Technology
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">4-Year JNTUK Affiliated
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">Sanctioned Intake — 120
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">Industry-Aligned Curriculum
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item v__2">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Honors &amp; Minors</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">B.Tech Honors — AI/ML
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">B.Tech Honors — Cybersecurity
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">Minor — Full-Stack &amp; Cloud
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/academic-programs/" class="link__list">Minor — Data Science
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Innovation</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/research-consultancy/" class="link__list">AICTE IDEA Lab Access
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/research-consultancy/" class="link__list">On-Campus Start-Up Mentorship
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/research-consultancy/" class="link__list">Hackathons &amp; Coding Clubs
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/csit/research-consultancy/" class="link__list">Technology Centre Infrastructure
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
    <!-- content end -->

    <!-- Department Highlights -->
    <div class="rts-blog v_1 rts__light rts-section-padding">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-md-11 col-lg-12">
            <div class="rts-section rts-border-bottom-1 mb--50 pb--20">
              <h2 class="rts-section-title text-uppercase">Department Highlights</h2>
              <p class="rts-section-description">A young, rapidly-growing department powered by SRKR's Technology Centre and industry partnerships.</p>
            </div>
          </div>
        </div>
        <div class="row g-5 justify-content-md-center">
          <div class="col-md-11 col-lg-6">
            <div class="rts-blog-post blog-v-full">
              <div class="single-blog-post">
                <a href="/departments/csit/achievements/" class="blog-thumb">
                  <img src="/assets/images/blog/big-thumb-1.jpg" alt="Industry-Aligned Program" loading="lazy" decoding="async">
                </a>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-laptop-code"></i></span>
                      <a href="#">Curriculum</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Established 2020 · Intake 120</span>
                    </div>
                  </div>
                  <a href="/departments/csit/achievements/" class="post-title">
                    Modern, industry-aligned B.Tech in Computer Science &amp; Information Technology.
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-11 col-lg-6">
            <div class="rts-blog-post">
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/csit/facilities/">
                    <img src="/assets/images/blog/small-thumb-1.jpg" alt="Technology Centre" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-server"></i></span>
                      <a href="#">Infrastructure</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>400+ High-Performance Systems</span>
                    </div>
                  </div>
                  <a href="/departments/csit/facilities/" class="post-title">
                    Access to AICTE IDEA Lab, Innovation Centre &amp; 24×7 Technology Hubs.
                  </a>
                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/csit/placements/">
                    <img src="/assets/images/blog/small-thumb-2.jpg" alt="Placements" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-briefcase"></i></span>
                      <a href="#">Placements</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Strong First-Batch Outcomes</span>
                    </div>
                  </div>
                  <a href="/departments/csit/placements/" class="post-title">
                    Recruiters include TCS, Infosys, Wipro, Cognizant, HCL and Tech Mahindra.
                  </a>
                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/csit/research-consultancy/">
                    <img src="/assets/images/blog/small-thumb-3.jpg" alt="Innovation" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-lightbulb-on"></i></span>
                      <a href="#">Innovation</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Start-Ups &amp; Hackathons</span>
                    </div>
                  </div>
                  <a href="/departments/csit/research-consultancy/" class="post-title">
                    On-campus start-up incubation and active participation in national hackathons.
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Department Highlights end -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    </style>
  </body>
</html>
