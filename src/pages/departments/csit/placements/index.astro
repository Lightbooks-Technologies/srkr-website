---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const years = ['2025–26', '2024–25', '2023–24'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Placements | Computer Science & Information Technology | SRKR" description="Placement records of the Computer Science & Information Technology department at SRKR Engineering College." />
    <style>
      .recruiter-logo-box {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100px;
        transition: all 0.3s ease;
      }
      .recruiter-logo-box:hover {
        border-color: #1a3c6b;
        box-shadow: 0 4px 12px rgba(26, 60, 107, 0.1);
        transform: translateY(-2px);
      }
      .recruiter-logo-box img {
        max-width: 100%;
        max-height: 60px;
        object-fit: contain;
        transition: filter 0.3s ease;
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csit/">Computer Science & Information Technology</a></li>
              </ul>
              <h1 class="section-title">Placements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40">
      <div class="container">
        <DeptNav dept="csit" current="Placements" />
      </div>
    </section>

    <!-- About Placements -->
    <section class="rts-about-university pb--80">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">Placements</h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                The Department of Computer Science &amp; Information Technology partners with leading IT services firms, product companies and start-ups to deliver strong placement outcomes. Students are prepared through a structured Training &amp; Placement program covering aptitude, coding, full-stack development, cloud, AI/ML and communication skills — backed by year-round mentorship from the Technology Centre.
              </p>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <div class="academic-picture">
              {/* TODO: Replace with real CSIT placement event photo */}
              <img src="/assets/images/placeholder/photo-1521737711867-e3b97375f902_1200x400.jpg" alt="placements" style="max-height: 400px; object-fit: cover;">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Multi Row Sections -->
    <div class="rts-multi-row-section pb--80">
      <div class="container">
        <!-- Top Recruiters -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center">
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="/assets/images/placeholder/photo-1573164574511-73c773193279_800x600.jpg" alt="top recruiters" style="border-radius: 10px;" loading="lazy" decoding="async">
            </div>
          </div>
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content">
              <h4 class="row-title">Top Recruiters</h4>
              <p>Major IT services, product and consulting companies regularly recruit CSIT graduates for software, cloud and data roles.</p>
              <div class="row g-4 mt-3">
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/tcs.png" alt="Tata Consultancy Services" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/cts.png" alt="Cognizant Technology Solutions" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/infosys.png" alt="Infosys" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/wipro.png" alt="Wipro" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/hcl.png" alt="HCL Technologies" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/tm.png" alt="Tech Mahindra" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/ey.png" alt="Ernst & Young" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/lt.png" alt="L&T Infotech" / loading="lazy" decoding="async">
                  </div>
                </div>
                <div class="col-4">
                  <div class="recruiter-logo-box">
                    <img src="/assets/images/recruiters/ncc.png" alt="NCC Limited" / loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Placement Training -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center mt--80">
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content left-side">
              <h4 class="row-title">Placement Training</h4>
              <p>The Training &amp; Placement Cell, supported by the Technology Centre, offers continuous upskilling so students enter recruitment season interview-ready.</p>
              <div class="program-list">
                <a href="#" class="program-item"><span>Aptitude &amp; Quantitative Reasoning <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Data Structures &amp; Coding Bootcamps <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Full-Stack &amp; Cloud Project Builds <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Resume Building &amp; LinkedIn Optimization <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="#" class="program-item"><span>Mock Interviews &amp; Group Discussions <i class="fa-regular fa-chevron-right"></i></span></a>
              </div>
            </div>
          </div>
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="/assets/images/placeholder/photo-1542744173-8e7e53415bb0_800x600.jpg" alt="placement training" style="border-radius: 10px;" loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <!-- Year-wise Records -->
        <div class="row g-5 justify-content-center justify-content-start align-items-center mt--80">
          <div class="col-lg-7 col-md-11">
            <div class="rts-multi-row-image">
              <img src="/assets/images/placeholder/photo-1460925895917-afdab827c52f_800x600.jpg" alt="placement records" style="border-radius: 10px;" loading="lazy" decoding="async">
            </div>
          </div>
          <div class="col-lg-5 col-md-11">
            <div class="rts-multi-row-content">
              <h4 class="row-title">Year-wise Placement Records</h4>
              <p>Download detailed placement reports with company names, packages and student achievements for each academic year.</p>
              <div class="program-list">
                {years.map(year => (
                  <a href={`/assets/documents/csit-placements-${year.replace('–', '-')}.pdf`} class="program-item" target="_blank">
                    <span>{year} Placement Report <i class="fa-regular fa-chevron-right"></i></span> <span>PDF</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Multi Row Sections End -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
