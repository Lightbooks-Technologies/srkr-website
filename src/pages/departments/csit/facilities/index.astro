---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Programming Lab (C, Python, Java)',                img: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&h=600&fit=crop' },
  { name: 'Data Structures & Algorithms Lab',                  img: 'https://images.unsplash.com/photo-1542831371-29b0f74f9713?w=800&h=600&fit=crop' },
  { name: 'Database Management Systems Lab',                   img: 'https://images.unsplash.com/photo-1544383835-bda2bc66a55d?w=800&h=600&fit=crop' },
  { name: 'Operating Systems Lab',                             img: 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&h=600&fit=crop' },
  { name: 'Web Technologies Lab',                              img: 'https://images.unsplash.com/photo-1547658719-da2b51169166?w=800&h=600&fit=crop' },
  { name: 'Computer Networks Lab',                             img: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&h=600&fit=crop' },
  { name: 'AI & Machine Learning Lab',                         img: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=600&fit=crop' },
  { name: 'Cloud Computing Lab',                               img: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&h=600&fit=crop' },
  { name: 'Cybersecurity Lab',                                 img: 'https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=800&h=600&fit=crop' },
  { name: 'Project & Capstone Lab',                            img: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&h=600&fit=crop' },
  { name: 'Research & Innovation Lab (Technology Centre)',     img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Computer Science & Information Technology | SRKR" description="Laboratories and computing facilities of the Computer Science & Information Technology department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csit/">Computer Science & Information Technology</a></li>
                <li class="breadcrumb-item active" aria-current="page">Facilities</li>
              </ul>
              <h2 class="section-title">Facilities</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="csit" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The department operates a suite of modern laboratories — spanning programming, databases, networks, cloud, AI/ML and cybersecurity — backed by the broader infrastructure of SRKR's Technology Centre. Students enjoy access to the AICTE IDEA Lab, the Innovation Centre, on-campus start-up workspaces and a fleet of 400+ high-performance systems available 24×7 for projects, hackathons and research work.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      {/* TODO: Replace Unsplash image with real lab photo */}
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
