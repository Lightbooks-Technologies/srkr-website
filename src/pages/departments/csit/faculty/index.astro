---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: Replace placeholder faculty data with the official CSIT faculty list once published.
// Faculty photos should be placed at /assets/images/faculty/csit/{imgsrc}.jpg
const hod = [
  { name: 'Dr. Y. Kiran Kumar', designation: 'Associate Professor & Head of Department', specialization: 'Cloud Computing & Software Engineering', profile: '', imgsrc: 'PLACEHOLDER' },
];

const professors = [
  { name: 'Dr. A. Suresh Kumar',     designation: 'Professor', specialization: 'Artificial Intelligence & Machine Learning', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. B. Lakshmi Narayana', designation: 'Professor', specialization: 'Data Science & Big Data Analytics',          profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. C. Venkateswara Rao', designation: 'Professor', specialization: 'Cybersecurity & Computer Networks',          profile: '', imgsrc: 'PLACEHOLDER' },
];

const associateProfessors = [
  { name: 'Dr. Y. Kiran Kumar',  designation: 'Associate Professor', specialization: 'Cloud Computing & Software Engineering', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. P. Naga Lakshmi', designation: 'Associate Professor', specialization: 'Full-Stack Web Development',             profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. K. Ravi Kumar',   designation: 'Associate Professor', specialization: 'Operating Systems & Distributed Computing', profile: '', imgsrc: 'PLACEHOLDER' },
];

const assistantProfessors = [
  { name: 'Mr. M. Sai Krishna',     designation: 'Assistant Professor', specialization: 'Data Structures & Algorithms',     profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. T. Hemalatha',       designation: 'Assistant Professor', specialization: 'Database Management Systems',      profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. N. Pavan Kumar',     designation: 'Assistant Professor', specialization: 'DevOps & Site Reliability Engineering', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. R. Sravani',         designation: 'Assistant Professor', specialization: 'Machine Learning & NLP',            profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. V. Sandeep',         designation: 'Assistant Professor', specialization: 'Mobile Application Development',    profile: '', imgsrc: 'PLACEHOLDER' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Computer Science & Information Technology | SRKR" description="Faculty of the Department of Computer Science & Information Technology at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csit/">Computer Science & Information Technology</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="csit" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace /assets/images/faculty/csit/PLACEHOLDER.jpg with real HoD photo */}
                    <img src={`/assets/images/faculty/csit/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile ? (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    ) : (
                      <a href="#" class="rts-theme-btn border-btn">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with real faculty photo */}
                    <img src={`/assets/images/faculty/csit/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile ? (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    ) : (
                      <a href="#" class="rts-theme-btn border-btn">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with real faculty photo */}
                    <img src={`/assets/images/faculty/csit/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile ? (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    ) : (
                      <a href="#" class="rts-theme-btn border-btn">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with real faculty photo */}
                    <img src={`/assets/images/faculty/csit/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile ? (
                      <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                    ) : (
                      <a href="#" class="rts-theme-btn border-btn">VIDWAN Profile</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
