---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: replace placeholder faculty images at /assets/images/faculty/eee/<imgsrc>.jpg with real photographs.

const hod = [
  { name: 'Dr. B. Ravi Kumar Varma', designation: 'Professor & Head of Department', specialization: 'Power Systems & High Voltage Engineering', profile: '', imgsrc: 'hod' },
];

const professors = [
  { name: 'Dr. M. Venu Gopala Rao',  designation: 'Professor', specialization: 'Power Systems',           profile: '', imgsrc: 'prof-1' },
  { name: 'Dr. K. Sreenivasa Rao',   designation: 'Professor', specialization: 'Power Electronics & Drives', profile: '', imgsrc: 'prof-2' },
  { name: 'Dr. V. Subba Rao',        designation: 'Professor', specialization: 'Electrical Machines',     profile: '', imgsrc: 'prof-3' },
  { name: 'Dr. P. Srinivasa Varma',  designation: 'Professor', specialization: 'Control Systems & Automation', profile: '', imgsrc: 'prof-4' },
];

const associateProfessors = [
  { name: 'Dr. G. Naga Lakshmi',     designation: 'Associate Professor', specialization: 'Renewable Energy Systems', profile: '', imgsrc: 'assoc-1' },
  { name: 'Dr. A. Suresh Kumar',     designation: 'Associate Professor', specialization: 'Power Systems Protection', profile: '', imgsrc: 'assoc-2' },
  { name: 'Dr. K. Ramesh Babu',      designation: 'Associate Professor', specialization: 'Power Electronics',        profile: '', imgsrc: 'assoc-3' },
];

const assistantProfessors = [
  { name: 'Sri. S. V. R. Murthy',    designation: 'Assistant Professor', specialization: 'Electrical Machines',      profile: '', imgsrc: 'asst-1' },
  { name: 'Sri. P. Anil Kumar',      designation: 'Assistant Professor', specialization: 'Power Systems',            profile: '', imgsrc: 'asst-2' },
  { name: 'Smt. K. Padmavathi',      designation: 'Assistant Professor', specialization: 'Control Systems',          profile: '', imgsrc: 'asst-3' },
  { name: 'Sri. M. Naga Raju',       designation: 'Assistant Professor', specialization: 'Power Electronics & EV',   profile: '', imgsrc: 'asst-4' },
  { name: 'Smt. B. Lakshmi Prasanna',designation: 'Assistant Professor', specialization: 'Renewable Energy',         profile: '', imgsrc: 'asst-5' },
  { name: 'Sri. T. Sai Krishna',     designation: 'Assistant Professor', specialization: 'High Voltage Engineering', profile: '', imgsrc: 'asst-6' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Electrical & Electronics Engineering | SRKR" description="Faculty of the Department of Electrical & Electronics Engineering at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="eee" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real HoD photograph */}
                    <img src={`/assets/images/faculty/eee/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photograph */}
                    <img src={`/assets/images/faculty/eee/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photograph */}
                    <img src={`/assets/images/faculty/eee/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photograph */}
                    <img src={`/assets/images/faculty/eee/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
