---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  // UG Labs
  { name: 'Electrical Machines Laboratory', type: 'UG Lab', img: '/assets/images/eee/electrical-machines-lab.jpg' },
  { name: 'Basic Electrical System Laboratory', type: 'UG Lab', img: '/assets/images/eee/basic-electric-systems-lab.jpg' },
  { name: 'Networks Laboratory', type: 'UG Lab', img: '/assets/images/eee/networks-lab.jpg' },
  { name: 'Digital Design Laboratory', type: 'UG Lab', img: '/assets/images/eee/digital-design-lab.jpg' },
  { name: 'Electrical Systems Simulation Laboratory', type: 'UG Lab', img: '/assets/images/eee/simulation-lab.jpg' },
  { name: 'Smart System Laboratory', type: 'UG Lab', img: '/assets/images/eee/smart-system.jpg' },
  { name: 'Power Electronics Laboratory', type: 'UG Lab', img: '/assets/images/eee/power-electronics-lab.jpg' },
  { name: 'Microprocessor and Microcontroller Laboratory', type: 'UG Lab', img: '/assets/images/eee/microprocessors-lab.jpg' },
  { name: 'Electronics Engineering Workshop', type: 'UG Lab', img: '/assets/images/eee/electronics-workshop.jpg' },
  { name: 'Solar Energy Systems Laboratory', type: 'UG Lab', img: '/assets/images/eee/solar-energy-systems-lab.jpg' },
  { name: 'Robotics & Control System Laboratory', type: 'UG Lab', img: '/assets/images/eee/robotics-lab.jpg' },
  { name: 'Electric Vehicles Laboratory', type: 'UG Lab', img: '/assets/images/eee/electric-vehicles-lab.jpg' },
  { name: 'Tinkering Laboratory', type: 'UG Lab', img: '/assets/images/eee/tinkering-lab.jpg' },
  { name: 'Design Thinking Laboratory', type: 'UG Lab', img: '/assets/images/eee/sadhana-projects-lab.jpg' },
  
  // PG Labs
  { name: 'Power System Laboratory', type: 'PG Lab', img: '/assets/images/eee/pg-simulation-lab.jpg' },
  { name: 'Power Electronics for Renewable Integration Lab', type: 'PG Lab', img: '/assets/images/eee/ses-lab.jpg' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3.5rem;
    display: flex;
    align-items: center;
  }

  /* Optional styling tweak for the thumb badge based on type */
  .cat-link-btn.pg-badge {
    background-color: var(--rts-primary, #880e4f) !important;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Electrical & Electronics Engineering | SRKR" description="Laboratories and research facilities of the Electrical & Electronics Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/eee/eeehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="eee" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The department maintains well-equipped UG and PG laboratories supporting B.Tech and M.Tech courses, project work, and advanced research. Facilities range from foundational electrical systems, networks, and machines benches to modern setups for power electronics, renewable integration, robotics, electric vehicles, and power system simulation using state-of-the-art tools. These labs also support specialized innovation, design thinking, and consultancy services to industry and utilities.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class={`cat-link-btn ${lab.type === 'PG Lab' ? 'pg-badge' : ''}`}>
                        {lab.type}
                      </a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>