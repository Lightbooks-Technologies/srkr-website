---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Electrical Circuits Lab',                        img: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=800&h=600&fit=crop' },
  { name: 'Electrical Machines Lab',                        img: 'https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=800&h=600&fit=crop' },
  { name: 'Power Systems Lab',                              img: 'https://images.unsplash.com/photo-1473968512647-3e447244af8f?w=800&h=600&fit=crop' },
  { name: 'Power Electronics Lab',                          img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop' },
  { name: 'Control Systems Lab',                            img: 'https://images.unsplash.com/photo-1565043666747-69f6646db940?w=800&h=600&fit=crop' },
  { name: 'Electrical Measurements & Instrumentation Lab',  img: 'https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?w=800&h=600&fit=crop' },
  { name: 'MATLAB / Simulink Lab',                          img: 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&h=600&fit=crop' },
  { name: 'Renewable Energy Lab',                           img: 'https://images.unsplash.com/photo-1466611653911-95081537e5b7?w=800&h=600&fit=crop' },
  { name: 'High Voltage Engineering Lab',                   img: 'https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?w=800&h=600&fit=crop' },
  { name: 'Microprocessors & Microcontrollers Lab',         img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop' },
  { name: 'PSCAD / Power System Simulation Lab',            img: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=800&h=600&fit=crop' },
  { name: 'Project & Innovation Lab',                       img: 'https://images.unsplash.com/photo-1581092162384-8987c1d64718?w=800&h=600&fit=crop' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Electrical & Electronics Engineering | SRKR" description="Laboratories and research facilities of the Electrical & Electronics Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Facilities</li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="eee" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The department maintains twelve well-equipped laboratories supporting B.Tech and M.Tech courses, project work, and research. Facilities range from foundational electrical circuits and machines benches to modern setups for power electronics, control systems, renewable energy, high voltage testing, and large-scale power system simulation using MATLAB/Simulink and PSCAD. These labs also support consultancy services to industry and utilities.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
