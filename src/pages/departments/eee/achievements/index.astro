---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }

  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }

  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | Electrical & Electronics Engineering | SRKR" description="Department, faculty, and student achievements of the Electrical & Electronics Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/eee/eeehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="eee" current="Achievements" />

        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                The Department of Electrical &amp; Electronics Engineering at SRKR has built a four-decade legacy of academic and professional excellence. With NBA accreditation, strong research output, active industry collaboration, and a long record of student success in placements and competitive exams, the department continues to set benchmarks in EEE education.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                <img src="/assets/images/placeholder/photo-1473341304170-971dccb5ac1e_800x600.jpg" alt="Electrical & Electronics Engineering Department">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">NBA</h3>
                    <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>B.Tech EEE NBA Accredited Programme</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">100+</h3>
                    <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Research Publications in SCI/Scopus Journals</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">30+</h3>
                    <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Years of EEE Education Excellence</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="rts-funfact-wrapper justify-content-sm-between">
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">14</h2>
                    <p>Modern Laboratories</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">180</h2>
                    <p>B.Tech Sanctioned Intake</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">95%+</h2>
                    <p>Pass Percentage</p>
                  </div>
                  <div class="single-cta-item max-w-sm-100">
                    <h2 class="single-cta-item__title">50+</h2>
                    <p>Recruiting Companies</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1581094794329-c8112a89af12_800x600.jpg" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Nearly 120 research papers published by the faculty in various national and international journals and conferences</li>
                      <li class="si__list--single">A national level workshop on “Modern Trends in Power Systems” was held during 1st and 2nd June, 2005</li>
                      <li class="si__list--single">A workshop on “Digital Control on Power Electronics Applications” was held on 24th to 26th July, 2014, by resource persons Mr. Adapa Anil Kumar and Mr. Arjun Yadav from IISc, Bengaluru</li>
                      <li class="si__list--single">Every year, a national level tech fest called “SANKALP” is organized by the Department of EEE</li>
                      <li class="si__list--single">A special alumni workshop called “APOORVA” is organized by the department to strengthen alumni relations through expert talks from distinguished alumni and other prominent people</li>
                      <li class="si__list--single">The 2nd edition of “APOORVA” was organized on 9th and 10th of August</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Five consecutive University first ranks from 1998 to 2002; from 2003 onwards, ranks were yet to be announced by A.U.</li>
                      <li class="si__list--single">Mr. M.N.V. SatyaKiran scored All India 1st Rank with 99.99 percentile in GATE 2000</li>
                      <li class="si__list--single">Seven students scored more than 99.00 percentile in GATE 2005</li>
                      <li class="si__list--single">Mr. Adapa Anil Kumar secured All India 2nd Rank with 99.99 percentile in GATE 2009</li>
                      <li class="si__list--single">Many students from this department pursue post-graduation in IISc, IITs, NITs, and other premier institutions around the world</li>
                      <li class="si__list--single">Alumni of the department work in prestigious organizations like WIPRO, TCS, Tech Mahindra, Syntel, and in central government organizations such as GE, BHEL, NTPC, Power Grid, CPRI, SAIL, and Steel Plant</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg" alt="Student Success" loading="lazy" decoding="async">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Accreditation Timeline -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">Accreditation &amp; Milestones</h2>
                  <p class="rts__section--description">Established in 1994, the Department of Electrical &amp; Electronics Engineering has consistently evolved its curriculum, infrastructure, and research orientation to align with the changing electrical industry. NBA accreditation cycles affirm the department's commitment to outcome-based education and continuous quality improvement.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- 1980 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1473341304170-971dccb5ac1e_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">1994</a></h4>
                        <p class="campus__life--single--description">Department of Electrical &amp; Electronics Engineering established with B.Tech programme, intake 60.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2000s -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1581094794329-c8112a89af12_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2010</a></h4>
                        <p class="campus__life--single--description">M.Tech Power Systems and Automation introduced.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2010s
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1466611653911-95081537e5b7_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2010s</a></h4>
                        <p class="campus__life--single--description">NBA accreditation cycles, growth in funded research and renewable energy initiatives.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div> -->
                  <!-- 2020s -->
                  <!-- <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1565043666747-69f6646db940_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2020s</a></h4>
                        <p class="campus__life--single--description">Autonomy, EV and smart-grid focus areas, industry MoUs and modernised value-added courses.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div> -->
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
