---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: replace placeholder committee data and member images with real records.

// DAC Committee Members
const dacMembers = [
  { name: 'Dr. B.R.K.Varma', role: 'Chairman\nProfessor & Head', link: '', image: '221' },
  { name: 'Dr. P. Kantarao', role: 'Member\nProfessor', link: '', image: '693' },
  { name: 'Prof. N.Srinivasu', role: 'Member\nProfessor', link: '', image: '283' },
  { name: 'Dr. R V D Ramarao', role: 'Member\nProfessor & Head, VIT, Bhimavaram (Expert from outside Institute)', link: '', image: '' },
  { name: 'P. Madhusudhana Rao', role: 'Member\nAssistant Professor, RGUKT, Nuzvidu (Alumni)', link: '', image: '' },
  { name: 'B. Satyanarayana', role: 'Member\nLecturer in English, Sri Y.N.College, Narsapur. (Parent)', link: '', image: '' },
  { name: 'V.V.N.S.S.R.M.Krishna Varma', role: 'Member\nEngineer, BHEL, Banglore. (Industry Person)', link: '', image: '' }
];

// BoS Committee Members
const bosMembers = [
  { name: 'Dr. B.R.K. Varma', role: 'Chairman\nProfessor & Head Dept. of EEE SRKR Engineering College China Amiram, Bhimavaram-534204', link: '', image: '221' },
  { name: 'Dr. K. Ravindra, Ph. D', role: 'JNTUK Nominee\nProfessor Department of Electrical & Electronics Engineering UCEK, JNTUK, Kakinada.', link: '', image: 'DrKRavindraPhD' },
  { name: 'Dr. Ravikumar Bhimasingu, Ph. D (IISc Bangalore)', role: 'Experts from other Universities\nProfessor Department of Electrical Engineering Indian Institute of Technology Hyderabad – 502284.', link: '', image: 'Ravikumar_Bhimasingu' },
  { name: 'Dr. Vuddanti Sandeep, Ph. D (IIT Delhi)', role: 'Experts from other Universities\nAssociate Professor Department of Electrical Engineering National Institute of Technology Andhra Pradesh – 534101.', link: '', image: 'Dr.VuddantiSandeep' },
  { name: 'Dr. Adapa Anil, Ph. D (IISc Bangalore)', role: 'Industry Experts\nDirector of Electrical Engineering Ohmium Bangalore. Karnataka – 560078.', link: '', image: 'Dr.AdapaAnil' },
  { name: 'Dr. P.V.N Mohan Krishna, Ph. D (IIT Bhubaneswar)', role: 'Alumni\nMarket Research and Analyst Hitachi Energy, Bhorukha Tech Park, Mahadevapura, Banglore. Karnataka – 560078.', link: '', image: 'V.naga-Mohan-Krishna-P' },
];

// PAQIC Committee Members
const paqicMembers = [
  { name: 'Dr. B. Ravi Kumar Varma', role: 'Chairman',    link: '', image: 'hod' },
  { name: 'Dr. M. Venu Gopala Rao',  role: 'Coordinator', link: '', image: 'prof-1' },
  { name: 'Dr. K. Sreenivasa Rao',   role: 'Member',      link: '', image: 'prof-2' },
  { name: 'Dr. V. Subba Rao',        role: 'Member',      link: '', image: 'prof-3' },
  { name: 'Dr. G. Naga Lakshmi',     role: 'Member',      link: '', image: 'assoc-1' },
  { name: 'Dr. A. Suresh Kumar',     role: 'Member',      link: '', image: 'assoc-2' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .cat-title {
    margin-bottom: 0.5rem;
  }

  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }

  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | Electrical & Electronics Engineering | SRKR" description="Department committees of the Electrical & Electronics Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/eee/eeehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
              </ul>
              <h1 class="section-title">Committees</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="eee" current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Departmental Academic Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/eee/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/eee/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/eee/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
