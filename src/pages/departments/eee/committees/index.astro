---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: replace placeholder committee data and member images with real records.

// DAC Committee Members
const dacMembers = [
  { name: 'Dr. B. Ravi Kumar Varma', role: 'Chairman',    link: '', image: 'hod' },
  { name: 'Dr. M. Venu Gopala Rao',  role: 'Coordinator', link: '', image: 'prof-1' },
  { name: 'Dr. K. Sreenivasa Rao',   role: 'Member',      link: '', image: 'prof-2' },
  { name: 'Dr. V. Subba Rao',        role: 'Member',      link: '', image: 'prof-3' },
  { name: 'Dr. P. Srinivasa Varma',  role: 'Member',      link: '', image: 'prof-4' },
  { name: 'Dr. G. Naga Lakshmi',     role: 'Member',      link: '', image: 'assoc-1' },
  { name: 'Dr. A. Suresh Kumar',     role: 'Member',      link: '', image: 'assoc-2' },
  { name: 'Dr. K. Ramesh Babu',      role: 'Member',      link: '', image: 'assoc-3' },
];

// BoS Committee Members
const bosMembers = [
  { name: 'Dr. B. Ravi Kumar Varma', role: 'Chairman\nProfessor and Head, EEE', link: '', image: 'hod' },
  { name: 'Dr. P. Linga Reddy (JNTUK Nominee)', role: 'Member\nProfessor, Dept. of EEE, JNTUK', link: '', image: 'bos-1' },
  { name: 'Dr. S. Rama Krishna (Expert from Other University)', role: 'Member\nProfessor (NIT Warangal)', link: '', image: 'bos-2' },
  { name: 'Dr. K. Hari Babu (Expert from Research Organization)', role: 'Member\nPrincipal Scientist (CPRI)', link: '', image: 'bos-3' },
  { name: 'Sri. V. Sreenivas (Expert from Industry)', role: 'Member\nGM, APTRANSCO, Hyderabad', link: '', image: null },
  { name: 'Dr. M. Venu Gopala Rao', role: 'Member\nProfessor, Dept. of EEE, SRKR', link: '', image: 'prof-1' },
];

// PAQIC Committee Members
const paqicMembers = [
  { name: 'Dr. B. Ravi Kumar Varma', role: 'Chairman',    link: '', image: 'hod' },
  { name: 'Dr. M. Venu Gopala Rao',  role: 'Coordinator', link: '', image: 'prof-1' },
  { name: 'Dr. K. Sreenivasa Rao',   role: 'Member',      link: '', image: 'prof-2' },
  { name: 'Dr. V. Subba Rao',        role: 'Member',      link: '', image: 'prof-3' },
  { name: 'Dr. G. Naga Lakshmi',     role: 'Member',      link: '', image: 'assoc-1' },
  { name: 'Dr. A. Suresh Kumar',     role: 'Member',      link: '', image: 'assoc-2' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .cat-title {
    margin-bottom: 0.5rem;
  }

  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }

  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | Electrical & Electronics Engineering | SRKR" description="Department committees of the Electrical & Electronics Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Committees</li>
              </ul>
              <h1 class="section-title">Committees</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="eee" current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Departmental Academic Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/eee/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/eee/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  <img src={`/assets/images/faculty/eee/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
