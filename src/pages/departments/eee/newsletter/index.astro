---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const newsletters = [
  {
    title: 'January–June 2022',
    description: 'Department newsletter for the first half of 2022.',
    href: '/assets/documents/eee/newsletters/2022jan-june.pdf',
  },
  {
    title: 'July–December 2022',
    description: 'Department newsletter for the second half of 2022.',
    href: '/assets/documents/eee/newsletters/2022july-dec.pdf',
  },
  {
    title: 'January–June 2023',
    description: 'Department newsletter for the first half of 2023.',
    href: '/assets/documents/eee/newsletters/2023jan-june.pdf',
  },
  {
    title: 'July–December 2023',
    description: 'Department newsletter for the second half of 2023.',
    href: '/assets/documents/eee/newsletters/2023july-dec.pdf',
  },
  {
    title: 'January–June 2024',
    description: 'Department newsletter for the first half of 2024.',
    href: '/assets/documents/eee/newsletters/2024jan-june.pdf',
  },
  {
    title: 'July–December 2024',
    description: 'Department newsletter for the second half of 2024.',
    href: '/assets/documents/eee/newsletters/2024july-dec.pdf',
  },
  {
    title: 'January–June 2025',
    description: 'Department newsletter for the first half of 2025.',
    href: '/assets/documents/eee/newsletters/2025jan-june.pdf',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Newsletter | Electrical & Electronics Engineering | SRKR" description="Department newsletters from the Electrical & Electronics Engineering department at SRKR Engineering College." />
    <style>
      .newsletter-item {
        border: 1px solid #e5e5e5;
        border-radius: 0px;
        padding: 15px;
        background: #fff;
        transition: all 0.3s ease;
        margin-bottom: 24px;
      }
      .newsletter-item:hover {
        box-shadow: 0 8px 24px rgba(139, 15, 29, 0.1);
        border-color: #8b0f1d;
      }
      .newsletter-content-wrapper {
        display: flex;
        align-items: center;
        gap: 30px;
      }
      .newsletter-icon {
        flex-shrink: 0;
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #8b0f1d 0%, #8b0f1d 100%);
        border-radius: 0px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 32px;
      }
      .newsletter-content {
        flex: 1;
      }
      .newsletter-title {
        font-size: 22px;
        font-weight: 600;
        color: #8b0f1d;
        margin-bottom: 12px;
        line-height: 1.3;
      }
      .newsletter-period {
        display: inline-block;
        background: #f0f4f8;
        color: #1a3c6b;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 12px;
      }
      .newsletter-description {
        color: #666;
        font-size: 15px;
        line-height: 1.6;
        margin: 0;
      }
      .newsletter-action {
        flex-shrink: 0;
      }
      .newsletter-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: #8b0f1d;
        color: white;
        border-radius: 0px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
      }
      .newsletter-btn:hover {
        background: #6b0c16;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(139, 15, 29, 0.3);
      }
      @media (max-width: 768px) {
        .newsletter-content-wrapper {
          flex-direction: column;
          text-align: center;
        }
        .newsletter-action {
          width: 100%;
        }
        .newsletter-btn {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/eee/eeehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/eee/">Electrical &amp; Electronics Engineering</a></li>
              </ul>
              <h1 class="section-title">Newsletter</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="eee" current="Newsletter" />
        <div class="row">
          <div class="col-12">
            {newsletters.map((newsletter) => (
              <div class="newsletter-item">
                <div class="newsletter-content-wrapper">
                  <div class="newsletter-icon">
                    <i class="fa-regular fa-newspaper"></i>
                  </div>
                  <div class="newsletter-content">
                    <h5 class="newsletter-title">{newsletter.title}</h5>
                    <p class="newsletter-description">{newsletter.description}</p>
                  </div>
                  <div class="newsletter-action">
                    <a href={newsletter.href} class="newsletter-btn" target="_blank">
                      <i class="fa-regular fa-download"></i>
                      <span>Download PDF</span>
                    </a>
                  </div>
                </div>
              </div>
            ))}
            <p class="text-muted small" style="margin-top: 24px;"><i class="fa-regular fa-info-circle"></i> <em>Older issues will be available shortly.</em></p>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
