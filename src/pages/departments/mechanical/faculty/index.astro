---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: replace placeholder faculty images at /assets/images/faculty/mechanical/<imgsrc>.jpg with real photographs.

const hod = [
  { name: 'Dr. K. Sita Rama Raju', designation: 'Professor & Head of Department', specialization: 'Thermal Engineering & Heat Transfer', profile: '', imgsrc: 'hod' },
];

const professors = [
  { name: 'Dr. K. Kishore',            designation: 'Professor', specialization: 'Industrial Engineering & Production',  profile: '', imgsrc: 'prof-1' },
  { name: 'Dr. P. Srinivasa Rao',      designation: 'Professor', specialization: 'Thermal Engineering & IC Engines',     profile: '', imgsrc: 'prof-2' },
  { name: 'Dr. V. V. S. Kesava Rao',   designation: 'Professor', specialization: 'CAD/CAM & Machine Design',             profile: '', imgsrc: 'prof-3' },
  { name: 'Dr. M. Ramesh Babu',        designation: 'Professor', specialization: 'Manufacturing Technology & Metallurgy', profile: '', imgsrc: 'prof-4' },
];

const associateProfessors = [
  { name: 'Dr. G. Naga Mallikarjuna Rao', designation: 'Associate Professor', specialization: 'Refrigeration & Air Conditioning', profile: '', imgsrc: 'assoc-1' },
  { name: 'Dr. T. Sreenivasulu',          designation: 'Associate Professor', specialization: 'Strength of Materials & Solid Mechanics', profile: '', imgsrc: 'assoc-2' },
  { name: 'Dr. A. V. Sridhar',            designation: 'Associate Professor', specialization: 'Mechatronics & Robotics',          profile: '', imgsrc: 'assoc-3' },
];

const assistantProfessors = [
  { name: 'Sri. B. Naga Raju',         designation: 'Assistant Professor', specialization: 'Machine Design & FEA',           profile: '', imgsrc: 'asst-1' },
  { name: 'Sri. P. Phani Kumar',       designation: 'Assistant Professor', specialization: 'Thermal Engineering & CFD',      profile: '', imgsrc: 'asst-2' },
  { name: 'Sri. K. V. Subba Rao',      designation: 'Assistant Professor', specialization: 'Production Engineering',         profile: '', imgsrc: 'asst-3' },
  { name: 'Sri. M. Venkata Rao',       designation: 'Assistant Professor', specialization: 'Automotive Engineering & EV',    profile: '', imgsrc: 'asst-4' },
  { name: 'Smt. D. Lakshmi Padma',     designation: 'Assistant Professor', specialization: 'CAD/CAM & Computer Aided Design', profile: '', imgsrc: 'asst-5' },
  { name: 'Sri. S. Hari Krishna',      designation: 'Assistant Professor', specialization: 'Manufacturing & Quality Engineering', profile: '', imgsrc: 'asst-6' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Mechanical Engineering | SRKR" description="Faculty of the Department of Mechanical Engineering at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/mechanical/">Mechanical Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="mechanical" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real HoD photograph */}
                    <img src={`/assets/images/faculty/mechanical/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photograph */}
                    <img src={`/assets/images/faculty/mechanical/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photograph */}
                    <img src={`/assets/images/faculty/mechanical/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photograph */}
                    <img src={`/assets/images/faculty/mechanical/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
