---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';
import DeptNav from '../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Department of Mechanical Engineering | SRKR Engineering College" description="Department of Mechanical Engineering at SRKR Engineering College, Bhimavaram — established 1980, NBA accredited (4x), offering B.Tech ME and M.Tech Thermal Engineering." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mechanical Engineering</li>
              </ul>
              <h1 class="section-title">Department of Mechanical Engineering</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- content -->
    <div class="rts-faculty-details py-5">
      <div class="container">

        <DeptNav dept="mechanical" current="Home" />

        <!-- About the Department -->
        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-6 col-md-11">
            <div class="faculty-content-text me-5">
              <h3 class="rts-section-title mb-5">About the Department</h3>
              <p>The Department of Mechanical Engineering offers a broad foundation in design, manufacturing, thermal sciences, materials, and industrial engineering.</p>
              <p>Learning is strengthened through laboratory-intensive courses, CAD/CAE tools, workshop practice, and problem-solving approaches aligned with modern engineering needs.</p>
              <p>Students undertake projects in product development, automation, energy systems, and emerging technologies to build innovation capability and practical confidence.</p>
            </div>
          </div>
          <div class="col-lg-6 col-md-11">
            <div class="ratio ratio-16x9 mt-5 mt-lg-0">
              <iframe
                src="https://www.youtube.com/embed/GQigLJ6iV4Y?html5=1&enablejsapi=1"
                title="SRKR Department Video"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Message from HoD -->
        <div class="row mt--30">
          <div class="rts-section mb--60">
            <h3 class="rts-section-title">Message from Head of Department</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-8">
            <div class="faculty-image text-center">
              {/* TODO: replace with real HoD photograph at /assets/images/faculty/mechanical/hod.jpg */}
              <img class="img-fluid mw-100" src="/assets/images/faculty/mechanical/528.jpg" alt="Dr. K. Sita Rama Raju">
              <div class="h5 mb-2 mt-5">Dr. K. Sita Rama Raju</div>
              <span>Professor &amp; Head of Department</span>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faculty-content-text ms-lg-5 mt-5 mt-lg-0">
              <p class="h6 mb-4">Welcome to the Department of Mechanical Engineering</p>
              <p class="mb-5">Established in 1980, the Department of Mechanical Engineering is one of the oldest and largest departments at SRKR Engineering College. Over four decades, our NBA-accredited B.Tech programme, M.Tech in Thermal Engineering, and recognised Ph.D. research centre have produced generations of engineers who design, build, and lead in industries ranging from automotive and aerospace to manufacturing, energy, and robotics.</p>
              <p class="h6 mb-4">Where Theory Meets the Workshop Floor</p>
              <p class="mb-5">Our curriculum blends rigorous fundamentals in thermodynamics, design, manufacturing, and mechatronics with hands-on training across twelve well-equipped laboratories — from a fully-fledged Engineering Workshop and IC Engines Lab to modern CAD/CAM, CNC, and Robotics facilities. Students gain practical exposure on industry-standard tools such as AutoCAD, SolidWorks, ANSYS, CATIA, and PRO-E, complemented by internships, value-added courses, and live industry projects.</p>
              <p class="h6 mb-4">Research, Industry &amp; Society</p>
              <p>The department is a recognised research centre of Andhra University and JNTUK, with active work in thermal systems, advanced materials, CFD, electric mobility, and Industry 4.0. With 43 faculty members, more than 300 research publications, and consultancy and MoUs with leading industry partners, our graduates step confidently into roles at core manufacturers, automotive majors, PSUs such as BHEL, DRDO and ISRO, and global IT services. I warmly invite you to explore our department and look forward to welcoming you into our community.</p>
            </div>
          </div>

          <div class="border-top my-60"></div>

          <!-- Mission & Vision -->
          <div class="row align-items-center justify-content-md-center">
            <div class="col-lg-6 col-md-11 rts-scholarship-description">
              <div class="faculty-content-text si__list me-5">

                <h4 class="font-32 mb-3 mt-4">Vision</h4>
                <ul class="list-unstyled one-column-list mb-0">
                  <li class="mb-3">To be recognised globally for quality education, training, and research, leading to well-qualified engineers who are innovative, entrepreneurial, and successful in solving the problems of society.</li>
                </ul>

                <h4 class="font-32 mb-4">Mission</h4>
                <ul class="list-unstyled one-column-list">
                  <li class="mb-3">To impart quality education to students to enhance their skills and make them globally competitive mechanical engineers.</li>
                  <li class="mb-3">To maintain a vital and state-of-the-art research environment providing students and faculty opportunities to create, interpret, apply, and disseminate knowledge.</li>
                  <li class="mb-3">To prepare graduates to pursue higher studies, serve the profession, and meet intellectual, ethical, and career challenges.</li>
                </ul>

              </div>
            </div>
            <div class="col-lg-6 col-md-11">
              <figure class="mt-5 mt-lg-0">
                <img class="mw-100" src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=900&h=600&fit=crop" alt="Mechanical Engineering" loading="lazy" decoding="async">
              </figure>
            </div>
          </div>
        </div>

        <!-- Core Specializations -->
        <div class="row g-5 faculty-sub-details rts-section-padding">
          <div class="rts-section mb-4 text-center">
            <h3 class="rts-section-title">Core Specializations</h3>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=600&h=380&fit=crop" alt="Thermal Engineering" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/mechanical/research-consultancy/">Thermal Engineering</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/mechanical/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1517077304055-6e89abbf09b0?w=600&h=380&fit=crop" alt="Design & CAD/CAM" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/mechanical/research-consultancy/">Design &amp; CAD/CAM</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/mechanical/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1581094271901-8022df4466f9?w=600&h=380&fit=crop" alt="Manufacturing & CNC" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/mechanical/research-consultancy/">Manufacturing &amp; CNC</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/mechanical/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="single-cat-item civil-spec-card">
              <div class="cat-thumb civil-spec-thumb">
                <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&h=380&fit=crop" alt="Mechatronics & Robotics" loading="lazy" decoding="async">
              </div>
              <div class="cat-meta">
                <div class="cat-title">
                  <a href="/departments/mechanical/research-consultancy/">Mechatronics &amp; Robotics</a>
                </div>
                <div class="cat-link">
                  <a href="/departments/mechanical/research-consultancy/" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Academics & Programs -->
        <div class="row justify-content-md-center g-0">
          <div class="rts-section mb--60 text-center">
            <h3 class="rts-section-title">Academics &amp; Programs</h3>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Undergraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">B.Tech Mechanical Engineering
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">4-Year JNTUK Affiliated
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">NBA Accredited (4×)
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">Industry-Aligned Curriculum
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item v__2">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Postgraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">M.Tech Thermal Engineering
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">2-Year JNTUK Affiliated
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">Advanced CAD &amp; Simulation Studios
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/academic-programs/" class="link__list">Research &amp; Thesis Track
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-4 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Research</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/research-consultancy/" class="link__list">Ph.D. Programs (JNTUK &amp; AU)
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/research-consultancy/" class="link__list">CFD, Thermal &amp; Materials Research
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/research-consultancy/" class="link__list">Industry MoUs &amp; Consultancy
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/departments/mechanical/research-consultancy/" class="link__list">300+ Research Publications
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
    <!-- content end -->

    <!-- Department Highlights -->
    <div class="rts-blog v_1 rts__light rts-section-padding">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-md-11 col-lg-12">
            <div class="rts-section rts-border-bottom-1 mb--50 pb--20">
              <h2 class="rts-section-title text-uppercase">Department Highlights</h2>
              <p class="rts-section-description">Four decades of excellence in mechanical engineering education, research, and industry partnerships.</p>
            </div>
          </div>
        </div>
        <div class="row g-5 justify-content-md-center">
          <div class="col-md-11 col-lg-6">
            <div class="rts-blog-post blog-v-full">
              <div class="single-blog-post">
                <a href="/departments/mechanical/achievements/" class="blog-thumb">
                  <img src="/assets/images/blog/big-thumb-1.jpg" alt="NBA Accreditation" loading="lazy" decoding="async">
                </a>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-award"></i></span>
                      <a href="#">Accreditation</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>NBA Accredited 4 Times</span>
                    </div>
                  </div>
                  <a href="/departments/mechanical/achievements/" class="post-title">
                    NBA-accredited four times — a mark of sustained academic quality in ME.
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-11 col-lg-6">
            <div class="rts-blog-post">
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/mechanical/research-consultancy/">
                    <img src="/assets/images/blog/small-thumb-1.jpg" alt="Research Centres" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-flask"></i></span>
                      <a href="#">Research</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Recognised Research Centre</span>
                    </div>
                  </div>
                  <a href="/departments/mechanical/research-consultancy/" class="post-title">
                    Recognised research centre of Andhra University and JNTUK with 300+ publications.
                  </a>
                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/mechanical/placements/">
                    <img src="/assets/images/blog/small-thumb-2.jpg" alt="Placements" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-briefcase"></i></span>
                      <a href="#">Placements</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>Core + IT Recruiters</span>
                    </div>
                  </div>
                  <a href="/departments/mechanical/placements/" class="post-title">
                    Recruitment by L&amp;T, Mahindra, Tata Motors, Ashok Leyland, BHEL, TCS and more.
                  </a>
                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/mechanical/facilities/">
                    <img src="/assets/images/blog/small-thumb-3.jpg" alt="Facilities" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-gears"></i></span>
                      <a href="#">Facilities</a>
                    </div>
                    <div class="rt-date">
                      <span><i class="fal fa-calendar"></i></span>
                      <span>12 Modern Laboratories</span>
                    </div>
                  </div>
                  <a href="/departments/mechanical/facilities/" class="post-title">
                    Twelve labs — including CNC, CAD/CAM, Robotics, IC Engines and Heat Transfer.
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Department Highlights end -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      /* Equal-height specialization cards */
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    </style>
  </body>
</html>
