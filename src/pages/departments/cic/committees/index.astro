---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: Replace placeholder committee members with the official CIC committee composition once published.
// Member photos should be placed at /assets/images/faculty/cic/{image}.jpg
const dacMembers = [
  { name: 'Dr. S. Suresh Kumar',    role: 'Chairman',    link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. A. Ravi Kumar',      role: 'Coordinator', link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. B. Srinivasa Rao',   role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. P. Naga Lakshmi',    role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. K. Venkata Krishna', role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Mr. M. Sai Krishna',     role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Ms. T. Hemalatha',       role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Mr. N. Pavan Kumar',     role: 'Member',      link: '', image: 'PLACEHOLDER' },
];

const bosMembers = [
  { name: 'Dr. S. Suresh Kumar',                                   role: 'Chairman\nAssociate Professor and Head', link: '', image: 'PLACEHOLDER' },
  { name: 'Prof. (JNTUK Nominee)',                                 role: 'Member\nProfessor, Dept. of CSE, JNTUK',  link: '', image: 'PLACEHOLDER' },
  { name: 'Expert from Other University',                          role: 'Member\nAcademic Expert (TODO)',          link: '', image: 'PLACEHOLDER' },
  { name: 'Expert from Research Organization',                     role: 'Member\nScientist, IoT / Cyber Security (TODO)', link: '', image: 'PLACEHOLDER' },
  { name: 'Industry Expert — Cyber Security',                      role: 'Member\nIndustry Leader, InfoSec (TODO)',  link: '', image: 'PLACEHOLDER' },
  { name: 'Industry Expert — Blockchain',                          role: 'Member\nIndustry Leader, Blockchain (TODO)', link: '', image: 'PLACEHOLDER' },
];

const paqicMembers = [
  { name: 'Dr. S. Suresh Kumar',    role: 'Chairman',    link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. A. Ravi Kumar',      role: 'Coordinator', link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. B. Srinivasa Rao',   role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. P. Naga Lakshmi',    role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. K. Venkata Krishna', role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Mr. M. Sai Krishna',     role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Ms. T. Hemalatha',       role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Mr. N. Pavan Kumar',     role: 'Member',      link: '', image: 'PLACEHOLDER' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .cat-title {
    margin-bottom: 0.5rem;
  }

  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }

  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | CSE — IoT, Cybersecurity & Blockchain | SRKR" description="Department committees (DAC, BoS, PAQIC) of the CSE (IoT, Cyber Security & Blockchain Technology) department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cic/">CSE — IoT, Cybersecurity & Blockchain</a></li>
                <li class="breadcrumb-item active" aria-current="page">Committees</li>
              </ul>
              <h2 class="section-title">Committees</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="cic" current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Departmental Academic Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: Replace with real committee member photo */}
                  <img src={`/assets/images/faculty/cic/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: Replace with real committee member photo */}
                  <img src={`/assets/images/faculty/cic/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: Replace with real committee member photo */}
                  <img src={`/assets/images/faculty/cic/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
