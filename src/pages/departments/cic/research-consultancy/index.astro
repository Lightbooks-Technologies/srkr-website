---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | CSE — IoT, Cybersecurity & Blockchain | SRKR" description="Research areas, student projects, hackathons and consultancy focus of the CSE (IoT, Cyber Security & Blockchain Technology) department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cic/">CSE — IoT, Cybersecurity & Blockchain</a></li>
                <li class="breadcrumb-item active" aria-current="page">Research &amp; Consultancy</li>
              </ul>
              <h1 class="section-title">Research &amp; Consultancy</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="cic" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>As a young department launched in 2022, CIC is rapidly building a research portfolio focused on the three pillars that define the next decade of computing — connected devices, cybersecurity, and decentralized trust. Our faculty and students collaborate on applied projects in smart city sensing, network security, blockchain-based identity, and edge AI. Students participate in national CTF competitions, responsible bug-bounty programs, blockchain hackathons and IoT project expos, with mentorship from industry practitioners through SRKR's Technology Centre.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="cic-research-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cic-research-areas" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="cic-research-areas" class="accordion-collapse collapse show" data-bs-parent="#cic-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Internet of Things — wireless sensor networks, IoT protocols, smart city &amp; smart agriculture systems.</li>
                              <li class="si__list--single">Cyber Security — network &amp; web application security, intrusion detection, malware analysis, digital forensics.</li>
                              <li class="si__list--single">Applied Cryptography — post-quantum primitives, zero-knowledge proofs, secure multi-party computation.</li>
                              <li class="si__list--single">Blockchain Technology — smart-contract design, DeFi, decentralized identity, supply-chain provenance.</li>
                              <li class="si__list--single">Edge Computing &amp; TinyML — on-device intelligence for low-power and privacy-preserving applications.</li>
                              <li class="si__list--single">Cyber-Physical Systems — secure industrial automation and Industry 4.0 deployments.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Focus Groups & Clubs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cic-focus-groups" aria-expanded="false">
                      Focus Groups &amp; Student Clubs
                    </button>
                    <div id="cic-focus-groups" class="accordion-collapse collapse" data-bs-parent="#cic-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">SRKR CTF Squad — Capture-the-Flag team participating in national and inter-college hacking competitions.</li>
                              <li class="si__list--single">IoT Makers Club — sensor-to-cloud prototyping group running quarterly hardware build sprints.</li>
                              <li class="si__list--single">Blockchain Builders — Web3, Solidity and smart-contract development community.</li>
                              <li class="si__list--single">Bug Bounty &amp; Responsible Disclosure Cell — coordinated student participation in industry bug-bounty programs.</li>
                              <li class="si__list--single">Cyber Awareness Outreach — student-led awareness sessions for schools and the local community.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Projects -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cic-projects" aria-expanded="false">
                      Student &amp; Faculty Projects
                    </button>
                    <div id="cic-projects" class="accordion-collapse collapse" data-bs-parent="#cic-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: Replace with actual departmental projects */}Smart Campus IoT — energy, occupancy and air-quality sensing deployed across academic blocks.</li>
                              <li class="si__list--single">Blockchain-based Academic Credential Verification — tamper-proof transcript and certificate verification.</li>
                              <li class="si__list--single">Phishing &amp; URL Reputation Engine — ML-driven detection trained on real-world phishing corpora.</li>
                              <li class="si__list--single">Edge ML for Crop Disease Detection — on-device inference for rural smart-agriculture deployments.</li>
                              <li class="si__list--single">Secure Voting DApp — Solidity-based prototype demonstrating cryptographic voter privacy.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cic-publications" aria-expanded="false">
                      Publications &amp; Patents
                    </button>
                    <div id="cic-publications" class="accordion-collapse collapse" data-bs-parent="#cic-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: Update once verified */}Growing portfolio of peer-reviewed publications in IoT, cyber security and blockchain venues.</li>
                              <li class="si__list--single">Conference contributions at IEEE, Springer and ACM-affiliated symposia in security and connected systems.</li>
                              <li class="si__list--single">Active patent disclosures in IoT systems and blockchain-based identity (under preparation).</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cic-consultancy" aria-expanded="false">
                      Consultancy &amp; Industry Engagement
                    </button>
                    <div id="cic-consultancy" class="accordion-collapse collapse" data-bs-parent="#cic-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Service Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Vulnerability Assessment &amp; Penetration Testing (VAPT) for regional businesses and educational institutions.</li>
                              <li class="si__list--single">IoT prototyping and proof-of-concept development for smart-city and Industry 4.0 use cases.</li>
                              <li class="si__list--single">Blockchain advisory — proof-of-concept smart contracts and feasibility studies for SMEs.</li>
                              <li class="si__list--single">Corporate training in cyber-hygiene, ethical hacking and applied cryptography.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">{/* TODO: Update once formal consultancy assignments are recorded. */}The department actively partners with start-ups and regional industry to co-develop secure, connected and decentralized solutions.</p>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/cic/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/cic/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/cic/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>Specialization Tracks</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>CSE (IoT, Cyber Security &amp; Blockchain Technology)<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:hod.cic@srkrec.ac.in">hod.cic@srkrec.ac.in</a>
                  <a href="mailto:research.cic@srkrec.ac.in">research.cic@srkrec.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+918842226666">+91 884 222 6666</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
