---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }

  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }

  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | CSE — IoT, Cybersecurity & Blockchain | SRKR" description="Department, faculty, and student achievements of the CSE (IoT, Cyber Security & Blockchain Technology) department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cic/">CSE — IoT, Cybersecurity & Blockchain</a></li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="cic" current="Achievements" />

        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                Launched in 2022, the Department of CSE (IoT, Cyber Security &amp; Blockchain Technology) is one of SRKR's newest and most rapidly growing programs. Within its first cohorts, students have made strong showings in national CTF competitions, blockchain hackathons, responsible bug-bounty disclosures and IoT project expos — early markers of a future-focused department finding its stride.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                {/* TODO: Replace with actual CIC departmental photo */}
                <img src="/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg" alt="CIC Department">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">2022</h3>
                    <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Year of Establishment — Future-Ready From Day One</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">60</h3>
                    <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Sanctioned B.Tech Intake per Year</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">12</h3>
                    <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Specialised Labs across IoT, Security &amp; Blockchain</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="rts-funfact-wrapper">
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">4</h2>
                    <p>Specialization Tracks</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">10+</h2>
                    <p>CTF &amp; Hackathon Participations</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">5+</h2>
                    <p>Responsible Bug Disclosures</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">20+</h2>
                    <p>IoT &amp; Blockchain Student Projects</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  {/* TODO: Replace with actual faculty achievement photo */}
                  <img src="/assets/images/placeholder/photo-1524178232363-1fb2b075b655_800x600.jpg" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">{/* TODO: Update with verified records */}Faculty certified in industry security standards (CEH, OSCP, CompTIA Security+).</li>
                      <li class="si__list--single">Active reviewers for IEEE / Springer journals in IoT and Cyber Security.</li>
                      <li class="si__list--single">Resource persons for FDPs on Blockchain, Ethical Hacking and Embedded Systems.</li>
                      <li class="si__list--single">MoUs with regional security firms for student internships and mentorship.</li>
                      <li class="si__list--single">Conference paper contributions in IoT, applied cryptography and blockchain.</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">{/* TODO: Update with verified records */}Top finishers in inter-college Capture-the-Flag (CTF) competitions.</li>
                      <li class="si__list--single">Recognition in national blockchain hackathons and Web3 build challenges.</li>
                      <li class="si__list--single">Hall-of-Fame entries from responsible bug-bounty disclosures to global platforms.</li>
                      <li class="si__list--single">Prizes at IoT project expos for smart-city and smart-agriculture prototypes.</li>
                      <li class="si__list--single">Strong showings in coding contests on HackerRank, CodeChef and LeetCode.</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  {/* TODO: Replace with actual student achievement photo */}
                  <img src="/assets/images/placeholder/photo-1521737711867-e3b97375f902_800x600.jpg" alt="Student Success" loading="lazy" decoding="async">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Milestone Timeline -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">Departmental Milestones</h2>
                  <p class="rts__section--description">From its launch in 2022, the Department of CSE (IoT, Cyber Security &amp; Blockchain Technology) has steadily built out faculty, labs, student clubs and industry partnerships — laying the groundwork for accreditation and research impact in the years ahead.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- 2022 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2022</a></h4>
                        <p class="campus__life--single--description">Department launched with a sanctioned B.Tech intake of 60 seats and a dedicated curriculum spanning IoT, Cyber Security and Blockchain.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2023 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1558346490-a72e53ae2d4f_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2023</a></h4>
                        <p class="campus__life--single--description">Specialised IoT, Cyber Security and Blockchain labs commissioned; student clubs (CTF Squad, IoT Makers, Blockchain Builders) launched.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2024 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1639762681485-074b7f938ba0_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2024</a></h4>
                        <p class="campus__life--single--description">First major participations in national CTF events and blockchain hackathons; bug-bounty cell formalised under faculty mentorship.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- 2025 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1563013544-824ae1b704d3_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">2025</a></h4>
                        <p class="campus__life--single--description">First passing-out cohort prepares for placements; specialisation tracks in IoT, Cyber Security, Blockchain and Edge Computing fully operational.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
