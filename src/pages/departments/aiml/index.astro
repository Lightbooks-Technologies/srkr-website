    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      .civil-spec-card {
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      .civil-spec-thumb {
        height: 220px;
        overflow: hidden;
      }
      .civil-spec-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    </style>
  </body>
</html>
