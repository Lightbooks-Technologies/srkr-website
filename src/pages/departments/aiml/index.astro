                </div>
              </div>
              <div class="single-blog-post">
                <div class="blog-thumb">
                  <a href="/departments/aiml/achievements/">
                    <img src="/assets/images/blog/small-thumb-3.jpg" alt="Kaggle and Hackathons" loading="lazy" decoding="async">
                  </a>
                </div>
                <div class="blog-content">
                  <div class="post-meta">
                    <div class="rt-author">
                      <span><i class="fa-light fa-trophy"></i></span>
