---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: Replace placeholder faculty entries with verified data from srkrec.ac.in / VIDWAN profiles.
// TODO: Drop matching photos into /assets/images/faculty/aiml/ using the imgsrc value as filename.
const hod = [
  { name: 'Dr. K. Madhuri', designation: 'Associate Professor & Head of Department', specialization: 'Machine Learning & Data Science', profile: '', imgsrc: 'PLACEHOLDER' },
];

const professors = [
  { name: 'Dr. A. Ravi Kumar',        designation: 'Professor', specialization: 'Deep Learning & Computer Vision',          profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. S. Lakshmi Prasanna',  designation: 'Professor', specialization: 'Natural Language Processing',              profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. V. Naga Sudha',        designation: 'Professor', specialization: 'Reinforcement Learning & AI Systems',      profile: '', imgsrc: 'PLACEHOLDER' },
];

const associateProfessors = [
  { name: 'Dr. K. Madhuri',            designation: 'Associate Professor', specialization: 'Machine Learning & Data Science', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. P. Hari Krishna',       designation: 'Associate Professor', specialization: 'MLOps & Cloud-native ML',         profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. M. Bhavani',            designation: 'Associate Professor', specialization: 'Generative AI & Multimodal Models', profile: '', imgsrc: 'PLACEHOLDER' },
];

const assistantProfessors = [
  { name: 'Mr. G. Venkata Krishna',    designation: 'Assistant Professor', specialization: 'Deep Learning',           profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. T. Divya Sri',          designation: 'Assistant Professor', specialization: 'Computer Vision',         profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. B. Sai Teja',           designation: 'Assistant Professor', specialization: 'Natural Language Processing', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. R. Anusha',             designation: 'Assistant Professor', specialization: 'Reinforcement Learning',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. K. Pavan Kumar',        designation: 'Assistant Professor', specialization: 'Data Science & Analytics', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. N. Lavanya',            designation: 'Assistant Professor', specialization: 'MLOps & ML Systems',      profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. S. Aravind',            designation: 'Assistant Professor', specialization: 'Generative AI',           profile: '', imgsrc: 'PLACEHOLDER' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Artificial Intelligence & Machine Learning | SRKR" description="Faculty of the Department of Artificial Intelligence & Machine Learning at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aiml/">Artificial Intelligence & Machine Learning</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="aiml" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Add photo at /assets/images/faculty/aiml/{f.imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aiml/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Add photo at /assets/images/faculty/aiml/{f.imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aiml/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Add photo at /assets/images/faculty/aiml/{f.imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aiml/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Add photo at /assets/images/faculty/aiml/{f.imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aiml/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
