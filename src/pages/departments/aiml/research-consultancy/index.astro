---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Artificial Intelligence & Machine Learning | SRKR" description="Research areas, focus groups, publications, and consultancy services of the AI & ML department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aiml/">Artificial Intelligence & Machine Learning</a></li>
                <li class="breadcrumb-item active" aria-current="page">Research &amp; Consultancy</li>
              </ul>
              <h2 class="section-title">Research &amp; Consultancy</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="aiml" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>The Department of Artificial Intelligence &amp; Machine Learning is building an active research ecosystem around applied AI — spanning deep learning, computer vision, NLP, generative AI, MLOps, and responsible AI. Faculty collaborate with peers at IITs and NITs through research internships, contribute to peer-reviewed venues, and partner with industry on consultancy engagements that translate cutting-edge AI research into deployable solutions for businesses and the public sector.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="aiml-rts-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#aiml-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="aiml-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#aiml-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Deep Learning &amp; Neural Architectures</li>
                              <li class="si__list--single">Computer Vision &amp; Multimodal Perception</li>
                              <li class="si__list--single">Natural Language Processing &amp; Large Language Models</li>
                              <li class="si__list--single">Reinforcement Learning &amp; Decision Intelligence</li>
                              <li class="si__list--single">Generative AI, Diffusion &amp; Foundation Models</li>
                              <li class="si__list--single">MLOps, AutoML &amp; Trustworthy ML Systems</li>
                              <li class="si__list--single">Responsible AI — Fairness, Privacy, Safety</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Research Focus Groups -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aiml-collapseTwo" aria-expanded="false">
                      Research Focus Groups
                    </button>
                    <div id="aiml-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#aiml-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Applied Deep Learning Group</li>
                              <li class="si__list--single">Vision &amp; Multimodal AI Group</li>
                              <li class="si__list--single">Language &amp; Conversational AI Group</li>
                              <li class="si__list--single">Generative AI &amp; Foundation Models Group</li>
                              <li class="si__list--single">MLOps &amp; AI Systems Group</li>
                              <li class="si__list--single">Responsible &amp; Ethical AI Group</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Projects & Collaborations -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aiml-collapseThree" aria-expanded="false">
                      Projects &amp; Collaborations
                    </button>
                    <div id="aiml-collapseThree" class="accordion-collapse collapse" data-bs-parent="#aiml-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: Add real funded project details */} Ongoing student capstone projects in healthcare imaging, agri-tech vision, and Indic NLP.</li>
                              <li class="si__list--single">Summer research internships at IITs, NITs, and IIITs across India.</li>
                              <li class="si__list--single">Industry-sponsored mini-projects with regional technology partners.</li>
                              <li class="si__list--single">Open-source contributions to ML libraries and Hugging Face model hub.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aiml-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="aiml-collapseFour" class="accordion-collapse collapse" data-bs-parent="#aiml-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: Verify counts */} Growing portfolio of Scopus / IEEE / Springer indexed publications in AI &amp; ML venues.</li>
                              <li class="si__list--single">Papers presented at national and international AI conferences and workshops.</li>
                              <li class="si__list--single">Book chapters and tutorial contributions in machine learning and deep learning.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aiml-collapseFive" aria-expanded="false">
                      Consultancy Services
                    </button>
                    <div id="aiml-collapseFive" class="accordion-collapse collapse" data-bs-parent="#aiml-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Computer Vision — quality inspection, OCR pipelines, medical imaging analytics.</li>
                              <li class="si__list--single">Natural Language Processing — chatbots, document understanding, multilingual NLP.</li>
                              <li class="si__list--single">Predictive Analytics — demand forecasting, churn modelling, recommendation systems.</li>
                              <li class="si__list--single">Generative AI — RAG knowledge assistants, content generation, agentic workflows.</li>
                              <li class="si__list--single">MLOps Advisory — model deployment, monitoring, and ML platform setup.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">The department welcomes consultancy enquiries from industry, startups, and public-sector organisations seeking to apply modern AI techniques to real-world problems.</p>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/aiml/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/aiml/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/aiml/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>Specialization Tracks</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>AI &amp; ML Department<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:hod.aiml@srkr.ac.in">hod.aiml@srkr.ac.in</a>
                  <a href="mailto:research.aiml@srkr.ac.in">research.aiml@srkr.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+918842226666">+91 884 222 6666</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
