---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Programming & Data Structures Lab',          img: 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&h=600&fit=crop' },
  { name: 'Machine Learning Fundamentals Lab',          img: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop' },
  { name: 'Deep Learning Lab (GPU-Accelerated)',        img: 'https://images.unsplash.com/photo-1591453089816-0fbb971b454c?w=800&h=600&fit=crop' },
  { name: 'Computer Vision Lab',                        img: 'https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?w=800&h=600&fit=crop' },
  { name: 'Natural Language Processing Lab',            img: 'https://images.unsplash.com/photo-1546776310-eef45dd6d63c?w=800&h=600&fit=crop' },
  { name: 'Data Science & Visualization Lab',           img: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop' },
  { name: 'Generative AI Lab',                          img: 'https://images.unsplash.com/photo-1655720828018-edd2daec9349?w=800&h=600&fit=crop' },
  { name: 'MLOps & Cloud AI Lab',                       img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop' },
  { name: 'AI Ethics & Responsible AI Lab',             img: 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=800&h=600&fit=crop' },
  { name: 'Robotics & Reinforcement Learning Lab',      img: 'https://images.unsplash.com/photo-1535378620166-273708d44e4c?w=800&h=600&fit=crop' },
  { name: 'IoT & Edge AI Lab',                          img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop' },
  { name: 'AI Research & Project Lab',                  img: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&h=600&fit=crop' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Artificial Intelligence & Machine Learning | SRKR" description="Laboratories, GPU infrastructure, and research facilities of the AI & ML department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aiml/">Artificial Intelligence & Machine Learning</a></li>
                <li class="breadcrumb-item active" aria-current="page">Facilities</li>
              </ul>
              <h2 class="section-title">Facilities</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="aiml" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The AI &amp; ML department operates a network of modern, ICT-enabled laboratories built around the full machine learning stack — from foundational programming to GPU-accelerated deep learning, computer vision, NLP, MLOps, and generative AI. Students learn with industry-standard frameworks such as PyTorch, TensorFlow, Hugging Face, scikit-learn, OpenCV, and major cloud platforms, and have access to dedicated GPU compute for training large models and capstone projects.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      {/* TODO: Swap Unsplash placeholder with real lab photo when available */}
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
