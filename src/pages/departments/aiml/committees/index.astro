---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: Replace placeholder committee rosters with verified data from the department.
// DAC Committee Members
const dacMembers = [
  { name: 'Dr. K. Madhuri',         role: 'Chairman',    link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. A. Ravi Kumar',      role: 'Coordinator', link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. S. Lakshmi Prasanna',role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. V. Naga Sudha',      role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. P. Hari Krishna',    role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. M. Bhavani',         role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Mr. G. Venkata Krishna', role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Ms. T. Divya Sri',       role: 'Member',      link: '', image: 'PLACEHOLDER' },
];

// BoS Committee Members
const bosMembers = [
  { name: 'Dr. K. Madhuri',                                           role: 'Chairman\nAssociate Professor and Head',                                  link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. JNTUK Nominee (TBD)',                                  role: 'Member\nProfessor, JNTUK',                                                link: '', image: 'PLACEHOLDER' },
  { name: 'Expert from Other University (TBD)',                       role: 'Member\nProfessor, Reputed University',                                   link: '', image: 'PLACEHOLDER' },
  { name: 'Expert from Research Organization (TBD)',                  role: 'Member\nScientist, National R&D Lab',                                     link: '', image: 'PLACEHOLDER' },
  { name: 'Industry Expert (TBD)',                                    role: 'Member\nHead of AI, Leading Technology Company',                          link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. A. Ravi Kumar',                                        role: 'Member\nProfessor, Dept. of AIML, SRKREC',                                link: '', image: 'PLACEHOLDER' },
  { name: 'Alumni Representative (TBD)',                              role: 'Member\nML Engineer, AI Industry',                                        link: '', image: 'PLACEHOLDER' },
];

// PAQIC Committee Members
const paqicMembers = [
  { name: 'Dr. K. Madhuri',         role: 'Chairman',    link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. S. Lakshmi Prasanna',role: 'Coordinator', link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. A. Ravi Kumar',      role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. V. Naga Sudha',      role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. P. Hari Krishna',    role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. M. Bhavani',         role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Ms. N. Lavanya',         role: 'Member',      link: '', image: 'PLACEHOLDER' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .cat-title {
    margin-bottom: 0.5rem;
  }

  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }

  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | Artificial Intelligence & Machine Learning | SRKR" description="Department committees of the AI & ML department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aiml/">Artificial Intelligence & Machine Learning</a></li>
              </ul>
              <h1 class="section-title">Committees</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="aiml" current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Departmental Academic Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: Add photo at /assets/images/faculty/aiml/{member.image}.jpg */}
                  <img src={`/assets/images/faculty/aiml/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: Add photo at /assets/images/faculty/aiml/{member.image}.jpg */}
                  <img src={`/assets/images/faculty/aiml/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: Add photo at /assets/images/faculty/aiml/{member.image}.jpg */}
                  <img src={`/assets/images/faculty/aiml/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: cover;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
