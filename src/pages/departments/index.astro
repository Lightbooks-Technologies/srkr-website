---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { departments } from '../../data/departments';
import { programs } from '../../data/programs';

const programSlugs = new Set(programs.map((p) => p.slug));

const associatedDeptPrograms: Record<string, string> = {
  aids: '/departments/it/academic-programs/',
  aiml: '/departments/cse/academic-programs/',
  csbs: '/departments/it/academic-programs/',
  cic: '/departments/cse/academic-programs/',
  csit: '/departments/it/academic-programs/',
  csd: '/departments/cse/academic-programs/',
  bba: '/departments/ash/',
};

const getDeptLink = (slug: string) => {
  if (slug === 'aiml') {
    return `/departments/cse/academic-programs/#aiml`;
  }
  if (slug === 'csd') {
    return `/departments/cse/academic-programs/#csd`;
  }
  if (slug === 'cic') {
    return `/departments/cse/academic-programs/#cic`;
  }
  if (slug === 'csit') {
    return `/departments/it/academic-programs/#csit`;
  }
  if (slug === 'csbs') {
    return `/departments/it/academic-programs/#csbs`;
  }
  if (programSlugs.has(slug)) {
    return associatedDeptPrograms[slug] || `/departments/${slug}/academic-programs/`;
  }
  return `/departments/${slug}/`;
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Departments | SRKR Engineering College" description="Explore all the engineering and humanities departments at SRKR Engineering College, Bhimavaram." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
              </ul>
              <h1 class="section-title">Departments</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pt--60 pb--60">
      <div class="container">
        <div class="row justify-content-center mb--40">
          <div class="col-12 text-center">
            <h3 id="engineering">Engineering Departments</h3>
            <p class="text-muted"> 6 academic departments offering B.Tech, M.Tech and Ph.D. programs with NBA-accredited and industry-aligned curricula.</p>
          </div>
        </div>
        <div class="row g-4">
          {departments.filter((d) => !['ash', 'Engineering Mathematics & Humanities', 'Engineering Chemistry', 'Engineering Physics'].includes(d.slug)).map((d) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm dept-card">
                <div class="card-body d-flex flex-column">
                  <div class="d-flex align-items-center mb-3">
                    <i class={`${d.icon} dept-card__icon me-3`}></i>
                    <div>
                      <h5 class="card-title mb-0" style="color:#1a3c6b;">{d.name}</h5>
                      <span class="dept-card__code">{d.code} · Intake {d.intake}</span>
                    </div>
                  </div>
                  <p class="card-text flex-grow-1">{d.tagline}</p>
                  <a href={getDeptLink(d.slug)} class="rts-theme-btn mt-2 align-self-start">View Department</a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="row justify-content-center mt--60 mb--40">
          <div class="col-12 text-center">
            <h3>Applied Sciences &amp; Humanities</h3>
            <p class="text-muted">Foundation courses that strengthen every engineering programme.</p>
          </div>
        </div>
        <div class="row g-4 justify-content-center">
          <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm dept-card">
              <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                  <i class="fa-light fa-flask-vial dept-card__icon me-3"></i>
                  <div>
                    <h5 class="card-title mb-0" style="color:#1a3c6b;">Applied Sciences &amp; Humanities</h5>
                    <span class="dept-card__code">AS&amp;H</span>
                  </div>
                </div>
                <p class="card-text flex-grow-1">Mathematics, Physics, Chemistry, English &amp; Humanities — building the analytical and communication foundation for every SRKR engineer.</p>
                <a href="/departments/ash/" class="rts-theme-btn mt-2 align-self-start">View Department</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />

    <style>
      .dept-card { transition: transform .15s ease, box-shadow .15s ease; }
      .dept-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(26,60,107,.12) !important; }
      .dept-card__icon { font-size: 2rem; color: var(--rt-primary); }
      .dept-card__code {
        font-size: .85rem;
        color: var(--rt-body);
        text-transform: uppercase;
        letter-spacing: .04em;
      }
    </style>
  </body>
</html>
