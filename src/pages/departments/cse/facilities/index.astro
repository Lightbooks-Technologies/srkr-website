---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }
  
  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }
  
  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }

  .program-section {
    margin-top: 3.5rem;
    margin-bottom: 3.5rem;
  }

  .program-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--rt-heading);
    margin-bottom: 25px;
    position: relative;
    padding-left: 15px;
  }

  .program-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    height: 22px;
    width: 4px;
    background-color: var(--rt-primary);
    border-radius: 2px;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Computer Science & Engineering | SRKR" description="Laboratories and research facilities of the Computer Science & Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/cse/csehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cse/">Computer Science & Engineering</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="cse" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories & Facilities</h4>
              <p>The Department of Computer Science &amp; Engineering operates well-equipped laboratories, specialized research zones, smart classrooms, and learning spaces supporting our B.Tech, M.Tech, and research programs. Each lab is provisioned with modern computing systems, high-speed networking, and essential software environments.</p>
            </div>

            <div class="rts-section mb--20 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            {programs.map(program => (
              <div class="program-section">
                <h4 class="program-title">{program.title}</h4>
                <div class="row g-5">
                  {program.labs.map(lab => (
                    <div class="col-lg-4 col-md-6">
                      <div class="single-cat-item">
                        <div class="cat-thumb">
                          <img src={lab.img} alt={lab.name} />
                          <a href="#" class="cat-link-btn">{lab.room}</a>
                        </div>
                        <div class="cat-meta">
                          <div class="cat-title">
                            <a href="#">{lab.name}</a>
                          </div>
                          <div class="cat-link">
                            <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
