---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Programming & Problem Solving Lab',       img: '/assets/images/placeholder/photo-1517694712202-14dd9538aa97_800x600.jpg' },
  { name: 'Data Structures & Algorithms Lab',        img: '/assets/images/placeholder/photo-1555066931-4365d14bab8c_800x600.jpg' },
  { name: 'Database Management Systems Lab',         img: '/assets/images/placeholder/photo-1544383835-bda2bc66a55d_800x600.jpg' },
  { name: 'Operating Systems Lab',                   img: '/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg' },
  { name: 'Computer Networks Lab',                   img: '/assets/images/placeholder/photo-1558494949-ef010cbdcc31_800x600.jpg' },
  { name: 'AI / Machine Learning Lab',               img: '/assets/images/placeholder/photo-1677442136019-21780ecad995_800x600.jpg' },
  { name: 'Cyber Security Lab',                      img: '/assets/images/placeholder/photo-1614064641938-3bbee52942c7_800x600.jpg' },
  { name: 'Cloud Computing Lab',                     img: '/assets/images/placeholder/photo-1544197150-b99a580bb7a8_800x600.jpg' },
  { name: 'Internet of Things (IoT) Lab',            img: '/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg' },
  { name: 'Software Engineering Lab',                img: '/assets/images/placeholder/photo-1461749280684-dccba630e2f6_800x600.jpg' },
  { name: 'Project / Research Lab',                  img: '/assets/images/placeholder/photo-1581094288338-2314dddb7ece_800x600.jpg' },
  { name: 'E-Classroom & Seminar Hall',              img: '/assets/images/placeholder/photo-1497486751825-1233686d5d80_800x600.jpg' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }
  
  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }
  
  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Computer Science & Engineering | SRKR" description="Laboratories and research facilities of the Computer Science & Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/cse/csehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cse/">Computer Science & Engineering</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="cse" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The Department of Computer Science &amp; Engineering operates twelve well-equipped laboratories, ICT-enabled smart classrooms, and dedicated E-classrooms that support our B.Tech, M.Tech, and research programs. Each lab is provisioned with current generation workstations, licensed industry-standard software, and high-speed internet — giving students hands-on exposure to programming, databases, networks, AI/ML, cloud, IoT, and cyber security from the very first semester.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
