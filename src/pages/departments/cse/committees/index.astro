  { name: 'Dr.S Viswanadha Raju', role: 'EXPERTS FROM OTHER UNIVERSITIES\nProfessor, Dept. of CSE, JNTUH College of Engineering, Jagtial, TS - 505 501', link: '', image: 'ViswanadhaRaju' },
