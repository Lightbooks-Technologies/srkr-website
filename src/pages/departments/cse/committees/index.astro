// PAQIC Committee Members
const paqicMembers = [
  { name: 'Dr. Bh. V. S. Rama Krishnam Raju', role: 'Chairman\nHOD & Professor', link: '', image: '222' },
  { name: 'Dr. G Mahesh', role: 'Coordinator\nProfessor', link: '', image: '376' },
  { name: 'Dr. K.Suresh Babu', role: 'Member\nProfessor from other Department', link: '', image: '200' },
  { name: 'Dr. K V Krishnam Raju', role: 'Member\nProfessor', link: '', image: '354' },
