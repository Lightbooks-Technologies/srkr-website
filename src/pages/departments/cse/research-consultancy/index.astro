---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Computer Science & Engineering | SRKR" description="Research areas, funded projects, publications, and consultancy services of the Computer Science & Engineering department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/cse/csehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cse/">Computer Science & Engineering</a></li>
              </ul>
              <h1 class="section-title">Research &amp; Consultancy</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="cse" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p >The Department of Computer Science & Engineering has been recognized as a Research Centre by Jawaharlal Nehru Technological University Kakinada (JNTUK) since 2019, fostering high-quality research and doctoral studies in emerging areas such as Artificial Intelligence, Machine Learning, Data Science, Cyber Security, Cloud Computing, Internet of Things, and Generative AI. The department promotes a vibrant research culture through scholarly publications in reputed SCI/Scopus-indexed journals, patents, funded research activities, and collaborations with academic and industry partners. Faculty members actively engage in consultancy services, software solution development, data analytics, technology training, and industry-oriented projects, contributing to the advancement of both academia and industry.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="cse-research-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="cse-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">

                              
                              <li class="si__list--single">Artificial Intelligence, Machine Learning &amp; Generative AI</li>
                              <li class="si__list--single">Data Science &amp; Big Data Analytics</li>
                              <li class="si__list--single">Cyber Security, Cryptography &amp; Digital Forensics</li>
                              <li class="si__list--single">Internet of Things (IoT), Edge Computing &amp; Smart Systems</li>
                              <li class="si__list--single">Cloud Computing, DevOps &amp; Distributed Computing</li>
                              <li class="si__list--single">Computer Networks &amp; Network Security</li>
                              <li class="si__list--single">Software Engineering &amp; Software Quality Assurance</li>
                              <li class="si__list--single">Bioinformatics &amp; Computational Intelligence</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Research Centre & Collaborations -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseTwo" aria-expanded="false">
                      Research Centre &amp; Industry Collaborations
                    </button>
                    <div id="cse-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">

                              
                              <li class="si__list--single">Recognised Research Centre under JNTU Kakinada since 2019.</li>
                              <li class="si__list--single">Collaboration with TCS iON for training and certifications.</li>
                              <li class="si__list--single">Partnership with Netenrich in Cyber Security and SecOps.</li>
                              <li class="si__list--single">Industry-focused internships, expert talks, and skill development programs.</li>
                              <li class="si__list--single">Active ISTE and ACE student chapters.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Funded Projects -->
                  <!-- <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseThree" aria-expanded="false">
                      Funded Projects
                    </button>
                    <div id="cse-collapseThree" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              {/* TODO: replace with real funded project list */}
                              <li class="si__list--single">AICTE-sponsored research projects in AI/ML and bioinformatics domains.</li>
                              <li class="si__list--single">Industry-sponsored applied research in cloud security and SecOps with Netenrich.</li>
                              <li class="si__list--single">Faculty-led seed-funded projects across IoT, edge computing, and computer vision.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div> -->

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="cse-collapseFour" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <div class="table-responsive">
                              <table class="table">
                                <thead>
                                  <tr>
                                    <th>Academic Year</th>
                                    <th>Total Scopus Indexed Publications</th>
                                    <th>Web of Science (SCI/SCIE/ESCI)</th>
                                    <th>Total Publications</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <tr>
                                    <td>2025-2026</td>
                                    <td>155</td>
                                    <td>05</td>
                                    <td>160</td>
                                  </tr>
                                  <tr>
                                    <td>2024-2025</td>
                                    <td>26</td>
                                    <td>08</td>
                                    <td>34</td>
