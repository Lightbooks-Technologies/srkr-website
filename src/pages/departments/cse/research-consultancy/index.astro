---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Computer Science & Engineering | SRKR" description="Research areas, funded projects, publications, and consultancy services of the Computer Science & Engineering department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/cse/">Computer Science & Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Research &amp; Consultancy</li>
              </ul>
              <h2 class="section-title">Research &amp; Consultancy</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="cse" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>The Department of Computer Science &amp; Engineering has been a recognised Research Centre under JNTU Kakinada since 2019, with active Ph.D. supervision across Artificial Intelligence, Machine Learning, Cyber Security, Cloud Computing, and IoT. Our faculty work closely with industry partners such as TCS iON, Netenrich, and Bennett University on funded projects, sponsored research, and skill development initiatives. The department has produced 100+ SCI/Scopus publications and continues to deliver consultancy in software development, data analytics, and secure systems.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="cse-research-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="cse-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Artificial Intelligence &amp; Machine Learning</li>
                              <li class="si__list--single">Data Science &amp; Big Data Analytics</li>
                              <li class="si__list--single">Cyber Security &amp; Cryptography</li>
                              <li class="si__list--single">Internet of Things &amp; Edge Computing</li>
                              <li class="si__list--single">Cloud Computing &amp; DevOps</li>
                              <li class="si__list--single">Computer Networks &amp; Distributed Systems</li>
                              <li class="si__list--single">Software Engineering &amp; Bioinformatics</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Research Centre & Collaborations -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseTwo" aria-expanded="false">
                      Research Centre &amp; Industry Collaborations
                    </button>
                    <div id="cse-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Recognised Research Centre under JNTU Kakinada (since 2019).</li>
                              <li class="si__list--single">Strategic collaboration with TCS iON for industry-aligned training and certifications.</li>
                              <li class="si__list--single">Joint programs with Netenrich on cyber security and SecOps.</li>
                              <li class="si__list--single">Academic partnership with Bennett University on emerging technologies.</li>
                              <li class="si__list--single">Active student chapters of ISTE and the Association of Computer Engineers (ACE).</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Funded Projects -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseThree" aria-expanded="false">
                      Funded Projects
                    </button>
                    <div id="cse-collapseThree" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              {/* TODO: replace with real funded project list */}
                              <li class="si__list--single">AICTE-sponsored research projects in AI/ML and bioinformatics domains.</li>
                              <li class="si__list--single">Industry-sponsored applied research in cloud security and SecOps with Netenrich.</li>
                              <li class="si__list--single">Faculty-led seed-funded projects across IoT, edge computing, and computer vision.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="cse-collapseFour" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">100+ research papers published in SCI / Scopus indexed journals.</li>
                              <li class="si__list--single">75+ papers presented at IEEE / ACM national and international conferences.</li>
                              <li class="si__list--single">Multiple book chapters and edited volumes contributed by faculty.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cse-collapseFive" aria-expanded="false">
                      Consultancy Services
                    </button>
                    <div id="cse-collapseFive" class="accordion-collapse collapse" data-bs-parent="#cse-research-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Software Development — custom web/mobile applications for academic and industry clients.</li>
                              <li class="si__list--single">Data Analytics &amp; AI — predictive models, dashboards, and applied ML solutions.</li>
                              <li class="si__list--single">Cyber Security — vulnerability assessment, secure design, and SecOps training.</li>
                              <li class="si__list--single">Cloud &amp; DevOps — migration, automation, and CI/CD enablement for industry partners.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">The department actively supports faculty- and student-led consultancy through its industry partners and training programs.</p>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/cse/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/cse/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/cse/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>M.Tech Programs</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>Computer Science &amp; Engineering Department<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:cse@srkrec.ac.in">cse@srkrec.ac.in</a>
                  <a href="mailto:hod.cse@srkr.ac.in">hod.cse@srkr.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+919440933903">+91 94409 33903</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
