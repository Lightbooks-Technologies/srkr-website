---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: replace placeholder faculty data with verified entries from srkrec.ac.in/AIDS records.
// TODO: replace `imgsrc` placeholders once real headshots are added under /assets/images/faculty/aids/.

const hod = [
  { name: 'Dr. P. Kiran Sree', designation: 'Professor & Head of Department', specialization: 'Artificial Intelligence, Data Mining, Big Data', profile: '', imgsrc: 'PLACEHOLDER' },
];

const professors = [
  { name: 'Dr. K. Sailaja',          designation: 'Professor', specialization: 'Data Mining & Knowledge Discovery',     profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. M. Hari Krishna',     designation: 'Professor', specialization: 'Statistical Learning & Predictive Analytics', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. S. Ramakrishna',      designation: 'Professor', specialization: 'Big Data Engineering & Cloud Analytics', profile: '', imgsrc: 'PLACEHOLDER' },
];

const associateProfessors = [
  { name: 'Dr. B. Pavani',           designation: 'Associate Professor', specialization: 'Natural Language Processing', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. V. Naga Lakshmi',     designation: 'Associate Professor', specialization: 'Computer Vision & Deep Learning', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. T. Suresh Kumar',     designation: 'Associate Professor', specialization: 'Business Analytics & Decision Science', profile: '', imgsrc: 'PLACEHOLDER' },
];

const assistantProfessors = [
  { name: 'Sri. K. Phaneendra',      designation: 'Assistant Professor', specialization: 'Data Engineering & ETL Pipelines', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Smt. G. Lakshmi Prasanna', designation: 'Assistant Professor', specialization: 'Machine Learning & MLOps',       profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Sri. A. Ravi Kumar',      designation: 'Assistant Professor', specialization: 'Statistics & R Programming',     profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Smt. P. Divya',           designation: 'Assistant Professor', specialization: 'Data Visualization (Tableau / Power BI)', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Sri. N. Venkatesh',       designation: 'Assistant Professor', specialization: 'Cloud Analytics & MLOps',         profile: '', imgsrc: 'PLACEHOLDER' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Artificial Intelligence & Data Science | SRKR" description="Faculty of the Department of Artificial Intelligence & Data Science at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aids/">Artificial Intelligence &amp; Data Science</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="aids" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real photo at /assets/images/faculty/aids/{imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aids/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile || '#'} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real photo at /assets/images/faculty/aids/{imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aids/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile || '#'} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real photo at /assets/images/faculty/aids/{imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aids/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile || '#'} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real photo at /assets/images/faculty/aids/{imgsrc}.jpg */}
                    <img src={`/assets/images/faculty/aids/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile || '#'} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
