---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Artificial Intelligence & Data Science | SRKR" description="Research areas, applied AI projects, publications and consultancy services of the AIDS department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aids/">Artificial Intelligence &amp; Data Science</a></li>
              </ul>
              <h1 class="section-title">Research &amp; Consultancy</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="aids" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>Research in the Department of Artificial Intelligence &amp; Data Science centres on applied AI — building intelligent systems and analytical pipelines that solve real problems for industry, government, and society. Faculty and students collaborate on projects in machine learning, deep learning, natural language processing, computer vision, big data engineering, and business analytics, and engage industry partners through consultancy and capstone projects.</p>
              {/* TODO: replace publication / funding numbers with verified department records. */}
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="aids-rts-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#aids-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="aids-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#aids-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Machine Learning &amp; Statistical Learning</li>
                              <li class="si__list--single">Deep Learning, Computer Vision &amp; NLP</li>
                              <li class="si__list--single">Big Data Engineering &amp; Cloud Analytics</li>
                              <li class="si__list--single">Data Mining &amp; Knowledge Discovery</li>
                              <li class="si__list--single">Business Analytics &amp; Decision Science</li>
                              <li class="si__list--single">Responsible, Explainable &amp; Ethical AI</li>
                              <li class="si__list--single">Generative AI &amp; Large Language Models</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Research Groups -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aids-collapseTwo" aria-expanded="false">
                      Research Groups
                    </button>
                    <div id="aids-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#aids-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Applied Machine Learning &amp; Analytics Group</li>
                              <li class="si__list--single">Deep Learning &amp; Computer Vision Group</li>
                              <li class="si__list--single">Natural Language Processing &amp; Generative AI Group</li>
                              <li class="si__list--single">Big Data Engineering &amp; Cloud Analytics Group</li>
                              <li class="si__list--single">Responsible &amp; Explainable AI Group</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Funded Projects -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aids-collapseThree" aria-expanded="false">
                      Funded Projects
                    </button>
                    <div id="aids-collapseThree" class="accordion-collapse collapse" data-bs-parent="#aids-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: replace with verified data */} Faculty-led projects in applied machine learning and analytics.</li>
                              <li class="si__list--single">Student-driven capstone projects with industry data partners.</li>
                              <li class="si__list--single">Proposals submitted to AICTE, DST and industry sponsors in AI &amp; Data Science.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aids-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="aids-collapseFour" class="accordion-collapse collapse" data-bs-parent="#aids-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: replace with verified counts */} Peer-reviewed papers in Scopus/SCI-indexed journals on ML, deep learning, and analytics.</li>
                              <li class="si__list--single">International conference papers on NLP, computer vision and data engineering.</li>
                              <li class="si__list--single">Book chapters on AI, Data Science and responsible AI practices.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#aids-collapseFive" aria-expanded="false">
                      Consultancy Services
                    </button>
                    <div id="aids-collapseFive" class="accordion-collapse collapse" data-bs-parent="#aids-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Data Strategy &amp; Architecture — data warehouses, lakehouses, and analytics platforms.</li>
                              <li class="si__list--single">Predictive Analytics &amp; Forecasting — demand, risk and operations models.</li>
                              <li class="si__list--single">Machine Learning &amp; Deep Learning Solutions — vision, NLP and recommender systems.</li>
                              <li class="si__list--single">Business Intelligence &amp; Dashboards — Tableau / Power BI implementations.</li>
                              <li class="si__list--single">Training Programs — Python for Data Science, ML, Big Data and MLOps.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">{/* TODO: add real consultancy case studies and partners. */} The department actively engages with industry and government partners to deliver applied AI and analytics solutions.</p>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/aids/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/aids/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/aids/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>Academic Programs</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>Artificial Intelligence &amp; Data Science Department<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:hod.aids@srkrec.ac.in">hod.aids@srkrec.ac.in</a>
                  <a href="mailto:research.aids@srkrec.ac.in">research.aids@srkrec.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+918842226666">+91 884 222 6666</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
