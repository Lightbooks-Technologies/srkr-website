---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: replace Unsplash placeholders with real lab photos.
const labs = [
  { name: 'Programming Lab (Python / Java)',          img: '/assets/images/placeholder/photo-1517694712202-14dd9538aa97_800x600.jpg' },
  { name: 'Statistics & R Lab',                        img: '/assets/images/placeholder/photo-1551288049-bebda4e38f71_800x600.jpg' },
  { name: 'Data Mining Lab',                           img: '/assets/images/placeholder/photo-1518186285589-2f7649de83e0_800x600.jpg' },
  { name: 'Big Data Lab (Hadoop & Spark)',             img: '/assets/images/placeholder/photo-1544197150-b99a580bb7a8_800x600.jpg' },
  { name: 'Database Lab (SQL / NoSQL)',                img: '/assets/images/placeholder/photo-1544383835-bda2bc66a55d_800x600.jpg' },
  { name: 'Data Visualization Lab (Tableau / Power BI)', img: '/assets/images/placeholder/photo-1460925895917-afdab827c52f_800x600.jpg' },
  { name: 'Machine Learning Lab',                      img: '/assets/images/placeholder/photo-1620712943543-bcc4688e7485_800x600.jpg' },
  { name: 'Deep Learning Lab (GPU Cluster)',           img: '/assets/images/placeholder/photo-1591453089816-0fbb971b454c_800x600.jpg' },
  { name: 'Data Engineering Lab',                      img: '/assets/images/placeholder/photo-1558494949-ef010cbdcc31_800x600.jpg' },
  { name: 'Cloud Analytics Lab (AWS / Azure / GCP)',   img: '/assets/images/placeholder/photo-1451187580459-43490279c0fa_800x600.jpg' },
  { name: 'NLP & Computer Vision Lab',                 img: '/assets/images/placeholder/photo-1526374965328-7f61d4dc18c5_800x600.jpg' },
  { name: 'Project & Innovation Lab',                  img: '/assets/images/placeholder/photo-1531297484001-80022131f5a1_800x600.jpg' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Artificial Intelligence & Data Science | SRKR" description="Modern AI, Big Data, Cloud Analytics and Deep Learning laboratories of the Artificial Intelligence & Data Science department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/aids/">Artificial Intelligence &amp; Data Science</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="aids" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The Department of AI &amp; Data Science is equipped with modern computing infrastructure that supports the full data lifecycle — from data ingestion and processing to advanced analytics, machine learning, and visualization. Our labs run industry-standard stacks including Python, R, SQL, Hadoop, Spark, TensorFlow, PyTorch, Tableau, Power BI, and major cloud platforms (AWS, Azure, GCP), giving students hands-on exposure to the tools they will use on day one of their careers.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
