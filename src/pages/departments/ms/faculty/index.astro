---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const hod = [
  { name: 'Dr. M.Siva Krishnam Raju', designation: 'Head of the Department, Associate Professor & Controller of Examinations', specialization: 'HR & Marketing', profile: 'https://srkrec.irins.org/profile/715190', imgsrc: '990' },
];

const professors = [
  { name: 'Dr D Venkatpathi Raju', designation: 'Professor', specialization: 'Marketing & Finance', profile: '', imgsrc: '1301' },
];

const associateProfessors = [
  { name: 'Dr.K.Kiran Kumar Varma', designation: 'Associate Professor', specialization: 'Marketing', profile: 'https://srkrec.irins.org/profile/715387', image: '1002' }
];

const assistantProfessors = [
  { name: 'Vegesna Sri Krishna Chaturya', designation: 'Assistant Professor', specialization: 'Finance & Marketing', profile: 'https://vidwan.inflibnet.ac.in/profile/715179', image: '1132' },
  { name: 'R.Sirisha', designation: 'Assistant Professor', specialization: 'Human Resource Management, Marketing', profile: 'https://srkrec.irins.org/profile/578992', image: '1262' },
  { name: 'M.Harun Kumar', designation: 'Assistant Professor', specialization: 'Marketing', profile: 'https://srkrec.irins.org/profile/320238', image: '1278' },
  { name: 'P. Vasundhara', designation: 'Assistant Professor', specialization: 'Human Resource Management & Marketing Management', profile: 'https://srkrec.irins.org/profile/579052', image: '1280' },
  { name: 'M. Prudhvy Raju', designation: 'Assistant Professor', specialization: 'Marketing', profile: '', image: '1293' },
  { name: 'N. Krishan Mohan Raju', designation: 'Assistant Professor', specialization: 'Marketing', profile: 'https://vidwan.inflibnet.ac.in/profile/554301', image: '1307' },
  { name: 'R. Lakshmi Hyma', designation: 'Assistant Professor', specialization: 'Human Resource Management, Finance', profile: 'https://vidwan.inflibnet.ac.in/profile/579106', image: '1329' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Management Studies | SRKR" description="Faculty of the Department of Management Studies at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ms/">Management Studies</a></li>
              </ul>
              <h1 class="section-title">Faculty</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="ms" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">HOD &amp; Associate Professor</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/maths_humanitites/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/maths_humanitites/${f.imgsrc}.jpg`} alt={f.name} loading="lazy" decoding="async">
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/maths_humanitites/${f.image}.jpg`} alt={f.name} loading="lazy" decoding="async">
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    <img src={`/assets/images/faculty/maths_humanitites/${f.image}.jpg`} alt={f.name} loading="lazy" decoding="async">
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    {f.profile && <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
