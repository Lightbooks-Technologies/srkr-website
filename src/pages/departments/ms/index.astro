---
import BaseHead from '../../../components/BaseHead.astro';
import FooterScripts from '../../../components/FooterScripts.astro';
import SrkrHeader from '../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../components/SrkrFooter.astro';
import OffCanvas from '../../../components/OffCanvas.astro';
import DeptNav from '../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Department of Management Studies | SRKR Engineering College" description="Department of Management Studies at SRKR Engineering College, Bhimavaram — offering 3-Year Bachelor of Business Administration (BBA) program." />
  </head>
  <body>
    <SrkrHeader />

    <!-- BREADCRUMB -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
              </ul>
              <h1 class="section-title">Department of Management Studies</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <!-- content -->
    <div class="rts-faculty-details py-5">
      <div class="container">

        <DeptNav dept="ms" current="Home" />

        <!-- About the Department -->
        <div class="row align-items-center justify-content-md-center mb-5 pb-5">
          <div class="col-lg-12 col-md-11">
            <div class="faculty-content-text">
              <h3 class="rts-section-title mb-5">About the Department</h3>
              <p style="text-align: justify;">The Department of Management Studies was established in 2024 to cater to the growing need for high-quality management education. The department currently offers a 3-Year Bachelor of Business Administration (BBA) program with a focus on building industry-aligned competencies, leadership skills, and entrepreneurial mindsets.</p>
              <p style="text-align: justify;">With a curriculum designed to meet modern business demands, the department emphasizes experiential learning, case studies, guest lectures from industry experts, and internship opportunities to make students industry-ready and prepare them to excel in a dynamic global business environment.</p>
            </div>
          </div>
        </div>

        <!-- Message from HoD -->
        <div class="row mt--30">
          <div class="rts-section mb--60">
            <h3 class="rts-section-title">Message from Head of the Department</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-8">
            <div class="faculty-image text-center">
              <img class="img-fluid mw-100" src="/assets/images/faculty/maths_humanitites/990.jpg" alt="Dr. M.Siva Krishnam Raju" style="border-radius: 6px; max-height: 350px; object-fit: contain;">
              <div class="h5 mb-2 mt-5">Dr. M. Siva Krishnam Raju</div>
              <span>Head of the Department &amp; Associate Professor</span>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faculty-content-text ms-lg-5 mt-5 mt-lg-0">
              <p class="h6 mb-4">Welcome to the Department of Management Studies</p>
              <p style="text-align: justify;">Our department is committed to developing competent, ethical, and innovative management professionals equipped to meet the challenges of the dynamic business environment. We provide a learner-centric environment that integrates academic excellence with industry exposure, research, and skill development.</p>
              <p style="text-align: justify;">With experienced faculty, modern teaching methodologies, and strong industry interaction, we strive to nurture leadership, entrepreneurship, and lifelong learning among our students. We encourage every student to achieve academic excellence while contributing positively to society.</p>
            </div>
          </div>

          <div class="border-top my-60 my_sm--10"></div>

          <!-- Mission & Vision -->
          <div class="row g-4 align-items-start justify-content-md-center">
            <div class="col-lg-6 col-md-6 rts-scholarship-description">
              <div class="faculty-content-text si__list h-100">
                <h4 class="font-32 mb-3 mt-4">Vision</h4>
                <ul class="list-unstyled one-column-list mb-0">
                  <li class="mb-3">To be a center of excellence in management education, developing innovative, ethical, and socially responsible leaders who can navigate and lead in a dynamic global business environment.</li>
                </ul>
              </div>
            </div>
            <div class="col-lg-6 col-md-6 rts-scholarship-description">
              <div class="faculty-content-text si__list h-100">
                <h4 class="font-32 mb-4">Mission</h4>
                <ul class="list-unstyled one-column-list">
                  <li class="mb-3">To provide quality management education through industry-aligned curriculum and experiential learning.</li>
                  <li class="mb-3">To foster critical thinking, leadership skills, and an entrepreneurial mindset among students.</li>
                  <li class="mb-3">To promote ethical values, social responsibility, and continuous learning.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Academics & Programs -->
        <div class="row justify-content-md-center mt-5 pt-5">
          <div class="rts-section mb--60 text-center">
            <h3 class="rts-section-title">Academics &amp; Programs</h3>
          </div>
          <div class="col-lg-6 col-md-10">
            <div class="program__single--item">
              <div class="program__single--item--bg">
                <img src="/assets/images/program/program__bg.jpg" alt="" loading="lazy" decoding="async">
              </div>
              <h5 class="program__single--item--title">Undergraduate</h5>
              <ul class="program__single--item--list">
                <li class="program__single--item--list--item">
                  <a href="/syllabus/" class="link__list">Bachelor of Business Administration (BBA)
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/regulations/" class="link__list">3-Year JNTUK Affiliated
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/calender/" class="link__list">Sanctioned Intake: 60
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
                <li class="program__single--item--list--item">
                  <a href="/syllabus/" class="link__list">Industry-Aligned Curriculum
                    <span><i class="fa-regular fa-arrow-right"></i></span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
    <!-- content end -->

    <!-- Department Highlights -->
    <div class="rts-blog v_1 rts__light rts-section-padding">
      <div class="container">
        <div class="row justify-content-md-center">
          <div class="col-lg-10 col-md-11">
            <div class="rts-section rts-border-bottom-1 mb--50 pb--20">
              <h2 class="rts-section-title text-uppercase">Department Highlights</h2>
              <p class="rts-section-description">Dedicated to shaping competent business professionals with practical skills, leadership traits, and strong ethical values.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Department Highlights end -->

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
