---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { name: 'Programming Lab',                       img: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800&h=600&fit=crop' },
  { name: 'Data Structures & Algorithms Lab',       img: 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&h=600&fit=crop' },
  { name: 'Database Management Systems Lab',        img: 'https://images.unsplash.com/photo-1544383835-bda2bc66a55d?w=800&h=600&fit=crop' },
  { name: 'Web Design & Development Lab',           img: 'https://images.unsplash.com/photo-1547658719-da2b51169166?w=800&h=600&fit=crop' },
  { name: 'UI/UX Design Studio',                    img: 'https://images.unsplash.com/photo-1545235617-9465d2a55698?w=800&h=600&fit=crop' },
  { name: 'Animation Lab',                          img: 'https://images.unsplash.com/photo-1626785774573-4b799315345d?w=800&h=600&fit=crop' },
  { name: 'Game Development Lab',                   img: 'https://images.unsplash.com/photo-1556438064-2d7646166914?w=800&h=600&fit=crop' },
  { name: 'AR/VR Lab',                              img: 'https://images.unsplash.com/photo-1622979135225-d2ba269cf1ac?w=800&h=600&fit=crop' },
  { name: 'Computer Graphics Lab',                  img: 'https://images.unsplash.com/photo-1633356122544-f134324a6cee?w=800&h=600&fit=crop' },
  { name: 'Multimedia Lab',                         img: 'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=800&h=600&fit=crop' },
  { name: 'Creative Coding Lab',                    img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&h=600&fit=crop' },
  { name: 'Project & Innovation Lab',               img: 'https://images.unsplash.com/photo-1531297484001-80022131f5a1?w=800&h=600&fit=crop' },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }
  
  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }
  
  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Computer Science & Design | SRKR" description="Laboratories, studios, and creative-tech facilities of the Computer Science & Design department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csd/">Computer Science & Design</a></li>
                <li class="breadcrumb-item active" aria-current="page">Facilities</li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="csd" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Studios &amp; Labs</h4>
              <p>The Department of Computer Science &amp; Design is housed within the SRKR Technology Centre and equipped with a dozen specialized labs and studios. From core programming and database labs to UX studios, animation suites, game development workstations, and AR/VR rooms, students have access to industry-standard hardware and software (Figma, Adobe Creative Suite, Unity, Unreal Engine, Blender, Maya, ARCore/ARKit toolkits). The AICTE IDEA Lab and Innovation Centre further support prototyping and on-campus startups.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory &amp; Studio Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      {/* TODO: Replace with real lab/studio photo */}
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">Laboratory</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
