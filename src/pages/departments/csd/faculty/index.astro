---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

// TODO: Replace placeholder faculty entries with verified CSD faculty data from srkrec.ac.in.
// TODO: Add real faculty photos at /assets/images/faculty/csd/{imgsrc}.jpg.

const hod = [
  { name: 'Dr. M. Sumalatha', designation: 'Associate Professor & Program Coordinator', specialization: 'Human-Computer Interaction & UX Design', profile: '', imgsrc: 'PLACEHOLDER' },
];

const professors = [
  { name: 'Dr. K. Ravi Kumar',      designation: 'Professor', specialization: 'Computer Graphics & Visualization',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. S. Lakshmi Prasad',  designation: 'Professor', specialization: 'Multimedia Systems & Animation',      profile: '', imgsrc: 'PLACEHOLDER' },
];

const associateProfessors = [
  { name: 'Dr. P. Naga Bhushanam',  designation: 'Associate Professor', specialization: 'Game Development & Interactive Media',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. T. Madhavi',         designation: 'Associate Professor', specialization: 'AR/VR & Immersive Technologies',        profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. V. Suresh',          designation: 'Associate Professor', specialization: 'Creative Coding & Design Computing',    profile: '', imgsrc: 'PLACEHOLDER' },
];

const assistantProfessors = [
  { name: 'Mr. B. Karthik',          designation: 'Assistant Professor', specialization: 'UX/UI Design & Front-End Engineering',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. R. Sneha',            designation: 'Assistant Professor', specialization: '3D Animation & Motion Graphics',         profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. A. Praveen Kumar',    designation: 'Assistant Professor', specialization: 'Game Programming (Unity / Unreal)',      profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. K. Divya',            designation: 'Assistant Professor', specialization: 'Web &amp; Mobile App Development',       profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. N. Hari Krishna',     designation: 'Assistant Professor', specialization: 'Augmented Reality &amp; WebXR',          profile: '', imgsrc: 'PLACEHOLDER' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Computer Science & Design | SRKR" description="Faculty of the Department of Computer Science & Design at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/csd/">Computer Science & Design</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h1 class="section-title">Faculty</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="csd" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professor &amp; Program Coordinator</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with actual faculty photo */}
                    <img src={`/assets/images/faculty/csd/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with actual faculty photo */}
                    <img src={`/assets/images/faculty/csd/${f.imgsrc}.jpg`} alt={f.name} / loading="lazy" decoding="async">
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with actual faculty photo */}
                    <img src={`/assets/images/faculty/csd/${f.imgsrc}.jpg`} alt={f.name} / loading="lazy" decoding="async">
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: Replace with actual faculty photo */}
                    <img src={`/assets/images/faculty/csd/${f.imgsrc}.jpg`} alt={f.name} / loading="lazy" decoding="async">
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
