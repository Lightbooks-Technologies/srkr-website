---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<style>
  .rts-about-section {
    height: 100%;
  }

  .rts-about-section img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .rts-about-details {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
  }

  .rts-about-details .single-about-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Achievements | Electronics & Communication Engineering | SRKR" description="Department, faculty, and student achievements of the Electronics & Communication Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/ece/ecehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ece/">Electronics &amp; Communication Engineering</a></li>
              </ul>
              <h1 class="section-title">Achievements</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Achievements Section -->
    <section class="rts-about-university py-5">
      <div class="container">
        <DeptNav dept="ece" current="Achievements" />

        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-5">
              <h3 class="rts-section-title">Department Excellence</h3>
            </div>
            <div class="col-lg-8 col-md-7">
              <p class="rts-section-description">
                The Department of Electronics &amp; Communication Engineering at SRKR has built a four-decade legacy of academic and research excellence. With four consecutive NBA accreditations, a Centre of Excellence in VLSI Design, 200+ research publications and an alumni network spanning Intel, Apple, Google, AMD, ISRO and DRDO, the department continues to set benchmarks in electronics education.
              </p>
            </div>
          </div>
        </div>

        <!-- Main Content: Image + Stat Cards -->
        <div class="container">
          <div class="row g-5 justify-content-md-center justify-content-start align-items-stretch">
            <div class="col-lg-7 col-xl-8 col-md-11">
              <div class="rts-about-section">
                <img src="/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg" alt="ECE Department">
              </div>
            </div>
            <div class="col-lg-5 col-xl-4 col-md-11">
              <div class="rts-about-details">
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">5x</h3>
                    <img src="/assets/images/icon/11.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>NBA Accreditation — Five Consecutive Cycles</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">200+</h3>
                    <img src="/assets/images/icon/12.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Research Publications in SCI/Scopus Journals</p>
                  </div>
                </div>
                <div class="single-about-info">
                  <div class="content">
                    <h3 class="title">40+</h3>
                    <img src="/assets/images/icon/13.svg" alt="" loading="lazy" decoding="async">
                  </div>
                  <div class="desc">
                    <p>Batches of Alumni — Globally Placed</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="rts-funfact pt-5">
          <div class="container">
            <div class="row justify-content-center mx-0">
              <div class="col-lg-12 px-0">
                <div class="rts-funfact-wrapper">
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">12</h2>
                    <p>Modern Laboratories</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">240</h2>
                    <p>B.Tech Sanctioned Intake</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">95%+</h2>
                    <p>Pass Percentage</p>
                  </div>
                  <div class="single-cta-item">
                    <h2 class="single-cta-item__title">1</h2>
                    <p>Centre of Excellence (VLSI)</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Faculty Achievements -->
        <div class="rts-history rts-section-padding">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1581092580497-e0d23cbdf1dc_800x600.jpg" alt="Faculty Excellence" loading="lazy" decoding="async">
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Faculty Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Multiple faculty members recognized as JNTUK Ph.D. supervisors</li>
                      <li class="si__list--single">Centre of Excellence in VLSI Design established and led by ECE faculty</li>
                      <li class="si__list--single">Active IETE student chapter and ISTE college chapter mentored by department</li>
                      <li class="si__list--single">Faculty publications in IEEE Transactions, Springer and Elsevier journals</li>
                      <li class="si__list--single">Industry-academia collaborations with Texas Instruments, BEL and DRDO</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Student Achievements -->
        <section class="rts-mission rts-section-padding pt-0">
          <div class="container">
            <div class="row g-5 justify-content-md-center justify-content-start align-items-center">
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-section rts-scholarship-description">
                  <h4 class="rts-section-title mb--40">Student Achievements</h4>
                  <div class="si__list">
                    <ul class="list-unstyled" style="column-count: 1;">
                      <li class="si__list--single">Andhra University ranks obtained by ECE students since the department's inception</li>
                      <li class="si__list--single">Consistent top scores in GATE, GRE, TOEFL and CAT</li>
                      <li class="si__list--single">Placements in TCS, Cognizant, Infosys, IBM, Texas Instruments, BSNL, BEL, ISRO and DRDO</li>
                      <li class="si__list--single">National prizes in technical paper and hardware competitions</li>
                      <li class="si__list--single">Winners at IETE technical fests, project expos and innovation challenges</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-11">
                <div class="rts-history-image">
                  <img src="/assets/images/placeholder/photo-1523240795612-9a054b0db644_800x600.jpg" alt="Student Success" loading="lazy" decoding="async">
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Accreditation Timeline -->
        <section class="rts__section rts-section-padding pt-0">
          <div class="container">
            <div class="row">
              <div class="col-lg-5 col-md-6">
                <div class="rts__section--wrapper v__2">
                  <h2 class="rts__section--title">NBA Accreditation History</h2>
                  <p class="rts__section--description">The Department of Electronics &amp; Communication Engineering has been NBA accredited four times consecutively, demonstrating a sustained commitment to quality education, outcome-based learning and industry-aligned curriculum.</p>
                  <div class="campus__vector">
                    <img src="/assets/images/campus/campus__vector.svg" alt="" loading="lazy" decoding="async">
                  </div>
                </div>
              </div>
              <div class="col-lg-7 col-md-6">
                <div class="campus__life">
                  <!-- Cycle 1 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1518770660439-4636190af475_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">Cycle 1 ::  2002</a></h4>
                        <p class="campus__life--single--description">First NBA accreditation establishing outcome-based education and quality benchmarks for the B.Tech ECE program.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- Cycle 2 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1581092580497-e0d23cbdf1dc_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">Cycle 2 :: 2007</a></h4>
                        <p class="campus__life--single--description">Second accreditation recognizing continued excellence in faculty development and laboratory infrastructure.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- Cycle 3 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1551703599-6b3e8379aa8d_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">Cycle 3 :: 2013</a></h4>
                        <p class="campus__life--single--description">Third accreditation acknowledging the launch of M.Tech in Communication Systems and growing research footprint.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                  <!-- Cycle 4 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1639322537228-f710d846310a_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">Cycle 4 :: 2020</a></h4>
                        <p class="campus__life--single--description">Current accreditation demonstrating sustained quality, the VLSI Centre of Excellence, and strong student outcomes.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>

                  <!-- Cycle 5 -->
                  <div class="campus__life--single">
                    <div class="campus__life--single--bg">
                      <img src="/assets/images/placeholder/photo-1639322537228-f710d846310a_800x600.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                    <div class="campus__life--single--flex">
                      <div class="campus__life--single--content">
                        <h4 class="campus__life--single--title"><a href="#">Cycle 5 :: 2023</a></h4>
                        <p class="campus__life--single--description">Current accreditation demonstrating sustained quality, the VLSI Centre of Excellence, and strong student outcomes.</p>
                      </div>
                      <div class="campus__life--single--button">
                        <a href="#"><i class="fa-sharp fa-regular fa-check"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      </section>
    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
