---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Research & Consultancy | Electronics & Communication Engineering | SRKR" description="Research areas, funded projects, publications, and consultancy services of the Electronics & Communication Engineering department at SRKR." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ece/">Electronics &amp; Communication Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Research &amp; Consultancy</li>
              </ul>
              <h2 class="section-title">Research &amp; Consultancy</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="ece" current="Research/Consultancy" />

        <!-- Two Column Layout -->
        <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">

          <!-- Left: Overview + Accordion -->
          <div class="col-lg-8 col-md-11">

            <!-- Intro -->
            <div class="program-about mb--40">
              <h4 class="title">Research &amp; Consultancy Overview</h4>
              <p>The Department of Electronics &amp; Communication Engineering hosts an active research culture spanning VLSI design, embedded systems, communications, signal &amp; image processing, IoT and antenna engineering. A dedicated Centre of Excellence in VLSI Design serves as the focal point for IC design research, knowledge sharing, and student capstone projects. Faculty have published 200+ papers in SCI/Scopus journals and guide M.Tech and Ph.D. scholars across multiple specializations.</p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="ece-rts-accordion">

                  <!-- Research Areas -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#ece-collapseOne" aria-expanded="true">
                      Research Areas
                    </button>
                    <div id="ece-collapseOne" class="accordion-collapse collapse show" data-bs-parent="#ece-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">VLSI Design &amp; Low-Power IC Design</li>
                              <li class="si__list--single">Embedded Systems &amp; Internet of Things (IoT)</li>
                              <li class="si__list--single">Digital Signal &amp; Image Processing</li>
                              <li class="si__list--single">Wireless Communications &amp; 5G/6G</li>
                              <li class="si__list--single">Microwave Engineering, Antennas &amp; RF Design</li>
                              <li class="si__list--single">Machine Learning for Signal &amp; Image Analysis</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Centres of Excellence -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-collapseTwo" aria-expanded="false">
                      Centres of Excellence
                    </button>
                    <div id="ece-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#ece-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Centre of Excellence in VLSI Design — a focal point for IC design research and industry collaboration.</li>
                              <li class="si__list--single">Embedded Systems &amp; IoT Innovation Hub.</li>
                              <li class="si__list--single">Centre for Signal &amp; Image Processing.</li>
                              <li class="si__list--single">Centre for Wireless Communications &amp; Antenna Research.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Funded Projects -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-collapseThree" aria-expanded="false">
                      Funded Projects
                    </button>
                    <div id="ece-collapseThree" class="accordion-collapse collapse" data-bs-parent="#ece-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">{/* TODO: replace with verified project list */}Multiple DST and AICTE-funded research projects in VLSI, signal processing and IoT.</li>
                              <li class="si__list--single">Industry-sponsored projects in embedded design and wireless sensor networks.</li>
                              <li class="si__list--single">Active student-led mini and major projects in collaboration with research partners.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Publications -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-collapseFour" aria-expanded="false">
                      Publications
                    </button>
                    <div id="ece-collapseFour" class="accordion-collapse collapse" data-bs-parent="#ece-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">200+ research papers in SCI/Scopus indexed journals.</li>
                              <li class="si__list--single">75+ papers presented at IEEE and Springer national/international conferences.</li>
                              <li class="si__list--single">Multiple book chapters and edited volumes with international publishers.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Consultancy -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-collapseFive" aria-expanded="false">
                      Consultancy Services
                    </button>
                    <div id="ece-collapseFive" class="accordion-collapse collapse" data-bs-parent="#ece-rts-accordion">
                      <div class="accordion-body">
                        <div class="si">
                          <h4 class="title">Domains</h4>
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">VLSI Design — RTL design, verification, ASIC/FPGA prototyping, low-power circuits.</li>
                              <li class="si__list--single">Embedded Systems &amp; IoT — product design, firmware development, sensor integration.</li>
                              <li class="si__list--single">Communications — antenna design and characterization, RF system prototyping, link budget analysis.</li>
                              <li class="si__list--single">Signal &amp; Image Processing — algorithm development, MATLAB/Simulink consultancy, ML-based analytics.</li>
                            </ul>
                          </div>
                        </div>
                        <p class="mt--20">The department actively supports industry, MSMEs and academic partners through measurement, testing and design consultancy, leveraging modern lab infrastructure and faculty expertise.</p>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Right: Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">

              <!-- Quick Links -->
              <div class="program-curriculum">
                <h6 class="heading-title">Research Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li><a href="/departments/ece/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Profiles</a></li>
                    <li><a href="/departments/ece/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Research Facilities</a></li>
                    <li><a href="/departments/ece/academic-programs/"><span><i class="fa-light fa-arrow-right"></i></span>M.Tech Programs</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Ongoing Projects</a></li>
                    <li><a href="#"><span><i class="fa-light fa-arrow-right"></i></span>Publications List</a></li>
                  </ul>
                </div>
              </div>

              <!-- Contact Info -->
              <div class="program-info">
                <h5>Department Contact</h5>
                <p>Electronics &amp; Communication Engineering<br>SRKR Engineering College</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:hod.ece@srkr.ac.in">hod.ece@srkr.ac.in</a>
                  <a href="mailto:ece@srkrec.ac.in">ece@srkrec.ac.in</a>
                </div>
                <div class="contact-info mt--20 mb--20">
                  <h5>Phone:</h5>
                  <a href="tel:+918842226666">+91 884 222 6666</a>
                </div>
                <div class="social-info mt--20">
                  <h5>Connect With Us:</h5>
                  <div class="social-info-link">
                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
