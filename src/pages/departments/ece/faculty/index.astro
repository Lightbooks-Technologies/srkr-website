---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

/* TODO: replace placeholder names, designations, specializations, profile links and imgsrc filenames with verified ECE faculty data */
const hod = [
  { name: 'Dr. S.S. Mohan Reddy', designation: 'Professor & Head of Department', specialization: 'VLSI Design & Signal Processing', profile: '', imgsrc: 'PLACEHOLDER' },
];

const professors = [
  { name: 'Dr. P. Rajesh Kumar',        designation: 'Professor', specialization: 'VLSI Design',                profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. K. Babulu',              designation: 'Professor', specialization: 'Signal Processing',          profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. M. Kamaraju',            designation: 'Professor', specialization: 'Embedded Systems',           profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. B. Rama Rao',            designation: 'Professor', specialization: 'Microwave & Antennas',       profile: '', imgsrc: 'PLACEHOLDER' },
];

const associateProfessors = [
  { name: 'Dr. T. Venkata Lakshmi',     designation: 'Associate Professor', specialization: 'Image Processing',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. K. Srinivasa Naik',      designation: 'Associate Professor', specialization: 'Communications',    profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Dr. P. Naga Malleswari',     designation: 'Associate Professor', specialization: 'VLSI Design',       profile: '', imgsrc: 'PLACEHOLDER' },
];

const assistantProfessors = [
  { name: 'Mr. K. Phani Srinivas',      designation: 'Assistant Professor', specialization: 'Embedded Systems',  profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. M. Lakshmi Prasanna',    designation: 'Assistant Professor', specialization: 'Signal Processing', profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. A. Rajesh',              designation: 'Assistant Professor', specialization: 'Communications',    profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. G. Pravallika',          designation: 'Assistant Professor', specialization: 'VLSI Design',       profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Mr. D. Surya Prakash',       designation: 'Assistant Professor', specialization: 'IoT & Embedded',    profile: '', imgsrc: 'PLACEHOLDER' },
  { name: 'Ms. B. Sai Sushma',          designation: 'Assistant Professor', specialization: 'Image Processing',  profile: '', imgsrc: 'PLACEHOLDER' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Faculty | Electronics & Communication Engineering | SRKR" description="Faculty of the Department of Electronics & Communication Engineering at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ece/">Electronics &amp; Communication Engineering</a></li>
                <li class="breadcrumb-item active" aria-current="page">Faculty</li>
              </ul>
              <h2 class="section-title">Faculty</h2>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-faculty py-5">
      <div class="container">
        <DeptNav dept="ece" current="Faculty" />

        <!-- HoD -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professor &amp; Head of Department</h3>
        </div>
        <div class="row g-5 mb--50">
          {hod.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photo */}
                    <img src={`/assets/images/faculty/ece/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {professors.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photo */}
                    <img src={`/assets/images/faculty/ece/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Associate Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Associate Professors</h3>
        </div>
        <div class="row g-5 mb--50">
          {associateProfessors.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photo */}
                    <img src={`/assets/images/faculty/ece/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Assistant Professors -->
        <div class="rts-section mb--40">
          <h3 class="rts-section-title">Assistant Professors</h3>
        </div>
        <div class="row g-5">
          {assistantProfessors.map((f, i) => (
            <div class="col-lg-6 col-md-11">
              <div class="single-staff">
                <div class="single-staff__content">
                  <div class="staf-image">
                    {/* TODO: replace with real faculty photo */}
                    <img src={`/assets/images/faculty/ece/${f.imgsrc}.jpg`} alt={f.name} />
                  </div>
                  <div class="staf-info">
                    <h5 class="name">{f.name}</h5>
                    <span class="designation">{f.designation}</span>
                    <div class="staf-info__speciality">
                      <p>{f.specialization}</p>
                    </div>
                    <a href={f.profile} class="rts-theme-btn border-btn" target="_blank" rel="noopener">VIDWAN Profile</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
