---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Academic Programs | Electronics & Communication Engineering | SRKR" description="B.Tech and M.Tech academic programs offered by the Department of Electronics & Communication Engineering at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/ece/ecehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ece/">Electronics &amp; Communication Engineering</a></li>
              </ul>
              <h1 class="section-title">Academic Programs</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="ece" current="Academic Programs" />
        <div class="row sticky-coloum-wrap">
          <div class="col-lg-8 col-md-12">

            <!-- Intro -->
            <div class="program-about">
              <h4 class="title">Programs Offered</h4>
              <p>The Department of Electronics &amp; Communication Engineering offers a four-year B.Tech in ECE (sanctioned intake 240), a two-year M.Tech in Communication Systems, and a Ph.D. research program — all JNTUK affiliated. Our curriculum balances classical electronics foundations with modern industry skills in VLSI design, embedded systems, IoT, signal processing and wireless communications.</p>
            </div>

            <!-- Program Cards -->
            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Our Programs</h3>
            </div>
            <div class="row g-4 mb--40">
              <div class="col-lg-6 col-md-6">
                <div class="single-cat-item">
                  <div class="cat-thumb" style="height: 200px;">
                    <img src="/assets/images/programs/ece.jpg" alt="B.Tech ECE" style="height: 100%; object-fit: contain;">
                    <a href="#ece-btech" class="cat-link-btn">Undergraduate</a>
                  </div>
                  <div class="cat-meta">
                    <div class="cat-title">
                      <a href="#ece-btech">B.Tech Electronics &amp; Communication Engineering</a>
                    </div>
                    <div class="cat-link">
                      <a href="#ece-btech" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-6">
                <div class="single-cat-item">
                  <div class="cat-thumb" style="height: 200px;">
                    <img src="/assets/images/programs/communication_systems.png" alt="M.Tech Communication Systems" style="height: 100%; object-fit: contain;" loading="lazy" decoding="async">
                    <a href="#ece-mtech" class="cat-link-btn">Postgraduate</a>
                  </div>
                  <div class="cat-meta">
                    <div class="cat-title">
                      <a href="#ece-mtech">M.Tech Communication Systems</a>
                    </div>
                    <div class="cat-link">
                      <a href="#ece-mtech" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Accordion: B.Tech -->
            <div id="ece-btech" class="program-credit-area faq mt--50 rts-scholarship-description">
              <div class="rts-section mb--30">
                <h3 class="rts-section-title">B.Tech — Electronics &amp; Communication Engineering</h3>
              </div>
              <div class="program-accordion">
                <div class="accordion" id="ece-btech-accordion">

                  <!-- PEOs -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#ece-btech-peo" aria-expanded="true">
                      Program Educational Objectives (PEOs)
                    </button>
                    <div id="ece-btech-peo" class="accordion-collapse collapse show" data-bs-parent="#ece-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">The Program Educational Objectives define the career and professional accomplishments that our B.Tech ECE graduates are prepared to achieve within a few years of graduation. They guide our curriculum design and ensure alignment with industry needs, research aspirations and societal expectations.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">

                              
                              <li class="si__list--single">Preparing our graduates for successful careers in design, installation, operation and maintenance of electronic systems and processes.</li>
                              <li class="si__list--single">Preparing our graduates to have the ability for lifelong learning by pursuing higher education, research and professional development courses.</li>
                              <li class="si__list--single">Preparing our graduates to attain leadership roles in industry, academia and research organizations and innovate continuously.</li>
                              <li class="si__list--single">Preparing our graduates to develop management skills and become entrepreneurs.</li>
                              <li class="si__list--single">Preparing our graduates as ethical, responsible and value based professionals who work continuously for the benefit of the society.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- POs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-btech-po" aria-expanded="false">
                      Program Outcomes (POs)
                    </button>
                    <div id="ece-btech-po" class="accordion-collapse collapse" data-bs-parent="#ece-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Program Outcomes describe the knowledge, skills and attributes that B.Tech ECE students will acquire by graduation. They are aligned with NBA/AICTE graduate attributes and ensure our students are well-prepared for professional practice in electronics, communications and allied domains.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single"><strong>Engineering Knowledge:</strong> Apply mathematics, science, engineering fundamentals and ECE specialization to solve complex engineering problems.</li>
                              <li class="si__list--single"><strong>Problem Analysis:</strong> Identify, formulate and analyse complex engineering problems using first principles of mathematics and engineering sciences.</li>
                              <li class="si__list--single"><strong>Design &amp; Development:</strong> Design solutions and system components that meet specified needs with appropriate consideration for safety, environment and culture.</li>
                              <li class="si__list--single"><strong>Investigation:</strong> Use research-based knowledge and methods including experiment design, data analysis and interpretation to reach valid conclusions.</li>
                              <li class="si__list--single"><strong>Modern Tools:</strong> Create, select and apply appropriate modern engineering tools — EDA, embedded IDEs, MATLAB, simulation and modelling — to complex engineering activities.</li>
                              <li class="si__list--single"><strong>Engineer &amp; Society:</strong> Apply contextual reasoning to assess societal, health, safety, legal and cultural issues relevant to professional engineering practice.</li>
                              <li class="si__list--single"><strong>Sustainability:</strong> Understand the impact of engineering solutions in societal and environmental contexts and demonstrate the need for sustainable development.</li>
                              <li class="si__list--single"><strong>Ethics:</strong> Apply ethical principles and commit to professional responsibilities and norms of engineering practice.</li>
                              <li class="si__list--single"><strong>Teamwork:</strong> Function effectively as an individual and as a member or leader in diverse and multidisciplinary teams.</li>
                              <li class="si__list--single"><strong>Communication:</strong> Communicate effectively through reports, design documentation and presentations with peers and society at large.</li>
                              <li class="si__list--single"><strong>Project Management:</strong> Apply engineering and management principles to manage projects in multidisciplinary environments.</li>
                              <li class="si__list--single"><strong>Lifelong Learning:</strong> Recognise the need for, and have the ability to engage in, independent and life-long learning amidst rapid technological change.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- PSOs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-btech-pso" aria-expanded="false">
                      Program Specific Outcomes (PSOs)
                    </button>
                    <div id="ece-btech-pso" class="accordion-collapse collapse" data-bs-parent="#ece-btech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Program Specific Outcomes describe the specialised competencies that distinguish our B.Tech ECE program — competencies that prepare graduates for focused careers in networking, communication systems, VLSI design, embedded systems and IoT applications.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Should be able to clearly understand the concepts and applications in the field of networking, Communication systems and VLSI.</li>
                              <li class="si__list--single">Should be able to associate the learning from courses, Embedded Systems and IoT in arriving solutions to real world problems.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>

            <!-- Accordion: M.Tech -->
            <div id="ece-mtech" class="program-credit-area faq mt--50 rts-scholarship-description">
              <div class="rts-section mb--30">
                <h3 class="rts-section-title">M.Tech — Communication Systems</h3>
              </div>
              <div class="program-accordion">
                <div class="accordion" id="ece-mtech-accordion">

                  <!-- PEOs -->
                  <div class="accordion-item">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#ece-mtech-peo" aria-expanded="true">
                      Program Educational Objectives (PEOs)
                    </button>
                    <div id="ece-mtech-peo" class="accordion-collapse collapse show" data-bs-parent="#ece-mtech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">The M.Tech Communication Systems program — started in 2006 — develops advanced expertise in analog &amp; digital communication, wireless networks, signal processing and antenna design. Our Program Educational Objectives prepare graduates for leadership roles in industry, R&amp;D organisations and academia.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Graduates will apply advanced knowledge of communication systems to solve complex engineering problems in industry, research organizations, and academic institutions.</li>
                              <li class="si__list--single">Graduates will engage in research, innovation, and lifelong learning to address emerging challenges in wireless communication, signal processing, and networking technologies.</li>
                              <li class="si__list--single">Graduates will demonstrate professional ethics, effective communication, teamwork, and leadership skills in multidisciplinary engineering environments.</li>
                              <li class="si__list--single">Graduates will pursue higher responsibilities in technical, research, entrepreneurial, and academic careers with social and professional commitment.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- POs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-mtech-po" aria-expanded="false">
                      Program Outcomes (POs)
                    </button>
                    <div id="ece-mtech-po" class="accordion-collapse collapse" data-bs-parent="#ece-mtech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Our M.Tech program outcomes ensure that graduates possess advanced analytical, design and research capabilities in communication systems and allied areas. They reflect AICTE post-graduate attributes and emphasise independent research, technical writing and specialised domain mastery.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">

                              
                              <li class="si__list--single">An ability to independently carry out research /investigation and development work to solve practical problems.</li>
                              <li class="si__list--single">An ability to write and present a substantial technical report/document.</li>
                              <li class="si__list--single">Students should be able to demonstrate a degree of mastery over the area as per the specialization of the program. The mastery should be at a level higher than the requirements in the appropriate bachelor program.</li>
                              
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- PSOs -->
                  <div class="accordion-item">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ece-mtech-pso" aria-expanded="false">
                      Program Specific Outcomes (PSOs)
                    </button>
                    <div id="ece-mtech-pso" class="accordion-collapse collapse" data-bs-parent="#ece-mtech-accordion">
                      <div class="accordion-body">
                        <p class="mb-4">Program Specific Outcomes for M.Tech Communication Systems focus on advanced competencies in modulation techniques, wireless protocols, antenna theory and computational tools used in modern communications research and product development.</p>
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">Ability to analyze, design, and optimize modern analog and digital communication systems for real-world applications.</li>
                              <li class="si__list--single">Ability to apply advanced simulation tools and research methodologies for solving complex problems in wireless communication, signal processing, and network systems.</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>

          </div>

          <!-- Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="theiaStickySidebar">

              <!-- Program Links -->
              <div class="program-sidebar">
                <div class="program-curriculum">
                  <h6 class="heading-title">ECE Programs</h6>
                  <div class="program-menu">
                    <ul class="list-unstyled">
                      <li><a href="/departments/ece/faculty/"><span><i class="fa-light fa-arrow-right"></i></span>Faculty Members</a></li>
                      <li><a href="/departments/ece/facilities/"><span><i class="fa-light fa-arrow-right"></i></span>Facilities &amp; Labs</a></li>
                      <li><a href="/departments/ece/research-consultancy/"><span><i class="fa-light fa-arrow-right"></i></span>Research &amp; Projects</a></li>
                      <li><a href="/departments/ece/placements/"><span><i class="fa-light fa-arrow-right"></i></span>Placements</a></li>
                      <li><a href="/departments/ece/achievements/"><span><i class="fa-light fa-arrow-right"></i></span>Achievements</a></li>
                    </ul>
                  </div>
                </div>
                <!-- Image -->
                <div class="program-event-image mt-4">
                  <img src="/assets/images/placeholder/photo-1518770660439-4636190af475_600x800.jpg" alt="ECE Campus" style="width: 100%; height: auto; display: block;" loading="lazy" decoding="async">
                </div>
              </div>


            </div>
          </div>

        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
