  { name: 'Dr. P. Rajesh Kumar',      role: 'Coordinator', link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. K. Babulu',            role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. M. Kamaraju',          role: 'Member',      link: '', image: 'PLACEHOLDER' },
  { name: 'Dr. T. Venkata Lakshmi',   role: 'Member',      link: '', image: 'PLACEHOLDER' },
