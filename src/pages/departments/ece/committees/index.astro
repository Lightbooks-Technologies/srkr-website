  { name: 'Dr. N V S Narasimha Sharma',   role: 'Member\nProfessor, Dept. of ECE, NIT, Warangal.',                                                                                link: '', image: 'NVSNarasimhaSharma' },
  { name: 'Dr. Narayana Balaji',          role: 'Member\nProfessor, Department of ECE, University College of Engineering Kakinada, JNTUK, Kakinada.',                             link: '', image: 'NarayanaBalaji' },
