const paqicMembers = [
  { name: 'Dr. S. S Mohan Reddy', role: 'Chairman\nProfessor and Head', link: 'https://srkrec.irins.org/profile/180182', image: '313' },
  { name: 'Dr. N. Udaya Kumar', role: 'Coordinator\nProfessor', link: 'https://srkrec.irins.org/profile/245635', image: '219' },
  { name: 'Dr. B. Sanjay', role: 'Member\nDepartment NBA Coordinator', link: '', image: '638' },
  { name: 'Dr. B.V.D.S Sekhar', role: 'Member\nOther Department Professor', link: '', image: '332' },
];

const bosMeetings = [
  { name: 'ECE BOS MEETINGS 2024-2025', file: '/assets/documents/ece/bos/ECE_BOS_MEETINGS_2024-2025.pdf' },
  { name: 'ECE BOS MEETINGS 2023-2024', file: '/assets/documents/ece/bos/ECE_BOS_MEETINGS_2023-2024.pdf' },
  { name: 'ECE BOS MEETINGS 2022-2023', file: '/assets/documents/ece/bos/ECE_BOS_MEETINGS_2022-2023.pdf' },
  { name: 'ECE BOS MEETINGS 2021-2022', file: '/assets/documents/ece/bos/ECE_BOS_MEETINGS_2021-2022.pdf' },
  { name: 'ECE BOS MEETINGS 2020-2021', file: '/assets/documents/ece/bos/ECE_BOS_MEETINGS_2020-2021.pdf' },
  { name: 'ECE BOS MEETINGS 2019-2020', file: '/assets/documents/ece/bos/ECE_BOS_MEETINGS_2019-2020.pdf' },
