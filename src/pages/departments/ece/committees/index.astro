];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .cat-title {
    margin-bottom: 0.5rem;
  }

  .cat-role {
    font-size: 1.5rem;
    margin-top: 0.25rem;
  }

  .cat-role-text {
    display: inline-block;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Committees | Electronics & Communication Engineering | SRKR" description="Department committees of the Electronics & Communication Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/ece/ecehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ece/">Electronics &amp; Communication Engineering</a></li>
              </ul>
              <h1 class="section-title">Committees</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="ece" current="Committees" />

        <!-- DAC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Departmental Academic Committee (DAC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {dacMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: replace with real committee member photo */}
                  <img src={`/assets/images/faculty/ece/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: contain;">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Board of Studies (BoS)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5 mb--80">
          {bosMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: replace with real committee member photo */}
                  <img src={`/assets/images/faculty/ece/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: contain;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- PAQIC Section -->
        <div class="row justify-content-md-center">
          <div class="col-lg-12 col-md-11 d-flex flex-wrap gap-5 justify-content-between align-items-start mb--60 border-bottom pb-5">
            <div class="rts-section">
              <h3 class="rts-section-title">Program Assessment and Quality Improvement Committee (PAQIC)</h3>
            </div>
          </div>
        </div>

        <div class="row g-5">
          {paqicMembers.map((member) => (
            <div class="col-lg-3 col-md-4 col-sm-6">
              <div class="single-cat-item">
                <div class="cat-thumb" style="height: 250px;">
                  {/* TODO: replace with real committee member photo */}
                  <img src={`/assets/images/faculty/ece/${member.image}.jpg`} alt={member.name} style="height: 100%; object-fit: contain;" loading="lazy" decoding="async">
                </div>
                <div class="cat-meta">
                  <div class="cat-title">
                    {member.link ? (
                      <a href={member.link}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                  </div>
                  <div class="cat-role">
                    <span class="cat-role-text" style={member.role === 'Chairman' || member.role === 'Coordinator' ? 'color: var(--rt-primary); font-weight: 600;' : 'color: var(--rt-body);'}>
                      {member.role}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- BoS Meetings Accordion Section -->
        <div class="row justify-content-md-center mt--60">
          <div class="col-lg-12 col-md-11 border-top pt-5">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">Board of Studies (BoS) Meetings</h3>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="ece-bos-accordion">
                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#eceBosMeetings"
                      aria-expanded="false"
                    >
                      BOS Meeting Minutes (2016-17 to 2024-25)
                    </button>
                    <div
                      id="eceBosMeetings"
                      class="accordion-collapse collapse"
                      data-bs-parent="#ece-bos-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                          {bosMeetings.map((meeting) => (
                            <li class="si__list--single" style="margin-bottom: 0.75rem;">
                              <a href={meeting.file} target="_blank" rel="noopener noreferrer" style="color: var(--rt-primary); font-weight: 500; display: inline-flex; align-items: center; gap: 8px;">
                                <i class="fa-light fa-file-pdf" style="font-size: 1.4rem;"></i>
                                {meeting.name}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
