---
import BaseHead from '../../../../components/BaseHead.astro';
import FooterScripts from '../../../../components/FooterScripts.astro';
import SrkrHeader from '../../../../components/SrkrHeader.astro';
import SrkrFooter from '../../../../components/SrkrFooter.astro';
import OffCanvas from '../../../../components/OffCanvas.astro';
import DeptNav from '../../../../components/DeptNav.astro';

const labs = [
  { 
    name: 'Electronic Devices & Circuits Lab',          
    badge: 'Core Lab', 
    img: '/assets/images/ece/electronic-devices-circuits-lab.jpg' 
  },
  { 
    name: 'Digital Electronics Lab',                    
    badge: 'Core Lab', 
    img: '/assets/images/ece/digital-electronics-lab.jpg' 
  },
  { 
    name: 'Analog Circuits Lab',                        
    badge: 'Advanced', 
    img: '/assets/images/ece/analog-circuits-lab.jpg' 
  },
  { 
    name: 'Microprocessors & Microcontrollers Lab',     
    badge: 'Core Lab', 
    img: '/assets/images/ece/microprocessors-microcontroller-lab.jpg' 
  },
  { 
    name: 'Communication Lab',                          
    badge: 'Core Lab', 
    img: '/assets/images/ece/communication-lab.jpg' 
  },
  { 
    name: 'VLSI Design Lab',                            
    badge: 'Advanced', 
    img: '/assets/images/ece/vlsi-design.jpg' 
  },
  { 
    name: 'Digital Signal Processing (DSP) Lab',        
    badge: 'Advanced', 
    img: '/assets/images/ece/digital-signal-processing.jpg' 
  },
  { 
    name: 'Microwave & Antennas Lab',                   
    badge: 'Specialized', 
    img: '/assets/images/ece/microwave-antennas.jpg' 
  },
  { 
    name: 'IoT Lab',                                    
    badge: 'Emerging Tech', 
    img: '/assets/images/ece/iot.jpg' 
  },
  { 
    name: 'Project & Innovation Lab',                   
    badge: 'Workspace', 
    img: '/assets/images/ece/project-innovation.jpg' 
  },
  { 
    name: 'Skill Development Lab',                      
    badge: 'Training', 
    img: '/assets/images/ece/skill-development.jpg' 
  },
  { 
    name: 'Departmental Library',                       
    badge: 'Facility', 
    img: '/assets/images/ece/department-library.jpg' 
  },
];
---

<style>
  .single-cat-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cat-thumb {
    height: 250px;
    overflow: hidden;
    position: relative;
  }

  .cat-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-meta {
    padding: 1.5rem 1rem;
  }

  .cat-title a {
    font-size: 1.5rem;;
  }

  .cat-link {
    display: none;
  }

  .cat-title {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Facilities | Electronics & Communication Engineering | SRKR" description="Laboratories and research facilities of the Electronics & Communication Engineering department at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/faculty/ece/ecehome.jpeg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/departments">Departments</a></li>
                <li class="breadcrumb-item"><a href="/departments/ece/">Electronics &amp; Communication Engineering</a></li>
              </ul>
              <h1 class="section-title">Facilities</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rts-scholarship pt--40 pb--60">
      <div class="container">
        <DeptNav dept="ece" current="Facilities" />
        <div class="row">
          <div class="col-12">

            <div class="program-about">
              <h4 class="title">Our Laboratories</h4>
              <p>The department is equipped with eleven well-maintained laboratories featuring industry-grade instruments and the latest design software to support B.Tech and M.Tech coursework, research and consultancy. A dedicated VLSI Design Lab (operating as a Centre of Excellence), a Microwave &amp; Antennas Lab, and a modern IoT Lab give students hands-on exposure to the technologies that drive today's electronics industry.</p>
            </div>

            <div class="rts-section mb--40 mt--40">
              <h3 class="rts-section-title">Laboratory Infrastructure</h3>
            </div>

            <div class="row g-5">
              {labs.map(lab => (
                <div class="col-lg-4 col-md-6">
                  <div class="single-cat-item">
                    <div class="cat-thumb">
                      <img src={lab.img} alt={lab.name} />
                      <a href="#" class="cat-link-btn">{lab.badge}</a>
                    </div>
                    <div class="cat-meta">
                      <div class="cat-title">
                        <a href="#">{lab.name}</a>
                      </div>
                      <div class="cat-link">
                        <a href="#" class="cat-link-arrow"><i class="fa-sharp fa-regular fa-arrow-right"></i></a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
