--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     
    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Admission Procedure</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->



    <!-- event details -->
    <div class="rts-event-details pt--120 pb--80">
        <div class="container">
            <div class="row justify-content-md-center justify-content-start">
                <div class="col-lg-7 col-md-10">
                    <div class="event-details">
                        <div class="event-details__content">
                            
                            <div class="event-details__content--text">
                                <div class="rts-section">
                                    <p class="description">The eligibility criteria for admission into various UG and PG programmes at SRKR Engineering College are based upon the guidelines that are being set up by the Govt of Andhra Pradesh from time to time.</p>
                                </div>
                            </div>

                            <div class="mb--40">
                                <h4>Admission Codes</h4>
                                <div class="row g-4 mt--10">
                                    <div class="col-md-4">
                                        <div class="card h-100 shadow-sm text-center p-3 border-0 bg-light">
                                            <div class="card-body">
                                                <h3 class="mb-2" style="color: var(--rt-primary);">SRKR</h3>
                                                <p class="card-text small text-muted mb-0">EAPCET / ECET admission code</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card h-100 shadow-sm text-center p-3 border-0 bg-light">
                                            <div class="card-body">
                                                <h3 class="mb-2" style="color: var(--rt-primary);">SRKR1</h3>
                                                <p class="card-text small text-muted mb-0">M.Tech admission code</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card h-100 shadow-sm text-center p-3 border-0 bg-light">
                                            <div class="card-body">
                                                <h3 class="mb-2" style="color: var(--rt-primary);">17086</h3>
                                                <p class="card-text small text-muted mb-0">B.B.A. admission code</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="event-details__content--feature">
                                <!-- single feature -->
                                 <h4>Allotment of Seats for UG Courses:</h4>
                                 <div class="single-feature">
                                    <p class="feature-heading">Seat Classification:</p>
                                    <p class="feature-description">The seats are divided into Category A and Category B seats.</p>
                                </div>
                            
                                <!-- single feature -->
                                <div class="single-feature">
                                    <p class="feature-heading">Category A Seats:</p>
                                    <p class="feature-description">Comprise 70% of the sanctioned intake. These seats are filled with eligible candidates based on the rank obtained in APEAPCET.</p>
                                </div>
                            
                                <!-- single feature -->
                                <div class="single-feature">
                                    <p class="feature-heading">Category B Seats:</p>
                                    <p class="feature-description">Comprise 30% of the total intake. These include both Cat-B NRI and Cat-B non-NRI seats.</p>
                                </div>
                            
                                <!-- single feature -->
                                <!-- <div class="single-feature">
                                    <p class="feature-heading">Cat-B Sub-Division:</p>
                                    <p class="feature-description">15% of the sanctioned intake is allotted to each Cat-B category — NRI and non-NRI.</p>
                                </div> -->
                            
                                <!-- single feature -->
                                <div class="single-feature">
                                    <p class="feature-heading">Lateral Entry (Second Year):</p>
                                    <p class="feature-description">All seats are filled with eligible candidates based on the rank obtained in APECET.</p>
                                </div>
                                <h4>Allotment of Seats for PG Courses:</h4>
                                <div class="single-feature">
                                    <p class="feature-heading">Seat Classification:</p>
                                    <p class="feature-description">The seats are divided into Category A and Category B seats.</p>
                                </div>
                            
                                <!-- single feature -->
                                <div class="single-feature">
                                    <p class="feature-heading">Category A Seats:</p>
                                    <p class="feature-description">Comprise 70% of the sanctioned intake. These seats are filled with eligible candidates based on the rank obtained in APPGECET.</p>
                                </div>
                            
                                <!-- single feature -->
                                <div class="single-feature">
                                    <p class="feature-heading">Category B Seats:</p>
                                    <p class="feature-description">Comprise 30% of the total intake. These include both Cat-B NRI and Cat-B non-NRI seats.</p>
                                </div>
                            
                                <!-- single feature -->
                                <div class="single-feature">
                                    <p class="feature-heading">Cat-B Sub-Division:</p>
                                    <p class="feature-description">15% of the sanctioned intake is allotted to each Cat-B category — NRI and non-NRI.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
   
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>