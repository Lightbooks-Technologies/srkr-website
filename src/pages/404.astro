---
import BaseHead from '../components/BaseHead.astro';
import SrkrHeader from '../components/SrkrHeader.astro';
import SrkrFooter from '../components/SrkrFooter.astro';
import OffCanvas from '../components/OffCanvas.astro';
import FooterScripts from '../components/FooterScripts.astro';
import { SITE_NAME } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Page Not Found (404) | ${SITE_NAME}`}
      description="The page you were looking for could not be found. Browse SRKR Engineering College's departments, admissions information, placements, research, and campus life."
      noindex={true}
    />
  </head>
  <body class="error-page">
    <SrkrHeader />
    <style is:global>
      /* Force solid header on 404 page — header starts transparent, force it opaque */
      body.error-page .header.header__sticky {
        background: #ffffff !important;
        box-shadow: 0px 7px 18px rgba(24, 16, 16, 0.08) !important;
      }
      body.error-page .header.header__sticky .navigation__menu--item__link {
        color: #262626 !important;
      }
      body.error-page .header.header__sticky .navigation__menu--item.has-arrow::before {
        color: #262626 !important;
      }
      body.error-page .header.header__sticky .hamburger-line {
        background: #262626 !important;
      }

      /* 404 page buttons with accessible hover contrast */
      .err-btn {
        display: inline-flex;
        align-items: center;
        padding: 12px 28px;
        border-radius: 4px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        border: 2px solid transparent;
        transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
        cursor: pointer;
      }
      /* Primary: maroon bg, white text — matches site theme */
      .err-btn--primary {
        background: #890C25;
        color: #ffffff;
        border-color: #890C25;
      }
      .err-btn--primary:hover {
        background: #6a0a1c;
        color: #ffffff;
        border-color: #6a0a1c;
      }
      /* Outline: white bg, maroon text + border */
      .err-btn--outline {
        background: #ffffff;
        color: #890C25;
        border-color: #890C25;
      }
      .err-btn--outline:hover {
        background: #890C25;
        color: #ffffff;
        border-color: #890C25;
      }
      /* Secondary: dark heading bg, white text */
      .err-btn--dark {
        background: #2b3d4f;
        color: #ffffff;
        border-color: #2b3d4f;
      }
      .err-btn--dark:hover {
        background: #1c2d3a;
        color: #ffffff;
        border-color: #1c2d3a;
      }
      /* 404 large number */
      .err-404-number {
        font-size: clamp(80px, 10vw, 160px);
        font-weight: 800;
        line-height: 1;
        color: #890C25;
        letter-spacing: -4px;
        margin-bottom: 0.25rem;
      }
      .err-quick-links a {
        color: #5e6e7d;
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s;
      }
      .err-quick-links a:hover {
        color: #890C25;
      }
      .err-card h5 {
        color: #890C25;
      }
    </style>

    <!-- Breadcrumb banner — matches other pages -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
              </ul>
              <h1 class="section-title">Page Not Found</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main 404 content -->
    <div class="rts-about-area pt--60 pb--80">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <div class="d-flex flex-wrap gap-3 justify-content-center mb-5">
              <a href="/" class="err-btn err-btn--primary">
                <i class="fa-light fa-house me-2"></i> Back to Home
              </a>
              <a href="/departments/" class="err-btn err-btn--outline">
                <i class="fa-light fa-building-columns me-2"></i> Departments
              </a>
              <a href="/admission-brochure/" class="err-btn err-btn--dark">
                <i class="fa-light fa-graduation-cap me-2"></i> Admissions 2026
              </a>
            </div>
          </div>
        </div>

        <div class="row g-4 mt-4">
          <div class="col-md-4">
            <div class="p-4 bg-white border rounded shadow-sm h-100 err-card">
              <h5 style="display:flex; align-items:center; gap:10px;">
                <i class="fa-light fa-building-columns"></i> Academics
              </h5>
              <ul class="list-unstyled mb-0 err-quick-links" style="font-size:0.95rem; line-height:2;">
                <li><a href="/departments/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>All Departments</a></li>
                <li><a href="/programmes/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Programs Offered</a></li>
                <li><a href="/calender/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Academic Calendar</a></li>
                <li><a href="/syllabus/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Syllabus</a></li>
              </ul>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-4 bg-white border rounded shadow-sm h-100 err-card">
              <h5 style="display:flex; align-items:center; gap:10px;">
                <i class="fa-light fa-user-graduate"></i> Admissions
              </h5>
              <ul class="list-unstyled mb-0 err-quick-links" style="font-size:0.95rem; line-height:2;">
                <li><a href="/procedure/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>How to Apply</a></li>
                <li><a href="/admission-brochure/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Admission Brochure</a></li>
                <li><a href="/fee/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Fee Structure</a></li>
                <li><a href="/regulations/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Academic Regulations</a></li>
              </ul>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-4 bg-white border rounded shadow-sm h-100 err-card">
              <h5 style="display:flex; align-items:center; gap:10px;">
                <i class="fa-light fa-briefcase"></i> Career & Research
              </h5>
              <ul class="list-unstyled mb-0 err-quick-links" style="font-size:0.95rem; line-height:2;">
                <li><a href="/placements/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Placements</a></li>
                <li><a href="/research-overview/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Research Overview</a></li>
                <li><a href="/quick-links/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>Quick Links</a></li>
                <li><a href="/college-profile/"><i class="fa-light fa-chevron-right me-1" style="font-size:11px;"></i>About SRKR</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
