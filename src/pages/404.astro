---
import BaseHead from '../components/BaseHead.astro';
import SrkrHeader from '../components/SrkrHeader.astro';
import SrkrFooter from '../components/SrkrFooter.astro';
import OffCanvas from '../components/OffCanvas.astro';
import FooterScripts from '../components/FooterScripts.astro';
import { SITE_NAME } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Page Not Found (404) | ${SITE_NAME}`}
      description="The page you were looking for could not be found. Browse SRKR Engineering College's departments, admissions information, placements, research, and campus life."
      noindex={true}
    />
  </head>
  <body class="error-page">
    <SrkrHeader />

    <section class="rts-section-padding" style="min-height: 60vh; display: flex; align-items: center; background: linear-gradient(135deg, #f8fafc 0%, #e8eef7 100%);">
      <div class="container">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <div style="font-size: clamp(80px, 8vw, 180px); font-weight: 800; line-height: 1; color: #1a3c6b; margin-bottom: 0.5rem;">
              404
            </div>
            <h1 style="font-size: clamp(28px, 4vw, 42px); color: #1a3c6b; margin-bottom: 1rem;">
              Page Not Found
            </h1>
            <p style="font-size: 1.1rem; color: #475569; max-width: 600px; margin: 0 auto 2rem;">
              Sorry, the page you were looking for doesn't exist or may have moved. If you arrived here from an old SRKR link, the content may now live at a new URL.
              Please use the suggestions below to find what you're looking for.
            </p>

            <div class="d-flex flex-wrap gap-3 justify-content-center mb-5">
              <a href="/" class="rts-theme-btn">
                <i class="fa-light fa-house me-2"></i> Back to Home
              </a>
              <a href="/departments/" class="rts-theme-btn" style="background:#fff;color:#1a3c6b;border:2px solid #1a3c6b;">
                <i class="fa-light fa-building-columns me-2"></i> Departments
              </a>
              <a href="/admission-brochure/" class="rts-theme-btn" style="background:#f5c518;color:#1a3c6b;">
                <i class="fa-light fa-graduation-cap me-2"></i> Admissions 2025
              </a>
            </div>

            <div class="row g-4 text-start mt-5">
              <div class="col-md-4">
                <div class="p-4 bg-white rounded shadow-sm h-100">
                  <h5 style="color:#1a3c6b;"><i class="fa-light fa-building-columns me-2"></i>Academics</h5>
                  <ul class="list-unstyled mb-0" style="font-size:0.95rem;">
                    <li><a href="/departments/" style="color:#475569;">All Departments</a></li>
                    <li><a href="/programmes/" style="color:#475569;">Programs Offered</a></li>
                    <li><a href="/calender/" style="color:#475569;">Academic Calendar</a></li>
                    <li><a href="/syllabus/" style="color:#475569;">Syllabus</a></li>
                  </ul>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-4 bg-white rounded shadow-sm h-100">
                  <h5 style="color:#1a3c6b;"><i class="fa-light fa-user-graduate me-2"></i>Admissions</h5>
                  <ul class="list-unstyled mb-0" style="font-size:0.95rem;">
                    <li><a href="/procedure/" style="color:#475569;">How to Apply</a></li>
                    <li><a href="/admission-brochure/" style="color:#475569;">Admission Brochure</a></li>
                    <li><a href="/fee/" style="color:#475569;">Fee Structure</a></li>
                    <li><a href="/regulations/" style="color:#475569;">Academic Regulations</a></li>
                  </ul>
                </div>
              </div>
              <div class="col-md-4">
                <div class="p-4 bg-white rounded shadow-sm h-100">
                  <h5 style="color:#1a3c6b;"><i class="fa-light fa-briefcase me-2"></i>Career & Research</h5>
                  <ul class="list-unstyled mb-0" style="font-size:0.95rem;">
                    <li><a href="/placements/" style="color:#475569;">Placements</a></li>
                    <li><a href="/research-overview/" style="color:#475569;">Research Overview</a></li>
                    <li><a href="/quick-links/" style="color:#475569;">Quick Links</a></li>
                    <li><a href="/college-profile/" style="color:#475569;">About SRKR</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
