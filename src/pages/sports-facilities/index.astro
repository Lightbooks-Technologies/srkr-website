---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import OffCanvas from "../../components/OffCanvas.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
import DeptNav from "~/components/DeptNav.astro";

const momentsImages = [
  "/assets/images/sports/badminton.jpg",
  "/assets/images/sports/basketball.jpg",
  "/assets/images/sports/boys-gym.jpg",
  "/assets/images/sports/carroms.jpg",
  "/assets/images/sports/chess.jpg",
  "/assets/images/sports/cricket-court.jpg",
  "/assets/images/sports/football.jpg",
  "/assets/images/sports/gym-facilities-for-girls.jpg",
  "/assets/images/sports/Kabaddi.jpg",
  "/assets/images/sports/kho-kho.jpg",
  "/assets/images/sports/long-jump.jpg",
  "/assets/images/sports/net-ball.jpg",
  "/assets/images/sports/pickel-ball.jpg",
  "/assets/images/sports/table-tennis.jpg",
  "/assets/images/sports/tennis-court.jpg",
  "/assets/images/sports/throwball.jpg",
  "/assets/images/sports/volleyball.jpg"
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .event-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
        border-radius: 16px;
        border: 1px solid #e3e7f3;
        padding: 16px 0;
        margin-top: 15px;
      }
      .event-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .event-wall .container-fluid {
        position: relative;
        z-index: 1;
      }
      .event-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      }
      .event-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .event-wall__track {
        display: flex;
        width: max-content;
        gap: 20px;
        padding: 6px 12px;
      }
      .moment-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 14px;
        width: min(75vw, 280px);
        flex: 0 0 auto;
        padding: 10px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .moment-card__photo {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
      }
    </style>
  </head>
  <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->

    <!-- BREADCRUMB AREA -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
              </ul>
              <h1 class="section-title">Sports and Games</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->

    <div class="container">
      <div class="row mt--30">
        <DeptNav dept="pet" current="Home" />

        <div class="col-12">
          <div class="admission-content-top">
            
            <!-- OUTDOOR SPORTS FACILITIES -->
            <div class="application-deadline mb-5">
              <h3 class="rts-section-title mb-4">
                Outdoor Sports Facilities
              </h3>
              <div class="application-deadline__content">
                <div class="application-deadline__content--table">
                  <table class="table">
                    <thead class="table-theme">
                      <tr>
                        <td>S.NO</td>
                        <td>Sports &amp; Games Facilities</td>
                        <td>No. of courts</td>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>1</td>
                        <td>Tennikoit Courts</td>
                        <td>2</td>
                      </tr>
                      <tr>
                        <td>2</td>
                        <td>Throw Ball Court</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>3</td>
                        <td>Basketball Court</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>4</td>
                        <td>Volleyball Courts</td>
                        <td>2</td>
                      </tr>
                      <tr>
                        <td>5</td>
                        <td>Badminton Outdoor Courts</td>
                        <td>2</td>
                      </tr>
                      <tr>
                        <td>6</td>
                        <td>Kabaddi Court</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>7</td>
                        <td>Kho-Kho Court</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>8</td>
                        <td>Tennis Court</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>9</td>
                        <td>Cricket Ground including Running Track</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>10</td>
                        <td>Football Field</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>11</td>
                        <td>Hand Ball Court</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>12</td>
                        <td>Hockey Field</td>
                        <td>1</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- INDOOR SPORTS FACILITIES -->
            <div class="application-deadline mb-5">
              <h3 class="rts-section-title mb-4">
                Indoor Sports Facilities
              </h3>
              <div class="application-deadline__content">
                <div class="application-deadline__content--table">
                  <table class="table">
                    <thead class="table-theme">
                      <tr>
                        <td>S.NO</td>
                        <td>Sports &amp; Games Facilities</td>
                        <td>No. of courts / boards</td>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>1</td>
                        <td>Table Tennis</td>
                        <td>2 (Boards)</td>
                      </tr>
                      <tr>
                        <td>2</td>
                        <td>Carroms</td>
                        <td>5 (Boards)</td>
                      </tr>
                      <tr>
                        <td>3</td>
                        <td>Chess</td>
                        <td>10 (Boards)</td>
                      </tr>
                      <tr>
                        <td>4</td>
                        <td>Gym (Sandpit)</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>5</td>
                        <td>Indoor Badminton Synthetic Courts</td>
                        <td>2</td>
                      </tr>
                      <tr>
                        <td>6</td>
                        <td>Multi Station Gym (Boys)</td>
                        <td>1</td>
                      </tr>
                      <tr>
                        <td>7</td>
                        <td>Gym (Girls)</td>
                        <td>1</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- MOMENTS & HIGHLIGHTS SECTION -->
            <div class="row mt-5 mb-5">
              <div class="col-12">
                <div class="rts-scholarship-description">
                  <h3 class="mb-4">
                  </h3>
                  <div class="event-wall">
                    <div class="container-fluid px-0">
                      <div class="event-wall__ticker" data-ticker>
                        <div class="event-wall__track">
                          {momentsImages.map((imgSrc, idx) => (
                            <div class="moment-card">
                              <img 
                                class="moment-card__photo"
                                src={imgSrc} 
                                alt={`Moment ${idx + 1}`} 
                                loading="lazy" 
                                decoding="async" 
                              />
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- Ticker Autoscroll Script -->
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const tickers = document.querySelectorAll('[data-ticker]');
        tickers.forEach((ticker) => {
          const track = ticker.querySelector('.event-wall__track');
          if (!track) return;

          let paused = false;
          let lastTime = 0;

          const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

          const step = (time) => {
            if (!lastTime) lastTime = time;
            const delta = time - lastTime;
            lastTime = time;

            if (!paused && ticker.clientWidth > 0) {
              ticker.scrollLeft += delta * 0.05;
              const maxScroll = getMaxScroll();
              if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
                ticker.scrollLeft = 0;
              }
            }

            window.requestAnimationFrame(step);
          };

          ticker.addEventListener('mouseenter', () => {
            paused = true;
          });

          ticker.addEventListener('mouseleave', () => {
            paused = false;
            lastTime = 0;
          });

          const observer = new ResizeObserver(() => {
            lastTime = 0;
          });
          observer.observe(ticker);

          window.requestAnimationFrame(step);
        });
      })();
    </script>

    <!-- footer -->
    <SrkrFooter />

    <!-- footer copyright end -->

    <OffCanvas />

    <!-- scripts -->
    <FooterScripts />
  </body>
</html>