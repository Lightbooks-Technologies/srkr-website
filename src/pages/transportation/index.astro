const routes = [
  { region: 'East Godavari', stops: ['Rajahmundry', 'Kakinada', 'Tanuku', 'Nidadavolu', 'Tadepalligudem'] },
  { region: 'West Godavari', stops: ['Bhimavaram (Town)', 'Palakollu', 'Narsapur', 'Mogalthur', 'Veeravasaram', 'Akividu', 'Undi'] },
  { region: 'Krishna District', stops: ['Vijayawada', 'Machilipatnam', 'Gudivada', 'Kaikalur', 'Mandavalli'] },
  { region: 'Visakhapatnam / North AP', stops: ['Visakhapatnam (limited weekend service)', 'Vizianagaram (on-demand)'] },
