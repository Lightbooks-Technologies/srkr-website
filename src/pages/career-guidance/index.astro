---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = 'Career Guidance';

const services = [
  { icon: 'fa-light fa-file-lines',  title: 'Resume Reviews',           desc: 'Personalized resume audits, LinkedIn profile optimization and portfolio reviews.' },
  { icon: 'fa-light fa-user-tie',    title: 'Interview Coaching',       desc: 'Mock technical, HR and behavioral interviews with structured feedback.' },
  { icon: 'fa-light fa-graduation-cap', title: 'Career Studies Counseling', desc: 'M.Tech, MS, MBA — university selection, SOP review and application timelines.' },
  { icon: 'fa-light fa-handshake',   title: 'Industry Mentorship',      desc: 'One-on-one mentorship with SRKR alumni in product, services, GCC and PSU domains.' },
  // { icon: 'fa-light fa-landmark',    title: 'Govt Exam Coaching',       desc: 'UPSC, APPSC, GATE, IBPS and SSC — strategy sessions and study circles.' },
  // { icon: 'fa-light fa-lightbulb',   title: 'Entrepreneurship Support', desc: 'Startup ideation, EDC mentorship and pitch deck reviews.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Career counseling, resume reviews, interview coaching, higher studies and government exam guidance at SRKR Engineering College." />
  </head>
     <style>
      .program-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: inherit;
        transition:
          background-color 0.2s,
          box-shadow 0.2s;
        gap: 8px;
        margin-bottom: 12px;
      }
      .program-item:hover {
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .program-item span {
        display: flex;
        align-items: center;
        color: var(--rt-primary);
      }
      .program-item i {
        margin-left: 8px;
        transition: transform 0.2s;
        padding: 8px;
        color: var(--rt-secondary);
      }
      .learning-resources span {
        justify-content: left;
        display: flex;
        flex-direction: column;
      }

    </style>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/placements">Placements</a></li>
                <li class="breadcrumb-item active" aria-current="page">{pageTitle}</li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hero + Funfact -->
    <section class="rts-about-university pt--60 pb--40">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">Career Guidance</h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                Whether you're targeting industry, higher studies, government services or starting up — our counselors and alumni mentors help you choose the right path.
              </p>
            </div>
          </div>
        </div>

        <div class="row g-4 mt--30">
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">1500+</h2>
            <p class="item-description">Counseling Sessions / Year</p>
          </div></div></div>
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">100+</h2>
            <p class="item-description">Alumni Mentors</p>
          </div></div></div>
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">5</h2>
            <p class="item-description">Career Pathways</p>
          </div></div></div>
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">45+</h2>
            <p class="item-description">Higher-Studies Admits / Year</p>
          </div></div></div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="rts-campus-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Services Offered</h3>
          </div>
        </div>
        <div class="row g-5">
          {services.map((s) => (
            <div class="col-lg-4 col-md-6 col-sm-6">
              <div class="single-item">
                <div class="single-item__content">
                  <div class="single-item__meta" style="padding: 28px;">
                    <h5 class="item-title"><i class={s.icon}></i> &nbsp;{s.title}</h5>
                    <p class="item-description">{s.desc}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pathways Accordion -->
