    <!-- Resources -->
    <div class="rts-multi-row-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Learning Resources</h3>
          </div>
        </div>
        <div class="row g-4 learning-resources">
          <div class="col-lg-4 col-md-6 col-sm-12">
            <a href="https://www.nptel.ac.in" class="program-item" target="_blank" rel="noopener"><span><strong>NPTEL</strong><br /><small>IIT-led online courses &amp; certification</small></span><i class="fa-regular fa-chevron-right"></i></a>
          </div>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <a href="https://www.coursera.org" class="program-item" target="_blank" rel="noopener"><span><strong>Coursera</strong><br /><small>Coursera for Campus licenses</small></span><i class="fa-regular fa-chevron-right"></i></a>
          </div>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <a href="https://www.linkedin.com/learning/" class="program-item" target="_blank" rel="noopener"><span><strong>LinkedIn Learning</strong><br /><small>Career-aligned courses &amp; videos</small></span><i class="fa-regular fa-chevron-right"></i></a>
          </div>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <a href="https://gate2025.iitr.ac.in" class="program-item" target="_blank" rel="noopener"><span><strong>GATE 2025</strong><br /><small>Official GATE portal &amp; study plan</small></span><i class="fa-regular fa-chevron-right"></i></a>
          </div>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <a href="https://www.ets.org/gre" class="program-item" target="_blank" rel="noopener"><span><strong>GRE Prep</strong><br /><small>Official ETS preparation hub</small></span><i class="fa-regular fa-chevron-right"></i></a>
          </div>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <a href="https://upsc.gov.in" class="program-item" target="_blank" rel="noopener"><span><strong>UPSC</strong><br /><small>Civil Services &amp; ESE notifications</small></span><i class="fa-regular fa-chevron-right"></i></a>
          </div>
        </div>
      </div>
    </div>

    <!-- Counselor Contact + External Links -->
    <section class="rts-research-section pb--80">
      <div class="container">
        <div class="row">
          <div class="rts-research-section__content">
            <div class="rts-section">
              <h3 class="rts-section-title">Counselor Contact</h3>
              <p class="description"><strong>Mrs. K. Padmaja</strong> — Internship &amp; Career Counselor</p>
              <p class="description"><i class="fa-regular fa-envelope"></i> <a href="mailto:careers@srkrec.ac.in">careers@srkrec.ac.in</a></p>
              <p class="description"><i class="fa-regular fa-phone"></i> +91 9849 55 3332</p>
              <p class="description"><i class="fa-regular fa-clock"></i> Walk-in: Monday–Friday, 2:00 PM – 5:00 PM</p>
              <p class="description"><i class="fa-regular fa-location-dot"></i> T&amp;P Cell, Administrative Block, SRKR Engineering College</p>
            </div>
          </div>
          <div class="research__text">
            <div class="research__text--single">
              <h3 class="rts-section-title">Quick Links</h3>
              <div class="program-list">
                <a href="/placements" class="program-item"><span>About Placement Cell <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="/placements-team" class="program-item"><span>Placements Team <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="/training" class="program-item"><span>Training Activities <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="/internships" class="program-item"><span>Internship Opportunities <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="https://www.srkrexams.in" class="program-item" target="_blank" rel="noopener"><span>Examinations Portal <i class="fa-regular fa-chevron-right"></i></span></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* TODO: add alumni mentor directory with department/role filtering */}
    {/* TODO: add downloadable GATE/GRE/UPSC study-plan PDFs once curated */}

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
