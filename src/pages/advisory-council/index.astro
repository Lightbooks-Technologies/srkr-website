    <!-- footer copyright -->
    <div class="copyright">
      <div class="container">
        <div class="row">
          <div class="col-sm-12">
            <div class="copyright__wrapper">
              <p>
                Copyright &copy; 2026 All Rights Reserved by <a
                  href="/">SRKR Engineering College</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- footer copyright end -->

    <OffCanvas />

    <!-- scripts -->
    <FooterScripts />
  </body>
</html>
