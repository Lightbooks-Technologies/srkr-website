---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import OffCanvas from "../../components/OffCanvas.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";

type ResearchData = {
  year: number;
  scopusCount: number | string;
};

var researchData: ResearchData[] = [
    {
     year: 2026,
        scopusCount: '251*',
    },
    {
    year: 2025,
    scopusCount: 772,
    },
  {
    year: 2024,
    scopusCount: 499,
  },
  {
    year: 2023,
    scopusCount: 195,
  },
  {
    year: 2022,
    scopusCount: 152,
  },
  {
    year: 2021,
    scopusCount: 76,
  },
  {
    year: 2020,
    scopusCount: 77,
  },
  {
    year: 2019,
    scopusCount: 201,
  },
  {
    year: 2018,
    scopusCount: 145,
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
    <!-- BREADCRUMB AREA -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcrumb-height-full breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb-2.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                  Publications
                </li>
              </ul>
              <h1 class="section-title">Publications</h1>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- BREADCRUMB AREA END -->
    <!-- reasearch area -->
    <section class="rts-research-section rts-section-padding">
      <div class="container">
        <div class="row">
          <!-- research item -->
          <div class="research__items">
            <!-- apply content -->
            <div
              class="row justify-content-sm-center justify-content-md-start g-5"
            >
              {
                researchData.map((item, index) => (
                  <div class="col-lg-4 col-md-6 col-sm-11">
                    <div
                      class={`research-procedure ${index === 1 ? "primary-style" : ""}`}
                    >
                      <div class="research-image">
                        <img
                          src="/assets/images/apply/01.jpg"
                          alt="application-thumb"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="rt-serial">
                        {String(index + 1).padStart(2, "0")}
                      </div>
                      <a href="#">{item.year}</a>
                      <p>Publications (Scopus Indexed): {item.scopusCount}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- reasearch area end-->
    <!-- footer -->
    <SrkrFooter />

    <!-- footer copyright end -->

    <OffCanvas/>

    <!-- scripts -->
    <FooterScripts />
  </body>
</html>
