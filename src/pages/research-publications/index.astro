--- 
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '~/components/SrkrHeader.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
      <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcrumb-height-full breadcumb-bg" style="background-image: url(assets/images/banner/breadcrumb-2.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Publications</li>
                        </ul>
                        <h2 class="section-title">Publications</h2>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->
    <!-- reasearch area -->
