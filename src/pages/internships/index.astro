    </section> -->

    <!-- Past Internship Companies -->
    <div class="rts-multi-row-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Past Internship Companies</h3>
          </div>
        </div>
        <div class="row g-4">
          {internshipCompanies.map((c) => (
            <div class="col-lg-2 col-md-3 col-4">
              <div class="recruiter-logo-box">
                <img src={c.logo} alt={c.name} />
              </div>
            </div>
          ))}
          {/* TODO: add more recruiter logos */}
        </div>
      </div>
    </div>

    <!-- Reports/Forms downloads + Quick Links -->
    <section class="rts-research-section pb--80">
      <div class="container">
        <div class="row">
          <div class="rts-research-section__content">
            <div class="rts-section">
              <h3 class="rts-section-title">Forms &amp; Reports</h3>
              <div class="program-list">
                <a href="/assets/documents/internship-registration-form.pdf" class="program-item" target="_blank" rel="noopener"><span>Internship Registration Form <i class="fa-regular fa-chevron-right"></i></span><span>PDF</span></a>
                <a href="/assets/documents/internship-weekly-log.pdf" class="program-item" target="_blank" rel="noopener"><span>Weekly Log Template <i class="fa-regular fa-chevron-right"></i></span><span>PDF</span></a>
                <a href="/assets/documents/internship-final-report-template.pdf" class="program-item" target="_blank" rel="noopener"><span>Final Report Template <i class="fa-regular fa-chevron-right"></i></span><span>PDF</span></a>
                <a href="/assets/documents/internship-evaluation-rubric.pdf" class="program-item" target="_blank" rel="noopener"><span>Evaluation Rubric <i class="fa-regular fa-chevron-right"></i></span><span>PDF</span></a>
              </div>
            </div>
          </div>
          <div class="research__text">
            <div class="research__text--single">
              <h3 class="rts-section-title">External Portals</h3>
              <div class="program-list">
                <a href="https://internship.aicte-india.org" class="program-item" target="_blank" rel="noopener"><span>AICTE Internship Portal <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="https://internshala.com" class="program-item" target="_blank" rel="noopener"><span>Internshala <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="https://www.aicte-india.org/schemes/students-development-schemes/AICTE-IDEA-Lab" class="program-item" target="_blank" rel="noopener"><span>AICTE-IDEA Lab <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="https://www.nptel.ac.in" class="program-item" target="_blank" rel="noopener"><span>NPTEL Industry Associate <i class="fa-regular fa-chevron-right"></i></span></a>
                <a href="/training" class="program-item"><span>Training Activities <i class="fa-regular fa-chevron-right"></i></span></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* TODO: replace placeholder form PDFs in /assets/documents/ with official templates */}
    {/* TODO: add past internship project gallery / student testimonials section */}

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
