---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = 'Internship Opportunities';

const types = [
  { icon: 'fa-light fa-sun',         title: 'Summer Internships',         desc: '6â€“8 week vacation internships with industry, research labs and partner firms.' },
  { icon: 'fa-light fa-book-open',   title: 'Semester Internships',       desc: 'Final-year semester-long, credit-linked internships with sponsored projects.' },
  { icon: 'fa-light fa-flask',       title: 'Research Internships',       desc: 'IIT/NIT/IIIT and IISc research internships under faculty mentorship.' },
  { icon: 'fa-light fa-industry',    title: 'Industry-Embedded',          desc: 'Year-long industry-embedded programs through TCS, Cognizant and partner MoUs.' },
];

// Companies that have hosted SRKR interns â€” reuse the recruiter logo paths
const internshipCompanies = [
  { name: 'TCS',          logo: '/assets/images/recruiters/tcs.png' },
  { name: 'Infosys',      logo: '/assets/images/recruiters/infosys.png' },
  { name: 'Cognizant',    logo: '/assets/images/recruiters/cts.png' },
  { name: 'Amazon',    logo: '/assets/images/recruiters/amazon.png' },
  
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Summer, semester, research and industry-embedded internships, application process and partner companies at SRKR Engineering College." />
  </head>
  <body>
       <style>
      .program-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: inherit;
        transition:
          background-color 0.2s,
          box-shadow 0.2s;
        gap: 8px;
        margin-bottom: 12px;
      }
      .program-item:hover {
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .program-item span {
        display: flex;
        align-items: center;
        color: var(--rt-primary);
      }
      .program-item i {
        margin-left: 8px;
        transition: transform 0.2s;
        padding: 8px;
        color: var(--rt-secondary);
      }
    </style>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/placements">Placements</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hero + Funfact -->
    <section class="rts-about-university pt--60 pb--40">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">Internships</h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                Hands-on industry exposure through summer, semester, research and embedded internships â€” many converting into pre-placement offers.
              </p>
            </div>
          </div>
        </div>

        <div class="row g-4 mt--30">
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">4500+</h2>
            <p class="item-description">Internships / Year</p>
          </div></div></div>
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">60+</h2>
            <p class="item-description">Partner Companies</p>
          </div></div></div>
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">30+</h2>
            <p class="item-description">Pre-Placement Offers</p>
          </div></div></div>
          <div class="col-lg-3 col-md-6 col-sm-6"><div class="single-item"><div class="single-item__meta" style="text-align:center; padding:24px;">
            <h2 style="color: var(--rt-primary); margin: 0;">12</h2>
            <p class="item-description">Departments</p>
          </div></div></div>
        </div>
      </div>
    </section>

    <!-- Internship Types -->
    <section class="rts-campus-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Internship Types</h3>
          </div>
        </div>
        <div class="row g-5">
          {types.map((t) => (
            <div class="col-lg-3 col-md-6 col-sm-6">
              <div class="single-item">
                <div class="single-item__content">
                  <div class="single-item__meta" style="padding: 28px;">
                    <h5 class="item-title"><i class={t.icon}></i> &nbsp;{t.title}</h5>
                    <p class="item-description">{t.desc}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process accordion -->
    <!-- <section class="rts-scholarship pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Application Process</h3>
          </div>
        </div>
        <div class="row">
          <div class="col-12">
            <div class="accordion" id="internAccordion">
              <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step1">Step 1 â€” Eligibility &amp; Discovery</button></h2>
                <div id="step1" class="accordion-collapse collapse show" data-bs-parent="#internAccordion"><div class="accordion-body">
                  Verify CGPA and backlog criteria. Discover openings via department TPRs, T&amp;P notice board or partner portals (AICTE, Internshala).
                </div></div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#step2">Step 2 â€” Apply via T&amp;P Cell</button></h2>
                <div id="step2" class="accordion-collapse collapse" data-bs-parent="#internAccordion"><div class="accordion-body">
                  Submit application with resume, transcripts and recommendation through the official T&amp;P portal or department TPR.
                </div></div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#step3">Step 3 â€” Selection</button></h2>
                <div id="step3" class="accordion-collapse collapse" data-bs-parent="#internAccordion"><div class="accordion-body">
                  Online assessment, technical screening and interviews (virtual or on-campus depending on company).
                </div></div>
              </div>
