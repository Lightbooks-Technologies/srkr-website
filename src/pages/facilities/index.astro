--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
<section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                    </ul>
                    <h1 class="section-title">Facilities</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
    <!-- Organogram -->
    <!-- Testimonial Start -->
    <div class="rts-testimonial v_2 rt-relative pt--120 pb--120">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-section text-center mb--45">
                        <h2 class="rts-section-title">General Facilities</h2>
                    </div>
                </div>
            </div>
            <!-- testimonial content -->
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-testimonial-box">
                        <div class="testimonial-item rt-flex">
                            
                            <div class="testimonial-item-content rt-relative" style="width: 100%;">
                                <div class="testmonial-v2">
                                    <div class="swiper-wrapper">
                                        <!-- single testimonial -->
                                        <div class="swiper-slide d-flex align-items-center" style="gap: 20%;">
                                            <div class="testimonial-item-image save-from-hidden">
                                                <img src="/assets/images/testimonial/testimonial-big-1.jpg" alt="testimonial thumbnail">
                                                
                                            </div>
                                            <div>
                                                
                                                <h2 class="text-center">
                                                    Yagashala</h2>
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center" style="gap: 20%;">
                                            <div class="testimonial-item-image save-from-hidden">
                                                <img src="/assets/images/testimonial/testimonial-big-2.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                            <div>
                                                
                                                <h2 class="text-center">
                                                    Yagashala</h2>
                                                
                                            </div>
                                        </div><div class="swiper-slide d-flex align-items-center" style="gap: 20%;">
                                            <div class="testimonial-item-image save-from-hidden">
                                                <img src="/assets/images/testimonial/testimonial-big-3.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                            <div>
                                                
                                                <h2 class="text-center">
                                                    Yagashala</h2>
                                                
                                            </div>
                                        </div><div class="swiper-slide d-flex align-items-center" style="gap: 20%;">
                                            <div class="testimonial-item-image save-from-hidden">
                                                <img src="/assets/images/testimonial/testimonial-big-4.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                            <div>
                                                
                                                <h2 class="text-center">
                                                    Yagashala</h2>
                                                
                                            </div>
                                        </div><div class="swiper-slide d-flex align-items-center" style="gap: 20%;">
                                            <div class="testimonial-item-image save-from-hidden">
                                                <img src="/assets/images/testimonial/testimonial-big-5.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                            <div>
                                                
                                                <h2 class="text-center">
                                                    Yagashala</h2>
                                                
                                            </div>
                                        </div><div class="swiper-slide d-flex align-items-center" style="gap: 20%;">
                                            <div class="testimonial-item-image save-from-hidden">
                                                <img src="/assets/images/testimonial/testimonial-big-6.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                            <div>
                                                
                                                <h2 class="text-center">
                                                    Yagashala</h2>
                                                
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- rts dot -->
                            <div class="swiper-pagination"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Testimonial end -->
    



   <!-- footer -->
   <SrkrFooter/>
   
    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>