---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="Meet the Training & Placement Cell team at SRKR Engineering College — TPO, Deputy TPO, Assistant TPOs and department coordinators."
    />
    <style>
      .program-item {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: inherit;
        transition:
          background-color 0.2s,
          box-shadow 0.2s;
        gap: 8px;
        margin-bottom: 12px;
      }
      .program-item:hover {
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .program-item span {
        display: flex;
        align-items: center;
        color: var(--rt-primary);
      }
      .program-item i {
        margin-left: 8px;
        transition: transform 0.2s;
        padding: 8px;
        color: var(--rt-secondary);
      }
    </style></head
  >

  <body>
    <SrkrHeader />

    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item">
                  <a href="/placements">Placements</a>
                </li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hero / Intro + Funfact stats -->
    <section class="rts-about-university pt--60 pb--40">
      <div class="container">
        <div class="row">
          <div class="rts-section">
            <div class="col-lg-4 col-md-3 col-sm-12">
              <h3 class="rts-section-title">
                Training &amp; Placement Cell Team
              </h3>
            </div>
            <div class="col-lg-8 col-md-9 col-sm-12">
              <p class="rts-section-description">
                The T&amp;P Cell is led by a dedicated team of officers, faculty
                coordinators and department representatives who drive
                recruitment, training and industry partnerships across all
                programs.
              </p>
            </div>
          </div>
        </div>

        <div class="row g-4 mt--30">
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">86.8%+</h2>
                <p class="item-description">Placements (2025–26)</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">19.00 LPA</h2>
                <p class="item-description">Top Package (AT&T)</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">250+</h2>
                <p class="item-description">Recruiters On-Campus</p>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6 col-sm-6">
            <div class="single-item">
              <div
                class="single-item__meta"
                style="text-align:center; padding:24px;"
              >
                <h2 style="color: var(--rt-primary); margin: 0;">25</h2>
                <p class="item-description">Industry Partners</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Team Cards -->
    <section class="rts-campus-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">Core T&amp;P Cell Officers</h3>
          </div>
        </div>
        <div class="row g-5" style="justify-content: center;">
          {
            coreTeam.map(
              (m, index) =>
                index < 1 && (
                  <div class="col-lg-4 col-md-6 col-sm-6 ">
                    <div class="single-item">
                      <div class="single-item__content">
                        {index < 1 && (
                          <div class="single-item__image">
                            <img
                              src={`/assets/images/campus/tp/${m.image}`}
                              alt={m.name}
                            />
                          </div>
                        )}
                        <div class="single-item__meta">
                          <h5 class="item-title">
                            <a href={`mailto:${m.email}`}>{m.name}</a>
                          </h5>
                          <p
                            class="item-description"
                            style="color: var(--rt-primary); font-weight: 600;"
                          >
                            {m.designation}
                          </p>
                          <p class="item-description">
                            <i class="fa-regular fa-envelope" /> {m.email}
                            <br />
                            <i class="fa-regular fa-phone" /> {m.phone}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                ),
            )
          }
        </div>
        <div class="row g-5 mt-2">
          {
            coreTeam.map(
              (m, index) =>
                index >= 1 && (
                  <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="single-item">
                      <div class="single-item__content">
                        <div class="single-item__meta">
                          <h5 class="item-title">
                            <a href={`mailto:${m.email}`}>{m.name}</a>
                          </h5>
                          <p
                            class="item-description"
                            style="color: var(--rt-primary); font-weight: 600;"
                          >
                            {m.designation}
                          </p>
                          <p class="item-description">
                            <i class="fa-regular fa-envelope" /> {m.email}
                            <br />
                            <i class="fa-regular fa-phone" /> {m.phone}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                ),
            )
          }
        </div>
      </div>
    </section>

    <!-- Department TPRs -->
    <div class="rts-multi-row-section pb--60">
      <div class="container">
        <div class="row">
          <div class="rts-section rt-center mb--45">
            <h3 class="rts-section-title">
              Department Training &amp; Placement Representatives
            </h3>
          </div>
        </div>
        <div class="row g-4">
          {
            tpcCord.map((d) => (
              <div class="col-lg-4 col-md-6 col-sm-12">
                <a
                  href={`/departments/${d.branch}/placements/`}
                  class="program-item"
                >
                  <span>
                    <div>
                      <h6>{d.branch}</h6>
                      <p>{d.name}</p>
                      <p> {d.email} </p>
                    </div>
                  </span>
                  <i class="fa-regular fa-chevron-right" />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Contact T&P Cell card + Cross-links -->
    <section class="rts-research-section pb--80">
      <div class="container">
        <div class="row">
          <div class="rts-research-section__content">
            <div class="rts-section">
              <h3 class="rts-section-title">Contact the T&amp;P Cell</h3>
              <p class="description">
                <i class="fa-regular fa-envelope"></i>
                <a href="mailto:dean.placements@srkrec.ac.in"
                  >dean.placements@srkrec.ac.in</a
                >
              </p>
              <p class="description">
                <i class="fa-regular fa-phone"></i> +91 970 419 5376 / +91 956 354
                4999
              </p>
              <p class="description">
                <i class="fa-regular fa-clock"></i> Office Hours: Monday–Saturday,
                9:00 AM – 5:00 PM
              </p>
              <p class="description">
                <i class="fa-regular fa-location-dot"></i> Training &amp; Placement
                Cell, Administrative Block, SRKR Engineering College, Bhimavaram –
                534204, Andhra Pradesh
              </p>
            </div>
          </div>

          <div class="research__text">
            <div class="research__text--single">
              <h3 class="rts-section-title">Quick Links</h3>
              <div class="program-list">
                <a href="/placements" class="program-item"
                  ><span
                    >About Placement Cell <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
                <a href="/placements-summary" class="program-item"
                  ><span
                    >Placement Statistics <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
                <a href="/training" class="program-item"
                  ><span
                    >Training Activities <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
                <a href="/internships" class="program-item"
                  ><span
                    >Internship Opportunities <i
                      class="fa-regular fa-chevron-right"></i></span
                  ></a
                >
                <a href="/career-guidance" class="program-item"
                  ><span
                    >Career Guidance <i class="fa-regular fa-chevron-right"
                    ></i></span
                  ></a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      /* TODO: replace placeholder photos in /assets/images/placements/PLACEHOLDER.jpg with real T&P team photos */
    }
    {
      /* TODO: replace placeholder TPR names and emails once dept-level T&P representatives confirmed */
    }

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
