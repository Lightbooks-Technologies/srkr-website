--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Research Centers and Resources</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- Scholarship content -->
    <div class="rts-scholarship pt--20">
        <div class="container">
            <div class="rts-scholarship-description pb--80">
                <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
                    <div class="col-lg-10 col-md-11">
                        <div class="program-description-area">
                            <!-- scholarship requirement -->
                            <!-- si = scholarship-information -->
                            <div class="si">
                                <h4 class="title">About the Club: LANGUAGE NEST
                                </h4>
                                <p>
                                    LANGUAGE NEST is a student-driven club at SRKR Engineering College, run by first-year students under faculty supervision. It promotes language, leadership, and creative skills through monthly events, including SRKR Toastmasters. Inaugurated on January 8, 2022, the club also aims to lay the foundation for SRKR TED Talks and offers a platform for diverse creative abilities.
                                </p>
                                <div class="si__list">
                                    <ul class="list-unstyled">
                                        <li class="si__list--single">
                                            Student-Driven Club: Language Nest is an independent, student-driven club promoting language and literary activities at SRKR Engineering College.
                                        </li>
                                        <li class="si__list--single">
                                            First-Year Leadership: The club is run by an elected student body consisting only of first-year students.
                                        </li>
                                        <li class="si__list--single">
                                            Advisory Committee: The activities are supervised by an advisory committee headed by the professor in charge of Training and Placement.
                                        </li>
                                        <li class="si__list--single">
                                            Monthly Events: The club organizes events every month and an annual event in January.
                                        </li>
                                        <li class="si__list--single">
                                            Open Participation: Events are open to students of all years, with recognition through certificates and/or prize money.
                                        </li>
                                        <li class="si__list--single">
                                            SRKR Toastmasters: The club includes SRKR Toastmasters, a part of the International Toastmasters organization.
                                        </li>
                                        <li class="si__list--single">
                                            Student-Centric: The club is entirely "of the students, by the students, for the students."
                                        </li>
                                        <li class="si__list--single">
                                            Objective 1: To promote language and leadership skills by encouraging creative expression.
                                        </li>
                                        <li class="si__list--single">
                                            Objective 2: To lay a strong foundation for SRKR TED Talks.
                                        </li>
                                        <li class="si__list--single">
                                            Objective 3: To serve as a platform for a variety of creative abilities.
                                        </li>
                                    </ul>
                                    
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- Testimonial Start -->
    <div class="rts-testimonial v_2 rt-relative pt--50 pb--20">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-section text-center mb--45">
                        <h2 class="rts-section-title">Language Nest Events Held in March 2022
                        </h2>
                        <p>
                            In March 2022, Language Nest hosted multiple engaging contests and cultural events. The Gadget Review contest was held on 21st March, with Mr. D. N. Varma and Mr. K. Hashwanth winning the first and second prizes. The same day, the Current Talk contest saw Mr. G. Durgesh take the first prize. Additionally, the Know Your Friend contest awarded M. Sree Sowmya and G. Deepthi the first prize. The month concluded with a Cultural Event in I-block, where students showcased their talents in singing and dancing, creating a lively atmosphere with enthusiastic participation from all branches.







</p>

                    </div>
                </div>
            </div>
            <!-- testimonial content -->
            <div class="row justify-content-center">
                <div class="col-lg-12 col-md-10">
                    <div class="rts-testimonial-box">
                        <div class="testimonial-item rt-flex">
                            
                            <div class="testimonial-item-content rt-relative" style="width: 100%;">
                                <div class="testmonial-v2">
                                    <div class="swiper-wrapper">
                                        <!-- single testimonial -->
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-27.jpg" alt="testimonial thumbnail">
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-28.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-29.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                        </div>
                                        <div class="swiper-slide d-flex align-items-center">
                                            <div class="testimonial-item-image save-from-hidden" style="max-width: 100%; object-fit: cover; width: 100%;">
                                                <img width="100%" src="/assets/images/testimonial/testimonial-big-30.jpg" alt="testimonial thumbnail" loading="lazy" decoding="async">
                                                
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                </div>
                           <div class="swiper-pagination"></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="rts-scholarship-description pb--50">
            <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
                <div class="col-lg-10 col-md-11">
                    <div class="program-description-area">
                        <!-- scholarship requirement -->
                        <!-- si = scholarship-information -->
                        <div class="si">
                            <h4 class="title">Language Nest’s Top Leadership
                            </h4>
                            
                            <div class="si__list">
                                <ul class="list-unstyled">
                                    <li class="si__list--single">
                                        Advisory Committee Chairperson: Prof. BH.V.N. Lakshmi
                                    </li>
                                    <li class="si__list--single">
                                        Chief Faculty Coordinator: Mr. M. Sankar
                                    </li>
                                    <li class="si__list--single">
                                        President - K. Karthik (CSBS) - 8639933872
                                    </li>
                                    <li class="si__list--single">
                                        Vice President - Ch. Sai Ram (ECE) - 8688833482
                                    </li>
                                    <li class="si__list--single">
                                        General Secretary - M. Sree Sowmya (AIML) - 9441773359
                                    </li>
                                    <li class="si__list--single">
                                        General Secretary - Y. N. S. Vara Prasad (ECE) - 7673922419
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary, Finance - D. Sree Sushmanjali (ECE) - 9010657789
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary Documentation - G. Hemanth (ECE) - 9138123000
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary, Data Management - S. Pawan Pundarikaksha
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary, Logistics - S. Divakar - 9390262818
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary, Planning - Gowri Shankar - 8096651626
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary, Public Relations - S. Murari - 7207905645
                                    </li>
                                    <li class="si__list--single">
                                        Joint Secretary, Publicity - K. M. S. S. Manaswini - 6303019499
                                    </li>
                                </ul>
                                
                                
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="rts-scholarship-description pb--50">
            <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
                <div class="col-lg-10 col-md-11">
                    <div class="program-description-area">
                        <!-- scholarship requirement -->
                        <!-- si = scholarship-information -->
                        <div class="si">
                            <h4 class="title">Proposed Events For Language Nest Club
                            </h4>
                            
                            <div class="si__list">
                                <ul class="list-unstyled">
                                    <li class="si__list--single">KYC - Know Your Campus - A Video Documentary/ Campus Tour in English</li>
                                    <li class="si__list--single">KYG - Know Your Guru/Guest - A Video recorded interview in English with your Teacher/ Guest</li>
                                    <li class="si__list--single">KYF – Know Your Senior/Friend</li>
                                    <li class="si__list--single">My Philosophy of Life</li>
                                    <li class="si__list--single">Inspiring Personalities of our Times (from business, politics, sports, arts, social service, etc.)</li>
                                    <li class="si__list--single">My Favourite Engineer of the 21st Century</li>
                                    <li class="si__list--single">Elocution – A talk on a prepared topic in English</li>
                                    <li class="si__list--single">Extempore – A spontaneous talk on a given topic</li>
                                    <li class="si__list--single">Current Talk – GDs on burning issues of regional, national, and global importance</li>
                                    <li class="si__list--single">Controversial Conversations – Debates on topics like ‘Is Climate Change Real?’</li>
                                    <li class="si__list--single">Reproducing the Historic Speeches of Accomplished Men and Women</li>
                                    <li class="si__list--single">Poetry Recitation - Great poetry in my voice</li>
                                    <li class="si__list--single">Story Narration</li>
                                    <li class="si__list--single">Movie Review/News Presentation</li>
                                    <li class="si__list--single">Gadget/Vehicle Review</li>
                                    <li class="si__list--single">Creative Writing – Writing inspired by random pictures/ experiences</li>
                                    <li class="si__list--single">Vocab Quiz – Quizzing the GRE/CAT/GMAT vocabulary</li>
                                    <li class="si__list--single">Vlogging – Vlogs on unique places in your village/town</li>
                                    <li class="si__list--single">Sports Commentary – Giving voiceover to a muted sports video</li>
                                    <li class="si__list--single">Wildlife Commentary – Giving voiceover to a muted video on wildlife</li>
                                </ul>
                                
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="rts-scholarship-description pb--50">
            <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
                <div class="col-lg-10 col-md-11">
                    <div class="program-description-area">
                        <!-- scholarship requirement -->
                        <!-- si = scholarship-information -->
                        <div class="si">
                            <h4 class="title">Cultural Events
                            </h4>
                            
                            <div class="si__list">
                                <ul class="list-unstyled">
                                    <li class="si__list--single">Music – Vocal (classical, western, folk), Instruments (classical, western, folk)</li>
                                    <li class="si__list--single">Dance – Classical, Western, Folk</li>
                                    <li class="si__list--single">Mimicry</li>
                                    <li class="si__list--single">Photography</li>
                                    <li class="si__list--single">Live Painting</li>
                                    <li class="si__list--single">Short Films – Telugu/English</li>
                                    <li class="si__list--single">Stand-up Comedy</li>
                                    <li class="si__list--single">Re-enacting Movie Scenes with Dialogues</li>
                                    <li class="si__list--single">Monologues</li>
                                    <li class="si__list--single">Beauty Contest/ Ramp Walk in Traditional Outfit</li>
                                    <li class="si__list--single">Flash Mob</li>
                                    <li class="si__list--single">Treasure Hunt</li>
                                    <li class="si__list--single">Craft Making</li>
                                    <li class="si__list--single">Movie Screening</li>
                                    <li class="si__list--single">Mime</li>
                                </ul>
                                
                                
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
        </div>
    </div>
    <!-- program content end -->

    <!-- footer -->
    <SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>
