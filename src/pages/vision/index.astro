--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			p, .si__list--single {
				text-align: justify !important;
			}
		</style>
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Vision & Mission</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- mission -->
    <section class="rts-mission pt--30 pb--30">
        <div class="container">
            <div class="row justify-content-center rt-center">
                <div class="rts-section mb--50">
                    <h2 class="rts-section-title">Vision & Mission</h2>
                </div>
            </div>
            <!-- mission -->
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <section class="mb--40">
                        <div class="row g-4 align-items-start">
                            <div class="col-lg-7 rts-scholarship-description">
                                <h3 class="timeline-title mb--15">Vision</h3>
                                <p>
                                    To be a world-class technical institute contributing to socio-ecological well-being through quality education and innovation.
                                </p>

                                <h3 class="timeline-title mt--30 mb--15">Mission</h3>
                                <div class="si__list">
                                    <ul class="list-unstyled one-column-list">
                                    <li class="si__list--single">To upgrade teaching-learning environment with state-of-the-art infrastructure to accelerate employability and entrepreneurship.</li>
                                    <li class="si__list--single">To promote inter-disciplinary research and innovation through institute-industry partnership.</li>
                                    <li class="si__list--single">To nurture ethical and ecological consciousness to sustain the holistic social well-being.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <img src="/assets/images/about/mission-1.jpg" alt="Vision" style="height: 100%; min-height: 300px; object-fit: cover; width: 100%;" loading="lazy" decoding="async">
                            </div>
                        </div>
                    </section>

                    <section class="mb--40 rts-scholarship-description">
                        <h5 class="timeline-title mb--15">Quality Policy</h5>
                        <p>The college is committed to achieving excellence in Teaching, Research and Consultancy:</p>
                        <div class="si__list mb--30">
                            <ul class="list-unstyled one-column-list">
                                <li class="si__list--single">By deploying global best practices in education to create world-class professionals</li>
                                <li class="si__list--single">By establishing harmonious relationships with industry and society</li>
                                <li class="si__list--single">By developing state-of-the-art infrastructure and sustaining the quality of education through well-endowed faculty</li>
                                <li class="si__list--single">By imparting knowledge through advanced learning and teaching methods</li>
                            </ul>
                        </div>
                        <img src="/assets/images/about/mission-3.jpg" alt="Quality Policy" loading="lazy" decoding="async" style="height: 300px; object-fit: cover; width: 100%;">
                    </section>

                    <section class="mb--40 rts-scholarship-description">
                        <h5 class="timeline-title mb--15">Key Pillars</h5>
                        <div class="si__list">
                            <ul class="list-unstyled one-column-list">
                                <li class="si__list--single">Regional Ecosystem</li>
                                <li class="si__list--single">Academic Excellence</li>
                                <li class="si__list--single">Research Excellence</li>
                                <li class="si__list--single">Industry Relevance</li>
                                <li class="si__list--single">Social Responsibility</li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </section>
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>

<FooterScripts />
</body>
</html>