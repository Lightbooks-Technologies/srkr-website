--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<style>
    .single-item__image {
        height: 320px;
        overflow: hidden;
        background: #f5f5f5;
    }

    .single-item__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
        background: #f5f5f5;
    }

    @media (max-width: 767px) {
        .single-item {
            background: transparent;
            border: 0;
            box-shadow: none;
        }

        .single-item__content,
        .single-item__meta,
        .single-item__image {
            background: transparent;
            border: 0;
        }

        .single-item__image {
            height: 240px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .single-item__image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center center;
            background: transparent;
            border-radius: 12px;
            padding: 0 12px;
        }

        .single-item__meta {
            text-align: center;
        }

        .single-item__meta .item-title,
        .single-item__meta .item-description {
            text-align: center;
        }
    }
</style>

<!doctype html>
