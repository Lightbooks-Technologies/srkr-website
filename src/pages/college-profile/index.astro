--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
        <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
     <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Profile</li>
                        </ul>
                        <h1 class="section-title">Campus</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->
        <!-- campus life -->
        <div class="rts-campus-life rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="campus-life">
                        <div class="campus-life__content">
                            <h1 class="section-title">College Profile</h1>
                            <p class="description w-680">
                                Empowering rural India through decades of innovation and academic excellence.
                            </p>
                            <div class="campus-video">
                                <img src="/assets/images/campus/video-bg.jpg" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- campus life end -->
    
        <!-- funfact -->
    
        <div class="rts-funfact v_2 stroke">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10 ">
                        <div class="rts-funfact-wrapper">
                            <div class="single-cta-item">
                                <h2 class="single-cta-item__title">44</h2>
                                <p>Years of Excellence</p>
                            </div>
                            <div class="single-cta-item">
                                <h2 class="single-cta-item__title">30 Acres</h2>
                                <p>Green Campus</p>
                            </div>
                            <div class="single-cta-item">
                                <h2 class="single-cta-item__title">14</h2>
                                <p>Centres of Excellence</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- funfact end-->
    
        <!-- section one -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Academic Distinction
                        </h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/01.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Autonomous Institution</a></h5>
                                    <p class="item-description">UGC-approved autonomous status since 2016 ensures academic freedom and innovation in curriculum.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/02.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Program Diversity</a></h5>
                                    <p class="item-description">12 B.Tech, 6 M.Tech, 10 Ph.D. programs and a BBA course catering to varied academic aspirations.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/03.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Global Recognition
                                    </a></h5>
                                    <p class="item-description">Accredited by NAAC with A+ (CGPA 3.42), NBA-certified programs, and JNTUK affiliation.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
        <!-- section two -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding v_2">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Innovation & Research Ecosystem
                        </h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/04.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Recognized Research Centres</a></h5>
                                    <p class="item-description">JNTUK-recognized departments promote active PhD research in engineering and sciences.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/05.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Scientific Institution Status
                                    </a></h5>
                                    <p class="item-description">Designated as SIRO by the Ministry of Science & Tech for R&D excellence and outreach.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/06.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Advanced Labs & Infrastructure</a></h5>
                                    <p class="item-description">Equipped with AICTE IDEA Lab, DST-FIST funding, and MSME-backed incubation space.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
    
        <!-- section three -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Global Exposure & Employability</h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/07.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">International Collaborations</a></h5>
                                    <p class="item-description">MoUs with German varsities support internships and global Master’s programs.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/08.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Certified Test Centres</a></h5>
                                    <p class="item-description">GRE, IELTS, and TOEFL test centres on campus strengthen overseas opportunities.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/09.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Skill Development Platforms</a></h5>
                                    <p class="item-description">Powered by Infosys, Google, Oracle, and ICT Academy for industry-ready learning.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
    
    
        <!-- footer -->
        <SrkrFooter/>

        <!-- footer copyright end -->
    
        <!-- offcanvase menu -->
        <!-- header style two -->
        <div id="side-bar" class="side-bar">
            <button class="close-icon-menu"><i class="far fa-times"></i></button>
            <!-- inner menu area desktop start -->
            <div class="inner-main-wrapper-desk">
                <div class="thumbnail">
                    <img src="/assets/images/logo/srkr-logo.png" alt="SRKR Engineering College" loading="lazy" decoding="async">
                </div>
                <div class="inner-content">
                    <p class="disc">
                        Apply to SRKR – Start your journey with excellence.
                    </p>
                    <!-- offcanvase banner -->
                    <div class="offcanvase__banner mt--50">
                        <div class="offcanvase__banner--content">
                            <img src="/assets/images/offcanvase.jpg" alt="offcanvase" loading="lazy" decoding="async">
                            <a href="/admission-brochure/" class="rts-theme-btn">Apply Now</a>
                        </div>
                    </div>
                    <div class="offcanvase__info">
                        <div class="offcanvase__info--content">
                            <a href="tel:+919848823332"><span><i class="fa-sharp fa-light fa-phone"></i></span>+91 9848823332</a>
                            <a href="#"><span><i class="fa-sharp fa-light fa-location-dot"></i></span>SRKR Marg, China Amiram,
Bhimavaram, A.P, India - 534204</a>
                            <div class="offcanvase__info--content--social">
                                <p class="title">Follow Us:</p>
                                <div class="social__links">
                                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                                    <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- mobile menu area start -->
            <div class="mobile-menu-main">
                <nav class="nav-main mainmenu-nav mt--30">
                    <ul class="mainmenu metismenu" id="mobile-menu-active">
    
                        <li class="has-droupdown">
                            <a href="#" class="main">Homepages</a>
                            <ul class="submenu mm-collapse">
                                <li><a class="mobile-menu-link" href="/">Home Style One</a></li>
                                <li><a class="mobile-menu-link" href="/">Home Style Two</a></li>
                                <li><a class="mobile-menu-link" href="/">Home Style Three</a></li>
                                <li><a class="mobile-menu-link" href="/">Home Style Four</a></li>
                                <li><a class="mobile-menu-link" href="/">Home Style Five</a></li>
                            </ul>
                        </li>
                        <li class="has-droupdown">
                            <a href="#" class="main">Pages</a>
                            <ul class="submenu mm-collapse">
                                <li><a class="mobile-menu-link" href="/college-profile/">About Us</a></li>
                                <li><a class="mobile-menu-link" href="/sports/">Athletics</a></li>
                                <li class="has-dropdown third-lvl">
                                    <a href="javascript:void(0);">Faculty</a>
                                    <ul class="submenu third-lvl base">
                                        <li><a class="mobile-menu-link" href="/departments/">Faculty</a></li>
                                        <li><a class="mobile-menu-link" href="/departments/">Faculty Details</a></li>
                                        <li><a class="mobile-menu-link" href="/departments/">Faculty</a></li>
                                        <li><a class="mobile-menu-link" href="/departments/">Faculty Staff details</a></li>
                                    </ul>
                                </li>
                                <li><a class="mobile-menu-link" href="/research-overview/">Research</a></li>
                            </ul>
                        </li>
                        <li class="has-droupdown">
                            <a href="#" class="main">Academics</a>
                            <ul class="submenu mm-collapse">
                                <li><a class="mobile-menu-link" href="/programmes/">Academic</a></li>
                                <li><a class="mobile-menu-link" href="/admission-brochure/">Admission</a></li>
                                <li><a class="mobile-menu-link" href="/programmes/">Academic Area</a></li>
                                <li><a class="mobile-menu-link" href="/activities/">Campus Life</a></li>
                                <li><a class="mobile-menu-link" href="/fee/">Scholarship</a></li>
                                <li><a class="mobile-menu-link" href="/fee/">Tution Fee</a></li>
                                <li><a class="mobile-menu-link" href="/prominent-alumni/">Alumni</a></li>
                                <li><a class="mobile-menu-link" href="/programmes/">Program Single</a></li>
                                <li><a class="mobile-menu-link" href="/departments/">Department Details</a></li>
                            </ul>
                        </li>
    
                        <li class="has-droupdown">
                            <a href="#" class="main">Events</a>
                            <ul class="submenu mm-collapse">
                                <li><a class="mobile-menu-link" href="/activities/">Event</a></li>
                                <li><a class="mobile-menu-link" href="/activities/">Event Details</a></li>
                            </ul>
                        </li>
                        <li class="has-droupdown">
                            <a href="#" class="main">Blog</a>
                            <ul class="submenu mm-collapse">
                                <li><a class="mobile-menu-link" href="/">Blog</a></li>
                                <li><a class="mobile-menu-link" href="/">Blog Grid</a></li>
                                <li><a class="mobile-menu-link" href="/">Blog List</a></li>
                                <li><a class="mobile-menu-link" href="/">Blog Details</a></li>
                            </ul>
                        </li>
                        <li>
                            <a href="/quick-links/" class="main">Contact Us</a>
                        </li>
                    </ul>
                </nav>
    
                <div class="offcanvase__info--content mt--30">
                    <a href="tel:+919848823332"><span><i class="fa-sharp fa-light fa-phone"></i></span>+91 9848823332</a>
                    <a href="#"><span><i class="fa-sharp fa-light fa-location-dot"></i></span>SRKR Marg, China Amiram,
Bhimavaram, A.P, India - 534204</a>
                    <div class="offcanvase__info--content--social">
                        <p class="title">Follow Us:</p>
                        <div class="social__links">
                            <a href="#"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#"><i class="fa-brands fa-instagram"></i></a>
                            <a href="#"><i class="fa-brands fa-linkedin"></i></a>
                            <a href="#"><i class="fa-brands fa-youtube"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- mobile menu area end -->
        </div>
        <!-- header style two End -->
    
        <div class="search-input-area">
            <div class="container">
                <div class="search-input-inner">
                    <div class="input-div">
                        <input class="search-input autocomplete ui-autocomplete-input" type="text" placeholder="Search by keyword or #" autocomplete="off">
                        <button><i class="far fa-search"></i></button>
                    </div>
                </div>
            </div>
            <div id="close" class="search-close-icon"><i class="far fa-times"></i></div>
        </div>
        <!-- rts backto top start -->
        <div class="progress-wrap">
            <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
                <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" style="transition: stroke-dashoffset 10ms linear 0s; stroke-dasharray: 307.919, 307.919; stroke-dashoffset: 307.919;"></path>
            </svg>
        </div>
        <!-- rts back to top end -->
        <div id="anywhere-home" class="">
        </div>
    
    
        <!-- scripts -->
        <FooterScripts />
    
    </body>
    </html>