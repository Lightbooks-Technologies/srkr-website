    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .placement-wall {
        background: #f8f9fc;
        overflow: hidden;
        position: relative;
      }
      .placement-wall::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
          circle at 2px 2px,
          #d8deee 1.1px,
          transparent 1.1px
        );
        background-size: 26px 26px;
        opacity: 0.45;
        pointer-events: none;
      }
      .placement-wall .container {
        position: relative;
        z-index: 1;
      }
      .placement-wall__eyebrow {
        margin: 10px;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 22px;
        font-weight: 700;
        color: #5e71b3;
      }
      .placement-wall__title {
        text-align: center;
        margin: 8px 0 26px;
        color: #203a86;
        font-size: clamp(1.5rem, 2.6vw, 2.25rem);
      }
      .placement-wall__ticker {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
        mask-image: linear-gradient(
          to right,
          transparent 0,
          #000 8%,
          #000 92%,
          transparent 100%
        );
        -webkit-mask-image: linear-gradient(
          to right,
          transparent 0,
          #000 8%,
          #000 92%,
          transparent 100%
        );
      }
      .placement-wall__ticker::-webkit-scrollbar {
        display: none;
      }
      .placement-wall__track {
        display: flex;
        width: max-content;
        gap: 18px;
        padding-bottom: 6px;
      }
      .placement-wall-card {
        background: #ffffff;
        border: 1px solid #e3e7f3;
        border-radius: 16px;
        min-width: min(88vw, 320px);
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        box-shadow: 0 8px 20px rgba(20, 44, 112, 0.08);
      }
      .placement-wall-card__photo {
        width: 300px;
        height: 200px;
        object-fit: cover;
        flex-shrink: 0;
      }
      .placement-wall-card__meta {
        min-width: 0;
      }
      .placement-wall-card__logo {
        height: 24px;
        width: auto;
        max-width: 110px;
        display: block;
      }
      .placement-wall-card__package {
        margin: 8px 0 4px;
        color: #1f3f96;
        font-size: clamp(1.35rem, 2.3vw, 2rem);
        font-weight: 800;
        line-height: 1;
      }
      .placement-wall-card__name {
        margin: 0;
        color: #1f2a44;
        font-weight: 700;
        font-size: 1.05rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .about__right--content--description,
      .item-description {
        text-align: justify !important;
      }
      .rt-center {
        text-align: center !important;
      }
      .rt-center .rts-section-title {
        margin-left: auto !important;
        margin-right: auto !important;
      }
    

    </style>
  </head>

