--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
        <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
     <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Profile</li>
                        </ul>
                        <h1 class="section-title">Campus</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->
        <!-- campus life -->
        <div class="rts-campus-life rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="campus-life">
                        <div class="campus-life__content">
                            <h1 class="section-title">College Profile</h1>
<!-- class="description w-680"  -->
                            <p style="text-align: justify;">
Sagi Rama Krishnam Raju Engineering College (SRKR Engineering College), established in 1980, is one of the pioneering self-financing engineering institutions in Andhra Pradesh. Founded with the vision of empowering rural students through quality technical education, the institution has evolved into a center of academic excellence and innovation. Spread across a lush 30-acre green campus, SRKR provides state-of-the-art infrastructure, advanced laboratories, and a vibrant learning environment that nurtures creativity, research, and professional growth. Guided by the visionary leadership of Sri S. Prasad Raju, the institution continues the legacy of Late Sri Sagi Rama Krishnam Raju in shaping responsible engineers and leaders. With a strong emphasis on innovation, critical thinking, and societal impact, SRKR has consistently contributed to producing skilled engineers, entrepreneurs, researchers, and academicians. Over four decades, the institution has built a remarkable reputation through academic achievements, industry collaborations, research contributions, and distinguished alumni serving across the globe.                            </p>
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- campus life end -->
    
        <!-- funfact -->
    
        <div class="rts-funfact v_2 stroke">
            <div class="container">
                <img src="/assets/images/campus/timeline.png" alt="funfact-bg" class="funfact-bg" loading="lazy" decoding="async">
                
            </div>
        </div>
    
        <!-- funfact end-->
    
        <!-- section one -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Academic Distinction
                        </h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/01.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Autonomous Institution</a></h5>
                                    <p class="item-description">UGC-approved autonomous status since 2016 ensures academic freedom and innovation in curriculum.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/02.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Quality Certified Education </a></h5>
                                    <p class="item-description">CSE, IT, ECE, EEE, Civil, and Mechanical Engineering programs are accredited by NBA, reflecting excellence in academic quality and outcome-based education.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/03.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Global Recognition
                                    </a></h5>
                                    <p class="item-description">Accredited by NAAC with A+ (CGPA 3.42), NBA-certified programs, and JNTUK affiliation.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
        <!-- section two -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding v_2">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Innovation & Research Ecosystem
                        </h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/04.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Recognized Research Centres</a></h5>
                                    <p class="item-description">JNTUK-recognized departments promote active PhD research in engineering and sciences.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/05.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Scientific Institution Status
                                    </a></h5>
                                    <p class="item-description">Designated as SIRO by the Ministry of Science & Tech for R&D excellence and outreach.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/06.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Advanced Labs & Infrastructure</a></h5>
                                    <p class="item-description">Equipped with AICTE IDEA Lab, DST-FIST funding, and MSME-backed incubation space.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
    
        <!-- section three -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Global Exposure & Employability</h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/07.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">International Collaborations</a></h5>
                                    <p class="item-description">MoUs with German varsities support internships and global Master’s programs.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/08.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Certified Test Centres</a></h5>
                                    <p class="item-description">GRE, IELTS, and TOEFL test centres on campus strengthen overseas opportunities.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/09.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Skill Development Platforms</a></h5>
                                    <p class="item-description">Powered by Infosys, Google, Oracle, and ICT Academy for industry-ready learning.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
    
    
        <!-- footer -->
        <SrkrFooter/>

        <!-- footer copyright end -->
    
        <OffCanvas/>
    
    
        <!-- scripts -->
        <FooterScripts />
    
    </body>
    </html>