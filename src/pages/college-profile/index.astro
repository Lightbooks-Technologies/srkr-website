    <script is:inline>
      (() => {
        const ticker = document.querySelector('.placement-wall__ticker');
        const track = document.querySelector('.placement-wall__track');
        if (!ticker || !track) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        let paused = false;
        let lastTime = 0;

        const getMaxScroll = () => Math.max(0, track.scrollWidth - ticker.clientWidth);

        const step = (time) => {
          if (!lastTime) lastTime = time;
          const delta = time - lastTime;
          lastTime = time;

          if (!paused) {
            ticker.scrollLeft += delta * 0.06;
            const maxScroll = getMaxScroll();
            if (maxScroll > 0 && ticker.scrollLeft >= maxScroll) {
              ticker.scrollLeft = 0;
            }
          }

          window.requestAnimationFrame(step);
        };

        ticker.addEventListener('mouseenter', () => {
          paused = true;
        });

        ticker.addEventListener('mouseleave', () => {
          paused = false;
          lastTime = 0;
        });

        window.requestAnimationFrame(step);
      })();
    </script>



