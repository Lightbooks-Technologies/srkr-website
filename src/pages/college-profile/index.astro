--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
        <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
     <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Campus</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->

            <!-- about us -->
        <section class="about v__2 pt--80 pb--40">
            <div class="container">
                <div class="row justify-content-md-center g-5">
                    <div class="col-lg-3 col-md-3">
                        <div class="about__left--content">
                            <div class="about__left--content--left mt-0">
                                <img src="/assets/images/home/f1.jpg" alt="" style="min-width: 250px;">
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-9">
                        <div class="about__right--content">
                          
                            <h2 class="about__right--content--title">About SRKR Engineering College</h2>
                            <p class="about__right--content--description">Founded in 1980, SRKR Engineering College stands as one of Andhra Pradesh's premier self-financing engineering institutions. With NAAC A++ accreditation, NBA recognition across six programmes, and SIRO status from DSIR, we embody excellence in technical education.</p>
                            <p class="about__right--content--description">Spread across 30 acres in Bhimavaram, our campus blends world-class infrastructure with a rich legacy of nurturing industry-ready engineers. We are committed to fostering innovation, empowering students to achieve their fullest potential, and contributing meaningfully to society through quality education and research.</p>
                            <div class="about__right--content--vision d-none">
                                <div class="mision">
                                    <div class="mision__icon">
                                        <img src="/assets/images/icon/mission.svg" alt="" loading="lazy" decoding="async">
                                    </div>
                                    <div class="mision__title">
                                        Our Mission
                                        Statement
                                    </div>
                                </div>
                                <div class="vision">
                                    <div class="vision__icon">
                                        <img src="/assets/images/icon/vission.svg" alt="" loading="lazy" decoding="async">
                                    </div>
                                    <div class="vision__title">
                                        Our Vision &
                                        Values
                                    </div>
                                </div>
                            </div> 
                            <!-- <a href="/programmes/" class="rts-theme-btn btn-arrow">Explore Programs -->
                                <!-- <span><i class="fa-regular fa-arrow-right"></i></span> -->
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- about us end -->
        <!-- campus life -->
   
        <!-- campus life end -->
    
        <!-- funfact -->
    
        <div class="rts-funfact v_2 stroke">
            <div class="container">
                <img src="/assets/images/campus/timeline.png" alt="funfact-bg" class="funfact-bg" loading="lazy" decoding="async">
                
            </div>
        </div>
    
        <!-- funfact end-->
    
        <!-- section one -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Academic Distinction
                        </h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/01.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Autonomous Institution</a></h5>
                                    <p class="item-description">UGC-approved autonomous status since 2016 ensures academic freedom and innovation in curriculum.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/02.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Quality Certified Education </a></h5>
                                    <p class="item-description">CSE, IT, ECE, EEE, Civil, and Mechanical Engineering programs are accredited by NBA, reflecting excellence in academic quality and outcome-based education.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/03.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Global Recognition
                                    </a></h5>
                                    <p class="item-description">Accredited by NAAC with A+ (CGPA 3.42), NBA-certified programs, and JNTUK affiliation.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
        <!-- section two -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding v_2">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Innovation & Research Ecosystem
                        </h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/04.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Recognized Research Centres</a></h5>
                                    <p class="item-description">JNTUK-recognized departments promote active PhD research in engineering and sciences.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/05.jpeg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Scientific Institution Status
                                    </a></h5>
                                    <p class="item-description">Designated as SIRO by the Ministry of Science & Tech for R&D excellence and outreach.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/06.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Advanced Labs & Infrastructure</a></h5>
                                    <p class="item-description">Equipped with AICTE IDEA Lab, DST-FIST funding, and MSME-backed incubation space.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
    
        <!-- section three -->
        <!-- single section -->
        <div class="rts-campus-section rts-section-padding">
            <div class="container">
                <div class="row">
                    <div class="rts-section rt-center mb--45">
                        <h3 class="rts-section-title">Collaborations & Sustainability</h3>
                    </div>
                </div>
                <div class="row g-5">
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/07.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Collaborations</a></h5>
                                    <p class="item-description">Fostering strategic partnerships with academia, research organizations, and industry to drive innovation, knowledge exchange, and societal impact.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/08.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Unnat Bharat Abhiyan (UBA)</a></h5>
                                    <p class="item-description">Transforming rural communities through sustainable development, innovation, and community engagement in nearby villages.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                    <!-- single item -->
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="single-item">
                            <div class="single-item__content">
                                <div class="single-item__image">
                                    <img src="/assets/images/campus/09.jpg" alt="item-image" loading="lazy" decoding="async">
                                </div>
                                <div class="single-item__meta">
                                    <h5 class="item-title"><a href="#">Societal Impact</a></h5>
                                    <p class="item-description">Transforming lives by addressing community needs through technology-driven and socially responsible interventions.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- single item end -->
                </div>
            </div>
        </div>
        <!-- single section end -->
    
    
    
        <!-- footer -->
        <SrkrFooter/>

        <!-- footer copyright end -->
    
        <OffCanvas/>
    
    
        <!-- scripts -->
        <FooterScripts />
    
    </body>
    </html>