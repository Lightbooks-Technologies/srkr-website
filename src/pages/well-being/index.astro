---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Student wellness, counselling, mental &amp; physical health support at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="#">Life @ SRKR</a></li>
              </ul>
              <h1 class="section-title">Student Well-Being</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HERO INTRO -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 text-center">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">A Caring Campus</h3>
              <p class="rts-section-description">Enjoy your Student Life & Excel at SRKR.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PILLARS -->
    <div class="rts-multi-row-section pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Six Pillars of Student Well-Being</h3>
        </div>
        <div class="row g-4">
          {pillars.map((p) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm single-cta-item">
                <div class="card-body">
                  <h2 class="single-cta-item__title"><i class={`fa-light ${p.icon}`}></i></h2>
                  <h5 class="mt-3 mb-2">{p.name}</h5>
                  <p class="mb-0 small text-muted" set:html={p.desc}></p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- COUNSELORS -->
    <div class="rts-multi-row-content py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Counselling Team</h3>
        </div>
        <div class="row g-4">
          {counselors.map((c) => (
            <div class="col-lg-3 col-md-6">
              <div class="card h-100 shadow-sm single-cat-item">
                {/* TODO: replace placeholder photo */}
                <div class="cat-thumb">
                  <img src="/assets/images/well-being/PLACEHOLDER.jpg" alt={c.name} />
                </div>
                <div class="card-body text-center">
                  <h5 class="card-title mb-1" set:html={c.name}></h5>
                  <p class="mb-2 small" set:html={c.role}></p>
                  <p class="mb-0 small text-muted">{c.specialty}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- SERVICES ACCORDION -->
    <div class="py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Services Offered</h3>
        </div>
        <div class="program-credit-area faq rts-scholarship-description">
          <div class="program-accordion">
            <div class="accordion" id="wb-accordion">
              <div class="accordion-item">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#wb1" aria-expanded="true">
                  Confidential 1-on-1 Counselling
                </button>
                <div id="wb1" class="accordion-collapse collapse show" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>Drop-in or scheduled sessions with our counsellors. All conversations are strictly confidential. Walk-ins welcome at the Student Welfare Office.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wb2" aria-expanded="false">
                  Faculty Mentorship Program
                </button>
                <div id="wb2" class="accordion-collapse collapse" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>Every student is assigned a faculty mentor who monitors academic progress and provides personal guidance throughout the semester.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wb3" aria-expanded="false">
                  Peer Support Network
                </button>
                <div id="wb3" class="accordion-collapse collapse" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>Senior-junior buddy system &amp; trained peer-listener volunteers across hostels and day-scholar wings.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wb4" aria-expanded="false">
                  Workshops &amp; Sensitisation Sessions
                </button>
                <div id="wb4" class="accordion-collapse collapse" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>Periodic workshops on stress management, exam anxiety, mindfulness, gender sensitisation and digital wellness.</p>
                  </div>
                </div>
              </div>

             
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wb5" aria-expanded="false">
                  Anti-Ragging &amp; Anti-Drug Cell
                </button>
                <div id="wb5" class="accordion-collapse collapse" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>UGC-mandated anti-ragging committee with a 24x7 hotline. Women's Cell handles all sexual-harassment complaints confidentially. See <a href="/code-of-conduct">Code of Conduct</a> for procedures.</p>
                    {
                      antiRaggingCommittee.length > 0 && (
                        <>
                          <h6 class="mt-3">Anti-Ragging Committee Members:</h6>
                          <table class="table table-sm table-striped">
                            <thead>
                              <tr>
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Role</th>
                                <th>Contact</th>
                              </tr>
                            </thead>
                            <tbody>
                              {antiRaggingCommittee.map((m) => (
                                <tr>
                                  <td><strong>{m.name}</strong></td>
                                  <td>{m.designation}</td>
                                  <td>{m.role}</td>
                                  <td>{m.contact ? <a href={`tel:${m.contact}`}>{m.contact}</a> : 'Contact not available'}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </>
                      )
                    }
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wb6" aria-expanded="false">
                   Internal Complaints Committee
                </button>
                <div id="wb6" class="accordion-collapse collapse" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>The Internal Complaints Committee (ICC) of SRKREC is constituted under the provisions of the Sexual Harassment of Women at Workplace (Prevention, Prohibition and Redressal) Act, 2013 (PoSH Act).
The Committee is responsible for ensuring a safe, secure, and respectful environment for all stakeholders of the Institute, including students, faculty, and staff.
Staff and students may approach the ICC, Student Counsellor, or alternatively bring concerns to the Principal, HoD, any Faculty member, or respective Mentor â€” all in complete confidence.</p>
                  </div>
                </div>
              </div>

               <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wb7" aria-expanded="false">
                  Minority Cell
                </button>
                <div id="wb7" class="accordion-collapse collapse" data-bs-parent="#wb-accordion">
                  <div class="accordion-body">
                    <p>The Minority Cell of SRKREC has been constituted with the purpose of empowering the minority communities in the institute. The cell is committed to providing an environment that ensures equal opportunities and respect for all sections of minorities, and to ensuring protection to everyone as per the provisions of the Constitution of India in such matters.</p>
                      {
                        minorityCell.length > 0 && (
                          <>
                            <h6 class="mt-3">Minority Cell Members:</h6>
                            <table class="table table-sm table-striped">
                              <thead>
                                <tr>
                                  <th>Name</th>
                                  <th>Designation</th>
                                  <th>Role</th>
                                </tr>
                              </thead>
                              <tbody>
                                {minorityCell.map((m) => (
                                  <tr>
                                    <td><strong>{m.name}</strong></td>
                                    <td>{m.designation}</td>
                                    <td>{m.role}</td>
                                    <td>{m.contact ? <a href={`tel:${m.contact}`}>{m.contact}</a> : 'Contact not available'}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </>
                        )
                      }
                  </div>
                </div>
              </div>



             </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RESOURCES -->


    <!-- EXTERNAL LINKS -->
    <!-- <div class="rts-mission py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">External Helplines &amp; Trusted Resources</h3>
        </div>
        <div class="program-list">
          <ul class="list-unstyled one-column-list">
            {externalLinks.map((l) => (
              <li class="si__list--single mb-2">
                <a href={l.url} target="_blank" rel="noopener">{l.name} <i class="fa-regular fa-arrow-up-right-from-square"></i></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div> -->

    <!-- EMERGENCY CONTACT -->
    <div class="py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="card shadow-sm border-danger">
              <div class="card-body text-center">
                <h4 class="mb-3 text-danger"><i class="fa-light fa-triangle-exclamation"></i> Contacts</h4>
                <p class="mb-2"><strong>Anti-Ragging Helpline:</strong> <a href="tel:1800-180-5522">9490501171</a> Â· <a href="https://antiragging.in" target="_blank" rel="noopener">antiragging.in</a></p>
                <p class="mb-2"><strong>Your voice matters. Every grievance is heard.</strong><br><a href="mailto:grievanceredressal@srkrec.ac.in">grievanceredressal@srkrec.ac.in</a></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
