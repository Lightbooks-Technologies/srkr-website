                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="assets/images/icon/04.svg" alt="">
                                        </div>
                                        <a href="program-single.html">450+ Computers & 200 Internships</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="assets/images/icon/05.svg" alt="">
                                        </div>
                                        <a href="program-single.html"> 1Cr+ External Funding</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="assets/images/icon/06.svg" alt="">
                                        </div>
                                        <a href="program-single.html">2000+ In-House Tech Training
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Organogram -->
    <div class="rts-campus-life">
        <div class="container mt--10 mb--30">
            <div class="row">
                <div class="col-sm-12">
                    <div class="about__image">
                        <img src="assets/images/about/about__5.jpg" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
    
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <!-- offcanvase menu -->
    <!-- header style two -->
