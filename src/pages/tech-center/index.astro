--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Technology Centre</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->
    <section class="rts-program v_2 rts-section-padding">
        <div class="container">
            <div class="row rt-center">
                <div class="col-sm-12">
                    <div class="rts__section--wrapper v__5">
                        <h2 class="rts__section--title">Technology Centre Profile</h2>
                    </div>
                </div>
            </div>
            <!-- program content -->
            <div class="row justify-content-center g-0">
                <div class="col-lg-4 col-md-10">
                    <div class="rts-program-single">
                        <div class="rts-program-single__content">
                            <div class="rts-program-hover">
                                <div class="icon">
                                    <img src="/assets/images/program/icon/03.svg" alt="education">
                                </div>
                                <p>The Technology Centre was established in 2015 to promote technology training, innovation, and entrepreneurship through workshops and skill-building programs for all SRKR students.

                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-10">
                    <div class="rts-program-single ">
                        <div class="rts-program-single__content">
                            <div class="rts-program-hover center-item rt-primary-bg">
                                <ul class="list-unstyled">
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/04.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">NPTEL 5K+ Certified</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/05.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">Minors Programs</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/06.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">Bachelorâ€™s & Masterâ€™s</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-10">
                    <div class="rts-program-single">
                        <div class="rts-program-single__content">
                            <div class="rts-program-hover">
                                <div class="icon">
                                    <img src="/assets/images/program/icon/01.svg" alt="education" loading="lazy" decoding="async">
                                </div>
                                <p>It focuses on developing practical skills in the latest technologies and encourages student-driven projects across all engineering disciplines, supported by a well-equipped computer lab and expert guidance.

                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-10 pt--50">
                    <div class="rts-program-single ">
                        <div class="rts-program-single__content">
                            <div class="rts-program-hover center-item rt-primary-bg">
                                <ul class="list-unstyled">
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/04.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">1800+ IIT-B Spoken Tutorial Certified
                                            </a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/05.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">60+ Workshops organized</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/06.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">10 MOUS Collabrations</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-10 pt--50">
                    <div class="rts-program-single ">
                        <div class="rts-program-single__content">
                            <div class="rts-program-hover center-item rt-primary-bg">
                                <ul class="list-unstyled">
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/04.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">450+ Computers & 200 Internships</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/05.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/"> 1Cr+ External Funding</a>
                                    </li>
                                    <li class="single-program">
                                        <div class="icon-box">
                                            <img src="/assets/images/icon/06.svg" alt="" loading="lazy" decoding="async">
                                        </div>
                                        <a href="/programmes/">2000+ In-House Tech Training
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Organogram -->
    <div class="rts-campus-life">
        <div class="container mt--10 mb--30">
            <div class="row">
                <div class="col-sm-12">
                    <div class="about__image">
                        <img src="/assets/images/about/about__5.jpg" alt="" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>
        </div>
    </div>
    
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>