--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Rules</li>
                        </ul>
                        <h1 class="section-title">Library Rules</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->


    <!-- Scholarship content -->
    <div class="rts-scholarship pt--20">
        <div class="container">
            <div class="rts-scholarship-description">
                <div class="row sticky-coloum-wrap justify-content-md-center justify-content-start">
                    <div class="col-lg-10 col-md-11">
                        <div class="program-description-area">
                            <!-- scholarship requirement -->
                            <!-- si = scholarship-information -->
                            <div class="si">
                                <h4 class="title">Book Lending Facility
                                </h4>
                                <p>
                                    The details of borrower categories and their entitlements.
                                </p>
                                <div class="si__list">
                                    <ul class="list-unstyled">
                                        <li class="si__list--single">
                                            Faculty Members can borrow 12 books for a period of one semester.
                                        </li>
                                        <li class="si__list--single">
                                            Non-Teaching Staff can borrow 5 books for one semester.
                                        </li>
                                        <li class="si__list--single">
                                            Research Scholars can borrow 8 books for 90 days.
                                        </li>
                                        <li class="si__list--single">
                                            PG Students can borrow 5 books for 15 days.
                                        </li>
                                        <li class="si__list--single">
                                            UG Students can borrow 5 books for 15 days.
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- faq -->
                            <div class="program-credit-area faq mt--50">
                                <div class="program-accordion">
                                    <div class="accordion" id="rts-accordion">
                                        <div class="accordion-item">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                                General Rules
                                            </button>
                                            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#rts-accordion">
                                                <div class="accordion-body">
                                                    <ol>
                                                        <li><p>Faculty Members, Non-Teaching staff and Student members of SRKR are allowed to use the Central Library. Members should always carry their ID cards while using the Central Library.</p></li>
                                                    
                                                        <li><p>Readers should observe strict silence inside the Central Library.</p></li>
                                                    
                                                        <li><p>Mobile phones are to be switched off or to be kept on silent mode in the Central Library reading halls; their use in Central Library is strictly prohibited. Online Chatting is not allowed.</p></li>
                                                    
                                                        <li><p>Members are responsible for books issued against their membership. If the issued document is found mutilated or seriously damaged on return, the users will be held responsible for the damage and will have to replace the same or pay triple times the present cost of the mutilated book.</p></li>
                                                    
                                                        <li><p>Readers are not allowed to bring their personal books or any printed material inside the Central Library.</p></li>
                                                    
                                                        <li><p>Personal belongings like bags, umbrellas, etc. are to be kept at the Property Counter. Readers are advised not to leave their precious and valuable items like money, passport, credit card etc. at the Property Counter.</p></li>
                                                    
                                                        <li><p>Readers should not carry books from one floor to another and should leave the books on the reading table after use. Users should not rest or keep their feet on tables, chairs, shelves, etc.</p></li>
                                                    
                                                        <li><p>Readers should not write in, mark, scratches, and disfigure damage books or furniture of the Central Library.</p></li>
                                                    
                                                        <li><p>Chairs and tables and other Central Library equipment, fittings and furniture should not be marked, defaced, or disarranged.</p></li>
                                                    
                                                        <li><p>Users are not allowed to bring personal belongings like bags, briefcases, handbags, umbrellas, aprons, personal books, or other receptacles inside the Central Library. They are to be kept at the Property Counter only.</p></li>
                                                    
                                                        <li><p>Users are not allowed to carry eatables and drinks inside the Central Library.</p></li>
                                                    
                                                        <li><p>Readers are not to share their net access ID and Password with other students.</p></li>
                                                    
                                                        <li><p>Changing the settings and display of the computers kept in the Central Library are not allowed.</p></li>
                                                    
                                                        <li><p>Playing games on computers is strictly prohibited in the entire Central Library premises.</p></li>
                                                    
                                                        <li><p>Students should take care of their Pen drives, Cell Phones, and Wallets etc.</p></li>
                                                    
                                                        <li><p>Browsing other than academic materials is strictly prohibited. Strict disciplinary action will be taken against the defaulters.</p></li>
                                                    </ol>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                                Circulation Rules
                                            </button>
                                            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#rts-accordion">
                                                <div class="accordion-body">
                                                    <ol>
                                                        <li><p>Borrowers must satisfy themselves with the physical condition of the book before borrowing.</p></li>
                                                    
                                                        <li><p>Books are normally issued for a month except reference books which are issued to faculty for overnight only.</p></li>
                                                    
                                                        <li><p>Those textbooks which have single copies shall not be issued.</p></li>
                                                    
                                                        <li><p>Students can reserve the books at the circulation counter in case these are already issued.</p></li>
                                                    
                                                        <li><p>Reference books, theses, project reports and periodicals/bound journals are not issued at all.</p></li>
                                                    
                                                        <li><p>Project Reports/Theses are to be consulted within the Central Library premises only.</p></li>
                                                    
                                                        <li><p>Dissertations/Theses cannot be photocopied.</p></li>
                                                    
                                                        <li><p>Central Library can recall any issued book even before the due date.</p></li>
                                                    </ol>
                                                </div>
                                            </div>
                                        </div>
                                        
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- program content end -->
<!-- footer -->
<SrkrFooter/>

