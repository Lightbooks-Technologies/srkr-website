--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    <!-- header area end -->
     <!-- BREADCRUMB AREA -->
<section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcrumb-content">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Life @ SRKR</a></li>
                    </ul>
                    <h1 class="section-title">Library</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- BREADCRUMB AREA END -->
   <!-- blog details -->
   <div class="rts-blog-details rts-section-padding">
    <div class="container">
        <div class="row sticky-coloum-wrap justify-content-center g-5">
            <div class="col-lg-8 col-md-10">
                <article class="blog-details">
                    <div class="blog-details__featured-image">
                        <img src="/assets/images/blog/blog-details.jpg" alt="blog post">
                    </div>
                    
                    <h3 class="blog-title">Central Library</h3>
                    <p>A 4160 sqm fully automated library with RFID tech, offering 24,000+ titles, 1.19 lakh volumes, 6458 e-journals, and 110 print journals. Facilities include a Digital Learning Center with 252 systems, e-learning, reading room, book bank, and reference section.</p>
                    
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <div class="post-image">
                                <img src="/assets/images/blog/blog-recent-1.jpg" alt="" loading="lazy" decoding="async">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="post-image">
                                <img src="/assets/images/blog/blog-recent-2.jpg" alt="" loading="lazy" decoding="async">
                            </div>
                        </div>
                    </div>
                    <h3 class="sub-title">List of E-Journals can be accessed from Our Campus LAN</h3>
                    <div class="row mb-5 align-items-center">
                        <div class="col-md-5">
                            <div class="post-image mb-5">
                                <img src="/assets/images/blog/blog-recent-3.jpg" alt="" loading="lazy" decoding="async">
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="check-area-details">
                                <div class="single-check">
                                    <i class="far fa-check-circle"></i>
                                    <span>
                                        <a href="https://www.sciencedirect.com/" target="_blank">Science Direct (Elsevier Journals)</a>
                                    </span>
                                </div>
                                <div class="single-check">
                                    <i class="far fa-check-circle"></i>
                                    <span><a href="https://ascelibrary.org/journals" target="_blank">American Society Of Civil Engineers (Asce)</a></span>
                                </div>
                                <div class="single-check">
                                    <i class="far fa-check-circle"></i>
                                    <span><a href="https://ieeexplore.ieee.org" target="_blank">IEEE Library</a></span>
                                </div>
                                <div class="single-check">
                                    <i class="far fa-check-circle"></i>
                                    <span><a href="http://link.springer.com" target="_blank">Springer (Engineering, CS, Maths And Stats)</a>
                                    </span>
                                </div>
                                <div class="single-check">
                                    <i class="far fa-check-circle"></i>
                                    <span><a href="https://www.ieiindia.org" target="_blank">Journal Of The Institution Of Engineers (India) Series</a></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
               
               
                
            </div>
            <div class="col-lg-4 col-md-10 sticky-coloum-item">
                <div class="program-sidebar">
                    <!-- curriculum -->
                    <div class="program-curriculum">
                        <h6 class="heading-title">Databases</h6>
                        <div class="program-menu">
                            <ul class="list-unstyled">
                                <li><a href="http://164.100.247.26"><span><i class="fa-light fa-arrow-right"></i></span>DELNET</a></li>
                                <li><a href="https://jgateplus.com/"><span><i class="fa-light fa-arrow-right"></i></span>J- Gate</a></li>
                                <li><a href="https://nlist.inflibnet.ac.in"><span><i class="fa-light fa-arrow-right"></i></span>N- LIST </a></li>
                                <li><a href="https://archive.nptel.ac.in/course.html"><span><i class="fa-light fa-arrow-right"></i></span>NPTEL COURSES</a></li>
                                <li><a href="https://srkrec.knimbus.com/portal/v2/default/home" target="_blank" rel="noopener"><span><i class="fa-light fa-arrow-right"></i></span>Knimbus</a></li>
                            </ul>
                        </div>
                    </div>
                    <!-- contact info -->
                    

                    <!-- join event -->
                    <div class="program-event">
                        <div class="program-event-content">
                            <p>Guidelines for Responsible Use of SRKR Central Library: Access, Conduct, and Borrowing Regulations for an Optimal Learning Environment
                            </p>
                           
                            
                            <a href="/library-rules/" class="rts-theme-btn with-arrow btn-white lh-100">Library rules<span><i class="fa-thin fa-arrow-right"></i></span></a>
                        </div>
                    </div>
                    <!-- curriculum -->
                    <div class="program-curriculum">
                        <h6 class="heading-title">e-Books</h6>
                        <div class="program-menu">
                            <ul class="list-unstyled">
                                <li><a href="https://www.accessengineeringlibrary.com" target="_blank"><span><i class="fa-light fa-arrow-right"></i></span>McGraw Hill</a></li>
                                <li><a href="https://www.sciencedirect.com" target="_blank"><span><i class="fa-light fa-arrow-right"></i></span>Elsevier</a></li>
                                <li><a href="http://springerlink.com/" target="_blank"><span><i class="fa-light fa-arrow-right"></i></span>Springer</a></li>
                            </ul>
                                                       
                        </div>
                    </div>
                    <!-- contact info -->
                </div>
            </div>
        </div>
    </div>
</div>
<!-- blog details end -->
    <!-- footer -->
    <SrkrFooter/>

    <!-- footer copyright end -->

    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>