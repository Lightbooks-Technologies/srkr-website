---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
import OffCanvas from "../../components/OffCanvas.astro";

const pageTitle = "Statutes & Code of Conduct";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="Official statutes and codes of conduct for students, teachers, and administrative staff at SRKR Engineering College."
    />
  </head>
  <body>
    <SrkrHeader />

    <!-- Breadcrumb -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/vitals/">Vitals</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="program-about mb--40 text-center">
              <h3 class="title">Institutional Statutes &amp; Code of Conduct Guidelines</h3>
              <p class="mx-auto" style="max-width: 650px;">
                Official manuals and legal statutes outlining the roles, responsibilities, and code of conduct governing students, teachers, and staff at SRKR Engineering College.
              </p>
            </div>

            <!-- Statutes Cards -->
            <div class="card shadow-sm border-0 mb--40">
              <div class="card-body p-4">
                <h4 class="card-title mb-4"><i class="fa-solid fa-scale-balanced me-2" style="color: var(--rt-primary);"></i> College Statutes</h4>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                  <div>
                    <h6 class="mb-1 text-dark">Institutional Statutes</h6>
                    <p class="mb-0 text-muted small">Updated November 2025</p>
                  </div>
                  <a
                    href="/assets/documents/statutes/statutes_26-11-2025.pdf"
                    class="rts-theme-btn"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <i class="fa-light fa-download me-1"></i> Download PDF
                  </a>
                </div>
              </div>
            </div>

            <div class="card shadow-sm border-0">
              <div class="card-body p-4">
                <h4 class="card-title mb-4"><i class="fa-solid fa-users-gear me-2" style="color: var(--rt-primary);"></i> Code of Conduct Guidelines</h4>
                <div class="list-group list-group-flush">
                  <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                      <h6 class="mb-1 text-dark">Code of Conduct for Students</h6>
                      <p class="mb-0 text-muted small">Behavioral expectations and academic integrity guidelines</p>
                    </div>
                    <a
                      href="/assets/documents/statutes/Code_of_Conduct_for_Students_26-11-25.pdf"
                      class="rts-theme-btn"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <i class="fa-light fa-download me-1"></i> Download PDF
                    </a>
                  </div>

                  <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                      <h6 class="mb-1 text-dark">Code of Conduct for Teachers &amp; Other Staff</h6>
                      <p class="mb-0 text-muted small">Professional ethics and workplace conduct guidelines</p>
                    </div>
                    <a
                      href="/assets/documents/statutes/Code_of_Conduct_for_Faculty_and_Staff_26-11-2025.pdf"
                      class="rts-theme-btn"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <i class="fa-light fa-download me-1"></i> Download PDF
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
