  { sno: 7, name: 'Ombudsperson',                   designation: 'Nominee from JNTUK, Kakinada',              role: 'Member (JNTUK)' },
];

const antiRagging = [
  { sno: 1, name: 'Dr. K.V. Murali Krishnam Raju',  designation: 'Principal',                                role: 'Chairman' },
  { sno: 2, name: 'Mr. K. Srinivas',                designation: 'Associate Professor, Dept. of IT',         role: 'Coordinator' },
  { sno: 3, name: 'Sri G. Kalicharan',              designation: 'Circle Inspector, II Town, Bhimavaram',    role: 'External Member' },
  { sno: 4, name: 'Dr. R. Rama Krishnam Raju',      designation: 'Psychiatrist',                             role: 'External Member' },
  { sno: 5, name: 'Sri Ch. Bangar Rao',             designation: 'Local Media Person',                       role: 'External Member' },
  { sno: 6, name: 'Sri P. Murali Rama Raju',        designation: 'Honorary Chairman, Rythu Karyacharana Samithi, AP', role: 'External Member' },
