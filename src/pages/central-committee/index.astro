  { name: 'Academic Council',    href: '/academic-council' },
  { name: 'Board of Studies',    href: '/board-of-studies' },
  { name: 'Finance Committee',   href: '/financial-committee' },
];

const grievance = [
  { sno: 1, name: 'Dr. K.V. Murali Krishnam Raju',  designation: 'Principal',                                role: 'Chairman' },
  { sno: 2, name: 'Dr. S. Venkata Ramana',          designation: 'Professor, Dept. of Information Technology', role: 'Coordinator (SC/ST/OBC Representative)' },
  { sno: 3, name: 'Dr. Bh.V.N Lakshmi',             designation: 'Professor, Dept. of E&amp;FL',              role: 'Member (Professor — Women)' },
  { sno: 4, name: 'Dr. S. Rajesh',                  designation: 'Professor, Dept. of ME · Dean, IQAC',       role: 'Member (Teaching Faculty)' },
