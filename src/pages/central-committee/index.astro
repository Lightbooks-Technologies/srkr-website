      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/">Institute</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Funfact -->
    <div class="rts-funfact v_2 stroke pt--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">4+</h2>
                <p>Statutory Committees</p>
             
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">25+</h2>
                <p>Non-Statutory Cells &amp; Committees</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">100%</h2>
                <p>Categories of stakeholders represented</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">
        <!-- Statutory -->
        <div class="row mb--40">
          <div class="rts-section rt-center mb--45">
            <!-- <h3 class="rts-section-title">Statutory Committees</h3> -->
          </div>
        </div>
        <div class="row g-4">
          <h3 class="rts-section-title">
                Statutory Committees
              </h3>
          {
            statutory.map((s) => (
              <div class="col-lg-3 col-md-6">
                <div class="card h-100 shadow-sm">
                  <div class="card-body">
                    <h5 class="card-title">
                      <a href={s.href}>{s.name}</a>
                    </h5>
                    <p class="card-text">
                      Visit the dedicated page for composition, functions and
                      meeting records.
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Non-statutory accordion + key tables -->
        <div
