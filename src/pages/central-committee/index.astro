        </div>

        <!-- Committee index table -->
        <div class="row mt--60 program-accordion">
          <div  class="accordion col-12" id="cc-accordion">
            <!-- Item: All College Committees · Coordinators Index -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingCommitteeIndex">
          <button
            class="accordion-button collapsed"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#ccCommitteeIndex"
            aria-expanded="false"
            aria-controls="ccCommitteeIndex"
          >
            All College Committees · Coordinators
          </button>
        </h2>
        <div
          id="ccCommitteeIndex"
          class="accordion-collapse collapse"
          aria-labelledby="headingCommitteeIndex"
          data-bs-parent="#cc-accordion"
        >
          <div class="accordion-body">
            <div class="application-deadline__content">
              {
                otherCommittees.length > 0 && (
                  <div class="application-deadline__content--table">
                    <table class="table table-sm table-striped">
                      <thead class="table-theme">
                        <tr>
                          <th><strong>Committee / Cell</strong></th>
                          <th><strong>Coordinator</strong></th>
                        </tr>
                      </thead>
                      <tbody>
                        {otherCommittees.map((c) => (
                          <tr>
                            <td set:html={c.name} />
                            <td>{c.coord}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
