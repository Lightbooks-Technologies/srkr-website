<!-- Popup Modal Component -->
<div id="popupOverlay" class="popup-overlay">
  <div class="popup-content">
    <!-- Close Button -->
    <button id="closePopupBtn" class="popup-close-btn" aria-label="Close Popup">&times;</button>
    
    <!-- Modal Content -->
    <div class="popup-body">
  <!-- OPTION 1: Video -->
  <video src="assets/modal/video1.mp4" autoplay muted loop playsinline></video>

  <!-- OPTION 2: Image -->
  <!-- <img src="assets/modal/249-tcs.png" alt="Admissions 2026–27" /> -->

  <!-- OPTION 3: Text Content -->
  <!-- 
  <h2>Admissions 2026–27</h2>
