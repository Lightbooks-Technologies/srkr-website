  /* --- Pure CSS Infinite Scroll Styles (iOS Safari Friendly) --- */
  .event-wall {
    background: #f8f9fc;
    overflow: hidden;
    position: relative;
    border-radius: 14px;
    border: 1px solid #e3e7f3;
    padding: 12px 0;
    width: 100%;
  }
  .event-wall::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 2px 2px, #d8deee 1.1px, transparent 1.1px);
    background-size: 26px 26px;
    opacity: 0.45;
