  }
  .event-wall__ticker {
    overflow: hidden; /* Prevents manual scroll conflict on iOS */
    width: 100%;
    mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  .event-wall__track {
    display: flex;
    width: max-content;
    gap: 16px;
    padding: 4px 8px;
    /* CSS Animation running on GPU compositor thread - completely smooth on iOS Safari */
    animation: scrollTicker 15s linear infinite;
  }
  
  /* Pause animation when user hovers or touches */
  .event-wall__ticker:hover .event-wall__track,
  .event-wall__ticker:active .event-wall__track {
    animation-play-state: paused;
  }

  @keyframes scrollTicker {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Moves exactly half way since items are duplicated */
      transform: translateX(-50%);
    }
  }

  .event-wall-card {
    background: #ffffff;
