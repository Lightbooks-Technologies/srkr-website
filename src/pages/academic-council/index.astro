<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="The Academic Council is the apex academic body of SRKR Engineering College — composition, functions and meeting records."
    />
  </head>
  <body>
    <SrkrHeader />

    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/">Institute</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Funfact -->
    <!-- <div class="rts-funfact v_2 stroke pt--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">26</h2>
                <p>Members across 6 categories</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">7</h2>
                <p>External Experts &amp; JNTUK Nominees</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">2x</h2>
                <p>Statutory Meetings per Academic Year</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div> -->

    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">
        <!-- Functions accordion -->
        <div
          class="row sticky-coloum-wrap justify-content-md-center justify-content-start"
        >
          <div class="col-lg-8 col-md-11">
            <div class="program-about mb--40">
              <h4 class="title">About the Academic Council</h4>
              <p>
                The Academic Council is the apex statutory body for academic
                matters at SRKR Engineering College. It scrutinises and approves
                curricula, regulations and evaluation procedures recommended by
                the Board of Studies, and advises the Governing Body on
                academic policy.
              </p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="ac-accordion">
                  <div class="accordion-item">
                    <button
                      class="accordion-button"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#acFunctions"
                      aria-expanded="true">Functions &amp; Powers</button
                    >
                    <div
                      id="acFunctions"
                      class="accordion-collapse collapse show"
                      data-bs-parent="#ac-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                          <li class="si__list--single">
                            Scrutinise and approve proposals from Boards of
                            Studies on courses of study, regulations, curricula,
                            syllabi, instruction and evaluation methods.
                          </li>
                          <li class="si__list--single">
                            Make regulations for admission of students to
                            programmes, keeping in view the policy of the
                            Government.
                          </li>
                          <li class="si__list--single">
                            Make regulations for sports, extra-curricular
                            activities, playgrounds and hostels.
                          </li>
                          <li class="si__list--single">
                            Recommend institution of new programmes of study to
                            the Governing Body.
                          </li>
                          <li class="si__list--single">
                            Recommend institution of scholarships, studentships,
                            fellowships, prizes and medals.
                          </li>
                          <li class="si__list--single">
                            Advise the Governing Body on academic affairs and
                            perform such other functions as may be assigned.
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <!-- <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#acReturn"
                      aria-expanded="false">Return &amp; Reconsideration</button
                    >
                    <div
                      id="acReturn"
                      class="accordion-collapse collapse"
                      data-bs-parent="#ac-accordion"
                    >
                      <div class="accordion-body">
                        <p>
                          Where the Academic Council differs on any proposal, it
                          shall have the right to return the matter for
                          reconsideration to the Board of Studies concerned, or
                          reject it, after giving reasons for the same.
                        </p>
                      </div>
                    </div>
                  </div> -->

                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#acMeetings"
                      aria-expanded="false">Meetings of Minutes </button
                    >
                    <div
                      id="acMeetings"
                      class="accordion-collapse collapse"
                      data-bs-parent="#ac-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                    
                    
                          <li class="si__list--single">
                          
                            <ul>
                              <li>
                                <a href="/assets/documents/ac/2023-24.pdf"
                                  >2023-24 <i class="fa-light fa-download"></i></a
                                >
                              </li>
                              <li>
                                <a href="/assets/documents/ac/2024-25.pdf"
                                  >2024-25 <i class="fa-light fa-download"></i></a
                                >
                              </li>
                              <li>
                                <a href="/assets/documents/ac/2025-26.pdf"
                                  >2025-26 <i class="fa-light fa-download"></i></a
                                >
                              </li>
                            </ul>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">
              <div class="program-curriculum">
                <h6 class="heading-title">Related Bodies</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li>
                      <a href="/governing"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >Governing Body</a>
                    </li>
                    <li>
                      <a href="/board-of-studies"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >Board of Studies</a>
                    </li>
                     <li>
                      <a href="/financial-committee"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >Finance Committee</a>
                    </li>
                    <li>
                      <a href="/central-committee"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >Statutory Committees</a>
                    </li>
                   
                    <li>
                      <a href="/iqac"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >IQAC</a>
                    </li>
                  </ul>
                </div>
              </div>
              <!-- <div class="program-info">
                <h5>Member Secretary</h5>
                <p>{memberSecretary.name}<br/><small set:html={memberSecretary.role}></small></p>
              </div> -->
            </div>
          </div>
        </div>
<section class="rts-scholarship pt--40 pb--60" id="rac">
  <div class="container">
    

    <div class="application-deadline">
      <div class="application-deadline__content">
        <div class="application-deadline__content--table">
          <table class="table align-middle">
            <thead class="table-theme">
              <tr>
                <th scope="col" style="width: 8%;">S.No</th>
                <th scope="col" style="width: 25%;">Name</th>
                <th scope="col" style="width: 32%;">Designation</th>
                <th scope="col" style="width: 23%;">Role</th>
              </tr>
            </thead>
            <tbody>
              {racMembers.map((m, i) => (
                <>
                  {/* Category Header Row */}
                  {m.isHeader ? (
                    <tr class="category-header-row">
                      <td colspan="5" class="fw-bold pt-3 pb-2" style="color: var(--rt-primary, #0b4a72); background-color: #f8f9fa;">
                        {m.title}
                      </td>
                    </tr>
                  ) : (
                    /* Member Data Row */
                    <tr>
                      <td>{m.sno}</td>
                      <td set:html={m.name}></td>
                      <td>{m.designation}</td>
                      <td>{m.role}</td>
                      {/* <td class="text-center align-middle">
                        <img 
                          src={m.photo || '/assets/images/default-avatar.png'} 
                          alt={m.name} 
                          class="img-fluid rounded"
                          style="width: 65px; height: 80px; object-fit: cover;"
                        />
                      </td> */}
                    </tr>
                  )}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
        

       
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
