---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description={`Internal Quality Assurance Cell (IQAC) at SRKR Engineering College — composition, AQAR reports, meeting minutes and best practices.`}
    />
  </head>
  <body>
    <SrkrHeader />

    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/">Institute</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Overview + KPI funfact -->
    <div class="rts-funfact v_2 stroke pt--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10">
            <div class="rts-funfact-wrapper">
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">A+</h2>
                <p>NAAC Grade · CGPA 3.42 (Cycle 2)</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">25</h2>
                <p>IQAC Members across 8 stakeholder categories</p>
              </div>
              <div class="single-cta-item">
                <h2 class="single-cta-item__title">8</h2>
                <p>AQAR Reports filed since 2016-17</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">
        <!-- Vision / Mission / Strategies / Functions / Benefits -->
        <div
          class="row sticky-coloum-wrap justify-content-md-center justify-content-start"
        >
          <div class="col-lg-8 col-md-11">
            <div class="program-about mb--40">
              <h4 class="title">About IQAC</h4>
              <p>
                The Internal Quality Assurance Cell (IQAC) is the nodal body
                responsible for planning, sustaining and driving quality
                enhancement initiatives across academic, research and
                administrative functions at SRKR Engineering College.
                Established in line with NAAC guidelines, the IQAC builds a
                culture of continuous improvement through systematic
                documentation, stakeholder feedback and data-driven decision
                making.
              </p>
            </div>

            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="iqac-accordion">
                  <div class="accordion-item">
                    <button
                      class="accordion-button"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#iqacStrategies"
                      aria-expanded="true">Strategies</button
                    >
                    <div
                      id="iqacStrategies"
                      class="accordion-collapse collapse show"
                      data-bs-parent="#iqac-accordion"
                    >
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">
                                Ensure timely, efficient and progressive
                                performance of academic, administrative and
                                financial tasks.
                              </li>
                              <li class="si__list--single">
                                Strengthen relevance and quality of academic and
                                research programmes.
                              </li>
                              <li class="si__list--single">
                                Provide equitable access to and affordability of
                                academic programmes for various sections of
                                society.
                              </li>
                              <li class="si__list--single">
                                Optimise and integrate modern methods of
                                teaching and learning.
                              </li>
                              <li class="si__list--single">
                                Uphold the credibility of evaluation procedures.
                              </li>
                              <li class="si__list--single">
                                Maintain adequacy and effective functioning of
                                support structure and services.
                              </li>
                              <li class="si__list--single">
                                Encourage research sharing and networking with
                                institutions in India and abroad.
                              </li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#iqacFunctions"
                      aria-expanded="false">Functions</button
                    >
                    <div
                      id="iqacFunctions"
                      class="accordion-collapse collapse"
                      data-bs-parent="#iqac-accordion"
                    >
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">
                                Develop and apply quality benchmarks for
                                academic and administrative activities.
                              </li>
                              <li class="si__list--single">
                                Facilitate a learner-centric environment and
                                faculty maturation for participatory
                                teaching-learning.
                              </li>
                              <li class="si__list--single">
                                Collect feedback from students, parents and
                                stakeholders on quality-related processes.
                              </li>
                              <li class="si__list--single">
                                Disseminate information on quality parameters of
                                higher education.
                              </li>
                              <li class="si__list--single">
                                Organise inter and intra institutional workshops
                                and seminars on quality themes.
                              </li>
                              <li class="si__list--single">
                                Document programmes/activities leading to
                                quality improvement.
                              </li>
                              <li class="si__list--single">
                                Act as a nodal agency for coordinating
                                quality-related activities and best practices.
                              </li>
                              <li class="si__list--single">
                                Maintain an institutional MIS database for
                                quality enhancement.
                              </li>
                              <li class="si__list--single">
                                Prepare the Annual Quality Assurance Report
                                (AQAR) per NAAC guidelines.
                              </li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#iqacBenefits"
                      aria-expanded="false">Benefits</button
                    >
                    <div
                      id="iqacBenefits"
                      class="accordion-collapse collapse"
                      data-bs-parent="#iqac-accordion"
                    >
                      <div class="accordion-body">
                        <div class="si">
                          <div class="si__list">
                            <ul class="list-unstyled">
                              <li class="si__list--single">
                                Heightened clarity and focus in institutional
                                functioning towards quality enhancement.
                              </li>
                              <li class="si__list--single">
                                Internalisation of a quality culture across
                                departments and units.
                              </li>
                              <li class="si__list--single">
                                Better coordination and institutionalisation of
                                good practices.
                              </li>
                              <li class="si__list--single">
                                Sound basis for evidence-based decision-making.
                              </li>
                              <li class="si__list--single">
                                Organised methodology of documentation and
                                internal communication.
                              </li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#iqacBestPractices"
                      aria-expanded="false"
                      >Best Practices &amp; Distinctiveness</button
                    >
                    <div
                      id="iqacBestPractices"
                      class="accordion-collapse collapse"
                      data-bs-parent="#iqac-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                          {
                            bestPractices.map((bp) => (
                              <li class="si__list--single">
                                <a
                                  href={bp.href}
                                  target="_blank"
                                  rel="noopener"
                                >
                                  Best Practices — {bp.year} (PDF)
                                </a>
                              </li>
                            ))
                          }
                          <li class="si__list--single">
                            <a
                              href="/assets/documents/mandates/DISTINCTVENESS_WEBSITE_2023-24.pdf"
                              target="_blank"
                              rel="noopener"
                              >Institutional Distinctiveness 2023-24 (PDF)</a>
                          </li>
                          <li class="si__list--single">
                            <a
                              href="/assets/documents/mandates/DISTINCTVENESS_WEBSITE_2022-23.pdf"
                              target="_blank"
                              rel="noopener"
                              >Institutional Distinctiveness 2022-23 (PDF)</a>
                          </li>
                          <li class="si__list--single">
                            <a
                              href="/assets/documents/iqac/Student_Satisfaction_Survey_2023-24.pdf"
                              target="_blank"
                              rel="noopener"
                              >Student Satisfaction Survey 2023-24 (PDF)</a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="col-lg-4 col-md-11 sticky-coloum-item">
            <div class="program-sidebar">
              <div class="program-curriculum">
                <h6 class="heading-title">Quality Resources</h6>
                <div class="program-menu">
                  <ul class="list-unstyled">
                    <li>
                      <a href="/naac-ssr/"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >NAAC SSR</a>
                    </li>
                    <li>
                      <a href="/accreditations/"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >NAAC Mandates</a>
                    </li>
                    <li>
                      <a href="/vitals/#nirf"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >NIRF Disclosures</a>
                    </li>
                    <li>
                      <a href="/vitals/#nba"
                        ><span><i class="fa-light fa-arrow-right"></i></span>NBA
                        Accreditation</a>
                    </li>
                    <li>
                      <a href="/vitals"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >Institute Vitals</a>
                    </li>
                    <li>
                      <a href="/development-plan"
                        ><span><i class="fa-light fa-arrow-right"></i></span
                        >Institution Development Plan</a>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="program-info">
                <h5>IQAC Coordinator</h5>
                <p>Dr. S. Rajesh<br />Dean, IQAC · Member Secretary</p>
                <div class="contact-info mt--10 mb--10">
                  <h5>Email:</h5>
                  <a href="mailto:iqac@srkrec.ac.in">iqac@srkrec.ac.in</a>
                  {/* TODO: confirm official IQAC email */}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Composition table -->
        <div class="row mt--60">
          <div class="col-12">
            <div class="application-deadline">
              <h3 class="rts-section-title">IQAC Composition</h3>
              <div class="application-deadline__content">
                <div class="application-deadline__content--table">
                  <table class="table">
                    <thead class="table-theme">
                      <tr>
                        <td>S.No</td>
                        <td>Category</td>
                        <td>Name</td>
                        <td>Designation</td>
                        <td>Position</td>
                      </tr>
                    </thead>
                    <tbody>
                      {
                        iqacMembers.map((m) => (
                          <tr>
                            <td>{m.sno}</td>
                            <td>{m.category}</td>
                            <td>{m.name}</td>
                            <td>{m.designation}</td>
                            <td>{m.position}</td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- AQAR + Meetings + Orders accordion -->
        <div class="row mt--40">
          <div class="col-12">
            <div class="program-credit-area faq rts-scholarship-description">
              <div class="program-accordion">
                <div class="accordion" id="iqac-docs-accordion">
                  <div class="accordion-item">
                    <button
                      class="accordion-button"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#aqarList"
                      aria-expanded="true"
                      >Annual Quality Assurance Reports (AQAR)</button
                    >
                    <div
                      id="aqarList"
                      class="accordion-collapse collapse show"
                      data-bs-parent="#iqac-docs-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                          {
                            aqarReports.map((r) => (
                              <li class="si__list--single">
                                <a href={r.href} target="_blank" rel="noopener">
                                  AQAR Report {r.year} (PDF)
                                </a>
                              </li>
                            ))
                          }
                        </ul>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#meetingMinutes"
                      aria-expanded="false">Recent IQAC Meeting Minutes</button
                    >
                    <div
                      id="meetingMinutes"
                      class="accordion-collapse collapse"
                      data-bs-parent="#iqac-docs-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                          {
                            recentMeetings.map((m) => (
                              <li class="si__list--single">
                                <a href={m.href} target="_blank" rel="noopener">
                                  IQAC Meeting — {m.date} (PDF)
                                </a>
                              </li>
                            ))
                          }
                          <li class="si__list--single">
                            <a
                              href="https://website.srkramc.in/iqac.php"
                              target="_blank"
                              rel="noopener"
                              >View full archive (2016 onwards)</a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <div class="accordion-item">
                    <button
                      class="accordion-button collapsed"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#orderList"
                      aria-expanded="false">IQAC Reconstitution Orders</button
                    >
                    <div
                      id="orderList"
                      class="accordion-collapse collapse"
                      data-bs-parent="#iqac-docs-accordion"
                    >
                      <div class="accordion-body">
                        <ul class="list-unstyled">
                          {
                            reconstitutionOrders.map((o) => (
                              <li class="si__list--single">
                                <a href={o.href} target="_blank" rel="noopener">
                                  IQAC Order dated {o.date} (PDF)
                                </a>
                              </li>
                            ))
                          }
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
