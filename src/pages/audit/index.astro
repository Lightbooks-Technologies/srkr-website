---
import BaseHead from "../../components/BaseHead.astro";
import FooterScripts from "../../components/FooterScripts.astro";
import SrkrHeader from "../../components/SrkrHeader.astro";
import SrkrFooter from "../../components/SrkrFooter.astro";
import OffCanvas from "../../components/OffCanvas.astro";

const pageTitle = "Audited Statements";

const auditedStatements = [
  { year: "2024-25", href: "/assets/documents/audit/Audited_Statements_2024-25.pdf" },
  { year: "2023-24", href: "/assets/documents/audit/Audited_Statements_2023-24.pdf" },
  { year: "2022-23", href: "/assets/documents/audit/Audited_Statements_2022-23.pdf" },
  { year: "2021-22", href: "/assets/documents/audit/Audited_Statements_2021-22.pdf" },
  { year: "2020-21", href: "/assets/documents/audit/Audited_Statements_2020-21.pdf" },
  { year: "2019-20", href: "/assets/documents/audit/Audited_Statements_2019-20.pdf" },
  { year: "2018-19", href: "/assets/documents/audit/Audited_Statements_2018-19.pdf" },
  { year: "2017-18", href: "/assets/documents/audit/Audited_Statements_2017-18.pdf" },
  { year: "2016-17", href: "/assets/documents/audit/Audited_Statements_2016-17.pdf" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${pageTitle} | SRKR Engineering College`}
      description="Audited statements and financial declarations for Sagi Rama Krishnam Raju Engineering College."
    />
  </head>
  <body>
    <SrkrHeader />

    <!-- Breadcrumb -->
    <section
      class="rts-breadcrumb breadcrumb-height breadcumb-bg"
      style="background-image: url(/assets/images/banner/breadcrumb.jpg);"
    >
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/vitals/">Vitals</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <section class="rts-scholarship pt--60 pb--60">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <div class="program-about mb--40 text-center">
              <h3 class="title">Audited Financial Statements</h3>
              <p class="mx-auto" style="max-width: 650px;">
                Annual audited statement records indicating transparency and compliance with academic institution financial standards.
              </p>
            </div>

            <!-- Audit Statements List -->
            <div class="card shadow-sm border-0">
              <div class="card-body p-4">
                <div class="list-group list-group-flush">
                  {
                    auditedStatements.map((a) => (
                      <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                          <h6 class="mb-0 text-dark">Audited Financial Statement — {a.year}</h6>
                        </div>
                        <a
                          href={a.href}
                          class="rts-theme-btn"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <i class="fa-light fa-download me-1"></i> Download PDF
                        </a>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
