--- 
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import OffCanvas from '../../components/OffCanvas.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
    <body>
    <!-- header area start -->
    <SrkrHeader />
    
    <!-- header area end -->
     

    <!-- BREADCRUMB AREA -->
    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumb-content">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                        </ul>
                        <h1 class="section-title">Regulations</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- BREADCRUMB AREA END -->
    <!-- admission page content -->
    <div class="rts-page-content">
        <div class="container">
            <div class="row">
                
                <div class="col-12">
                    <div class="admission-content-top">
                        <div class="application-deadline">
                            <h3 class="rts-section-title">Regulations</h3>
                            <div class="application-deadline__content">
                                <div class="application-deadline__content--table">
                                    <table class="table">
                                        <thead class="table-theme">
                                          <tr>
                                            <td>BBA</td>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          <tr>
                                            <td> <a href="/files/regulations/BBA.pdf" target="_blank">R24 Academic Regulations</a></td>
                                          </tr>
                                        </tbody>
                                        <thead class="table-theme">
                                            <tr>
                                              <td>B-Tech</td>
                                            </tr>
                                          </thead>
                                          <tbody>
                                            
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/R23_REGUALTIONS_BTech_updated_WS.pdf" target="_blank" >R23 Academic Regulations</a></td>
                                            </tr>
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R23_MINORS_REGULATIONS.pdf" target="_blank" >Guidelines for Honors and Minors - R23 B.Tech Regulations</a></td>
                                            </tr>

                                            <tr>  
                                              <td><a href="/files/regulations/R23-DESIGN-THINKING-REGULATIONS.pdf" target="_blank" >Design Thinking Regulations - R23 B.Tech Regulations</a></td>
                                            </tr>

                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R20_REGULATIONS.pdf" target="_blank" >R20 Academic Regulations</a></td>
                                            </tr>
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R20_MINORS_REGULATIONS.pdf" target="_blank" >Guidelines for Honors and Minors - R20 B.Tech Regulations</a></td>
                                            </tr>
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R20_MINORS_REGULATIONS_AMENDMENT.pdf" target="_blank" >Honors and Minors Amendment- R20 B.Tech Regulations</a></td>
                                            </tr>
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R19_REGULATIONS.pdf" target="_blank" >R19 Academic Regulations</a></td>
                                            </tr>
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R17_REGULATIONS.pdf" target="_blank" >R17 Academic Regulations</a></td>
                                            </tr>
                                          
                                            <tr>  
                                              <td><a href="/files/regulations/BTECH_R16_REGULATIONS.pdf" target="_blank" >R16 Academic Regulations</a></td>
                                            </tr>
                                          
                                          </tbody>
                                          <thead class="table-theme">
                                            <tr>
                                              <td>M-Tech</td>
                                            </tr>
                                          </thead>
                                          <tbody>

                                            <tr>  <td><a href="/files/regulations/MTECH_R19_REGULATIONS.pdf" target="_blank" >R19 Academic Regulations</a></td></tr>
                                         
                                            
                                         
                                            <tr>  <td><a href="/files/regulations/MTECH_R17_REGULATIONS.pdf" target="_blank" >R17 Academic Regulations</a></td></tr>
                                         
                                            
                                         
                                            <tr>  <td><a href="/files/regulations/MTECH_R16_REGULATIONS.pdf" target="_blank" >R16 Academic Regulations</a></td></tr>
                                         
                                            
                                         
                                          </tbody>
                                      </table>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- admission page content end -->
<!-- footer -->
<SrkrFooter/>

    <!-- footer copyright end -->


    <OffCanvas/>


    <!-- scripts -->
    <FooterScripts />


</body>

</html>