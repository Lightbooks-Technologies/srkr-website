---
import BaseHead from '../../components/BaseHead.astro';
import FooterScripts from '../../components/FooterScripts.astro';
import SrkrHeader from '../../components/SrkrHeader.astro';
import SrkrFooter from '../../components/SrkrFooter.astro';
import OffCanvas from '../../components/OffCanvas.astro';

const pageTitle = "Code of Conduct";

const values = [
  { icon: 'fa-handshake', name: 'Integrity', desc: 'Honesty in all academic and personal interactions; ownership of one\'s actions.' },
  { icon: 'fa-people-arrows', name: 'Respect', desc: 'For peers, faculty, staff and property — irrespective of background or belief.' },
  { icon: 'fa-shield-check', name: 'Responsibility', desc: 'Towards self, community and the institution\'s reputation.' },
  { icon: 'fa-globe', name: 'Inclusivity', desc: 'Equal opportunity, zero discrimination on grounds of gender, caste or religion.' },
  { icon: 'fa-book-bookmark', name: 'Academic Honesty', desc: 'No plagiarism, no exam malpractice, full citation of sources.' },
  
  { icon: 'fa-scale-balanced', name: 'Fairness', desc: 'Uphold impartiality in evaluation, decisions and the use of institutional resources.' },

];

const ragCommittee = [
  { role: 'Chairperson', name: 'Principal, SRKR' },
  { role: 'Members — Faculty', name: '{TODO: 4 senior faculty members nominated by Principal}' },
  { role: 'Members — Non-Teaching', name: '{TODO: 2 administrative staff representatives}' },
  { role: 'Members — Parents', name: '{TODO: 2 parent representatives}' },
  { role: 'Members — Students', name: 'Two senior &amp; two fresher students (mandatory)' },
  { role: 'External NGO Representative', name: '{TODO: NGO rep — UGC mandated}' },
];

const downloads = [
  { name: 'Code of Conduct — Full Document (PDF)', href: '/assets/docs/code-of-conduct.pdf' },
  { name: 'Anti-Ragging Affidavit — Student (UGC Format)', href: 'https://antiragging.in/Site/Affidavits_registration.aspx' },
  { name: 'Anti-Ragging Affidavit — Parent', href: 'https://antiragging.in/Site/Affidavits_registration.aspx' },
  { name: 'Grievance Redressal Form', href: '/assets/docs/grievance-form.pdf' },
  { name: 'Examination Malpractice Policy', href: '/assets/docs/malpractice-policy.pdf' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${pageTitle} | SRKR Engineering College`} description="Student Code of Conduct, anti-ragging policy &amp; disciplinary procedures at SRKR Engineering College." />
  </head>
  <body>
    <SrkrHeader />

    <section class="rts-breadcrumb breadcrumb-height breadcumb-bg" style="background-image: url(/assets/images/banner/breadcrumb.jpg);">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="breadcrumb-content">
              <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="#">Life @ SRKR</a></li>
              </ul>
              <h1 class="section-title">{pageTitle}</h1>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HERO -->
    <div class="rts-history py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 text-center">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">A Community Built on Trust</h3>
              <p class="rts-section-description">SRKR's Code of Conduct sets clear, fair expectations for every member of our community — students, faculty and staff alike. Our pledge: a safe, respectful and intellectually honest campus.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CORE VALUES -->
    <div class="rts-multi-row-section pb-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Core Values</h3>
        </div>
        <div class="row g-4">
          {values.map((v) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm single-cta-item">
                <div class="card-body text-center">
                  <h2 class="single-cta-item__title"><i class={`fa-light ${v.icon}`}></i></h2>
                  <h5 class="mt-3 mb-2">{v.name}</h5>
                  <p class="mb-0 small text-muted">{v.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- CONDUCT CATEGORIES -->
    <div class="py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Conduct Categories</h3>
        </div>
        <div class="program-credit-area faq rts-scholarship-description">
          <div class="program-accordion">
            <div class="accordion" id="coc-accordion">
              <div class="accordion-item">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cc1" aria-expanded="true">
                  Classroom &amp; Laboratory Conduct
                </button>
                <div id="cc1" class="accordion-collapse collapse show" data-bs-parent="#coc-accordion">
                  <div class="accordion-body">
                    <div class="si__list">
                      <ul class="list-unstyled">
                        <li class="si__list--single">Punctuality is mandatory; minimum 75% attendance required to write exams.</li>
                        <li class="si__list--single">Mobile phones must be switched off in classrooms &amp; labs.</li>
                        <li class="si__list--single">No damage to lab equipment — students bear cost of wilful damage.</li>
                        <li class="si__list--single">Lab dress code &amp; PPE compulsory wherever specified.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cc2" aria-expanded="false">
                  Hostel Conduct
                </button>
                <div id="cc2" class="accordion-collapse collapse" data-bs-parent="#coc-accordion">
                  <div class="accordion-body">
                    <div class="si__list">
                      <ul class="list-unstyled">
                        <li class="si__list--single">Strict in-time as per hostel rules; movement register to be signed.</li>
                        <li class="si__list--single">Compulsory study hours 9 PM – 11 PM; silence to be maintained.</li>
                        <li class="si__list--single">Possession of alcohol, drugs or weapons strictly prohibited.</li>
                        <li class="si__list--single">Guests allowed only in visitors' area with prior warden permission.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cc3" aria-expanded="false">
                  Anti-Ragging Policy
                </button>
                <div id="cc3" class="accordion-collapse collapse" data-bs-parent="#coc-accordion">
                  <div class="accordion-body">
                    <p>SRKR enforces a <strong>zero-tolerance</strong> anti-ragging policy in line with UGC Regulations 2009 and the Hon'ble Supreme Court's directives. Any form of ragging — physical, verbal, online or psychological — invites strict action including suspension, FIR &amp; cancellation of admission.</p>
                    <p class="mb-0">Report to: <a href="https://antiragging.in" target="_blank" rel="noopener">antiragging.in</a> · National Helpline <a href="tel:1800-180-5522">1800-180-5522</a></p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cc4" aria-expanded="false">
                  Online &amp; Social-Media Conduct
                </button>
                <div id="cc4" class="accordion-collapse collapse" data-bs-parent="#coc-accordion">
                  <div class="accordion-body">
                    <div class="si__list">
                      <ul class="list-unstyled">
                        <li class="si__list--single">No defamatory, communal, or obscene posts about the institution, peers or faculty.</li>
                        <li class="si__list--single">Sharing exam questions/answers in groups before/during the exam is malpractice.</li>
                        <li class="si__list--single">Cyberbullying &amp; harassment fall under IT Act 2000 and will be reported.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cc5" aria-expanded="false">
                  Examination Conduct
                </button>
                <div id="cc5" class="accordion-collapse collapse" data-bs-parent="#coc-accordion">
                  <div class="accordion-body">
                    <div class="si__list">
                      <ul class="list-unstyled">
                        <li class="si__list--single">Carrying any unauthorised material into the exam hall is malpractice.</li>
                        <li class="si__list--single">Impersonation results in cancellation of all results &amp; FIR.</li>
                        <li class="si__list--single">Plagiarism in projects/theses is treated as academic misconduct.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cc6" aria-expanded="false">
                  Library Conduct
                </button>
                <div id="cc6" class="accordion-collapse collapse" data-bs-parent="#coc-accordion">
                  <div class="accordion-body">
                    <div class="si__list">
                      <ul class="list-unstyled">
                        <li class="si__list--single">Maintain silence; mobile phones on silent mode.</li>
                        <li class="si__list--single">Return books on time; fines apply on delayed returns.</li>
                        <li class="si__list--single">No tearing pages, marking or damaging library books — replacement cost recovered.</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- DISCIPLINARY PROCESS -->
    <div class="rts-mission py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Disciplinary Process</h3>
        </div>
        <div class="program-credit-area faq rts-scholarship-description">
          <div class="program-accordion">
            <div class="accordion" id="disc-accordion">
              <div class="accordion-item">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#dp1" aria-expanded="true">
                  Step 1 — Reporting
                </button>
                <div id="dp1" class="accordion-collapse collapse show" data-bs-parent="#disc-accordion">
                  <div class="accordion-body">
                    <p>Incident reported to a faculty member, HoD, Warden, Student Welfare Officer or directly via the online <a href="/assets/docs/grievance-form.pdf">grievance form</a>.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dp2" aria-expanded="false">
                  Step 2 — Investigation
                </button>
                <div id="dp2" class="accordion-collapse collapse" data-bs-parent="#disc-accordion">
                  <div class="accordion-body">
                    <p>The Disciplinary Committee initiates a fact-finding inquiry; witnesses and evidence are recorded confidentially.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dp3" aria-expanded="false">
                  Step 3 — Hearing
                </button>
                <div id="dp3" class="accordion-collapse collapse" data-bs-parent="#disc-accordion">
                  <div class="accordion-body">
                    <p>Both parties get a fair hearing. Students may be accompanied by a parent or guardian.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dp4" aria-expanded="false">
                  Step 4 — Action
                </button>
                <div id="dp4" class="accordion-collapse collapse" data-bs-parent="#disc-accordion">
                  <div class="accordion-body">
                    <p>Penalty determined — ranging from written warning, suspension, fine, hostel debarment, to expulsion as per the gravity of misconduct.</p>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#dp5" aria-expanded="false">
                  Step 5 — Appeal
                </button>
                <div id="dp5" class="accordion-collapse collapse" data-bs-parent="#disc-accordion">
                  <div class="accordion-body">
                    <p>An appeal may be filed before the Principal within 15 days. The Principal's decision, taken in consultation with the Governing Body, is final.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ANTI-RAGGING COMMITTEE -->
    <div class="rts-multi-row-section py-5">
      <div class="container">
        <div class="rts-section mb--30">
          <h3 class="rts-section-title">Anti-Ragging Committee </h3>
        </div>
        <div class="row g-4">
          {ragCommittee.map((m) => (
            <div class="col-lg-4 col-md-6">
              <div class="card h-100 shadow-sm">
                <div class="card-body">
                  <h6 class="text-uppercase small text-muted mb-1">{m.role}</h6>
                  <p class="mb-0" set:html={m.name}></p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="small text-muted mt-3 mb-0">{/* TODO: replace with actual committee roster from Principal's office */}Composition follows UGC Anti-Ragging Regulations 2009.</p>
      </div>
    </div>

    <!-- DOWNLOADS + EXTERNAL LINKS -->
    <div class="py-5">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-6">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">Downloads</h3>
            </div>
            <div class="program-list">
              <ul class="list-unstyled one-column-list">
                {downloads.map((d) => (
                  <li class="si__list--single mb-2">
                    <a href={d.href} target={d.href.startsWith('http') ? '_blank' : undefined} rel={d.href.startsWith('http') ? 'noopener' : undefined}>
                      <i class="fa-regular fa-file-pdf"></i> {d.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <p class="small text-muted mt-2">{/* TODO: confirm PDF paths exist under /assets/docs/ */}</p>
          </div>
          <div class="col-lg-6">
            <div class="rts-section mb--30">
              <h3 class="rts-section-title">External References</h3>
            </div>
            <div class="program-list">
              <ul class="list-unstyled one-column-list">
                <li class="si__list--single mb-2"><a href="https://antiragging.in" target="_blank" rel="noopener">UGC Anti-Ragging Portal — antiragging.in <i class="fa-regular fa-arrow-up-right-from-square"></i></a></li>
                <li class="si__list--single mb-2"><a href="https://www.ugc.gov.in" target="_blank" rel="noopener">University Grants Commission (UGC) <i class="fa-regular fa-arrow-up-right-from-square"></i></a></li>
                <li class="si__list--single mb-2"><a href="https://nhrc.nic.in" target="_blank" rel="noopener">National Human Rights Commission (NHRC) <i class="fa-regular fa-arrow-up-right-from-square"></i></a></li>
                <li class="si__list--single mb-2"><a href="https://ncw.nic.in" target="_blank" rel="noopener">National Commission for Women (NCW) <i class="fa-regular fa-arrow-up-right-from-square"></i></a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <SrkrFooter />
    <OffCanvas />
    <FooterScripts />
  </body>
</html>
