---
import { departments, DEPT_NAV_ITEMS } from '../data/departments';

const headerDepartments = departments.filter((department) =>
  ['civil', 'cse', 'ece', 'eee', 'mechanical', 'it'].includes(department.slug),
);
---

<style>
  /* Remove any hide-on-scroll logic if present elsewhere in the project */
  /* Tighter submenu padding */
  .navigation__menu--item ul.submenu,
  .navigation__menu--item .sub__style {
    padding: 12px 0 !important;
  }
  .navigation__menu--item ul.submenu li,
  .navigation__menu--item .sub__style li {
    padding: 0 18px !important;
  }
  .navigation__menu--item ul.submenu li:not(:last-child),
  .navigation__menu--item .sub__style li:not(:last-child) {
    margin: 0 0 6px !important;
  }

  /* Modern Hamburger Menu */
  .menu__trigger {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    padding: 8px;
    border-radius: 6px;
    transition: all 0.3s ease;
    background: transparent;
  }
  
  .menu__trigger:hover {
    background: rgba(0, 0, 0, 0.05);
  }
  
  .hamburger-line {
    width: 24px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: all 0.3s ease;
    margin: 3px 0;
  }
  
  .menu__trigger:hover .hamburger-line {
    background: var(--rt-primary-2, #d32f2f);
  }
  
  /* Active state animation */
  .menu__trigger.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  
  .menu__trigger.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  
  .menu__trigger.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Use chevrons for menu indicators instead of plus signs. */
  .navigation__menu--item.has-arrow::before {
    content: "\f078" !important;
    font-family: "Font Awesome 6 Pro" !important;
    font-weight: 900;
    font-size: 12px;
  }

  .navigation__menu--item ul.submenu li.has-arrow::before,
  .navigation__menu--item .sub__style li.has-arrow::before {
    content: "\f054" !important;
    font-family: "Font Awesome 6 Pro" !important;
    font-weight: 900;
    font-size: 11px;
  }

  /* Keep logo and menu close while preserving right-side trigger alignment. */
  .header .header__wrapper {
    justify-content: flex-start;
    gap: 40px;
  }

  .header .header__right {
    margin-left: auto;
  }
</style>

