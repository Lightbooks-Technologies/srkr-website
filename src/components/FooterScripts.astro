				'--rt-primary-2': '#890C25',
				'--rt-secondary': '#110C2D',
				'--rt-footer': '#181818',
				'--rt-body': '#5e6e7d',
				'--rt-heading': '#262626',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#890C25',
				'--rt-border': '#D9D9D9',
				'--rt-line': '#EEEEEE',
				'--rt-hover': '#AF0E2E'
			},
			'executive-navy': {
				'--rt-theme': '#328CC1',
				'--rt-primary': '#0B3C5D',
				'--rt-primary-1': '#145C87',
				'--rt-primary-2': '#082D45',
				'--rt-secondary': '#1D2731',
				'--rt-footer': '#0F1620',
				'--rt-body': '#5e6e7d',
				'--rt-heading': '#1A2530',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#0B3C5D',
				'--rt-border': '#CED8E3',
				'--rt-line': '#E8EEF4',
				'--rt-hover': '#145C87'
			},
			'heritage-maroon': {
				'--rt-theme': '#CFA670',
				'--rt-primary': '#7A1E2C',
				'--rt-primary-1': '#9D3143',
				'--rt-primary-2': '#611523',
				'--rt-secondary': '#2E1F27',
				'--rt-footer': '#181114',
				'--rt-body': '#6F6166',
				'--rt-heading': '#2A2024',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#7A1E2C',
				'--rt-border': '#DDD2D0',
				'--rt-line': '#F1EAEA',
				'--rt-hover': '#9D3143'
			},
			'emerald-slate': {
				'--rt-theme': '#79B4A9',
				'--rt-primary': '#0E7C66',
				'--rt-primary-1': '#14947A',
				'--rt-primary-2': '#0A6553',
				'--rt-secondary': '#203A43',
				'--rt-footer': '#16262C',
				'--rt-body': '#5F6F74',
				'--rt-heading': '#1E3036',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#0E7C66',
				'--rt-border': '#CFE1DD',
				'--rt-line': '#E7F0ED',
				'--rt-hover': '#14947A'
			},
			'royal-violet': {
				'--rt-theme': '#8A6FD1',
				'--rt-primary': '#5A2E98',
				'--rt-primary-1': '#7447B2',
				'--rt-primary-2': '#47257A',
				'--rt-secondary': '#2B1E4A',
				'--rt-footer': '#1B1530',
				'--rt-body': '#69607E',
				'--rt-heading': '#2A2142',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#5A2E98',
				'--rt-border': '#D7CEE8',
				'--rt-line': '#EEE9F7',
				'--rt-hover': '#7447B2'
			},
			'sunset-coral': {
				'--rt-theme': '#F39C6B',
				'--rt-primary': '#C44536',
				'--rt-primary-1': '#D95E4F',
				'--rt-primary-2': '#A7372B',
				'--rt-secondary': '#2F3542',
				'--rt-footer': '#1F2430',
				'--rt-body': '#646B78',
				'--rt-heading': '#2C3140',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#C44536',
				'--rt-border': '#E5D5CF',
				'--rt-line': '#F5ECE9',
				'--rt-hover': '#D95E4F'
			},
			'midnight-teal': {
				'--rt-theme': '#2DD4BF',
				'--rt-primary': '#0F766E',
				'--rt-primary-1': '#14958A',
				'--rt-primary-2': '#0B5C56',
				'--rt-secondary': '#1F2937',
				'--rt-footer': '#111827',
				'--rt-body': '#617083',
				'--rt-heading': '#1D2A39',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#0F766E',
				'--rt-border': '#CCE7E3',
				'--rt-line': '#E9F6F4',
				'--rt-hover': '#14958A'
			},
			'graphite-gold': {
				'--rt-theme': '#E6C65B',
				'--rt-primary': '#B08900',
				'--rt-primary-1': '#CAA12A',
				'--rt-primary-2': '#8E6D00',
				'--rt-secondary': '#2B2D42',
				'--rt-footer': '#1B1E2E',
				'--rt-body': '#6B6D79',
				'--rt-heading': '#2A2D3E',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#B08900',
				'--rt-border': '#E4DDC3',
				'--rt-line': '#F4F2E8',
				'--rt-hover': '#CAA12A'
			},
			'crimson-ink': {
				'--rt-theme': '#D14D72',
				'--rt-primary': '#9B1C31',
				'--rt-primary-1': '#B3354B',
				'--rt-primary-2': '#7A1426',
				'--rt-secondary': '#1E1E2F',
				'--rt-footer': '#141423',
				'--rt-body': '#6A6878',
				'--rt-heading': '#252438',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#9B1C31',
				'--rt-border': '#E2CFD5',
				'--rt-line': '#F3EBEE',
				'--rt-hover': '#B3354B'
			},
			'forest-stone': {
				'--rt-theme': '#66BB6A',
				'--rt-primary': '#2E7D32',
				'--rt-primary-1': '#3F9444',
				'--rt-primary-2': '#255F28',
				'--rt-secondary': '#374151',
				'--rt-footer': '#222B36',
				'--rt-body': '#66707B',
				'--rt-heading': '#2E3845',
				'--rt-white': '#FFFFFF',
				'--rt-rating': '#2E7D32',
				'--rt-border': '#D1DED1',
				'--rt-line': '#EDF3ED',
				'--rt-hover': '#3F9444'
			}
		};

		function normalizeHex(value) {
			if (!value || typeof value !== 'string') return '#000000';
			var hex = value.trim();
			if (hex[0] !== '#') hex = '#' + hex;
			if (/^#[0-9a-fA-F]{3}$/.test(hex)) {
				return '#' + hex[1] + hex[1] + hex[2] + hex[2] + hex[3] + hex[3];
			}
			if (!/^#[0-9a-fA-F]{6}$/.test(hex)) return '#000000';
			return hex.toUpperCase();
		}

		function loadStored() {
			try {
				var raw = window.localStorage.getItem(STORAGE_KEY);
				if (!raw) return {};
				var parsed = JSON.parse(raw);
				return parsed && typeof parsed === 'object' ? parsed : {};
			} catch (err) {
				return {};
			}
		}

		function saveStored(colors) {
			try {
				window.localStorage.setItem(STORAGE_KEY, JSON.stringify(colors));
			} catch (err) {
				// Ignore localStorage errors.
			}
		}

		function applyColors(colors) {
			var root = document.documentElement;
			Object.keys(DEFAULTS).forEach(function (cssVar) {
				var color = normalizeHex(colors[cssVar] || DEFAULTS[cssVar]);
				root.style.setProperty(cssVar, color);
			});
		}

		function initColorConfig() {
			var launcher = document.getElementById('colorConfigLauncher');
			var panel = document.getElementById('colorConfigPanel');
			var resetBtn = document.getElementById('cfgReset');
			var closeBtn = document.getElementById('cfgClose');
			if (!launcher || !panel || !resetBtn || !closeBtn) return;

			var colors = Object.assign({}, DEFAULTS, loadStored());
			applyColors(colors);

			var presetButtons = Array.prototype.slice.call(panel.querySelectorAll('[data-preset]'));
			presetButtons.forEach(function (button) {
				button.addEventListener('click', function () {
					var presetKey = button.getAttribute('data-preset');
					if (!presetKey || !PRESETS[presetKey]) return;
					colors = Object.assign({}, DEFAULTS, PRESETS[presetKey]);
					applyColors(colors);
					saveStored(colors);
					launcher.style.background = normalizeHex(colors['--rt-primary']);
				});
			});

			launcher.addEventListener('click', function () {
				panel.hidden = !panel.hidden;
			});

			closeBtn.addEventListener('click', function () {
				panel.hidden = true;
			});

			resetBtn.addEventListener('click', function () {
				colors = Object.assign({}, DEFAULTS);
				applyColors(colors);
				launcher.style.background = normalizeHex(DEFAULTS['--rt-primary']);
				try {
					window.localStorage.removeItem(STORAGE_KEY);
				} catch (err) {
					// Ignore localStorage errors.
				}
			});

			document.addEventListener('click', function (event) {
				if (panel.hidden) return;
				var target = event.target;
				if (panel.contains(target) || launcher.contains(target)) return;
				panel.hidden = true;
			});

			launcher.style.background = normalizeHex(colors['--rt-primary']);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initColorConfig);
		} else {
			initColorConfig();
		}
	})();
</script>

<!-- Method 1: Using Astro's script tag with the is:inline attribute -->
<script is:inline src="/assets/js/vendor/jquery.min.js"></script>

<!-- All other scripts with dependencies, using defer attribute to ensure they load after jQuery -->
