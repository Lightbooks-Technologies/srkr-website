---
import OnlineNow from './OnlineNow.astro';
---

<OnlineNow />

<style>
	.color-config-launcher {
		position: fixed;
		right: 20px;
		bottom: 90px;
		width: 46px;
		height: 46px;
		border: none;
		border-radius: 50%;
		background: var(--rt-primary, #890C25);
		color: var(--rt-white, #fff);
		font-size: 21px;
		line-height: 1;
		cursor: pointer;
		z-index: 10001;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
	}

	.color-config-panel {
		position: fixed;
		right: 20px;
		bottom: 145px;
		width: min(92vw, 330px);
		max-height: min(70vh, 560px);
		overflow-y: auto;
		background: #fff;
		border: 1px solid var(--rt-border, #D9D9D9);
		border-radius: 12px;
		box-shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
		padding: 14px;
		z-index: 10001;
	}

	.color-config-panel[hidden] {
		display: none;
	}

	.color-config-title {
		font-size: 16px;
		font-weight: 700;
		color: var(--rt-heading, #262626);
		margin: 0 0 10px;
	}

	.color-config-grid {
		display: grid;
		gap: 8px;
	}

	.color-preset-btn {
		width: 100%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 10px 12px;
		border: 1px solid var(--rt-border, #D9D9D9);
		border-radius: 9px;
		background: #fff;
		color: var(--rt-heading, #262626);
		cursor: pointer;
		font-size: 13px;
		font-weight: 600;
		text-align: left;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.color-preset-btn:hover {
		border-color: var(--rt-primary, #890C25);
		transform: translateY(-1px);
	}

	.color-preset-swatches {
		display: flex;
		gap: 6px;
		flex-shrink: 0;
	}

	.color-preset-swatches span {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		border: 1px solid rgba(0, 0, 0, 0.12);
	}

	.color-config-actions {
		margin-top: 12px;
		display: flex;
		gap: 8px;
		justify-content: flex-end;
	}

	.color-config-actions button {
		border: 1px solid var(--rt-border, #D9D9D9);
		border-radius: 8px;
		padding: 7px 10px;
		background: #fff;
		color: var(--rt-heading, #262626);
		font-size: 12px;
		font-weight: 600;
		cursor: pointer;
	}

	.color-config-actions button.primary {
		background: var(--rt-primary, #890C25);
		border-color: var(--rt-primary, #890C25);
		color: #fff;
	}
</style>

<button
	id="colorConfigLauncher"
	class="color-config-launcher"
	type="button"
	aria-label="Open color settings"
	title="Color settings"
>
	⚙
</button>

<div id="colorConfigPanel" class="color-config-panel" hidden>
	<h3 class="color-config-title">Theme Presets</h3>
	<div class="color-config-grid">
		<button type="button" class="color-preset-btn" data-preset="srkr-classic">
			<span>SRKR Classic</span>
			<span class="color-preset-swatches"><span style="background:#890C25"></span><span style="background:#110C2D"></span><span style="background:#09A24F"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="executive-navy">
			<span>Executive Navy</span>
			<span class="color-preset-swatches"><span style="background:#0B3C5D"></span><span style="background:#1D2731"></span><span style="background:#328CC1"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="heritage-maroon">
			<span>Heritage Maroon</span>
			<span class="color-preset-swatches"><span style="background:#7A1E2C"></span><span style="background:#2E1F27"></span><span style="background:#CFA670"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="emerald-slate">
			<span>Emerald Slate</span>
			<span class="color-preset-swatches"><span style="background:#0E7C66"></span><span style="background:#203A43"></span><span style="background:#79B4A9"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="royal-violet">
			<span>Royal Violet</span>
			<span class="color-preset-swatches"><span style="background:#5A2E98"></span><span style="background:#2B1E4A"></span><span style="background:#8A6FD1"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="sunset-coral">
			<span>Sunset Coral</span>
			<span class="color-preset-swatches"><span style="background:#C44536"></span><span style="background:#2F3542"></span><span style="background:#F39C6B"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="midnight-teal">
			<span>Midnight Teal</span>
			<span class="color-preset-swatches"><span style="background:#0F766E"></span><span style="background:#1F2937"></span><span style="background:#2DD4BF"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="graphite-gold">
			<span>Graphite Gold</span>
			<span class="color-preset-swatches"><span style="background:#B08900"></span><span style="background:#2B2D42"></span><span style="background:#E6C65B"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="crimson-ink">
			<span>Crimson Ink</span>
			<span class="color-preset-swatches"><span style="background:#9B1C31"></span><span style="background:#1E1E2F"></span><span style="background:#D14D72"></span></span>
		</button>
		<button type="button" class="color-preset-btn" data-preset="forest-stone">
			<span>Forest Stone</span>
			<span class="color-preset-swatches"><span style="background:#2E7D32"></span><span style="background:#374151"></span><span style="background:#66BB6A"></span></span>
		</button>
	</div>
	<div class="color-config-actions">
		<button id="cfgReset" type="button">Reset</button>
		<button id="cfgClose" type="button" class="primary">Close</button>
	</div>
</div>

<script is:inline>
	(function () {
