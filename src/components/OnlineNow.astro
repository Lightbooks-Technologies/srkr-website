---
// "Online now" pill pinned to the right edge of every page.
// Reads the live count from the SRKR CMS proxy (/api/analytics/online), which
// holds the Umami API key server-side. Stays hidden until the first successful
// fetch AND the count reaches the visibility threshold — a live counter that
// says "2 online" hurts more than it helps.
const CMS_URL = import.meta.env.PUBLIC_CMS_URL || 'http://localhost:3001';
const MIN_VISIBLE = Number(import.meta.env.PUBLIC_ONLINE_MIN_VISIBLE || 5);
---

<style>
	.online-now {
		position: fixed;
		top: 50%;
		right: 0;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 9px 12px 9px 11px;
		background: var(--rt-secondary, #110c2d);
		color: #fff;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.2px;
		border-radius: 9px 0 0 9px;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
		z-index: 9999;
		cursor: default;
		user-select: none;
	}

	.online-now[hidden] {
		display: none;
	}

	.online-now__dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--rt-theme, #09a24f);
		flex-shrink: 0;
		animation: online-pulse 2s ease-in-out infinite;
	}

	@keyframes online-pulse {
		0%, 100% { box-shadow: 0 0 0 0 rgba(9, 162, 79, 0.55); }
		50% { box-shadow: 0 0 0 5px rgba(9, 162, 79, 0); }
	}

	@media (max-width: 767px) {
		.online-now {
			font-size: 11px;
			padding: 7px 9px;
		}
	}
</style>

<div
	id="srkrOnlineNow"
	class="online-now"
	hidden
	role="status"
	title="Visitors browsing srkrec.ac.in right now"
>
	<span class="online-now__dot" aria-hidden="true"></span>
	<span><strong id="srkrOnlineCount">0</strong> online now</span>
</div>

<script is:inline define:vars={{ CMS_URL, MIN_VISIBLE }}>
	(function () {
		// Not on the homepage — the pill overlaps the hero design there.
		if (location.pathname === '/' || location.pathname === '/index.html') return;

		var pill = document.getElementById('srkrOnlineNow');
		var countEl = document.getElementById('srkrOnlineCount');
		if (!pill || !countEl) return;

		var POLL_MS = 60000;
		var timer = null;

		function refresh() {
			fetch(CMS_URL + '/api/analytics/online', { headers: { Accept: 'application/json' } })
				.then(function (res) { return res.ok ? res.json() : null; })
				.then(function (data) {
					var online = data && data.enabled ? Number(data.online) || 0 : 0;
					if (online >= MIN_VISIBLE) {
						countEl.textContent = String(online);
						pill.hidden = false;
					} else {
						pill.hidden = true;
					}
				})
				.catch(function () { pill.hidden = true; });
		}

		function start() {
			if (timer) return;
			refresh();
			timer = setInterval(refresh, POLL_MS);
		}

		function stop() {
			if (timer) { clearInterval(timer); timer = null; }
		}

		// Don't poll while the tab is in the background.
		document.addEventListener('visibilitychange', function () {
			document.hidden ? stop() : start();
		});
		start();
	})();
</script>
