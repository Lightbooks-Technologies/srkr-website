# Astro website environment variables

# Base URL of the SRKR CMS (Payload) that serves Events & News.
# Local dev default is http://localhost:3001 (used if unset).
# In production (Vercel), set this to the deployed CMS domain.
PUBLIC_CMS_URL=http://localhost:3001

# Umami analytics (see docs/ANALYTICS-SETUP.md). The website ID is public —
# it appears in the page source anyway. Tracking only records srkrec.ac.in
# domains, so localhost/preview traffic is never counted.
PUBLIC_UMAMI_WEBSITE_ID=bb31090e-6112-4614-81ff-0a6992cd4296

# Optional overrides:
# PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js   # change if ever self-hosting
# PUBLIC_ONLINE_MIN_VISIBLE=5   # min live visitors before the "online now" pill shows
